WINE_BRANCH=main
WINE_COMMIT=da5b7c3b0644c7cc686f7018f7b5e72085e6c92f
# FEX, which runs x86_64 code on the arm64 Wine and in the VM: this one commit of our fork's main and its submodules.
FEX_REPO=https://github.com/Mac-Neutron/FEX.git
FEX_COMMIT=1129152562c7e3e37591d2a60e832da76885ad44
# Where our FEX's macOS unixlib helpers come from (one commit on top of FEX 4ed80fd, the 0.6.0 pin); the build
# doesn't fetch it.
FEX_MACOS_REPO=https://github.com/dappermint/FEX.git
FEX_MACOS_COMMIT=4efc3abc8aca8a0d3a8aca1f153ef6c4299f4426
