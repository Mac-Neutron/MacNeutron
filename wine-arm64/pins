# MacNeutron's native arm64 stack inputs (native arm64 spec §5.1, §6.1), sourced by wine-arm64/build.sh.
# Wine: this one commit of our fork's WINE_BRANCH (upstream master with our changes, the VM's included; build.sh
# fetches it alone). The VM's Wine is the same tree (vm/wine/sync.sh). llvm-mingw is not pinned here: dxmt/pins
# owns it, via dxmt/toolchain.sh.
WINE_REPO=https://github.com/Mac-Neutron/wine.git
WINE_BRANCH=main
WINE_COMMIT=47c8bf8b71152916f45cde607df4d20f4ad15012
# FEX, which runs x86_64 code on the arm64 Wine and in the VM: this one commit of our fork's main and its submodules.
FEX_REPO=https://github.com/Mac-Neutron/FEX.git
FEX_COMMIT=6c0e56db34618a112b50361809ef0230c3bd46c1
# Where our FEX's macOS unixlib helpers come from (one commit on top of FEX 4ed80fd, the 0.6.0 pin); the build
# doesn't fetch it.
FEX_MACOS_REPO=https://github.com/dappermint/FEX.git
FEX_MACOS_COMMIT=4efc3abc8aca8a0d3a8aca1f153ef6c4299f4426
