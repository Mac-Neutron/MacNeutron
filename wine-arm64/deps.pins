# Third-party sources wine.app is built from beside Wine, FEX and DXMT (ship-base spec §5, §7), sourced by
# wine-arm64/build.sh. In the build stamp, not in the Wine, FEX or DXMT pins: editing this file never re-clones Wine
# or FEX.
# FreeType (libfreetype.6.dylib), gnutls with libtasn1, nettle and gmp linked into it (libgnutls.30.dylib), and FFmpeg
# (libavutil.61, libavcodec.63, libavformat.63, libswscale.10 and libswresample.7 .dylib; video playback spec §6): each
# project's development head. A git source is <NAME>_REPO at <NAME>_COMMIT, its submodules at the commits it records,
# cloned with every commit and tag but only that tree's files (gnulib's git-version-gen describes the commit), and
# bootstrapped by build.sh. GMP's development trunk (gmp-next) is its own nightly snapshot, configure included: its
# repository refuses scripted clones. GMP signs no snapshot; the SHA-256 was recorded at download, 2026-10-24.
FREETYPE_REPO=https://gitlab.freedesktop.org/freetype/freetype.git
FREETYPE_COMMIT=2b01fa2d6723bf12490822268c9627697ed89643
GNUTLS_REPO=https://gitlab.com/gnutls/gnutls.git
GNUTLS_COMMIT=0e7b36b58a259d5c67f298adb66291d79b019f22
LIBTASN1_REPO=https://gitlab.com/gnutls/libtasn1.git
LIBTASN1_COMMIT=2b2065b2383aebe138c7d0f7b5646369e5f56ec3
NETTLE_REPO=https://git.lysator.liu.se/nettle/nettle.git
NETTLE_COMMIT=cf01e9d2741339cf01a90a0986b82e732b00ea59
GMP_URL=https://gmplib.org/download/snapshot/gmp-next/gmp-6.3.0-20260920180220.tar.zst
GMP_SHA256=a625d1bdf36b096117fac26463ab9c6037b2e678d7e98b8711783c25a8894d16
FFMPEG_REPO=https://git.ffmpeg.org/ffmpeg.git
FFMPEG_COMMIT=3719f257cf76e4463adc8b5b77029c3594def120
# lsteamclient, the Steam bridge (spec §7): the lsteamclient/ folder of our Proton fork's main (Proton's bleeding-edge
# with our changes) at this commit, a sparse, blob-filtered checkout without the Steamworks SDK folders. Its pin is
# LSTEAMCLIENT_COMMIT alone: a tarball pin never re-fetches it.
LSTEAMCLIENT_REPO=https://github.com/Mac-Neutron/Proton.git
LSTEAMCLIENT_COMMIT=59b9eee05e1d2bcf65fed128250f92b4ed3d5a02
