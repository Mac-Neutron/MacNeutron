+        retained(meta::read(handle_of(self), |e| e.map_or(0, |e| e.queue))).expect("a command buffer's queue")
+    }
+    fn retainedReferences(&self) -> bool {
+        true
+    }
+    fn errorOptions(&self) -> MTLCommandBufferErrorOption {
