index 00000000..f08e3fea
--- /dev/null
+++ b/mtld3d/unix/mtl/src/metal_fx.rs
@@ -0,0 +1,137 @@
+//! objc2-metal-fx's spatial scaler over winemetal (slots 57, 59, 68): the scaler keeps its textures until it is
+//! encoded, as winemetal's encode slot takes them together.
+
+#![allow(non_snake_case)]
+
+use core::sync::atomic::{AtomicUsize, Ordering};
+use std::{collections::HashMap, sync::Mutex};
+
+pub use crate::metal::MTLFXSpatialScalerColorProcessingMode;
+use crate::{
+    foundation::NSUInteger,
+    meta,
+    metal::{MTLCommandBuffer, MTLDevice, MTLPixelFormat, MTLTexture, MTLTextureUsage, handle_of},
+    objc2::{
+        self, Message, Retained,
+        runtime::{NSObjectProtocol, ProtocolObject},
+    },
+    table, wmt,
+};
+
+/// The descriptor (the facade's own object).
+pub struct MTLFXSpatialScalerDescriptor {
+    refs: AtomicUsize,
+    d: Mutex<wmt::SpatialScalerInfo>,
+}
+
+// SAFETY: a Rust count; the box goes with the last reference.
+unsafe impl Message for MTLFXSpatialScalerDescriptor {
+    unsafe fn retain_raw(ptr: *const Self) {
+        // SAFETY: a live object.
+        unsafe { &*ptr }.refs.fetch_add(1, Ordering::Relaxed);
+    }
+    unsafe fn release_raw(ptr: *const Self) {
+        // SAFETY: the last reference frees the box.
+        unsafe {
+            if (*ptr).refs.fetch_sub(1, Ordering::AcqRel) == 1 {
+                drop(Box::from_raw(ptr.cast_mut()));
+            }
+        }
+    }
+}
+
+fn lock(d: &Mutex<wmt::SpatialScalerInfo>) -> std::sync::MutexGuard<'_, wmt::SpatialScalerInfo> {
+    d.lock().unwrap_or_else(std::sync::PoisonError::into_inner)
+}
+
+impl MTLFXSpatialScalerDescriptor {
+    /// # Safety
+    /// None (objc2-metal-fx generates it `unsafe`).
+    #[must_use]
+    pub unsafe fn new() -> Retained<Self> {
+        let ptr = Box::into_raw(Box::new(Self { refs: AtomicUsize::new(1), d: Mutex::new(wmt::SpatialScalerInfo::default()) }));
+        // SAFETY: a new object with its one reference.
+        unsafe { Retained::from_raw(ptr).unwrap_unchecked() }
+    }
+    /// # Safety
+    /// objc2's contract.
+    pub unsafe fn setColorTextureFormat(&self, v: MTLPixelFormat) { lock(&self.d).color_format = v.0 as u32; }
+    /// # Safety
+    /// objc2's contract.
+    pub unsafe fn setOutputTextureFormat(&self, v: MTLPixelFormat) { lock(&self.d).output_format = v.0 as u32; }
+    /// # Safety
+    /// objc2's contract.
+    pub unsafe fn setInputWidth(&self, v: NSUInteger) { lock(&self.d).input_width = v as u32; }
+    /// # Safety
+    /// objc2's contract.
+    pub unsafe fn setInputHeight(&self, v: NSUInteger) { lock(&self.d).input_height = v as u32; }
+    /// # Safety
+    /// objc2's contract.
+    pub unsafe fn setOutputWidth(&self, v: NSUInteger) { lock(&self.d).output_width = v as u32; }
+    /// # Safety
+    /// objc2's contract.
+    pub unsafe fn setOutputHeight(&self, v: NSUInteger) { lock(&self.d).output_height = v as u32; }
+    /// Perceptual only: winemetal's scaler has no processing mode (HDR is left out under the facade).
+    ///
+    /// # Safety
+    /// objc2's contract.
+    pub unsafe fn setColorProcessingMode(&self, _v: MTLFXSpatialScalerColorProcessingMode) {}
+    /// # Safety
+    /// objc2's contract.
+    pub unsafe fn newSpatialScalerWithDevice(&self, device: &ProtocolObject<dyn MTLDevice>) -> Option<Retained<ProtocolObject<dyn MTLFXSpatialScaler>>> {
+        let info = *lock(&self.d);
+        let mut params = wmt::NewWithConstInfo { device: device.handle(), info: (&raw const info).cast(), ret: 0 };
+        // SAFETY: slot 57 reads the info.
+        unsafe { table::call(wmt::DEVICE_NEW_SPATIAL_SCALER, &mut params) };
+        let scaler = objc2::from_plus_one(params.ret)?;
+        let d = device.handle();
+        meta::with(params.ret, |e| e.device = d);
+        Some(scaler)
+    }
+    /// # Safety
+    /// objc2's contract.
+    pub unsafe fn supportsDevice(device: &ProtocolObject<dyn MTLDevice>) -> bool {
+        let mut params = wmt::ObjU64Ret { handle: device.handle(), ret: 0 };
+        // SAFETY: slot 68 queries a live device.
+        unsafe { table::call(wmt::DEVICE_SUPPORTS_FX_SPATIAL_SCALER, &mut params) };
+        params.ret != 0
+    }
+}
+
+/// Each scaler's colour and output textures, set until it is encoded.
+static TEXTURES: Mutex<Option<HashMap<u64, (u64, u64)>>> = Mutex::new(None);
+
+fn textures<R>(f: impl FnOnce(&mut HashMap<u64, (u64, u64)>) -> R) -> R {
+    f(TEXTURES.lock().unwrap_or_else(std::sync::PoisonError::into_inner).get_or_insert_with(HashMap::new))
+}
+
+/// objc2-metal-fx's `MTLFXSpatialScalerBase`.
+pub unsafe trait MTLFXSpatialScalerBase: NSObjectProtocol {
+    unsafe fn colorTextureUsage(&self) -> MTLTextureUsage {
+        MTLTextureUsage::ShaderRead
+    }
+    unsafe fn outputTextureUsage(&self) -> MTLTextureUsage {
+        MTLTextureUsage::RenderTarget | MTLTextureUsage::ShaderRead | MTLTextureUsage::ShaderWrite
+    }
+    unsafe fn setColorTexture(&self, color_texture: Option<&ProtocolObject<dyn MTLTexture>>) {
+        let t = color_texture.map_or(0, |t| t.handle());
+        textures(|m| m.entry(handle_of(self)).or_default().0 = t);
+    }
+    unsafe fn setOutputTexture(&self, output_texture: Option<&ProtocolObject<dyn MTLTexture>>) {
+        let t = output_texture.map_or(0, |t| t.handle());
+        textures(|m| m.entry(handle_of(self)).or_default().1 = t);
+    }
+}
+
+/// objc2-metal-fx's `MTLFXSpatialScaler`.
+pub unsafe trait MTLFXSpatialScaler: MTLFXSpatialScalerBase {
+    unsafe fn encodeToCommandBuffer(&self, command_buffer: &ProtocolObject<dyn MTLCommandBuffer>) {
+        let (color, output) = textures(|m| m.get(&handle_of(self)).copied().unwrap_or_default());
+        let mut params = wmt::SpatialScale { cmdbuf: command_buffer.handle(), scaler: handle_of(self), color, output, fence: 0 };
+        // SAFETY: slot 59 encodes the scaler into a live buffer.
+        unsafe { table::call(wmt::COMMAND_BUFFER_ENCODE_SPATIAL_SCALE, &mut params) };
+    }
+}
+
+unsafe impl MTLFXSpatialScalerBase for ProtocolObject<dyn MTLFXSpatialScaler> {}
+unsafe impl MTLFXSpatialScaler for ProtocolObject<dyn MTLFXSpatialScaler> {}
diff --git a/mtld3d/unix/mtl/src/objc2.rs b/mtld3d/unix/mtl/src/objc2.rs
new file mode 100644
index 00000000..a88cef38
--- /dev/null
+++ b/mtld3d/unix/mtl/src/objc2.rs
@@ -0,0 +1,285 @@
+//! objc2's object model, as far as mtld3d uses it, over winemetal handles.
+//!
+//! A Metal object is a `ProtocolObject<dyn MTLX>` reference whose address is its winemetal handle (on macOS the
+//! Objective-C object's address, as in objc2; in the VM's guest a number the guest picked): the type is zero-sized and
+//! never read, so code that turns objects into `u64`s and back works unchanged. `Retained<T>` holds +1 of it; its
+//! release goes to winemetal when the facade's own count of the object's references reaches zero. Descriptors and
+//! strings the facade makes are Rust objects behind the same `Retained` (`Message` says how each is kept).
+
+use core::{fmt, marker::PhantomData, ops::Deref, ptr::NonNull};
+
+use crate::meta;
+
+/// How an object is retained and released: winemetal for Metal objects, a Rust count for the facade's own.
+///
+/// # Safety
+/// `retain_raw`/`release_raw` keep the object alive exactly as long as its references.
+pub unsafe trait Message {
+    /// +1 on the object at `ptr`.
+    ///
+    /// # Safety
+    /// `ptr` is a live object of this type.
+    unsafe fn retain_raw(ptr: *const Self);
+    /// -1 on the object at `ptr`, freeing it at zero.
+    ///
+    /// # Safety
+    /// `ptr` holds a reference the caller gives up.
+    unsafe fn release_raw(ptr: *const Self);
+
+    /// A new +1 reference to `self`.
+    fn retain(&self) -> Retained<Self>
+    where
+        Self: Sized,
+    {
+        // SAFETY: `self` is live; the new reference is the Retained's.
+        unsafe {
+            Self::retain_raw(self);
+            Retained::from_raw(core::ptr::from_ref(self).cast_mut()).unwrap_unchecked()
+        }
+    }
+}
+
+/// objc2's `ProtocolType` (a marker here).
+pub trait ProtocolType {}
+
+pub mod rc {
+    use super::{Deref, Message, NonNull, PhantomData, fmt};
+
+    /// A +1 reference.
+    pub struct Retained<T: ?Sized + Message> {
+        ptr: NonNull<T>,
+        _p: PhantomData<T>,
+    }
+
+    // SAFETY: winemetal objects are thread-safe as Metal's are; the facade's own objects are Sync themselves.
+    unsafe impl<T: ?Sized + Message + Sync> Send for Retained<T> {}
+    // SAFETY: as above.
+    unsafe impl<T: ?Sized + Message + Sync> Sync for Retained<T> {}
+
+    impl<T: Message> Retained<T> {
+        /// Takes over +1 at `ptr` (objc2's `from_raw`).
+        ///
+        /// # Safety
+        /// `ptr` is null or holds +1 the caller gives up.
+        pub unsafe fn from_raw(ptr: *mut T) -> Option<Self> {
+            NonNull::new(ptr).map(|ptr| Self { ptr, _p: PhantomData })
+        }
+
+        /// +1 on `ptr` (objc2's `retain`).
+        ///
+        /// # Safety
+        /// `ptr` is null or a live object.
+        pub unsafe fn retain(ptr: *mut T) -> Option<Self> {
+            let ptr = NonNull::new(ptr)?;
+            // SAFETY: the caller's contract.
+            unsafe { T::retain_raw(ptr.as_ptr()) };
+            Some(Self { ptr, _p: PhantomData })
+        }
+
+        /// Gives up the reference without releasing it.
+        #[must_use]
+        pub fn into_raw(this: Self) -> *mut T {
+            let ptr = this.ptr.as_ptr();
+            core::mem::forget(this);
+            ptr
+        }
+
+        /// The object's address.
+        #[must_use]
+        pub fn as_ptr(this: &Self) -> *const T {
+            this.ptr.as_ptr()
+        }
+
+        /// The same reference as another type (objc2's `cast_unchecked`).
+        ///
+        /// # Safety
+        /// The object is also a `U`.
+        #[must_use]
+        pub unsafe fn cast_unchecked<U: Message>(this: Self) -> Retained<U> {
+            let ptr = Self::into_raw(this).cast::<U>();
+            // SAFETY: non-null, +1 handed over.
+            unsafe { Retained::from_raw(ptr).unwrap_unchecked() }
+        }
+
+        /// objc2's `into_retained` on an owned object: itself.
+        #[must_use]
+        pub const fn into_retained(this: Self) -> Self {
+            this
+        }
+    }
+
+    impl<T: ?Sized + Message> Deref for Retained<T> {
+        type Target = T;
+        fn deref(&self) -> &T {
+            // SAFETY: a live object; for a winemetal object the type is zero-sized and never read.
+            unsafe { self.ptr.as_ref() }
+        }
+    }
+
+    impl<T: Message> Clone for Retained<T> {
+        fn clone(&self) -> Self {
+            (**self).retain()
+        }
+    }
+
+    impl<T: ?Sized + Message> Drop for Retained<T> {
+        fn drop(&mut self) {
+            // SAFETY: this reference is given up here.
+            unsafe { T::release_raw(self.ptr.as_ptr()) };
+        }
+    }
+
+    impl<T: ?Sized + Message + fmt::Display> fmt::Display for Retained<T> {
+        fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+            (**self).fmt(f)
+        }
+    }
+
+    impl<T: ?Sized + Message> AsRef<T> for Retained<T> {
+        fn as_ref(&self) -> &T {
+            self
+        }
+    }
+
+    impl<T: ?Sized + Message> core::borrow::Borrow<T> for Retained<T> {
+        fn borrow(&self) -> &T {
+            self
+        }
+    }
+
+    impl<T: ?Sized + Message> fmt::Debug for Retained<T> {
+        fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+            write!(f, "Retained({:p})", self.ptr)
+        }
+    }
+
+    impl<T: ?Sized + Message> PartialEq for Retained<T> {
+        fn eq(&self, other: &Self) -> bool {
+            core::ptr::eq(self.ptr.as_ptr(), other.ptr.as_ptr())
+        }
+    }
+
+    /// objc2's `AutoreleasePool` marker.
+    pub struct AutoreleasePool<'p>(PhantomData<&'p ()>);
+
+    /// Runs `f` inside an autorelease pool: winemetal's on macOS (slot 10, drained by its release), none on Linux,
+    /// where the VM's host owns the pools of the calls it runs.
+    pub fn autoreleasepool<R>(f: impl for<'p> FnOnce(AutoreleasePool<'p>) -> R) -> R {
+        #[cfg(target_vendor = "apple")]
+        {
+            use crate::{table, wmt};
+            let mut params = wmt::ObjRet::default();
+            // SAFETY: slot 10 takes and fills this struct.
+            unsafe { table::call(wmt::AUTORELEASE_POOL_ALLOC_INIT, &mut params) };
+            let result = f(AutoreleasePool(PhantomData));
+            let mut release = wmt::ObjNoRet { handle: params.ret };
+            // SAFETY: the pool made above, released (drained) on the thread that made it.
+            unsafe { table::call(wmt::RELEASE, &mut release) };
+            result
+        }
+        #[cfg(not(target_vendor = "apple"))]
+        {
+            f(AutoreleasePool(PhantomData))
+        }
+    }
+}
+
+pub use rc::Retained;
+
+pub mod runtime {
+    use super::{Message, PhantomData, meta};
+    use crate::{table, wmt};
+
+    /// A winemetal object seen through a protocol: zero-sized, its address is the handle.
+    #[repr(C)]
+    pub struct ProtocolObject<P: ?Sized> {
+        _inner: [u8; 0],
+        _p: PhantomData<fn() -> *const P>,
+    }
+
+    // SAFETY: the handle is a number; winemetal's calls are thread-safe.
+    unsafe impl<P: ?Sized> Send for ProtocolObject<P> {}
+    // SAFETY: as above.
+    unsafe impl<P: ?Sized> Sync for ProtocolObject<P> {}
+
+    impl<P: ?Sized> ProtocolObject<P> {
+        /// The same object through another protocol (objc2's `from_ref`).
+        pub fn from_ref<T: ?Sized>(obj: &T) -> &Self {
+            // SAFETY: a zero-sized type at the same address.
+            unsafe { &*(core::ptr::from_ref(obj).cast::<Self>()) }
+        }
+
+        /// The object's winemetal handle.
+        #[must_use]
+        pub fn handle(&self) -> u64 {
+            core::ptr::from_ref(self) as usize as u64
+        }
+
+        /// The object with handle `handle`, borrowed (no reference taken).
+        ///
+        /// # Safety
+        /// `handle` is a live, non-zero winemetal handle of this protocol's kind, alive for `'a`.
+        #[must_use]
+        pub unsafe fn from_handle<'a>(handle: u64) -> &'a Self {
+            // SAFETY: a zero-sized type at a non-null address.
+            unsafe { &*(handle as usize as *const Self) }
+        }
+    }
+
+    // SAFETY: winemetal's retain and release (slots 0, 1), mirrored in the facade's count so its metadata goes with
+    // the last reference.
+    unsafe impl<P: ?Sized> Message for ProtocolObject<P> {
+        unsafe fn retain_raw(ptr: *const Self) {
+            let handle = ptr as usize as u64;
+            meta::retain(handle);
+            let mut params = wmt::ObjNoRet { handle };
+            // SAFETY: a live object.
+            unsafe { table::call(wmt::RETAIN, &mut params) };
+        }
+        unsafe fn release_raw(ptr: *const Self) {
+            let handle = ptr as usize as u64;
+            meta::release(handle);
+            let mut params = wmt::ObjNoRet { handle };
+            // SAFETY: a reference given up.
+            unsafe { table::call(wmt::RELEASE, &mut params) };
+        }
+    }
+
+    impl<P: ?Sized> PartialEq for ProtocolObject<P> {
+        fn eq(&self, other: &Self) -> bool {
+            self.handle() == other.handle()
+        }
+    }
+
+    impl<P: ?Sized> core::fmt::Debug for ProtocolObject<P> {
+        fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+            write!(f, "<object {:#x}>", self.handle())
+        }
+    }
+
+    /// objc2's `AnyObject`: any winemetal object.
+    pub type AnyObject = ProtocolObject<dyn core::any::Any>;
+
+    /// objc2's `NSObjectProtocol`.
+    pub trait NSObjectProtocol {}
+    impl<P: ?Sized> NSObjectProtocol for ProtocolObject<P> {}
+}
+
+/// A +1 winemetal handle from a slot, as a `Retained`; `None` for 0.
+pub(crate) fn from_plus_one<P: ?Sized>(handle: u64) -> Option<Retained<runtime::ProtocolObject<P>>> {
+    if handle == 0 {
+        return None;
+    }
+    meta::adopt(handle);
+    // SAFETY: a +1 handle the slot handed over.
+    unsafe { Retained::from_raw(handle as usize as *mut runtime::ProtocolObject<P>) }
+}
+
+/// An autoreleased (+0) winemetal handle from a slot, retained as a `Retained`; `None` for 0.
+pub(crate) fn from_autoreleased<P: ?Sized>(handle: u64) -> Option<Retained<runtime::ProtocolObject<P>>> {
+    if handle == 0 {
+        return None;
+    }
+    // SAFETY: a live object (its pool hasn't drained: we're inside the call that returned it).
+    unsafe { Retained::retain(handle as usize as *mut runtime::ProtocolObject<P>) }
+}
diff --git a/mtld3d/unix/mtl/src/quartz_core.rs b/mtld3d/unix/mtl/src/quartz_core.rs
new file mode 100644
index 00000000..8f4c984f
--- /dev/null
+++ b/mtld3d/unix/mtl/src/quartz_core.rs
@@ -0,0 +1,188 @@
+//! objc2-quartz-core's `CAMetalLayer` and `CAMetalDrawable` over winemetal's layer slots: a layer is the one
+//! `CreateMetalViewFromHWND` made for a window; its properties are winemetal's `WMTLayerProps`.
+
+#![allow(non_snake_case)]
+
+use crate::{
+    foundation::NSUInteger,
+    meta,
+    metal::{MTLDevice, MTLDrawable, MTLPixelFormat, MTLTexture, handle_of, retained},
+    objc2::{
+        self, Message, Retained,
+        runtime::{NSObjectProtocol, ProtocolObject},
+    },
+    table, wmt,
+};
+
+/// objc2-core-foundation's `CGSize`.
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct CGSize {
+    pub width: f64,
+    pub height: f64,
+}
+
+impl CGSize {
+    #[must_use]
+    pub const fn new(width: f64, height: f64) -> Self {
+        Self { width, height }
+    }
+}
+
+/// A winemetal layer.
+#[repr(C)]
+pub struct CAMetalLayer {
+    _inner: [u8; 0],
+}
+
+// SAFETY: winemetal's retain and release, as any winemetal object.
+unsafe impl Message for CAMetalLayer {
+    unsafe fn retain_raw(ptr: *const Self) {
+        // SAFETY: the same handle as a protocol object.
+        unsafe { ProtocolObject::<dyn core::any::Any>::retain_raw(ptr.cast()) }
+    }
+    unsafe fn release_raw(ptr: *const Self) {
+        // SAFETY: as above.
+        unsafe { ProtocolObject::<dyn core::any::Any>::release_raw(ptr.cast()) }
+    }
+}
+
+impl NSObjectProtocol for CAMetalLayer {}
+
+impl CAMetalLayer {
+    /// The layer with handle `handle` (from `CreateMetalViewFromHWND`), retained.
+    #[must_use]
+    pub fn from_handle(handle: u64) -> Option<Retained<Self>> {
+        if handle == 0 {
+            return None;
+        }
+        // SAFETY: a live layer.
+        unsafe { Retained::retain(handle as usize as *mut Self) }
+    }
+
+    fn props(&self) -> wmt::LayerProps {
+        let mut props = wmt::LayerProps::default();
+        let mut params = wmt::ObjPtrNoRet { handle: handle_of(self), arg: (&raw mut props).cast() };
+        // SAFETY: slot 71 fills the props.
+        unsafe { table::call(wmt::LAYER_GET_PROPS, &mut params) };
+        props
+    }
+
+    fn set(&self, f: impl FnOnce(&mut wmt::LayerProps)) {
+        let mut props = self.props();
+        f(&mut props);
+        let mut params = wmt::ObjConstPtrNoRet { handle: handle_of(self), arg: (&raw const props).cast() };
+        // SAFETY: slot 70 reads the props.
+        unsafe { table::call(wmt::LAYER_SET_PROPS, &mut params) };
+    }
+
+    pub fn device(&self) -> Option<Retained<ProtocolObject<dyn MTLDevice>>> {
+        retained(meta::read(handle_of(self), |e| e.map_or(0, |e| e.device)))
+    }
+    pub fn setDevice(&self, device: Option<&ProtocolObject<dyn MTLDevice>>) {
+        let device = device.map_or(0, |d| d.handle());
+        meta::with(handle_of(self), |e| e.device = device);
+        self.set(|p| p.device = device);
+    }
+    pub fn pixelFormat(&self) -> MTLPixelFormat {
+        MTLPixelFormat(self.props().pixel_format as usize)
+    }
+    pub fn setPixelFormat(&self, pixel_format: MTLPixelFormat) {
+        self.set(|p| p.pixel_format = pixel_format.0 as u32);
+    }
+    pub fn setFramebufferOnly(&self, framebuffer_only: bool) {
+        self.set(|p| p.framebuffer_only = framebuffer_only);
+    }
+    pub fn setOpaque(&self, opaque: bool) {
+        self.set(|p| p.opaque = opaque);
+    }
+    pub fn drawableSize(&self) -> CGSize {
+        let p = self.props();
+        CGSize::new(p.drawable_width, p.drawable_height)
+    }
+    pub fn setDrawableSize(&self, drawable_size: CGSize) {
+        self.set(|p| {
+            p.drawable_width = drawable_size.width;
+            p.drawable_height = drawable_size.height;
+        });
+    }
+    pub fn contentsScale(&self) -> f64 {
+        self.props().contents_scale
+    }
+    pub fn setDisplaySyncEnabled(&self, display_sync_enabled: bool) {
+        self.set(|p| p.display_sync_enabled = display_sync_enabled);
+    }
+    /// winemetal's layer keeps Core Animation's default (3).
+    pub fn setMaximumDrawableCount(&self, _maximum_drawable_count: NSUInteger) {}
+    /// winemetal's layer keeps Core Animation's default (no transaction).
+    pub fn setPresentsWithTransaction(&self, _presents_with_transaction: bool) {}
+    /// winemetal's layer keeps Core Animation's default (timeouts allowed).
+    pub fn setAllowsNextDrawableTimeout(&self, _allows_next_drawable_timeout: bool) {}
+    /// SDR only under the facade.
+    pub fn wantsExtendedDynamicRangeContent(&self) -> bool {
+        false
+    }
+    pub fn setWantsExtendedDynamicRangeContent(&self, _wants: bool) {}
+
+    pub fn nextDrawable(&self) -> Option<Retained<ProtocolObject<dyn CAMetalDrawable>>> {
+        let layer = handle_of(self);
+        let mut params = wmt::ObjObjRet { handle: layer, ret: 0 };
+        // SAFETY: slot 67 returns an autoreleased drawable or 0 (a timeout).
+        unsafe { table::call(wmt::LAYER_NEXT_DRAWABLE, &mut params) };
+        let drawable = objc2::from_autoreleased(params.ret)?;
+        let device = meta::read(layer, |e| e.map_or(0, |e| e.device));
+        meta::with(params.ret, |e| {
+            e.queue = layer;
+            e.device = device;
+        });
+        Some(drawable)
+    }
+}
+
+/// objc2-quartz-core's `CAMetalDrawable`.
+pub unsafe trait CAMetalDrawable: MTLDrawable {
+    fn texture(&self) -> Retained<ProtocolObject<dyn MTLTexture>> {
+        let mut params = wmt::ObjObjRet { handle: handle_of(self), ret: 0 };
+        // SAFETY: slot 66 returns the drawable's texture (autoreleased with the frame's pool).
+        unsafe { table::call(wmt::DRAWABLE_TEXTURE, &mut params) };
+        objc2::from_autoreleased(params.ret).expect("a drawable's texture")
+    }
+    fn layer(&self) -> Retained<CAMetalLayer> {
+        CAMetalLayer::from_handle(meta::read(handle_of(self), |e| e.map_or(0, |e| e.queue))).expect("a drawable's layer")
+    }
+}
+
+unsafe impl MTLDrawable for ProtocolObject<dyn CAMetalDrawable> {}
+unsafe impl CAMetalDrawable for ProtocolObject<dyn CAMetalDrawable> {}
+
+/// A metal view over the client area of window `hwnd` for `device` (winemetal's `CreateMetalViewFromHWND`, slot 72):
+/// the view's handle and its layer, or `None` when the window has no view to give (winemetal found no window data).
+#[must_use]
+pub fn create_metal_view(hwnd: u64, device: &ProtocolObject<dyn MTLDevice>) -> Option<(u64, Retained<CAMetalLayer>)> {
+    let mut params = wmt::CreateMetalView { hwnd, device: device.handle(), ret_view: 0, ret_layer: 0 };
+    // SAFETY: slot 72 makes a view for a window handle.
+    unsafe { table::call(wmt::CREATE_METAL_VIEW_FROM_HWND, &mut params) };
+    if params.ret_view == 0 || params.ret_layer == 0 {
+        return None;
+    }
+    let layer = CAMetalLayer::from_handle(params.ret_layer)?;
+    let d = device.handle();
+    meta::with(params.ret_layer, |e| e.device = d);
+    Some((params.ret_view, layer))
+}
+
+/// Releases a view `create_metal_view` made (slot 73), taking its layer off the window.
+pub fn release_metal_view(view: u64) {
+    let mut params = wmt::ObjNoRet { handle: view };
+    // SAFETY: slot 73 releases a live view.
+    unsafe { table::call(wmt::RELEASE_METAL_VIEW, &mut params) };
+}
+
+impl CAMetalLayer {
+    /// sRGB, standard range (winemetal's `MetalLayer_setColorSpace`, slot 93): the facade's only layer mode.
+    pub fn set_srgb(&self) {
+        let mut params = wmt::ObjU64U64Ret { handle: handle_of(self), arg: 0, ret: 0 };
+        // SAFETY: slot 93 on a live layer; 0 is WMTColorSpaceSRGB.
+        unsafe { table::call(wmt::LAYER_SET_COLOR_SPACE, &mut params) };
+    }
+}
diff --git a/mtld3d/unix/mtl/src/table.rs b/mtld3d/unix/mtl/src/table.rs
new file mode 100644
index 00000000..01a24d63
--- /dev/null
+++ b/mtld3d/unix/mtl/src/table.rs
@@ -0,0 +1,120 @@
+//! winemetal's Unix-call table: `winemetal.so` loaded once, its 64-bit `__wine_unix_call_funcs` slots called with
+//! winemetal's own parameter structs (`winemetal_thunks.h`).
+//!
+//! The library is the one beside the image holding this crate (`mtld3d.so` in Wine's `lib/wine/<arch>-unix`), or
+//! `MTLD3D_WINEMETAL` when that names one (tests). Under Wine the libraries it links (`ntdll.so`, `winemac.so` on
+//! macOS) are already loaded; outside Wine a test folder holds stand-ins beside it.
+
+use core::ffi::{CStr, c_char, c_int, c_void};
+use std::sync::OnceLock;
+
+type Slot = unsafe extern "C" fn(*mut c_void) -> i32;
+
+/// The loaded table: process-wide, as the library is (one `dlopen` handle per process, never closed).
+pub struct Table {
+    funcs: *const Slot,
+}
+
+// SAFETY: the table is an immutable array of function pointers in a library that is never unloaded.
+unsafe impl Send for Table {}
+// SAFETY: as above; every slot is callable from any thread (winemetal's own contract).
+unsafe impl Sync for Table {}
+
+static TABLE: OnceLock<Result<Table, String>> = OnceLock::new();
+
+unsafe extern "C" {
+    fn dlopen(path: *const c_char, mode: c_int) -> *mut c_void;
+    fn dlsym(handle: *mut c_void, symbol: *const c_char) -> *mut c_void;
+    fn dlerror() -> *const c_char;
+    fn dladdr(addr: *const c_void, info: *mut DlInfo) -> c_int;
+}
+
+#[repr(C)]
+struct DlInfo {
+    dli_fname: *const c_char,
+    dli_fbase: *mut c_void,
+    dli_sname: *const c_char,
+    dli_saddr: *mut c_void,
+}
+
+#[cfg(target_vendor = "apple")]
+const RTLD_NOW: c_int = 0x2;
+#[cfg(not(target_vendor = "apple"))]
+const RTLD_NOW: c_int = 0x2;
+
+fn last_error() -> String {
+    // SAFETY: dlerror returns null or a NUL-terminated string valid until the next dl call on this thread.
+    let e = unsafe { dlerror() };
+    if e.is_null() { "unknown dlopen error".to_owned() } else { unsafe { CStr::from_ptr(e) }.to_string_lossy().into_owned() }
+}
+
+/// The path of `winemetal.so` to load: `MTLD3D_WINEMETAL`, else the one beside this image.
+fn library_path() -> Result<String, String> {
+    if let Some(path) = std::env::var_os("MTLD3D_WINEMETAL") {
+        return Ok(path.to_string_lossy().into_owned());
+    }
+    let mut info = DlInfo { dli_fname: core::ptr::null(), dli_fbase: core::ptr::null_mut(), dli_sname: core::ptr::null(), dli_saddr: core::ptr::null_mut() };
+    // SAFETY: dladdr only reads the address, a function of this image.
+    if unsafe { dladdr(library_path as *const c_void, &raw mut info) } == 0 || info.dli_fname.is_null() {
+        return Err("dladdr found no image for mtld3d's facade".to_owned());
+    }
+    // SAFETY: dli_fname is a NUL-terminated path owned by the dynamic loader.
+    let image = unsafe { CStr::from_ptr(info.dli_fname) }.to_string_lossy().into_owned();
+    let dir = image.rsplit_once('/').map_or(".", |(dir, _)| dir).to_owned();
+    Ok(format!("{dir}/winemetal.so"))
+}
+
+impl Table {
+    /// The table, loaded at the first call.
+    ///
+    /// # Errors
+    /// The library or its table can't be loaded; the message says why.
+    pub fn get() -> Result<&'static Self, &'static str> {
+        TABLE.get_or_init(Self::load).as_ref().map_err(String::as_str)
+    }
+
+    fn load() -> Result<Self, String> {
+        let path = library_path()?;
+        let c_path = std::ffi::CString::new(path.clone()).map_err(|_| format!("{path}: a NUL in the path"))?;
+        // SAFETY: a plain dlopen of a path; the handle is kept for the process's life.
+        let handle = unsafe { dlopen(c_path.as_ptr(), RTLD_NOW) };
+        if handle.is_null() {
+            return Err(format!("dlopen {path}: {}", last_error()));
+        }
+        // SAFETY: a symbol lookup in the handle just opened.
+        let funcs = unsafe { dlsym(handle, c"__wine_unix_call_funcs".as_ptr()) };
+        if funcs.is_null() {
+            return Err(format!("{path} has no __wine_unix_call_funcs: {}", last_error()));
+        }
+        log::info!(target: "mtld3d::mtl", "winemetal: {path}");
+        Ok(Self { funcs: funcs.cast() })
+    }
+
+    /// The address of slot `slot`'s function, for a test that checks the table against its symbols.
+    #[must_use]
+    pub fn slot_address(&self, slot: u32) -> usize {
+        // SAFETY: callers ask only for slots the facade uses, all inside the table.
+        unsafe { *self.funcs.add(slot as usize) as usize }
+    }
+
+    /// Calls slot `slot` with `params`, winemetal's parameter struct for it; its NTSTATUS.
+    ///
+    /// # Safety
+    /// `params` is that slot's struct, valid for reads and writes, and every pointer and handle in it is valid for the
+    /// call.
+    pub unsafe fn call<P>(&self, slot: u32, params: &mut P) -> i32 {
+        // SAFETY: the caller's contract; the slot index is one the facade uses (inside the table).
+        unsafe { (*self.funcs.add(slot as usize))((params as *mut P).cast()) }
+    }
+}
+
+/// Calls slot `slot` of the loaded table, panicking if winemetal isn't loadable (every facade object comes from it,
+/// so a call without it is a bug in the order of things).
+///
+/// # Safety
+/// As [`Table::call`].
+pub unsafe fn call<P>(slot: u32, params: &mut P) -> i32 {
+    let table = Table::get().unwrap_or_else(|e| panic!("winemetal is not loaded: {e}"));
+    // SAFETY: the caller's contract.
+    unsafe { table.call(slot, params) }
+}
