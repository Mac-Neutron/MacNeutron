From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Sun, 11 Oct 2026 23:09:06 -0400
Subject: [PATCH] d3d12: Report Shader Model 6.8.

With SM6Caps(): the highest shader model is min(request, 6.8) (DXIL SM 6.8 plan, Tasks 1-14c translate its new
operations); OPTIONS21 reports comparison sampling with gradients and bias (0052) and extended command info, the
start vertex and instance locations (0051); OPTIONS11 reports 64-bit atomics on heap-indexed resources (0054 through
the same pointers); OPTIONS22 (65) is answered: no reordering, no byte-offset views, 65535 groups per 1D dispatch.
OPTIONS9's two 64-bit atomic bits are now backed by the lock path (0054, 0055, 0057); Int64ShaderOps stays FALSE
until an i64 audit.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/d3d12/d3d12_device.cpp       | 19 ++++++++++++++++++-
 src/d3d12/d3d12_feature_data.hpp | 11 +++++++++++
 2 files changed, 29 insertions(+), 1 deletion(-)

diff --git a/src/d3d12/d3d12_device.cpp b/src/d3d12/d3d12_device.cpp
index bb4c598..1dc0b80 100644
--- a/src/d3d12/d3d12_device.cpp
+++ b/src/d3d12/d3d12_device.cpp
@@ -648,6 +648,14 @@ public:
   CheckFeatureSupport(D3D12_FEATURE Feature, void *pFeatureData, UINT DataSize) {
     DXMT_STAT_SCOPE("device.CheckFeatureSupport");
     auto metal = GetMTLDevice();
+    if ((UINT)Feature == kFeatureOptions22) { // 65: not a D3D12_FEATURE value llvm-mingw's switch can name
+      if (DataSize != sizeof(D3D12_FEATURE_DATA_D3D12_OPTIONS22_MN))
+        return E_INVALIDARG;
+      auto *out = reinterpret_cast<D3D12_FEATURE_DATA_D3D12_OPTIONS22_MN *>(pFeatureData);
+      *out = {FALSE, FALSE, D3D12_CS_DISPATCH_MAX_THREAD_GROUPS_PER_DIMENSION,
+              D3D12_CS_DISPATCH_MAX_THREAD_GROUPS_PER_DIMENSION};
+      return S_OK;
+    }
     switch (Feature) {
     case D3D12_FEATURE_ARCHITECTURE: {
       if (DataSize != sizeof(D3D12_FEATURE_DATA_ARCHITECTURE))
@@ -757,7 +765,7 @@ public:
         return E_INVALIDARG;
       auto *out = reinterpret_cast<D3D12_FEATURE_DATA_SHADER_MODEL *>(pFeatureData);
       out->HighestShaderModel =
-          SM6Caps() ? std::min(out->HighestShaderModel, D3D_SHADER_MODEL_6_7) : D3D_SHADER_MODEL_5_1;
+          SM6Caps() ? std::min(out->HighestShaderModel, kShaderModel6_8) : D3D_SHADER_MODEL_5_1;
       return S_OK;
     }
     case D3D12_FEATURE_D3D12_OPTIONS: {
@@ -818,6 +826,9 @@ public:
       out->TotalLaneCount = 0;
       // If CheckFeatureSupport succeeds this value will always be true.
       out->ExpandedComputeResourceStates = TRUE;
+      // MacNeutron: FALSE until an i64 audit (the next spec): the 64-bit cbufferLoad is refused (dxil_lower_resources.cpp,
+      // "64-bit cbufferLoad") and the i64 wave overloads (air.simd_*.i64) are untested on Metal. The 64-bit atomics it
+      // would require on raw and structured buffers work (DXMT 0054).
       out->Int64ShaderOps = FALSE;
       return S_OK;
     }
@@ -826,6 +837,7 @@ public:
         return E_INVALIDARG;
       auto *out = reinterpret_cast<D3D12_FEATURE_DATA_D3D12_OPTIONS9 *>(pFeatureData);
       *out = {};
+      // 64-bit atomics: every kind through the translator's lock path (DXMT 0054, 0055, 0057); Metal's ulong atomics are never used.
       out->AtomicInt64OnTypedResourceSupported = SM6Caps();
       out->AtomicInt64OnGroupSharedSupported = SM6Caps();
       return S_OK;
@@ -923,6 +935,9 @@ public:
     }
     case D3D12_FEATURE_D3D12_OPTIONS11: {
       FEATURE_DATA(D3D12_FEATURE_DATA_D3D12_OPTIONS11)
+      // Heap-indexed resources resolve to the same pointers as bound ones (DXMT 0048-0049), so 0054's lock path covers
+      // them (Task 14a's heap-indexed row).
+      out->AtomicInt64OnDescriptorHeapResourceSupported = SM6Caps();
       return S_OK;
     }
     case D3D12_FEATURE_D3D12_OPTIONS13: {
@@ -955,6 +970,8 @@ public:
     case kFeatureOptions21: {
       FEATURE_DATA(D3D12_FEATURE_DATA_D3D12_OPTIONS21_MN)
       out->ExecuteIndirectTier = 10; // D3D12_EXECUTE_INDIRECT_TIER_1_0
+      out->SampleCmpGradientAndBiasSupported = SM6Caps(); // ops 254/255 (DXMT 0052)
+      out->ExtendedCommandInfoSupported = SM6Caps();       // SV_StartVertex/InstanceLocation (DXMT 0051)
       return S_OK;
     }
 #undef FEATURE_DATA
diff --git a/src/d3d12/d3d12_feature_data.hpp b/src/d3d12/d3d12_feature_data.hpp
index 260fcd1..cde7cfc 100644
--- a/src/d3d12/d3d12_feature_data.hpp
+++ b/src/d3d12/d3d12_feature_data.hpp
@@ -24,6 +24,9 @@ namespace dxmt {
 
 constexpr D3D12_FEATURE kFeatureOptions19 = (D3D12_FEATURE)48;
 constexpr D3D12_FEATURE kFeatureOptions21 = (D3D12_FEATURE)53;
+constexpr UINT kFeatureOptions22 = 65;
+// Shader Model 6.8, newer than llvm-mingw's D3D_SHADER_MODEL (DXIL SM 6.8 plan, Task 15).
+constexpr D3D_SHADER_MODEL kShaderModel6_8 = (D3D_SHADER_MODEL)0x68;
 
 struct D3D12_FEATURE_DATA_D3D12_OPTIONS19_MN {
   BOOL MismatchingOutputDimensionsSupported;
@@ -47,4 +50,12 @@ struct D3D12_FEATURE_DATA_D3D12_OPTIONS21_MN {
 };
 static_assert(sizeof(D3D12_FEATURE_DATA_D3D12_OPTIONS21_MN) == 16);
 
+struct D3D12_FEATURE_DATA_D3D12_OPTIONS22_MN {
+  BOOL ShaderExecutionReorderingActuallyReorders;
+  BOOL CreateByteOffsetViewsSupported;
+  UINT Max1DDispatchSize;
+  UINT Max1DDispatchMeshSize;
+};
+static_assert(sizeof(D3D12_FEATURE_DATA_D3D12_OPTIONS22_MN) == 16);
+
 } // namespace dxmt
