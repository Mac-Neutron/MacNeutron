From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Wed, 21 Oct 2026 11:31:13 -0400
Subject: [PATCH] mtld3d: the facade's addresses carry a 32-bit process's
 handles too

The facade's objects are addresses equal to their winemetal handles, but
a VM guest's handles are generation << 32 | index: an i686 build lost
the generation (every handle failed the guest's check, and mtld3d's view
registry panicked on "a 64-bit address"). objc2::addr_of and handle_at
convert at every crossing: the identity on a 64-bit build; on a 32-bit
one the address is the handle's index, unique among live handles, with
the handle in a process-wide table by index. macdrv_wm's view is kept by
its address like every other object. The facade's tests pass on the
i686 winemetal.so in the guest (encode 7, objects 9).

Assisted-by: Claude Code: claude-opus-5-5
---
 mtld3d/unix/mtl/src/metal.rs            |  4 +-
 mtld3d/unix/mtl/src/metal/command.rs    |  4 +-
 mtld3d/unix/mtl/src/objc2.rs            | 64 +++++++++++++++++++++----
 mtld3d/unix/mtl/src/quartz_core.rs      |  2 +-
 mtld3d/unix/unix/src/metal/macdrv_wm.rs | 16 +++++--
 5 files changed, 73 insertions(+), 17 deletions(-)

diff --git a/mtld3d/unix/mtl/src/metal.rs b/mtld3d/unix/mtl/src/metal.rs
index 298c09a0..61654d32 100644
--- a/mtld3d/unix/mtl/src/metal.rs
+++ b/mtld3d/unix/mtl/src/metal.rs
@@ -35,7 +35,7 @@ pub type Deallocator = block2::DynBlock<dyn Fn(NonNull<c_void>, NSUInteger)>;
 
 /// The handle of any facade object reference.
 pub fn handle_of<T: ?Sized>(obj: &T) -> u64 {
-    core::ptr::from_ref(obj).cast::<u8>() as usize as u64
+    objc2::handle_at(core::ptr::from_ref(obj).cast::<u8>() as usize)
 }
 
 /// `handle`, retained, as `Retained<ProtocolObject<P>>`; `None` for 0.
@@ -44,7 +44,7 @@ pub fn retained<P: ?Sized>(handle: u64) -> Option<Retained<ProtocolObject<P>>> {
         return None;
     }
     // SAFETY: a live object the facade knows.
-    unsafe { Retained::retain(handle as usize as *mut ProtocolObject<P>) }
+    unsafe { Retained::retain(objc2::addr_of(handle) as *mut ProtocolObject<P>) }
 }
 
 /// The device an object was made on (its entry), else the default device.
diff --git a/mtld3d/unix/mtl/src/metal/command.rs b/mtld3d/unix/mtl/src/metal/command.rs
index edd75e9a..70d7ee4e 100644
--- a/mtld3d/unix/mtl/src/metal/command.rs
+++ b/mtld3d/unix/mtl/src/metal/command.rs
@@ -800,13 +800,13 @@ fn now() -> f64 {
 /// Gives back the reference `keep_drawable` took for a presented handler.
 fn release_drawable(drawable: u64) {
     // SAFETY: that reference.
-    unsafe { <ProtocolObject<dyn MTLDrawable> as objc2::Message>::release_raw(drawable as usize as *const _) };
+    unsafe { <ProtocolObject<dyn MTLDrawable> as objc2::Message>::release_raw(objc2::addr_of(drawable) as *const _) };
 }
 
 /// A reference on `drawable` for a presented handler, until it has run (release_drawable).
 fn keep_drawable(drawable: u64) {
     // SAFETY: a live drawable.
-    unsafe { <ProtocolObject<dyn MTLDrawable> as objc2::Message>::retain_raw(drawable as usize as *const _) };
+    unsafe { <ProtocolObject<dyn MTLDrawable> as objc2::Message>::retain_raw(objc2::addr_of(drawable) as *const _) };
 }
 
 /// The facade's last reference to `handle` (objc2.rs).
diff --git a/mtld3d/unix/mtl/src/objc2.rs b/mtld3d/unix/mtl/src/objc2.rs
index 9c8413ef..68608432 100644
--- a/mtld3d/unix/mtl/src/objc2.rs
+++ b/mtld3d/unix/mtl/src/objc2.rs
@@ -5,12 +5,60 @@
 //! picked): the type is zero-sized and never read, so code that turns objects into `u64`s and back
 //! works unchanged. `Retained<T>` holds +1 of it; its release goes to winemetal when the facade's
 //! own count of the object's references reaches zero. Descriptors and strings the facade makes are
-//! Rust objects behind the same `Retained` (`Message` says how each is kept).
+//! Rust objects behind the same `Retained` (`Message` says how each is kept). A 32-bit process's
+//! addresses can't hold the guest's handles: [`addr_of`] and [`handle_at`] convert.
 
 use core::{fmt, marker::PhantomData, ops::Deref, ptr::NonNull};
 
 use crate::meta;
 
+/// A winemetal handle as its object's address here.
+///
+/// The handle itself in a 64-bit process. In a 32-bit one (old WoW64's i686 mtld3d.so in the
+/// VM's guest), whose addresses can't hold the guest's handles (`generation << 32 | index`), the
+/// handle's index, unique among live handles, with the handle kept for [`handle_at`].
+#[must_use]
+pub fn addr_of(handle: u64) -> usize {
+    #[cfg(target_pointer_width = "32")]
+    {
+        let index = (handle & 0xffff_ffff) as usize;
+        if let Some(slot) = guest_handles().get(index) {
+            slot.store(handle, core::sync::atomic::Ordering::Release);
+        }
+        index
+    }
+    #[cfg(not(target_pointer_width = "32"))]
+    {
+        handle as usize
+    }
+}
+
+/// The winemetal handle of the object at `addr` (see [`addr_of`]).
+#[must_use]
+pub fn handle_at(addr: usize) -> u64 {
+    #[cfg(target_pointer_width = "32")]
+    {
+        guest_handles().get(addr).map_or(0, |slot| slot.load(core::sync::atomic::Ordering::Acquire))
+    }
+    #[cfg(not(target_pointer_width = "32"))]
+    {
+        addr as u64
+    }
+}
+
+/// Every live handle by its index, in a 32-bit process.
+///
+/// The resource is process-wide: the VM guest's handle table is one per process (winemetal.so's,
+/// `MN_H_MAX` indexes), as the 32-bit address space its objects' addresses come from.
+#[cfg(target_pointer_width = "32")]
+fn guest_handles() -> &'static [core::sync::atomic::AtomicU64] {
+    static HANDLES: std::sync::LazyLock<Box<[core::sync::atomic::AtomicU64]>> = std::sync::LazyLock::new(|| {
+        // SAFETY: zero is a valid AtomicU64 (no handle); the pages stay untouched until used.
+        unsafe { Box::new_zeroed_slice(1 << 20).assume_init() }
+    });
+    &HANDLES
+}
+
 /// How an object is retained and released: winemetal for Metal objects, a Rust count otherwise.
 ///
 /// # Safety
@@ -215,7 +263,7 @@ pub mod runtime {
         /// The object's winemetal handle.
         #[must_use]
         pub fn handle(&self) -> u64 {
-            core::ptr::from_ref(self) as usize as u64
+            super::handle_at(core::ptr::from_ref(self) as usize)
         }
 
         /// The object with handle `handle`, borrowed (no reference taken).
@@ -225,7 +273,7 @@ pub mod runtime {
         #[must_use]
         pub unsafe fn from_handle<'a>(handle: u64) -> &'a Self {
             // SAFETY: a zero-sized type at a non-null address.
-            unsafe { &*(handle as usize as *const Self) }
+            unsafe { &*(super::addr_of(handle) as *const Self) }
         }
     }
 
@@ -233,14 +281,14 @@ pub mod runtime {
     // the last reference.
     unsafe impl<P: ?Sized> Message for ProtocolObject<P> {
         unsafe fn retain_raw(ptr: *const Self) {
-            let handle = ptr as usize as u64;
+            let handle = super::handle_at(ptr as usize);
             meta::retain(handle);
             let mut params = wmt::ObjNoRet { handle };
             // SAFETY: a live object.
             unsafe { table::call(wmt::RETAIN, &mut params) };
         }
         unsafe fn release_raw(ptr: *const Self) {
-            let handle = ptr as usize as u64;
+            let handle = super::handle_at(ptr as usize);
             if let Some(entry) = meta::release(handle) {
                 // The facade's last reference: what it keeps beside the object goes first, while it still lives.
                 crate::metal::forget(handle, &entry);
@@ -273,7 +321,7 @@ pub mod runtime {
         ///
         /// The references this process holds, which is what a retain-discipline test compares.
         fn retainCount(&self) -> usize {
-            meta::refs(core::ptr::from_ref(self).cast::<u8>() as usize as u64)
+            meta::refs(super::handle_at(core::ptr::from_ref(self).cast::<u8>() as usize))
         }
     }
     impl<P: ?Sized> NSObjectProtocol for ProtocolObject<P> {}
@@ -286,7 +334,7 @@ pub fn from_plus_one<P: ?Sized>(handle: u64) -> Option<Retained<runtime::Protoco
     }
     meta::adopt(handle);
     // SAFETY: a +1 handle the slot handed over.
-    unsafe { Retained::from_raw(handle as usize as *mut runtime::ProtocolObject<P>) }
+    unsafe { Retained::from_raw(addr_of(handle) as *mut runtime::ProtocolObject<P>) }
 }
 
 /// An autoreleased (+0) winemetal handle from a slot, retained as a `Retained`; `None` for 0.
@@ -295,5 +343,5 @@ pub fn from_autoreleased<P: ?Sized>(handle: u64) -> Option<Retained<runtime::Pro
         return None;
     }
     // SAFETY: a live object (its pool hasn't drained: we're inside the call that returned it).
-    unsafe { Retained::retain(handle as usize as *mut runtime::ProtocolObject<P>) }
+    unsafe { Retained::retain(addr_of(handle) as *mut runtime::ProtocolObject<P>) }
 }
diff --git a/mtld3d/unix/mtl/src/quartz_core.rs b/mtld3d/unix/mtl/src/quartz_core.rs
index 3f743765..1210df3c 100644
--- a/mtld3d/unix/mtl/src/quartz_core.rs
+++ b/mtld3d/unix/mtl/src/quartz_core.rs
@@ -59,7 +59,7 @@ impl CAMetalLayer {
             return None;
         }
         // SAFETY: a live layer.
-        unsafe { Retained::retain(handle as usize as *mut Self) }
+        unsafe { Retained::retain(crate::objc2::addr_of(handle) as *mut Self) }
     }
 
     fn props(&self) -> wmt::LayerProps {
diff --git a/mtld3d/unix/unix/src/metal/macdrv_wm.rs b/mtld3d/unix/unix/src/metal/macdrv_wm.rs
index bc334959..6bd95782 100644
--- a/mtld3d/unix/unix/src/metal/macdrv_wm.rs
+++ b/mtld3d/unix/unix/src/metal/macdrv_wm.rs
@@ -33,6 +33,13 @@ use attachment::{AttachLatches, Attachment};
 /// The rate a vsync request caps presents at: winemetal reports no panel rate.
 const PANEL_HZ: f64 = 60.0;
 
+/// The winemetal handle of an object mtld3d keeps by its address (a `MetalHandle`).
+///
+/// The facade's `addr_of`: a 32-bit process's addresses can't hold the VM guest's handles.
+fn handle_at(raw: u64) -> u64 {
+    usize::try_from(raw).map_or(0, crate::mtl::objc2::handle_at)
+}
+
 /// The guest's vsync ask plus the user's frame-rate ceiling (as macOS's).
 pub struct PresentPacing {
     pub vsync_requested: bool,
@@ -96,7 +103,7 @@ pub fn attach_metal_layer(
         return None;
     }
     // SAFETY: a live device handle from the PE side.
-    let device = unsafe { ProtocolObject::<dyn MTLDevice>::from_handle(device_handle.raw()) };
+    let device = unsafe { ProtocolObject::<dyn MTLDevice>::from_handle(handle_at(device_handle.raw())) };
     let Some((view, layer)) = create_metal_view(hwnd, device) else {
         log::warn!(target: crate::LOG_TARGET, "present: winemetal made no view for window {hwnd:#x}");
         return None;
@@ -129,14 +136,15 @@ pub fn attach_metal_layer(
         #[cfg(test)]
         client_surface: 0,
     };
-    let att = attachment::register(usize::try_from(view).expect("a 64-bit address"), layer_handle, &latches);
+    let view_addr = crate::mtl::objc2::addr_of(view);
+    let att = attachment::register(view_addr, layer_handle, &latches);
     att.set_min_present_duration(min_present_duration(&pacing));
     log::info!(
         target: crate::LOG_TARGET,
         "present: winemetal view {view:#x} layer {layer_handle:#x} for window {hwnd:#x}, {width}x{height} (sRGB, {PANEL_HZ} Hz assumed)"
     );
     // SAFETY: a view winemetal just made; its layer's +1 rides with it until retire.
-    let view_handle = unsafe { MetalHandle::new(view) };
+    let view_handle = unsafe { MetalHandle::new(view_addr as u64) };
     // SAFETY: the layer winemetal just made, as above.
     let layer_handle = unsafe { MetalHandle::new(layer_handle as u64) };
     Some((view_handle, layer_handle, DisplayCaps { backing_scale: scale, software_cursor_active: false }))
@@ -158,7 +166,7 @@ pub fn retire_metal_view(view_handle: MetalHandle<NSViewKind>, record: Option<&A
         // SAFETY: the +1 attach kept on the layer.
         drop(unsafe { crate::mtl::objc2::rc::Retained::from_raw(att.layer() as *mut CAMetalLayer) });
     }
-    release_metal_view(view_handle.raw());
+    release_metal_view(handle_at(view_handle.raw()));
 }
 
 /// No client surface under the facade.
