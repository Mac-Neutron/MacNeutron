From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Wed, 7 Oct 2026 21:21:23 -0400
Subject: [PATCH] dxgi: Save a window's state before the fullscreen mode
 change.

EnterFullscreenMode changed the display mode and then recorded the
window's rect and styles for LeaveFullscreenMode to restore. A game that
fits its window to the new mode on WM_DISPLAYCHANGE (sent during the
change) then got the fullscreen-sized rect back when leaving, not the
windowed one: under Wine's emulated modes, a small window in a corner
of the screen. Record them first, in both swapchains (D3D11, D3D12).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/d3d11/d3d11_swapchain.cpp    |  4 ++++
 src/d3d12/d3d12_swapchain.cpp    |  4 ++++
 src/util/wsi_window.hpp          | 11 +++++++++++
 src/util/wsi_window_headless.cpp |  3 +++
 src/util/wsi_window_win32.cpp    | 19 ++++++++++---------
 5 files changed, 32 insertions(+), 9 deletions(-)

diff --git a/src/d3d11/d3d11_swapchain.cpp b/src/d3d11/d3d11_swapchain.cpp
index 86cf466..30636a7 100644
--- a/src/d3d11/d3d11_swapchain.cpp
+++ b/src/d3d11/d3d11_swapchain.cpp
@@ -307,6 +307,10 @@ public:
 
     std::unique_lock<dxmt::mutex> lock(mutex_);
 
+    // MacNeutron: before the mode change, which the game may answer by moving or resizing the window
+    // (WM_DISPLAYCHANGE); leaving fullscreen restores what the window had while windowed.
+    wsi::saveWindowState(hWnd, &window_state_);
+
     DXGI_MODE_DESC1 preferred_display_mode = {
         desc_.Width,
         desc_.Height,
diff --git a/src/d3d12/d3d12_swapchain.cpp b/src/d3d12/d3d12_swapchain.cpp
index 7f62f35..4703b3d 100644
--- a/src/d3d12/d3d12_swapchain.cpp
+++ b/src/d3d12/d3d12_swapchain.cpp
@@ -326,6 +326,10 @@ public:
 
     std::unique_lock<dxmt::mutex> lock(mutex_);
 
+    // MacNeutron: before the mode change, which the game may answer by moving or resizing the window
+    // (WM_DISPLAYCHANGE); leaving fullscreen restores what the window had while windowed.
+    wsi::saveWindowState(hWnd, &window_state_);
+
     DXGI_MODE_DESC1 preferred_display_mode = {
         desc_.Width,
         desc_.Height,
diff --git a/src/util/wsi_window.hpp b/src/util/wsi_window.hpp
index 30d9bc8..9ad5df2 100644
--- a/src/util/wsi_window.hpp
+++ b/src/util/wsi_window.hpp
@@ -47,6 +47,17 @@ void resizeWindow(HWND hWindow, DXMTWindowState *pState, uint32_t width,
  */
 bool setWindowMode(HMONITOR hMonitor, HWND hWindow, const WsiMode &mode);
 
+/**
+ * \brief Saves a window's rect and styles, to be restored when it leaves fullscreen
+ *
+ * MacNeutron: called before the display mode changes, as the window may be
+ * moved or resized in response to the mode change (WM_DISPLAYCHANGE).
+ *
+ * \param [in] hWindow The window
+ * \param [out] pState The swapchain's window state
+ */
+void saveWindowState(HWND hWindow, DXMTWindowState *pState);
+
 /**
  * \brief Enter fullscreen mode for a window & monitor
  *
diff --git a/src/util/wsi_window_headless.cpp b/src/util/wsi_window_headless.cpp
index 382e150..035352a 100644
--- a/src/util/wsi_window_headless.cpp
+++ b/src/util/wsi_window_headless.cpp
@@ -32,6 +32,9 @@ bool setWindowMode(HMONITOR hMonitor, HWND hWindow, const WsiMode &mode) {
   return false;
 }
 
+void saveWindowState(HWND hWindow, DXMTWindowState *pState) {
+}
+
 bool enterFullscreenMode(HMONITOR hMonitor, HWND hWindow,
                          DXMTWindowState *pState,
                          [[maybe_unused]] bool modeSwitch) {
diff --git a/src/util/wsi_window_win32.cpp b/src/util/wsi_window_win32.cpp
index 295a99b..37621b8 100644
--- a/src/util/wsi_window_win32.cpp
+++ b/src/util/wsi_window_win32.cpp
@@ -124,6 +124,12 @@ bool setWindowMode(HMONITOR hMonitor, HWND hWindow, const WsiMode &mode) {
   return setMonitorDisplayMode(hMonitor, &devMode);
 }
 
+void saveWindowState(HWND hWindow, DXMTWindowState *pState) {
+  ::GetWindowRect(hWindow, &pState->rect);
+  pState->style = ::GetWindowLongW(hWindow, GWL_STYLE);
+  pState->exstyle = ::GetWindowLongW(hWindow, GWL_EXSTYLE);
+}
+
 bool enterFullscreenMode(HMONITOR hMonitor, HWND hWindow,
                          DXMTWindowState *pState,
                          [[maybe_unused]] bool modeSwitch) {
@@ -137,15 +143,10 @@ bool enterFullscreenMode(HMONITOR hMonitor, HWND hWindow,
   escape.hContext = HandleToUlong(hWindow);
   D3DKMTEscape(&escape);
 
-  // Find a display mode that matches what we need
-  ::GetWindowRect(hWindow, &pState->rect);
-
-  // Change the window flags to remove the decoration etc.
-  LONG style = ::GetWindowLongW(hWindow, GWL_STYLE);
-  LONG exstyle = ::GetWindowLongW(hWindow, GWL_EXSTYLE);
-
-  pState->style = style;
-  pState->exstyle = exstyle;
+  // Change the window flags to remove the decoration etc. (saveWindowState
+  // recorded the windowed ones before the mode change)
+  LONG style = pState->style;
+  LONG exstyle = pState->exstyle;
 
   style &= ~WS_OVERLAPPEDWINDOW;
   exstyle &= ~WS_EX_OVERLAPPEDWINDOW;
-- 
