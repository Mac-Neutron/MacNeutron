From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Sun, 11 Oct 2026 17:06:59 -0400
Subject: [PATCH] airconv: Lower SampleCmpBias and SampleCmpGrad.

SampleCmpGrad (254) and SampleCmpBias (255), Shader Model 6.8's comparison
samples, were refused. SampleCmpBias is SampleCmp with SampleBias's bias
(the shader's plus the sampler's LOD bias) and min-LOD clamp; in a compute
shader it takes the quad's coarse gradients scaled by 2^bias, as SampleBias
does there. SampleCmpGrad is the comparison-gradient sample with its
gradients scaled by 2^(sampler's LOD bias) and the clamp, as SampleGrad;
cubes take no offset. Both mark their texture sampled and compared, so it
binds as a depth texture, and a compute shader calling SampleCmpBias gets
the SIMD lane inputs as the other implicit-LOD samples do. CalculateLOD
with a comparison sampler needed nothing new.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/airconv/dxil/dxil_initialize.cpp      |  3 ++-
 src/airconv/dxil/dxil_lower.cpp           |  3 ++-
 src/airconv/dxil/dxil_lower_resources.cpp | 32 +++++++++++++++++------
 src/airconv/dxil/dxil_signature.cpp       |  4 +--
 4 files changed, 30 insertions(+), 12 deletions(-)

diff --git a/src/airconv/dxil/dxil_initialize.cpp b/src/airconv/dxil/dxil_initialize.cpp
index b6e2e87..b3cee5f 100644
--- a/src/airconv/dxil/dxil_initialize.cpp
+++ b/src/airconv/dxil/dxil_initialize.cpp
@@ -147,7 +147,8 @@ ScanUsage(const EntryInfo &entry, const llvm::Module &module) {
         case op::CalculateLOD:
           u.sampled = true;
           break;
-        case op::SampleCmp: case op::SampleCmpLevelZero: case op::TextureGatherCmp:
+        case op::SampleCmp: case op::SampleCmpLevelZero: case op::TextureGatherCmp: case op::SampleCmpGrad:
+        case op::SampleCmpBias:
           u.sampled = u.compared = true;
           break;
         case op::TextureLoad: case op::BufferLoad: case op::RawBufferLoad: case op::CBufferLoad: case op::CBufferLoadLegacy:
diff --git a/src/airconv/dxil/dxil_lower.cpp b/src/airconv/dxil/dxil_lower.cpp
index 4d12a3c..0c35e7b 100644
--- a/src/airconv/dxil/dxil_lower.cpp
+++ b/src/airconv/dxil/dxil_lower.cpp
@@ -171,7 +171,8 @@ Lowering::Lower(llvm::CallInst *call) {
   if (opcode == op::RenderTargetGetSamplePosition || opcode == op::RenderTargetGetSampleCount)
     return LowerOther(opcode, call); // inside the resource range, but they take no handle
   if ((opcode >= op::CBufferLoad && opcode <= op::AtomicCompareExchange) || opcode == op::CalculateLOD ||
-      opcode == op::RawBufferLoad || opcode == op::RawBufferStore)
+      opcode == op::RawBufferLoad || opcode == op::RawBufferStore || opcode == op::SampleCmpGrad ||
+      opcode == op::SampleCmpBias)
     return LowerResource(opcode, call);
   return LowerOther(opcode, call);
 }
diff --git a/src/airconv/dxil/dxil_lower_resources.cpp b/src/airconv/dxil/dxil_lower_resources.cpp
index 1d91fb0..22fafde 100644
--- a/src/airconv/dxil/dxil_lower_resources.cpp
+++ b/src/airconv/dxil/dxil_lower_resources.cpp
@@ -394,8 +394,17 @@ Lowering::LowerTexture(uint32_t opcode, llvm::CallInst *call, const HandleInfo &
     auto ddx = ir.CreateFMul(grad.first, scale);
     return std::make_pair(ddx, ir.CreateFMul(grad.second, scale));
   };
-  // A compute shader has no implicit derivatives (spec 3.3): Sample, SampleBias and SampleCmp take the quad's coarse
-  // gradients of their coordinates through the gradient path (`reference`: SampleCmp's).
+  // SampleGrad's and SampleCmpGrad's ddx0..2 from argument `first`, ddy0..2 after them (a 1D texture's y is 0).
+  auto gradients = [&](unsigned first) {
+    llvm::Value *ddx = llvm::UndefValue::get(coord->getType()), *ddy = ddx;
+    for (unsigned i = 0; i < dims; i++) {
+      ddx = ir.CreateInsertElement(ddx, one_d && i == 1 ? llvm::ConstantFP::get(ir.getFloatTy(), 0) : arg(first + i), i);
+      ddy = ir.CreateInsertElement(ddy, one_d && i == 1 ? llvm::ConstantFP::get(ir.getFloatTy(), 0) : arg(first + 3 + i), i);
+    }
+    return scaled({ddx, ddy}, bias);
+  };
+  // A compute shader has no implicit derivatives (spec 3.3): Sample, SampleBias, SampleCmp and SampleCmpBias take the
+  // quad's coarse gradients of their coordinates through the gradient path (`reference`: the comparisons').
   bool compute = entry.kind == ShaderKind::Compute;
   auto coarse = [&](llvm::Value *lod_bias, llvm::Value *shader_clamp, llvm::Value *reference) {
     auto [ddx, ddy] = scaled(CoarseGradients(coord), lod_bias);
@@ -421,19 +430,24 @@ Lowering::LowerTexture(uint32_t opcode, llvm::CallInst *call, const HandleInfo &
     return result(air.CreateSample(tex, d->ResourceHandle, sampler, coord, array, o(),
                                    llvm::air::sample_level{ir.CreateFAdd(arg(10), bias)}).first);
   case op::SampleGrad: { // (63, ..., ddx0..2, ddy0..2, clamp)
-    llvm::Value *ddx = llvm::UndefValue::get(coord->getType()), *ddy = ddx;
-    for (unsigned i = 0; i < dims; i++) {
-      ddx = ir.CreateInsertElement(ddx, one_d && i == 1 ? llvm::ConstantFP::get(ir.getFloatTy(), 0) : arg(10 + i), i);
-      ddy = ir.CreateInsertElement(ddy, one_d && i == 1 ? llvm::ConstantFP::get(ir.getFloatTy(), 0) : arg(13 + i), i);
-    }
-    std::tie(ddx, ddy) = scaled({ddx, ddy}, bias);
+    auto [ddx, ddy] = gradients(10);
     return result(air.CreateSampleGrad(tex, d->ResourceHandle, sampler, coord, array, ddx, ddy, min_lod(arg(16)).lod, o()).first);
   }
+  case op::SampleCmpGrad: { // (254, ..., compare, ddx0..2, ddy0..2, clamp); cubes take no offset (CreateSampleCmpGrad)
+    auto [ddx, ddy] = gradients(11);
+    return result(air.CreateSampleCmpGrad(tex, d->ResourceHandle, sampler, coord, array, arg(10), ddx, ddy,
+                                          min_lod(arg(17)).lod, o()).first);
+  }
   case op::SampleCmp: // (64, ..., compare, clamp)
     if (compute)
       return coarse(bias, arg(11), arg(10));
     return result(air.CreateSampleCmp(tex, d->ResourceHandle, sampler, coord, array, arg(10), o(),
                                       llvm::air::sample_bias{bias}, min_lod(arg(11))).first);
+  case op::SampleCmpBias: // (255, ..., compare, bias, clamp)
+    if (compute)
+      return coarse(ir.CreateFAdd(arg(11), bias), arg(12), arg(10));
+    return result(air.CreateSampleCmp(tex, d->ResourceHandle, sampler, coord, array, arg(10), o(),
+                                      llvm::air::sample_bias{ir.CreateFAdd(arg(11), bias)}, min_lod(arg(12))).first);
   case op::SampleCmpLevelZero: // (65, ..., compare)
     return result(air.CreateSampleCmp(tex, d->ResourceHandle, sampler, coord, array, arg(10), o(),
                                       llvm::air::sample_level{llvm::ConstantFP::get(ir.getFloatTy(), 0)}).first);
@@ -646,6 +660,8 @@ Lowering::LowerResource(uint32_t opcode, llvm::CallInst *call) {
   case op::TextureGather:
   case op::TextureGatherCmp:
   case op::CalculateLOD:
+  case op::SampleCmpGrad:
+  case op::SampleCmpBias:
     return LowerTexture(opcode, call, h);
   case op::Texture2DMSGetSamplePosition: { // (75, srv, i32 index) -> {f32, f32}: D3D's standard positions (air_samplepos)
     llvm::Value *count = ir.getInt32(0); // no texture: (0, 0), as the DXBC samplepos lowering
diff --git a/src/airconv/dxil/dxil_signature.cpp b/src/airconv/dxil/dxil_signature.cpp
index 0e77e7c..3f8ea8c 100644
--- a/src/airconv/dxil/dxil_signature.cpp
+++ b/src/airconv/dxil/dxil_signature.cpp
@@ -445,8 +445,8 @@ AddWaveInputs(const llvm::Module &module, SM50ShaderInternal *shader, uint32_t &
              op::WaveActiveBit, op::WavePrefixOp, op::WaveAllBitCount, op::WavePrefixBitCount, op::WaveMatch,
              op::WaveMultiPrefixOp, op::WaveMultiPrefixBitCount}) ||
       (shader->shader_type == microsoft::D3D11_SB_COMPUTE_SHADER &&
-       calls({op::Sample, op::SampleBias, op::SampleCmp, op::CalculateLOD, op::DerivCoarseX, op::DerivCoarseY,
-              op::DerivFineX, op::DerivFineY}))) {
+       calls({op::Sample, op::SampleBias, op::SampleCmp, op::SampleCmpBias, op::CalculateLOD, op::DerivCoarseX,
+              op::DerivCoarseY, op::DerivFineX, op::DerivFineY}))) {
     lane_index_arg = shader->func_signature.DefineInput(air::InputThreadIndexInSimdgroup{});
     lane_count_arg = shader->func_signature.DefineInput(air::InputThreadsPerSimdgroup{});
   }
-- 
