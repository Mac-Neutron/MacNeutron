From 57f838cfdc0f83b25505ff32c1c2dce79d11d32d Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Sun, 18 Oct 2026 14:15:30 -0400
Subject: [PATCH] d3d11: UNIMPLEMENTED throws in the native build.

Natively, a path DXMT's D3D11 has no code for throws std::logic_error
after logging, instead of aborting, as d3d12's IMPLEMENT_ME: a VM
host's stubs catch it and fail the call, so a game that reaches one
doesn't take the VM down. The Windows build still aborts.

Assisted-by: Claude Code: claude-opus-5-5
---
 src/d3d11/d3d11_private.h | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/src/d3d11/d3d11_private.h b/src/d3d11/d3d11_private.h
index 96fb723..7078102 100644
--- a/src/d3d11/d3d11_private.h
+++ b/src/d3d11/d3d11_private.h
@@ -11,9 +11,17 @@ extern "C" void _massert (const char *_Message, const char *_File, unsigned _Lin
   (_massert(#_Expression,__FILE__,__LINE__),0))
 #endif
 
+#ifdef _WIN32
+#define UNIMPLEMENTED_END abort();
+#else
+// MacNeutron, the native build: a VM host's stubs catch it and fail the call, rather than lose the VM.
+#include <stdexcept>
+#define UNIMPLEMENTED_END throw std::logic_error("not implemented");
+#endif
+
 #define UNIMPLEMENTED(text)                                                                                            \
   Logger::err(str::format(__FILE__, ":", __FUNCTION__, ": ", #text, "."));                                             \
-  abort();                                                                                                             \
+  UNIMPLEMENTED_END                                                                                                    \
   __builtin_unreachable();
 
 #define UNREACHABLE                                                                                                    \
