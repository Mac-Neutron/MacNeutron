From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ugl <stepan_ber@list.ru>
Date: Thu, 22 Oct 2026 09:48:09 +0300
Subject: [PATCH] fix(airconv): handle OUTPUT_CONTROL_POINT_ID relative
 indexing

Hull shaders may index the input patch with the control point they are running
for, i.e. an operand whose index is D3D11_SB_OPERAND_TYPE_OUTPUT_CONTROL_POINT_ID
(22). readOperandRelativeIndex() did not know that register type: the switch fell
into the default branch, DXASSERT_DXBC() expanded to a no-op in release builds,
and the function then left without a return statement, so an uninitialised
OperandIndex was returned. The result is an out-of-bounds access in
Converter::LoadOperand() as soon as a tessellation pipeline is compiled:

    EXC_BAD_ACCESS (SIGSEGV)  SM50CompileTessellationPipelineHull
      dxmt::dxbc::Converter::LoadOperand(...)

Add IndexByControlPointId to OperandIndex, map it to res.thread_id_in_patch in
Converter::LoadOperandIndex(), and give the default branch an explicit return so
a missing register type cannot produce an uninitialised value again.

Reproducer: any D3D11 application drawing a hull shader that uses
[outputcontrolpointid] as a relative index (S.T.A.L.K.E.R.: Call of Pripyat with
its R4 renderer does, for hair/gasmask materials) crashes the shader compiler
before the first frame; with the change the pipeline compiles and the tessellated
geometry renders correctly.

Signed-off-by: Stepan Berezhnoy <stepan@skyfort.digital>
Signed-off-by: Feifan He <feifan@codeweavers.com>
(cherry picked from commit ce001dfbedd7116aa9beb2e816c6ba44e599c15d)
---
 src/airconv/dxbc_instructions.cpp      | 8 ++++++++
 src/airconv/dxbc_instructions.hpp      | 8 ++++++--
 src/airconv/nt/dxbc_converter_base.cpp | 5 +++++
 src/airconv/nt/dxbc_converter_base.hpp | 1 +
 4 files changed, 20 insertions(+), 2 deletions(-)

diff --git a/src/airconv/dxbc_instructions.cpp b/src/airconv/dxbc_instructions.cpp
index e2b7f86b..4cf7cf98 100644
--- a/src/airconv/dxbc_instructions.cpp
+++ b/src/airconv/dxbc_instructions.cpp
@@ -38,6 +38,13 @@ auto readOperandRelativeIndex(
     };
   }
 
+  case D3D11_SB_OPERAND_TYPE_OUTPUT_CONTROL_POINT_ID: {
+    // Hull shaders index the input patch with the control point they run for.
+    return IndexByControlPointId{
+      .offset = offset,
+    };
+  }
+
   case D3D10_SB_OPERAND_TYPE_INDEXABLE_TEMP: {
     return IndexByIndexableTempComponent{
       .regfile = OpIndex.m_RelIndex,
@@ -50,6 +57,7 @@ auto readOperandRelativeIndex(
 
   default:
     DXASSERT_DXBC(false);
+    return 0u;
   };
 };
 
diff --git a/src/airconv/dxbc_instructions.hpp b/src/airconv/dxbc_instructions.hpp
index f55c4c1e..607e69a6 100644
--- a/src/airconv/dxbc_instructions.hpp
+++ b/src/airconv/dxbc_instructions.hpp
@@ -80,6 +80,10 @@ struct IndexByTempComponent {
   uint32_t offset;
 };
 
+struct IndexByControlPointId {
+  uint32_t offset;
+};
+
 struct IndexByIndexableTempComponent {
   uint32_t regfile;
   uint32_t regid;
@@ -88,8 +92,8 @@ struct IndexByIndexableTempComponent {
   uint32_t offset;
 };
 
-using OperandIndex =
-  std::variant<uint32_t, IndexByIndexableTempComponent, IndexByTempComponent>;
+using OperandIndex = std::variant<uint32_t, IndexByIndexableTempComponent,
+                                  IndexByTempComponent, IndexByControlPointId>;
 #pragma endregion
 
 enum class OperandDataType {
diff --git a/src/airconv/nt/dxbc_converter_base.cpp b/src/airconv/nt/dxbc_converter_base.cpp
index f4bb770e..6fa8bc16 100644
--- a/src/airconv/nt/dxbc_converter_base.cpp
+++ b/src/airconv/nt/dxbc_converter_base.cpp
@@ -47,6 +47,11 @@ Converter::LoadOperandIndex(const IndexByTempComponent &SrcOpIndex) {
   return ir.CreateAdd(Rel, ir.getInt32(SrcOpIndex.offset));
 }
 
+llvm::Value *
+Converter::LoadOperandIndex(const IndexByControlPointId &SrcOpIndex) {
+  return ir.CreateAdd(res.thread_id_in_patch, ir.getInt32(SrcOpIndex.offset));
+}
+
 llvm::Value *
 Converter::LoadOperandIndex(const IndexByIndexableTempComponent &SrcOpIndex) {
   auto Comp = SrcOpIndex.component;
diff --git a/src/airconv/nt/dxbc_converter_base.hpp b/src/airconv/nt/dxbc_converter_base.hpp
index 945e1d74..644f2966 100644
--- a/src/airconv/nt/dxbc_converter_base.hpp
+++ b/src/airconv/nt/dxbc_converter_base.hpp
@@ -113,6 +113,7 @@ public:
     return ir.getInt32(SrcOpIndex);
   }
   llvm::Value *LoadOperandIndex(const IndexByIndexableTempComponent &SrcOpIndex);
+  llvm::Value *LoadOperandIndex(const IndexByControlPointId &SrcOpIndex);
   llvm::Value *LoadOperandIndex(const IndexByTempComponent &SrcOpIndex);
 
   llvm::Value *
