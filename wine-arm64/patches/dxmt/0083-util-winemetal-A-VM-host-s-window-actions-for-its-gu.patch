From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Sun, 18 Oct 2026 08:20:41 -0400
Subject: [PATCH] util, winemetal: A VM host's window actions, for its guest to
 make.

With a VM host's window system hooks set, the native build's window
actions (saving a window's state, a display mode change, entering and
leaving fullscreen, resizing, minimising) go to a fourth hook, with their
arguments, for the guest to make with its own window system; natively they
still succeed and do nothing. isProcessForeground answers the guest's.

Assisted-by: Claude Code: claude-opus-5-5
---
 src/util/wsi_window_headless.cpp | 31 ++++++++++++++++++++++++-------
 src/winemetal/winemetal.h        | 24 ++++++++++++++++++++++--
 2 files changed, 46 insertions(+), 9 deletions(-)

diff --git a/src/util/wsi_window_headless.cpp b/src/util/wsi_window_headless.cpp
index 44e0121..88a54ce 100644
--- a/src/util/wsi_window_headless.cpp
+++ b/src/util/wsi_window_headless.cpp
@@ -18,9 +18,20 @@
 namespace dxmt::wsi {
 
 // MacNeutron: a VM host's window system (WMTSetWsiHooks), from what its guest last said; else headless. The window's
-// own changes are the guest's, so the actions only succeed.
+// own changes are the guest's: each action goes to the hooks for the guest to make, and succeeds here.
 static bool hooked() { return WMTGetWsiHooks() != nullptr; }
 
+static bool act(uint32_t kind, HWND hWindow, HMONITOR hMonitor = nullptr, uint32_t arg = 0,
+                const WsiMode &mode = {}) {
+  const WMTWsiHooks *hooks = WMTGetWsiHooks();
+  if (!hooks)
+    return false;
+  WMTWsiAction a = {kind, arg, (uint64_t)(uintptr_t)hWindow, (uint64_t)(uintptr_t)hMonitor, mode.width, mode.height,
+                    mode.refreshRate.numerator, mode.refreshRate.denominator, mode.bitsPerPixel, mode.interlaced};
+  hooks->action(&a);
+  return true;
+}
+
 static bool hookedWindow(HWND hWindow, WMTWsiWindow *pWindow) {
   const WMTWsiHooks *hooks = WMTGetWsiHooks();
   return hooks && hooks->window((uint64_t)(uintptr_t)hWindow, pWindow);
@@ -38,28 +49,30 @@ void getWindowSize(HWND hWindow, uint32_t *pWidth, uint32_t *pHeight) {
 
 void resizeWindow(HWND hWindow, DXMTWindowState *pState, uint32_t width,
                   uint32_t height) {
+  act(WMTWsiResizeWindow, hWindow, nullptr, 0, WsiMode{width, height, {0, 0}, 0, false});
 }
 
 bool setWindowMode(HMONITOR hMonitor, HWND hWindow, const WsiMode &mode) {
-  return hooked();
+  return act(WMTWsiSetWindowMode, hWindow, hMonitor, 0, mode);
 }
 
 void saveWindowState(HWND hWindow, DXMTWindowState *pState) {
+  act(WMTWsiSaveWindowState, hWindow);
 }
 
 bool enterFullscreenMode(HMONITOR hMonitor, HWND hWindow,
                          DXMTWindowState *pState,
                          [[maybe_unused]] bool modeSwitch) {
-  return hooked();
+  return act(WMTWsiEnterFullscreenMode, hWindow, hMonitor, modeSwitch);
 }
 
 bool leaveFullscreenMode(HWND hWindow, DXMTWindowState *pState,
                          bool restoreCoordinates) {
-  return hooked();
+  return act(WMTWsiLeaveFullscreenMode, hWindow, nullptr, restoreCoordinates);
 }
 
 bool restoreDisplayMode(HMONITOR hMonitor) {
-  return hooked();
+  return act(WMTWsiRestoreDisplayMode, nullptr, hMonitor);
 }
 
 HMONITOR getWindowMonitor(HWND hWindow) {
@@ -74,6 +87,7 @@ bool isWindow(HWND hWindow) {
 
 void updateFullscreenWindow(HMONITOR hMonitor, HWND hWindow,
                             bool forceTopmost) {
+  act(WMTWsiUpdateFullscreenWindow, hWindow, hMonitor, forceTopmost);
 }
 
 bool isForeground(HWND hWindow) {
@@ -86,8 +100,11 @@ bool isMinimized(HWND hWindow) {
   return hookedWindow(hWindow, &w) && (w.flags & 1) != 0;
 }
 
-bool isProcessForeground() { return true; }
+bool isProcessForeground() {
+  WMTWsiWindow w = {};
+  return hookedWindow(nullptr, &w) ? (w.flags & 8) != 0 : true;
+}
 
-void minimizeWindow(HWND hWindow) {}
+void minimizeWindow(HWND hWindow) { act(WMTWsiMinimizeWindow, hWindow); }
 
 } // namespace dxmt::wsi
diff --git a/src/winemetal/winemetal.h b/src/winemetal/winemetal.h
index 5f59b23..e4169fb 100644
--- a/src/winemetal/winemetal.h
+++ b/src/winemetal/winemetal.h
@@ -2267,15 +2267,35 @@ WINEMETAL_API void WMTSetPresentHook(void (*hook)(void *cmdbuf, void *drawable))
 WINEMETAL_API int WMTMemoryHooked(void);
 /* MacNeutron, the native build: the window system a VM host answers for its guest (Direct3D forwarding), from what the
  * guest last told it; set before any device. Unset, the native build's window system is headless. window: a window's
- * state (flags: 1 minimised, 2 foreground, 4 a window), 1, or 0 for one it doesn't know; display: the index-th display,
- * 1, or 0 past the last; mode: a display's index-th mode, 0 the current one, 1, or 0 past the last. */
+ * state (flags: 1 minimised, 2 foreground, 4 a window, 8 its process in front; hwnd 0: any of the caller's), 1, or 0
+ * for one it doesn't know; display: the index-th display, 1, or 0 past the last; mode: a display's index-th mode, 0 the
+ * current one, 1, or 0 past the last; action: a change to a window or a display's mode that DXMT makes, for the guest
+ * to make (it does nothing natively): WMTWsiAction's kind is the wsi function's, its other members that function's
+ * arguments (arg: enterFullscreenMode's modeSwitch, leaveFullscreenMode's restoreCoordinates,
+ * updateFullscreenWindow's forceTopmost; the mode: setWindowMode's, or resizeWindow's width and height). */
 struct WMTWsiWindow { uint64_t monitor; uint32_t width, height, flags; };
 struct WMTWsiDisplay { uint64_t monitor; int32_t left, top, right, bottom; uint16_t name[32]; };
 struct WMTWsiMode { uint32_t width, height, refresh_num, refresh_den; };
+enum {
+  WMTWsiSaveWindowState = 1,
+  WMTWsiSetWindowMode,
+  WMTWsiEnterFullscreenMode,
+  WMTWsiLeaveFullscreenMode,
+  WMTWsiRestoreDisplayMode,
+  WMTWsiResizeWindow,
+  WMTWsiUpdateFullscreenWindow,
+  WMTWsiMinimizeWindow,
+};
+struct WMTWsiAction {
+  uint32_t kind, arg;
+  uint64_t hwnd, monitor;
+  uint32_t width, height, refresh_num, refresh_den, bits_per_pixel, interlaced;
+};
 struct WMTWsiHooks {
   int (*window)(uint64_t hwnd, struct WMTWsiWindow *out);
   int (*display)(uint32_t index, struct WMTWsiDisplay *out);
   int (*mode)(uint64_t monitor, uint32_t index, struct WMTWsiMode *out);
+  void (*action)(const struct WMTWsiAction *action);
 };
 WINEMETAL_API void WMTSetWsiHooks(const struct WMTWsiHooks *hooks);
 WINEMETAL_API const struct WMTWsiHooks *WMTGetWsiHooks(void); /* NULL: none */
-- 
