diff --git a/src/airconv/dxil/dxil_converter.cpp b/src/airconv/dxil/dxil_converter.cpp
index 1a59519..b89726e 100644
--- a/src/airconv/dxil/dxil_converter.cpp
+++ b/src/airconv/dxil/dxil_converter.cpp
@@ -297,6 +297,28 @@ llvm::Error Finish(llvm::Module &module, llvm::Function *dxil_main) {
   return llvm::Error::success();
 }
 
+// A shader that indexes a descriptor heap needs its root signature to say so (spec 3.4: only then do the heap bases
+// follow its parameters in the root arguments). The view heap's flag is checked first.
+llvm::Error CheckHeapFlags(const EntryInfo &entry, SM50_SHADER_COMPILATION_ARGUMENT_DATA *pArgs) {
+  bool views = false, samplers = false;
+  for (auto &r : entry.resources)
+    if (r.heap)
+      (r.cls == ResourceClass::Sampler ? samplers : views) = true;
+  if (!views && !samplers)
+    return llvm::Error::success();
+  SM50_SHADER_ROOT_SIGNATURE_DATA *rootsig = nullptr;
+  if (!args_get_data<SM50_SHADER_ROOT_SIGNATURE, SM50_SHADER_ROOT_SIGNATURE_DATA>(pArgs, &rootsig))
+    return llvm::make_error<UnsupportedFeature>("DXIL: ResourceDescriptorHeap needs a root signature");
+  uint32_t flags = RootSignatureFlags(rootsig->bytecode, rootsig->bytecode_length);
+  if (views && !(flags & 0x400))
+    return llvm::make_error<UnsupportedFeature>(
+        "DXIL: ResourceDescriptorHeap needs root signature flag CBV_SRV_UAV_HEAP_DIRECTLY_INDEXED (0x400)");
+  if (samplers && !(flags & 0x800))
+    return llvm::make_error<UnsupportedFeature>(
+        "DXIL: SamplerDescriptorHeap needs root signature flag SAMPLER_HEAP_DIRECTLY_INDEXED (0x800)");
+  return llvm::Error::success();
+}
+
 } // namespace
 
 void
@@ -320,6 +342,8 @@ ConvertDXIL(SM50ShaderInternal *shader, const char *name, llvm::LLVMContext &con
   auto &entry = dxil.entry;
   if (entry.kind == ShaderKind::Geometry)
     return llvm::make_error<UnsupportedFeature>("DXIL: a geometry shader compiles only with its vertex shader");
+  if (auto err = CheckHeapFlags(entry, pArgs))
+    return std::move(err);
   auto loaded = Load(dxil, context);
   if (!loaded)
     return loaded.takeError();
@@ -462,6 +486,8 @@ ConvertDXILGeometryPipeline(bool object, SM50ShaderInternal *vs, SM50ShaderInter
   if (!vs->dxil || !gs->dxil || vs->dxil->entry.kind != ShaderKind::Vertex || gs->dxil->entry.kind != ShaderKind::Geometry)
     return llvm::make_error<UnsupportedFeature>("DXIL: a geometry pipeline needs a DXIL vertex and geometry shader");
   auto stage = object ? vs : gs;
+  if (auto err = CheckHeapFlags(stage->dxil->entry, pArgs))
+    return std::move(err);
   auto loaded = Load(*stage->dxil, context);
   if (!loaded)
     return loaded.takeError();
diff --git a/src/airconv/dxil/dxil_initialize.cpp b/src/airconv/dxil/dxil_initialize.cpp
index a8c3168..b6e2e87 100644
--- a/src/airconv/dxil/dxil_initialize.cpp
+++ b/src/airconv/dxil/dxil_initialize.cpp
@@ -55,6 +55,72 @@ ScalerDataType ToScalerType(ComponentType type) {
   }
 }
 
+// The resource annotateHandle's ResourceProperties {p0, p1} describe (DxilResourceProperties.h): p0 bits 0-7 kind,
+// 12 UAV, 13 ROV, 14 globally coherent, 15 comparison sampler or UAV counter; p1 the component type of textures and
+// typed buffers (bits 0-7), a structured buffer's stride or a constant buffer's size. As a heap range (spec 3.4).
+Resource HeapResource(uint32_t p0, uint32_t p1) {
+  Resource r;
+  r.kind = ResourceKind(p0 & 0xff);
+  bool uav = p0 & (1u << 12), bit15 = p0 & (1u << 15);
+  r.cls = r.kind == ResourceKind::CBuffer   ? ResourceClass::CBuffer
+          : r.kind == ResourceKind::Sampler ? ResourceClass::Sampler
+          : uav                             ? ResourceClass::UAV
+                                            : ResourceClass::SRV;
+  r.space = kHeapSpace, r.lower_bound = 0, r.size = ~0u;
+  r.rasterizer_ordered = p0 & (1u << 13);
+  r.globally_coherent = p0 & (1u << 14);
+  r.comparison_sampler = r.cls == ResourceClass::Sampler && bit15;
+  r.has_counter = r.cls == ResourceClass::UAV && bit15;
+  switch (r.kind) {
+  case ResourceKind::StructuredBuffer: r.stride = p1; break;
+  case ResourceKind::CBuffer: r.cbuffer_size = p1; break;
+  case ResourceKind::RawBuffer: case ResourceKind::Sampler: break;
+  default: r.element_type = ComponentType(p1 & 0xff); break;
+  }
+  r.heap = true, r.heap_props[0] = p0, r.heap_props[1] = p1;
+  return r;
+}
+
+// Dynamic resources (spec 3.4): a heap range for each distinct ResourceProperties that annotateHandle gives a
+// createHandleFromHeap handle (ResolveHandle finds it by them), with range IDs from kHeapRangeBase.
+void AddHeapRanges(const llvm::Module &module, EntryInfo &entry) {
+  auto annotate = module.getFunction("dx.op.annotateHandle");
+  if (!annotate)
+    return;
+  uint32_t next = kHeapRangeBase;
+  for (auto *user : annotate->users()) {
+    auto call = llvm::dyn_cast<llvm::CallInst>(user);
+    uint32_t props[2];
+    if (!call || !HeapHandle(*call, props) ||
+        std::any_of(entry.resources.begin(), entry.resources.end(), [&](const Resource &r) {
+          return r.heap && r.heap_props[0] == props[0] && r.heap_props[1] == props[1];
+        }))
+      continue;
+    auto r = HeapResource(props[0], props[1]);
+    r.id = next++;
+    entry.resources.push_back(r);
+  }
+}
+
+// A 64-bit groupshared atomic: an atomicrmw or cmpxchg of i64 on addrspace(3), which no dx.op carries. Metal has no
+// threadgroup ulong atomics, and its compiler service crashes on these (the i64 spike: XPC_ERROR_CONNECTION_INTERRUPTED
+// after retries, the op unnamed), so they're refused by name until the plan's Task 14c lock path.
+llvm::Error RefuseGroupshared64BitAtomics(const llvm::Module &module) {
+  for (auto &fn : module)
+    for (auto &bb : fn)
+      for (auto &inst : bb) {
+        auto rmw = llvm::dyn_cast<llvm::AtomicRMWInst>(&inst);
+        if (rmw && rmw->getPointerAddressSpace() == 3 && rmw->getValOperand()->getType()->isIntegerTy(64))
+          return llvm::make_error<UnsupportedFeature>("DXIL: 64-bit groupshared atomic (atomicrmw " +
+                                                      llvm::AtomicRMWInst::getOperationName(rmw->getOperation()).str() +
+                                                      ") not supported");
+        auto cx = llvm::dyn_cast<llvm::AtomicCmpXchgInst>(&inst);
+        if (cx && cx->getPointerAddressSpace() == 3 && cx->getNewValOperand()->getType()->isIntegerTy(64))
+          return llvm::make_error<UnsupportedFeature>("DXIL: 64-bit groupshared atomic (cmpxchg) not supported");
+      }
+  return llvm::Error::success();
+}
+
 struct Usage {
   bool read = false, written = false, sampled = false, compared = false;
 };
@@ -149,6 +215,9 @@ InitializeDXIL(const Container &container, SM50ShaderInternal *shader, MTL_SHADE
   auto entry = ReadEntry(**module);
   if (!entry)
     return entry.takeError();
+  if (auto err = RefuseGroupshared64BitAtomics(**module))
+    return err;
+  AddHeapRanges(**module, *entry);
   // Apple GPUs run 32-lane SIMD groups (d3d12_device.cpp's WaveLaneCountMin/Max); the preferred size is a hint.
   if (entry->wave_size_min && !(entry->wave_size_min <= 32 && 32 <= entry->wave_size_max))
     return llvm::make_error<UnsupportedFeature>("DXIL: [WaveSize(" + std::to_string(entry->wave_size_min) + ", " +
diff --git a/src/airconv/dxil/dxil_lower.cpp b/src/airconv/dxil/dxil_lower.cpp
index d4046f8..2fd4595 100644
--- a/src/airconv/dxil/dxil_lower.cpp
+++ b/src/airconv/dxil/dxil_lower.cpp
@@ -31,14 +31,34 @@ ConstantU32(llvm::Value *v, uint32_t otherwise) {
   return c ? (uint32_t)c->getZExtValue() : otherwise;
 }
 
+llvm::CallInst *
+HeapHandle(llvm::CallInst &annotate, uint32_t props[2]) {
+  if (annotate.arg_size() < 3)
+    return nullptr;
+  auto heap = llvm::dyn_cast<llvm::CallInst>(annotate.getArgOperand(1));
+  auto p = llvm::dyn_cast<llvm::Constant>(annotate.getArgOperand(2));
+  if (!heap || OpCode(*heap) != op::CreateHandleFromHeap || !p || !p->getAggregateElement(1u))
+    return nullptr;
+  props[0] = ConstantU32(p->getAggregateElement(0u)), props[1] = ConstantU32(p->getAggregateElement(1u));
+  return heap;
+}
+
 llvm::Expected<HandleInfo>
 ResolveHandle(const EntryInfo &entry, llvm::Value *handle) {
   auto call = llvm::dyn_cast<llvm::CallInst>(handle);
   if (!call)
     return llvm::make_error<UnsupportedFeature>("DXIL: resource handle through phi/select");
   switch (OpCode(*call)) {
-  case op::AnnotateHandle: // (216, handle, %dx.types.ResourceProperties)
+  case op::AnnotateHandle: { // (216, handle, %dx.types.ResourceProperties)
+    uint32_t props[2];
+    if (auto heap = HeapHandle(*call, props)) { // (218, i32 index, i1 samplerHeap, i1 nonUniform): the index is the register
+      for (auto &r : entry.resources)
+        if (r.heap && r.heap_props[0] == props[0] && r.heap_props[1] == props[1])
+          return HandleInfo{r.cls, r.id, heap->getArgOperand(1), &r};
+      return llvm::make_error<UnsupportedFeature>("DXIL: createHandleFromHeap names an undeclared heap range");
+    }
     return ResolveHandle(entry, call->getArgOperand(1));
+  }
   case op::CreateHandle: { // (57, i8 class, i32 rangeId, i32 index, i1 nonUniform)
     auto cls = ResourceClass(ConstantU32(call->getArgOperand(1)));
     uint32_t id = ConstantU32(call->getArgOperand(2));
@@ -59,8 +79,8 @@ ResolveHandle(const EntryInfo &entry, llvm::Value *handle) {
         return HandleInfo{cls, r.id, call->getArgOperand(2), &r};
     return llvm::make_error<UnsupportedFeature>("DXIL: createHandleFromBinding names an undeclared resource");
   }
-  case op::CreateHandleFromHeap:
-    return llvm::make_error<UnsupportedFeature>("DXIL: dx.op.createHandleFromHeap (dynamic resources) not supported");
+  case op::CreateHandleFromHeap: // only annotateHandle says what it is
+    return llvm::make_error<UnsupportedFeature>("DXIL: createHandleFromHeap without annotateHandle");
   default:
     return llvm::make_error<UnsupportedFeature>("DXIL: resource handle from an unrecognised op");
   }
@@ -137,10 +157,9 @@ Lowering::Lower(llvm::CallInst *call) {
   switch (opcode) {
   case op::CreateHandle:
   case op::CreateHandleFromBinding:
+  case op::CreateHandleFromHeap:
   case op::AnnotateHandle:
     return llvm::Error::success(); // resolved at each use, erased by Cleanup
-  case op::CreateHandleFromHeap:
-    return ResolveHandle(entry, call).takeError();
   default:
     break;
   }
@@ -170,6 +189,7 @@ Lowering::Cleanup(llvm::Function &function) {
         switch (OpCode(*call)) {
         case op::CreateHandle:
         case op::CreateHandleFromBinding:
+        case op::CreateHandleFromHeap:
         case op::AnnotateHandle:
           call->eraseFromParent();
           erased = true;
diff --git a/src/airconv/dxil/dxil_lower.hpp b/src/airconv/dxil/dxil_lower.hpp
index e0806f6..f3cb159 100644
--- a/src/airconv/dxil/dxil_lower.hpp
+++ b/src/airconv/dxil/dxil_lower.hpp
@@ -32,6 +32,9 @@ struct HandleInfo {
 // Resolves a %dx.types.Handle to its resource, through annotateHandle. Only reads the handle's defining call, so it
 // also serves SM50Initialize's usage scan.
 llvm::Expected<HandleInfo> ResolveHandle(const EntryInfo &entry, llvm::Value *handle);
+// An annotateHandle (216) of a createHandleFromHeap (218): returns that call and sets `props` to the
+// ResourceProperties, which pick its heap range; nullptr for any other handle (MacNeutron).
+llvm::CallInst *HeapHandle(llvm::CallInst &annotate, uint32_t props[2]);
 
 // Replaces dx.op calls with AIR, one call at a time, inside the AIR entry function being built.
 // GPU efficiency spec E5 (MacNeutron): a raw or structured buffer load is bounds-checked once for all its components
diff --git a/src/airconv/dxil/dxil_types.hpp b/src/airconv/dxil/dxil_types.hpp
index 4a5b8dd..2ca8381 100644
--- a/src/airconv/dxil/dxil_types.hpp
+++ b/src/airconv/dxil/dxil_types.hpp
@@ -92,8 +92,15 @@ struct Resource {
   uint32_t stride = 0;                                  // structured buffers
   uint32_t cbuffer_size = 0;                            // constant buffers, in bytes
   bool globally_coherent = false, has_counter = false, rasterizer_ordered = false, comparison_sampler = false;
+  // A descriptor heap range (ResourceDescriptorHeap/SamplerDescriptorHeap, op 218): space kHeapSpace, lower bound 0,
+  // unbounded, the heap index its register; one per distinct annotateHandle ResourceProperties (MacNeutron).
+  bool heap = false;
+  uint32_t heap_props[2] = {0, 0};
 };
 
+// Heap ranges' register space (no root parameter's) and their first range ID (MacNeutron).
+constexpr uint32_t kHeapSpace = ~0u, kHeapRangeBase = 1u << 24;
+
 struct EntryInfo {
   ShaderKind kind = ShaderKind::Invalid;
   uint32_t sm_major = 0, sm_minor = 0;
