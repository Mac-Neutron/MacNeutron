+    auto deferred_write = [&](const void *key) { // a resolve blit encoded after the passes writes it (B7)
+      auto by = [&](EncoderData *e) {
+        if (e->type != EncoderType::Blit || !e->query_resolve_only)
+          return false;
+        for (unsigned i = 0; i < e->write_count; i++)
