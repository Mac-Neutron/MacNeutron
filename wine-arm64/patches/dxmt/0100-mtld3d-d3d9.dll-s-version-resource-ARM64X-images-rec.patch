From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Tue, 20 Oct 2026 18:24:46 -0400
Subject: [PATCH] mtld3d: d3d9.dll's version resource; ARM64X images record
 their PDB by name.

Installers, launchers and some games read d3d9.dll's version: it says
Direct3D 9.0c's 5.3.1.904, as Wine's own d3d9.dll does
(windows/d3d9/version.rc, numeric constants, no SDK headers, compiled
by llvm-mingw's llvm-rc into the ARM64X link). /pdbaltpath:%_PDB% keeps
the build folder out of the images' CodeView record.

Assisted-by: Claude Code: claude-opus-5-5
---
 mtld3d/Makefile                |  8 +++++---
 mtld3d/windows/d3d9/version.rc | 31 +++++++++++++++++++++++++++++++
 2 files changed, 36 insertions(+), 3 deletions(-)
 create mode 100644 mtld3d/windows/d3d9/version.rc

diff --git a/mtld3d/Makefile b/mtld3d/Makefile
index d44b1ca6..7040a4ec 100644
--- a/mtld3d/Makefile
+++ b/mtld3d/Makefile
@@ -767,8 +767,8 @@ endef
 define arm64x_link
 $(ARM64X_LLD) -lldmingw /dll /machine:arm64x /nodefaultlib /opt:ref,icf \
 	/entry:DllMainCRTStartup /def:windows/$(2) /defarm64native:windows/$(2) \
-	/debug /pdb:$(OUT_arm64x)/$(1).pdb /out:$(OUT_arm64x)/$(1).dll \
-	$(ARM64X_CRT)/dllcrt2.o $(OUT_arm64)/$(1).lib $(OUT_arm64ec)/$(1).lib \
+	/debug /pdb:$(OUT_arm64x)/$(1).pdb /pdbaltpath:%_PDB% /out:$(OUT_arm64x)/$(1).dll \
+	$(ARM64X_CRT)/dllcrt2.o $(OUT_arm64)/$(1).lib $(OUT_arm64ec)/$(1).lib $(3) \
 	$(foreach lib,$(ARM64X_SYSLIBS),$(ARM64X_CRT)/lib$(lib).a) \
 	$(WINE_SDK)/lib/wine/aarch64-windows/libntdll.a
 endef
@@ -787,7 +787,9 @@ windows-arm64x:
 	$(ARM64X_CHECK_ARCHIVES)
 	mkdir -p $(OUT_arm64x)
 	$(call arm64x_link,mtld3d,shim/mtld3d.def)
-	$(call arm64x_link,d3d9,d3d9/d3d9.def)
+	# d3d9.dll's version resource (windows/d3d9/version.rc): installers, launchers and some games read it.
+	$(LLVM_MINGW)/bin/llvm-rc /nologo /fo $(OUT_arm64x)/d3d9.res windows/d3d9/version.rc
+	$(call arm64x_link,d3d9,d3d9/d3d9.def,$(OUT_arm64x)/d3d9.res)
 	$(WINEBUILD) --builtin $(OUT_arm64x)/mtld3d.dll
 	# A stock arm64 Wine's wineboot copies each builtin it finds into a prefix as its marker, so the bundle's hybrid
 	# placeholder has no use there, and its winebuild writes none (no ARM64EC metadata in a -marm64x fake module).
diff --git a/mtld3d/windows/d3d9/version.rc b/mtld3d/windows/d3d9/version.rc
new file mode 100644
index 00000000..585a7b09
--- /dev/null
+++ b/mtld3d/windows/d3d9/version.rc
@@ -0,0 +1,31 @@
+// d3d9.dll's version resource, which installers and launchers read and some games check before they start: the file
+// version is the one Wine's own d3d9.dll reports, Direct3D 9.0c's 5.3.1.904. Numeric constants, so it compiles
+// without an SDK's headers: VOS_NT_WINDOWS32, VFT_DLL.
+1 VERSIONINFO
+FILEVERSION    5,3,1,904
+PRODUCTVERSION 5,3,1,904
+FILEFLAGSMASK  0x3f
+FILEFLAGS      0x0
+FILEOS         0x40004
+FILETYPE       0x2
+FILESUBTYPE    0x0
+{
+    BLOCK "StringFileInfo"
+    {
+        BLOCK "040904B0"
+        {
+            VALUE "CompanyName", "mtld3d"
+            VALUE "FileDescription", "mtld3d Direct3D 9 on Metal"
+            VALUE "FileVersion", "5.3.1.904"
+            VALUE "InternalName", "d3d9.dll"
+            VALUE "LegalCopyright", "Copyright (c) 2026 Alexander Theissen (zlib licence)"
+            VALUE "OriginalFilename", "d3d9.dll"
+            VALUE "ProductName", "mtld3d"
+            VALUE "ProductVersion", "5.3.1.904"
+        }
+    }
+    BLOCK "VarFileInfo"
+    {
+        VALUE "Translation", 0x0409, 0x04B0
+    }
+}
-- 
