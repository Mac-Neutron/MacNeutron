From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Tue, 6 Oct 2026 20:21:56 -0400
Subject: [PATCH] d3d12: Count the MetalFX bridge's input copies.

DXMT_STATS counts "upscale input copied": an upscale whose depth or
motion vectors MetalFX can't read as they are (a depth/stencil depth,
typeless motion vectors) and are copied into a scratch texture first,
as "upscale output copied" counts output copies.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/d3d12/d3d12_command_list.cpp | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/d3d12/d3d12_command_list.cpp b/src/d3d12/d3d12_command_list.cpp
index 0a0a7da..ea0de86 100644
--- a/src/d3d12/d3d12_command_list.cpp
+++ b/src/d3d12/d3d12_command_list.cpp
@@ -2154,6 +2154,7 @@ public:
     };
     Rc<Texture> depth_scratch, motion_scratch, output_scratch;
     if (!readable(depth, info.depth_format) || !readable(motion, info.motion_format)) {
+      DXMT_STAT_COUNT("#upscale input copied", 1);
       allocator_->InvalidateCurrentPass(); // a blit of its own: the game's copies before it can't run after it
       PreBlit(nullptr);
       if (!readable(depth, info.depth_format)) {
-- 
