From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Sun, 11 Oct 2026 14:45:20 -0400
Subject: [PATCH] d3d12: Pass the bound descriptor heaps to shaders that index
 them.

A shader indexing ResourceDescriptorHeap or SamplerDescriptorHeap reads two
qwords after its root signature's parameters, the CBV/SRV/UAV heap's GPU
descriptor base, then the sampler heap's, when the root signature has
CBV_SRV_UAV_HEAP_DIRECTLY_INDEXED (0x400) or SAMPLER_HEAP_DIRECTLY_INDEXED
(0x800). They were never written, so such a shader read through whatever
followed the root arguments.

CalculateRootSignatureQwordOffsets appends the two qwords for those flags and
returns where they start (HeapQwordOffset; ~0u without), and UploadQwords
counts them, so ExecuteIndirect's per-command copies carry them. The root
argument staging grows to 66 qwords. SetDescriptorHeaps records each bound
heap's GPU base by its type (0 for a type not bound), writes both into the
compute and graphics staging of a root signature that has the qwords, and
marks both root arguments dirty; setting a root signature writes the bases
recorded so far. Resetting the list forgets the heaps.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/d3d12/d3d12_command_list.cpp   | 33 ++++++++++++++++++++++++------
 src/d3d12/d3d12_device.hpp         |  4 ++++
 src/d3d12/d3d12_root_signature.cpp | 15 +++++++++++---
 3 files changed, 43 insertions(+), 9 deletions(-)

diff --git a/src/d3d12/d3d12_command_list.cpp b/src/d3d12/d3d12_command_list.cpp
index 7318a8e..18278f6 100644
--- a/src/d3d12/d3d12_command_list.cpp
+++ b/src/d3d12/d3d12_command_list.cpp
@@ -202,11 +202,15 @@ class MTLD3D12GraphicsCommandListImpl
 
   Com<MTLD3D12GraphicsPipelineState, false> pso_graphics_;
   Com<MTLD3D12RootSignature, false> rootsig_graphics_;
-  uint64_t rootarg_graphics_staging_[64];
+  uint64_t rootarg_graphics_staging_[66]; // 64 qwords of parameters, then the heap bases (MacNeutron)
 
   Com<MTLD3D12ComputePipelineState, false> pso_compute_;
   Com<MTLD3D12RootSignature, false> rootsig_compute_;
-  uint64_t rootarg_compute_staging_[64];
+  uint64_t rootarg_compute_staging_[66];
+
+  // The bound CBV/SRV/UAV heap's and sampler heap's GPU bases (SetDescriptorHeaps; 0 for none), staged at a root
+  // signature's HeapQwordOffset. (MacNeutron)
+  uint64_t heap_bases_[2];
 
   FLOAT blend_factor_[4];
   UINT8 stencil_ref_;
@@ -264,6 +268,8 @@ public:
     rootsig_compute_ = nullptr;
     memset(rootarg_compute_staging_, 0, sizeof(rootarg_compute_staging_));
 
+    memset(heap_bases_, 0, sizeof(heap_bases_));
+
     memset(vertex_buffers_.data(), 0, sizeof(vertex_buffers_));
 
     index_buffer_address = 0;
@@ -712,7 +718,7 @@ public:
   };
 
   uint64_t
-  EncodeRootArgument(MTLD3D12RootSignature *pRootSig, uint64_t const pStaging[64], UINT Count = 1) {
+  EncodeRootArgument(MTLD3D12RootSignature *pRootSig, uint64_t const pStaging[66], UINT Count = 1) {
     auto [Ptr, Offset] = allocator_->AllocateGPUHeap(sizeof(uint64_t) * pRootSig->UploadQwords * Count, 64);
     for (unsigned i = 0; i < Count; i++)
       memcpy(
@@ -1361,9 +1367,22 @@ public:
   void STDMETHODCALLTYPE ExecuteBundle(ID3D12GraphicsCommandList *CommandList) {
     DXMT_STAT_SCOPE("list.ExecuteBundle"); IMPLEMENT_ME };
 
+  // Descriptor tables carry their full address; only a root signature with heap qwords takes the heaps' bases.
+  void
+  StageHeapBases(MTLD3D12RootSignature *pRootSig, uint64_t *pStaging) {
+    if (pRootSig && pRootSig->HeapQwordOffset != ~0u)
+      memcpy(pStaging + pRootSig->HeapQwordOffset, heap_bases_, sizeof(heap_bases_));
+  }
+
   void STDMETHODCALLTYPE SetDescriptorHeaps(UINT HeapCount, ID3D12DescriptorHeap *const *Heaps) {
     DXMT_STAT_SCOPE("list.SetDescriptorHeaps");
-    // no need to do anything here because because we encode the full descriptor table address in root argument
+    memset(heap_bases_, 0, sizeof(heap_bases_));
+    for (UINT i = 0; i < HeapCount; i++)
+      heap_bases_[Heaps[i]->GetDesc().Type == D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER] =
+          Heaps[i]->GetGPUDescriptorHandleForHeapStart().ptr;
+    StageHeapBases(rootsig_compute_.ptr(), rootarg_compute_staging_);
+    StageHeapBases(rootsig_graphics_.ptr(), rootarg_graphics_staging_);
+    dirty_state_.set(DirtyState::ComputeRootArguments, DirtyState::GraphicsRootArguments);
   };
 
   void STDMETHODCALLTYPE
@@ -1373,7 +1392,8 @@ public:
       return;
     if (pRootSignature) {
       rootsig_compute_ = static_cast<MTLD3D12RootSignature *>(pRootSignature);
-      assert(rootsig_compute_->UploadQwords < std::size(rootarg_compute_staging_));
+      assert(rootsig_compute_->UploadQwords <= std::size(rootarg_compute_staging_));
+      StageHeapBases(rootsig_compute_.ptr(), rootarg_compute_staging_);
     } else {
       rootsig_compute_ = nullptr;
     }
@@ -1387,7 +1407,8 @@ public:
       return;
     if (pRootSignature) {
       rootsig_graphics_ = static_cast<MTLD3D12RootSignature *>(pRootSignature);
-      assert(rootsig_graphics_->UploadQwords < std::size(rootarg_graphics_staging_));
+      assert(rootsig_graphics_->UploadQwords <= std::size(rootarg_graphics_staging_));
+      StageHeapBases(rootsig_graphics_.ptr(), rootarg_graphics_staging_);
     } else {
       rootsig_graphics_ = nullptr;
     }
diff --git a/src/d3d12/d3d12_device.hpp b/src/d3d12/d3d12_device.hpp
index ca1127a..13ec667 100644
--- a/src/d3d12/d3d12_device.hpp
+++ b/src/d3d12/d3d12_device.hpp
@@ -144,6 +144,10 @@ public:
   uint32_t UploadQwords;
   uint32_t ParameterSlots;
   uint32_t const *SlotQwordOffsets;
+  // With CBV_SRV_UAV_HEAP_DIRECTLY_INDEXED or SAMPLER_HEAP_DIRECTLY_INDEXED (flags 0xC00): the first of two qwords after
+  // the parameters', the bound CBV/SRV/UAV heap's GPU base, then the sampler heap's (UploadQwords counts them); ~0u
+  // without. (MacNeutron)
+  uint32_t HeapQwordOffset;
 
   size_t NumStaticSamplers;
   uint64_t const *EncodedStaticSamplers;
diff --git a/src/d3d12/d3d12_root_signature.cpp b/src/d3d12/d3d12_root_signature.cpp
index 845419f..a3035c8 100644
--- a/src/d3d12/d3d12_root_signature.cpp
+++ b/src/d3d12/d3d12_root_signature.cpp
@@ -346,7 +346,8 @@ D3D12CreateRootSignatureDeserializer(const void *pBytecode, SIZE_T DataSize, REF
 
 #pragma endregion
 
-inline std::pair<std::vector<uint32_t>, uint32_t>
+// Each parameter's first qword, the qwords in all, and where the two heap bases go (~0u: nowhere).
+inline std::tuple<std::vector<uint32_t>, uint32_t, uint32_t>
 CalculateRootSignatureQwordOffsets(const D3D12_ROOT_SIGNATURE_DESC1 &Desc) {
   uint32_t current_offset = 0;
   std::vector<uint32_t> out;
@@ -370,7 +371,14 @@ CalculateRootSignatureQwordOffsets(const D3D12_ROOT_SIGNATURE_DESC1 &Desc) {
     }
   }
 
-  return {out, current_offset};
+  // Dynamic resources (MacNeutron): the heaps' bases follow the parameters, where setup_binding_rootsig declares them.
+  uint32_t heap_offset = ~0u;
+  if (Desc.Flags & 0xC00) {
+    heap_offset = current_offset;
+    current_offset += 2;
+  }
+
+  return {out, current_offset, heap_offset};
 }
 
 class MTLD3D12RootSignatureImpl : public MTLD3D12DeviceChild<MTLD3D12RootSignature> {
@@ -459,9 +467,10 @@ public:
       EncodedStaticSamplers = static_samplers_encoded_.data();
     }
 
-    auto [offsets, total_qwords] = CalculateRootSignatureQwordOffsets(desc);
+    auto [offsets, total_qwords, heap_offset] = CalculateRootSignatureQwordOffsets(desc);
     qword_offsets_ = offsets;
     UploadQwords = total_qwords;
+    HeapQwordOffset = heap_offset;
     ParameterSlots = qword_offsets_.size();
     SlotQwordOffsets = qword_offsets_.data();
 
-- 
