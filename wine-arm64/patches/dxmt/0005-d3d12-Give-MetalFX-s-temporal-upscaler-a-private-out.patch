From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Mon, 5 Oct 2026 23:25:40 -0400
Subject: [PATCH] d3d12: Give MetalFX's temporal upscaler a private output.

MetalFX wants its output texture in private storage ("outputTexture
must have private storage mode" under the debug layer, on every
encode). The scratch textures asked for private storage in their
WMTTextureInfo, which Texture::allocate overwrites from its flags, so
they were shared: allocate them with GpuPrivate. D3D12's textures here
are all shared (committed and placed alike), so an output that isn't
private now also goes through the scratch output and a copy out.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/d3d12/d3d12_command_list.cpp | 6 ++++--
 src/d3d12/d3d12_device.cpp       | 7 +++----
 2 files changed, 7 insertions(+), 6 deletions(-)

diff --git a/src/d3d12/d3d12_command_list.cpp b/src/d3d12/d3d12_command_list.cpp
index 06f5d43..6d86041 100644
--- a/src/d3d12/d3d12_command_list.cpp
+++ b/src/d3d12/d3d12_command_list.cpp
@@ -2067,7 +2067,8 @@ public:
   // MacNeutron (XeSS answered by MetalFX): IMTLD3D12CommandListExt. Everything is checked before anything is recorded.
   // An input MetalFX can't take as it is (another Metal format than the upscaler's, or not readable: a depth/stencil
   // depth, typeless motion vectors) is copied into a scratch texture first, in a blit of its own; an output it can't
-  // write (MetalFX wants ShaderRead, ShaderWrite and RenderTarget) is written to a scratch texture and copied out after.
+  // write (MetalFX wants ShaderRead, ShaderWrite and RenderTarget, and private storage: D3D12's textures here are
+  // shared, so every output today) is written to a scratch texture and copied out after.
   // The copies take the region MetalFX uses to the scratch texture's origin, so their offsets become 0.
   HRESULT STDMETHODCALLTYPE
   TemporalUpscale(IMTLD3D12TemporalScaler *pScaler, const MTL_TEMPORAL_UPSCALE_D3D12_DESC *pDesc) {
@@ -2165,7 +2166,8 @@ public:
       }
     }
     Texture *target = output;
-    if ((output->usage() & writable) != writable) {
+    bool output_private = output->current()->flags().test(TextureAllocationFlag::GpuPrivate);
+    if ((output->usage() & writable) != writable || !output_private) {
       output_scratch = scaler->GetScratch(Scratch::Output);
       props.output_offset_x = props.output_offset_y = 0;
       target = output_scratch.ptr();
diff --git a/src/d3d12/d3d12_device.cpp b/src/d3d12/d3d12_device.cpp
index d400b1c..e2df3e5 100644
--- a/src/d3d12/d3d12_device.cpp
+++ b/src/d3d12/d3d12_device.cpp
@@ -287,8 +287,8 @@ public:
     return E_NOINTERFACE;
   }
 
-  // Private and untracked like D3D12's textures, and never resident through the device's set: only blits and MetalFX,
-  // which bind them directly, use them.
+  // Private (MetalFX wants its output private; allocate() sets the storage mode from its flags) and untracked, and
+  // never resident through the device's set: only blits and MetalFX, which bind them directly, use them.
   Rc<Texture>
   GetScratch(Scratch which) final {
     std::lock_guard<dxmt::mutex> lock(mutex_);
@@ -305,9 +305,8 @@ public:
                                                   : info.output_format;
       t.usage = WMTTextureUsage(WMTTextureUsageShaderRead | WMTTextureUsagePixelFormatView |
                                 (which == Scratch::Output ? WMTTextureUsageShaderWrite | WMTTextureUsageRenderTarget : 0));
-      t.options = WMTResourceOptions(WMTResourceStorageModePrivate | WMTResourceHazardTrackingModeUntracked);
       texture = new Texture(t, device_);
-      texture->rename(texture->allocate({}));
+      texture->rename(texture->allocate(TextureAllocationFlag::GpuPrivate));
     }
     return texture;
   }
