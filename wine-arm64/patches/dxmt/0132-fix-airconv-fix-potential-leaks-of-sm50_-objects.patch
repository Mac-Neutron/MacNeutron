From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Feifan He <feifan@codeweavers.com>
Date: Thu, 22 Oct 2026 10:18:12 +0800
Subject: [PATCH] fix(airconv): fix potential leaks of `sm50_*` objects

Signed-off-by: Feifan He <feifan@codeweavers.com>
(cherry picked from commit 39625fa98c9830ffb035d51a37e3590e2b8d4d9e)

[MacNeutron: the fork's DXIL front end returns its errors through SM50_RETURN_ERROR too.]
---
 src/airconv/dxbc_converter.cpp | 126 +++++++++++++--------------------
 src/airconv/dxbc_converter.hpp |  12 ++++
 2 files changed, 60 insertions(+), 78 deletions(-)

diff --git a/src/airconv/dxbc_converter.cpp b/src/airconv/dxbc_converter.cpp
index 6b1ca404..d570907c 100644
--- a/src/airconv/dxbc_converter.cpp
+++ b/src/airconv/dxbc_converter.cpp
@@ -33,11 +33,6 @@ public:
   llvm::SmallVector<char, 0> vec;
 };
 
-class SM50ErrorInternal {
-public:
-  llvm::SmallVector<char, 0> buf;
-};
-
 namespace dxmt::dxbc {
 
 inline dxmt::shader::common::ResourceType
@@ -994,20 +989,18 @@ AIRCONV_API int SM50Initialize(
   if (ppError) {
     *ppError = nullptr;
   }
-  auto errorObj = new SM50ErrorInternal();
+  auto errorObj = std::make_unique<SM50ErrorInternal>();
   llvm::raw_svector_ostream errorOut(errorObj->buf);
 
   if (ppShader == nullptr) {
     errorOut << "ppShader can not be null\0";
-    *ppError = (sm50_error_t)errorObj;
-    return 1;
+    SM50_RETURN_ERROR(errorObj, ppError, 1);
   }
 
