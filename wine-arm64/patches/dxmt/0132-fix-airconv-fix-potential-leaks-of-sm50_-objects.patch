diff --git a/src/airconv/dxbc_converter.hpp b/src/airconv/dxbc_converter.hpp
index a398dffb..ed9c9811 100644
--- a/src/airconv/dxbc_converter.hpp
+++ b/src/airconv/dxbc_converter.hpp
@@ -467,6 +467,18 @@ public:
   }
 };
 
+class SM50ErrorInternal {
+public:
+  llvm::SmallVector<char, 0> buf;
+};
+
+#define SM50_RETURN_ERROR(errorObj, ppError, errorCode) \
+  do { \
+    if (ppError) \
+      *(ppError) = (sm50_error_t)(errorObj).release(); \
+    return errorCode; \
+  } while (0)
+
 void handle_signature(
   microsoft::CSignatureParser &inputParser,
   microsoft::CSignatureParser5 &outputParser,
