From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Fri, 16 Oct 2026 16:08:23 -0400
Subject: [PATCH] meson: A guest_vm build for MacNeutron's EAC microVM.

-Dguest_vm=true builds DXMT for the x86-64 guest of MacNeutron's EAC microVM, whose winemetal.so forwards winemetal's
calls to the host: no Unix side of its own (winemetal's unix/ and airconv's darwin/ are left out), and the memory
DXMT gives Metal for a buffer to be made over (placed buffers, a command allocator's GPU heap, the dummy constant
buffer, staging blocks) comes from two new winemetal calls, WMTMemoryAlloc and WMTMemoryFree (153 and 154), which the
guest answers from memory the host maps too. Off by default, and every source change is behind DXMT_GUEST_VM, which
only the option defines.
---
 meson.build                           |  5 +++++
 meson.options                         |  1 +
 src/airconv/meson.build               |  2 +-
 src/d3d12/d3d12_command_allocator.cpp |  4 ++++
 src/d3d12/d3d12_command_allocator.hpp |  4 ++++
 src/dxmt/dxmt_buffer.cpp              |  8 ++++++++
 src/dxmt/dxmt_context.cpp             |  8 ++++++++
 src/dxmt/dxmt_ring_bump_allocator.hpp |  8 ++++++++
 src/winemetal/meson.build             |  3 ++-
 src/winemetal/winemetal.h             |  8 ++++++++
 src/winemetal/winemetal_thunks.c      | 19 +++++++++++++++++++
 src/winemetal/winemetal_thunks.h      |  8 ++++++++
 12 files changed, 76 insertions(+), 2 deletions(-)

diff --git a/meson.build b/meson.build
index e10c901..05d19a1 100644
--- a/meson.build
+++ b/meson.build
@@ -139,6 +139,11 @@ endif
 
 add_project_arguments('-DDXMT_PAGE_SIZE=4096', language: 'cpp')
 
+# MacNeutron: memory DXMT hands to Metal comes from winemetal (WMTMemoryAlloc), which the VM's host maps too.
+if get_option('guest_vm')
+  add_project_arguments('-DDXMT_GUEST_VM', language: ['c', 'cpp'])
+endif
+
 dxmt_version = vcs_tag(
   command: ['git', 'describe', '--always'],
   input:  'version.h.in',
diff --git a/meson.options b/meson.options
index dc84a45..a247f89 100644
--- a/meson.options
+++ b/meson.options
@@ -9,4 +9,5 @@ option('enable_tests', type : 'boolean', value : false)
 option('enable_nvapi', type : 'boolean', value : false)
 option('enable_nvngx', type : 'boolean', value : false)
 option('enable_d3d12', type : 'boolean', value : false)
+option('guest_vm', type : 'boolean', value : false, description : 'MacNeutron: an x86-64 build for the EAC microVM\'s guest, whose winemetal.so forwards to the host; no Unix side of its own')
 option('translator_key_file', type : 'string', value : '', description : 'A file holding the shader translator\'s key; empty: DXMT\'s version keys the shader cache')
diff --git a/src/airconv/meson.build b/src/airconv/meson.build
index 5627019..f65ed10 100644
--- a/src/airconv/meson.build
+++ b/src/airconv/meson.build
@@ -115,6 +115,6 @@ executable('airconv', airconv_src + airconv_cli_src,
 
 endif
 
-if cpu_family == 'x86_64' or cpu_family == 'aarch64' or not dxmt_crossbuild
+if (cpu_family == 'x86_64' or cpu_family == 'aarch64' or not dxmt_crossbuild) and not get_option('guest_vm')
   subdir('darwin')
 endif
\ No newline at end of file
diff --git a/src/d3d12/d3d12_command_allocator.cpp b/src/d3d12/d3d12_command_allocator.cpp
index a605223..bf2391d 100644
--- a/src/d3d12/d3d12_command_allocator.cpp
+++ b/src/d3d12/d3d12_command_allocator.cpp
@@ -60,7 +60,11 @@ MTLD3D12CommandAllocatorImpl::Initialize() {
   cpu_heap_offset_ = 0;
 
   if (!gpu_heap_)
+#ifdef DXMT_GUEST_VM
+    gpu_heap_ = WMTMemoryAlloc(kGPUHeapSize);
+#else
     gpu_heap_ = malloc(kGPUHeapSize);
+#endif
   if (!gpu_heap_)
     return E_OUTOFMEMORY;
   gpu_heap_offset_ = 0;
diff --git a/src/d3d12/d3d12_command_allocator.hpp b/src/d3d12/d3d12_command_allocator.hpp
index 4069750..3587ddc 100644
--- a/src/d3d12/d3d12_command_allocator.hpp
+++ b/src/d3d12/d3d12_command_allocator.hpp
@@ -132,7 +132,11 @@ public:
     free(cpu_heap_);
     cpu_heap_ = nullptr;
     gpu_heap_buffer_ = {};
+#ifdef DXMT_GUEST_VM
+    WMTMemoryFree(gpu_heap_);
+#else
     free(gpu_heap_);
+#endif
     gpu_heap_ = nullptr;
   }
 
diff --git a/src/dxmt/dxmt_buffer.cpp b/src/dxmt/dxmt_buffer.cpp
index ba3810f..3889498 100644
--- a/src/dxmt/dxmt_buffer.cpp
+++ b/src/dxmt/dxmt_buffer.cpp
@@ -42,7 +42,11 @@ BufferAllocation::BufferAllocation(WMT::Device device, const WMTBufferInfo &info
   }
   fenceTrackers.resize(suballocation_count_);
   if (flags_.test(BufferAllocationFlag::CpuPlaced)) {
+#ifdef DXMT_GUEST_VM
+    placed_buffer = WMTMemoryAlloc(info_.length);
+#else
     placed_buffer = wsi::aligned_malloc(info_.length, DXMT_PAGE_SIZE);
+#endif
     info_.memory.set(placed_buffer);
   }
   obj_ = device.newBuffer(info_);
@@ -73,7 +77,11 @@ BufferAllocation::BufferAllocation(
 void
 BufferAllocation::free() {
   if (placed_buffer) {
+#ifdef DXMT_GUEST_VM
+    WMTMemoryFree(placed_buffer);
+#else
     wsi::aligned_free(placed_buffer);
+#endif
     placed_buffer = nullptr;
   }
   delete this;
diff --git a/src/dxmt/dxmt_context.cpp b/src/dxmt/dxmt_context.cpp
index 1dbba87..985aec3 100644
--- a/src/dxmt/dxmt_context.cpp
+++ b/src/dxmt/dxmt_context.cpp
@@ -55,7 +55,11 @@ ArgumentEncodingContext::ArgumentEncodingContext(CommandQueue &queue, WMT::Devic
   dummy_sampler_info_.max_anisotroy = 1;
   dummy_sampler_info_.lod_average = false;
   dummy_sampler_ = device.newSamplerState(dummy_sampler_info_);
+#ifdef DXMT_GUEST_VM
+  dummy_cbuffer_host_ = WMTMemoryAlloc(65536);
+#else
   dummy_cbuffer_host_ = wsi::aligned_malloc(65536, DXMT_PAGE_SIZE);
+#endif
   dummy_cbuffer_info_.length = 65536;
   dummy_cbuffer_info_.memory.set(dummy_cbuffer_host_);
   dummy_cbuffer_info_.options = WMTResourceOptionCPUCacheModeWriteCombined | WMTResourceStorageModeShared |
@@ -70,7 +74,11 @@ ArgumentEncodingContext::ArgumentEncodingContext(CommandQueue &queue, WMT::Devic
 };
 
 ArgumentEncodingContext::~ArgumentEncodingContext() {
+#ifdef DXMT_GUEST_VM
+  WMTMemoryFree(dummy_cbuffer_host_);
+#else
   wsi::aligned_free(dummy_cbuffer_host_);
+#endif
 };
 
 template void ArgumentEncodingContext::encodeVertexBuffers<PipelineKind::Ordinary>(uint32_t slot_mask, uint64_t argument_buffer_offset);
diff --git a/src/dxmt/dxmt_ring_bump_allocator.hpp b/src/dxmt/dxmt_ring_bump_allocator.hpp
index 5c92d92..202da72 100644
--- a/src/dxmt/dxmt_ring_bump_allocator.hpp
+++ b/src/dxmt/dxmt_ring_bump_allocator.hpp
@@ -97,7 +97,11 @@ public:
 
     ~Block() {
       if (mapped_address) {
+#ifdef DXMT_GUEST_VM
+        WMTMemoryFree(mapped_address);
+#else
         free(mapped_address);
+#endif
         mapped_address = nullptr;
       }
     };
@@ -116,7 +120,11 @@ public:
   Block
   allocate(size_t block_size) {
     Block block{};
+#ifdef DXMT_GUEST_VM
+    block.mapped_address = placed_buffer_ ? WMTMemoryAlloc(block_size) : nullptr;
+#else
     block.mapped_address = placed_buffer_ ? malloc(block_size) : nullptr;
+#endif
     WMTBufferInfo info;
     info.options = buffer_info_;
     info.memory.set(block.mapped_address);
diff --git a/src/winemetal/meson.build b/src/winemetal/meson.build
index b3fa530..968377d 100644
--- a/src/winemetal/meson.build
+++ b/src/winemetal/meson.build
@@ -57,6 +57,7 @@ custom_target('postprocess_lib',
   build_by_default : true
 )
 
-if cpu_family == 'x86_64' or cpu_family == 'aarch64'
+# MacNeutron: a guest_vm build's winemetal.so is the VM's own (eac-vm/metal/wm).
+if (cpu_family == 'x86_64' or cpu_family == 'aarch64') and not get_option('guest_vm')
   subdir('unix')
 endif
diff --git a/src/winemetal/winemetal.h b/src/winemetal/winemetal.h
index 74b38bb..4cf6195 100644
--- a/src/winemetal/winemetal.h
+++ b/src/winemetal/winemetal.h
@@ -2239,4 +2239,12 @@ WINEMETAL_API void MTLTexture_getBytes(
     struct WMTMemoryPointer data, uint64_t bytes_per_row, uint64_t bytes_per_image
 );
 
+#ifdef DXMT_GUEST_VM
+/* MacNeutron: memory a Metal object can be made over (a buffer's info.memory) in the EAC microVM's guest, where the
+ * host maps it too: whole 16 KiB pages, page-aligned. Freed memory comes back for reuse only once every Metal object
+ * made over it is gone. */
+WINEMETAL_API void *WMTMemoryAlloc(uint64_t length);
+WINEMETAL_API void WMTMemoryFree(void *ptr);
+#endif
+
 #endif
\ No newline at end of file
diff --git a/src/winemetal/winemetal_thunks.c b/src/winemetal/winemetal_thunks.c
index 1cbc739..6a0cf6f 100644
--- a/src/winemetal/winemetal_thunks.c
+++ b/src/winemetal/winemetal_thunks.c
@@ -1424,3 +1424,22 @@ MTLCommandBuffer_encodeFrameInterpolate(
   WMT_MEMPTR_SET(params.props, props);
   UNIX_CALL(152, &params);
 }
+
+#ifdef DXMT_GUEST_VM
+WINEMETAL_API void *
+WMTMemoryAlloc(uint64_t length) {
+  struct unixcall_wmtmemory params;
+  params.length = length;
+  WMT_MEMPTR_SET(params.ptr, NULL);
+  UNIX_CALL(153, &params);
+  return params.ptr.ptr;
+}
+
+WINEMETAL_API void
+WMTMemoryFree(void *ptr) {
+  struct unixcall_wmtmemory params;
+  params.length = 0;
+  WMT_MEMPTR_SET(params.ptr, ptr);
+  UNIX_CALL(154, &params);
+}
+#endif
diff --git a/src/winemetal/winemetal_thunks.h b/src/winemetal/winemetal_thunks.h
index 3cfcb08..6c8477a 100644
--- a/src/winemetal/winemetal_thunks.h
+++ b/src/winemetal/winemetal_thunks.h
@@ -490,6 +490,14 @@ struct unixcall_mtldevice_newicb {
   obj_handle_t ret;
 };
 
+#ifdef DXMT_GUEST_VM
+/* MacNeutron: WMTMemoryAlloc (153) and WMTMemoryFree (154), answered in the EAC microVM's guest. */
+struct unixcall_wmtmemory {
+  uint64_t length;
+  struct WMTMemoryPointer ptr;
+};
+#endif
+
 #pragma pack(pop)
 
 #endif
-- 
