From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Tue, 13 Oct 2026 11:18:33 -0400
Subject: [PATCH] d3d12: DXMT_STATS says which barrier kept a render pass from
 merging.

Each opaque barrier call records why merges can't see through it (a move into or out of UNORDERED_ACCESS or COMMON,
a UAV or aliasing barrier, a split barrier's end, an unknown resource, simultaneous access), and a refusal at a
barrier counts that reason, "a resource the passes write" or "overlap order" as "render pass merges refused
(barrier): <reason>", beside the existing total (B6).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/d3d12/d3d12_command_list.cpp  | 24 ++++++++++++++-------
 src/d3d12/d3d12_command_queue.cpp | 36 +++++++++++++++++++++++--------
 src/d3d12/d3d12_device.hpp        | 17 +++++++++++----
 3 files changed, 56 insertions(+), 21 deletions(-)

diff --git a/src/d3d12/d3d12_command_list.cpp b/src/d3d12/d3d12_command_list.cpp
index 5813de9..0b2dbc8 100644
--- a/src/d3d12/d3d12_command_list.cpp
+++ b/src/d3d12/d3d12_command_list.cpp
@@ -1329,8 +1329,9 @@ public:
     DXMT_STAT_SCOPE("list.ResourceBarrier");
     DXMT_STAT_COUNT("#resource barriers", Count);
     transitioned_.clear();
-    bool join = false, opaque = false;
-    for (UINT i = 0; i < Count && !(join && opaque); i++) {
+    bool join = false;
+    int opaque = -1; // B6: why merges can't see through this call (a BarrierOpacity), its first barrier's that says
+    for (UINT i = 0; i < Count && !(join && opaque >= 0); i++) {
       auto &b = barriers[i];
       if (b.Flags & D3D12_RESOURCE_BARRIER_FLAG_BEGIN_ONLY)
         continue;
@@ -1338,15 +1339,22 @@ public:
       if (!key || (b.Flags & D3D12_RESOURCE_BARRIER_FLAG_END_ONLY) ||
           (static_cast<MTLD3D12Resource *>(b.Transition.pResource)->GetDesc().Flags &
            D3D12_RESOURCE_FLAG_ALLOW_SIMULTANEOUS_ACCESS)) {
-        join = opaque = true;
+        join = true;
+        if (opaque < 0)
+          opaque = b.Type == D3D12_RESOURCE_BARRIER_TYPE_UAV                ? kOpaqueUavBarrier
+                   : b.Type == D3D12_RESOURCE_BARRIER_TYPE_ALIASING         ? kOpaqueAliasing
+                   : (b.Flags & D3D12_RESOURCE_BARRIER_FLAG_END_ONLY) != 0 ? kOpaqueSplitEnd
+                   : !key                                                   ? kOpaqueUnknown
+                                                                            : kOpaqueSimultaneous;
         break;
       }
       auto before = b.Transition.StateBefore, after = b.Transition.StateAfter;
       if (ReadOnly(before) && ReadOnly(after))
         continue;
-      // B6 merges can't see through these: no render pass lists its UAV writes, and COMMON hides promoted ones.
-      opaque |= before == D3D12_RESOURCE_STATE_COMMON || after == D3D12_RESOURCE_STATE_COMMON ||
-                ((before | after) & D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+      if (opaque < 0 && ((before | after) & D3D12_RESOURCE_STATE_UNORDERED_ACCESS))
+        opaque = kOpaqueUavState;
+      else if (opaque < 0 && (before == D3D12_RESOURCE_STATE_COMMON || after == D3D12_RESOURCE_STATE_COMMON))
+        opaque = kOpaqueCommon;
       if (!WriteEnds(before) || after == D3D12_RESOURCE_STATE_COMMON) { // a join that names its resource (B6)
         join = true;
         continue;
@@ -1355,8 +1363,8 @@ public:
     }
     allocator_->Barrier(join, transitioned_.data(), transitioned_.size());
     auto call = allocator_->BarrierCalls();
-    if (opaque)
-      barrier_opaque.push_back(call);
+    if (opaque >= 0)
+      barrier_opaque.push_back({call, BarrierOpacity(opaque)});
     for (UINT i = 0; i < Count; i++) { // E7
       auto &b = barriers[i];
       if (b.Type == D3D12_RESOURCE_BARRIER_TYPE_TRANSITION)
diff --git a/src/d3d12/d3d12_command_queue.cpp b/src/d3d12/d3d12_command_queue.cpp
index 53d3d01..b216e2b 100644
--- a/src/d3d12/d3d12_command_queue.cpp
+++ b/src/d3d12/d3d12_command_queue.cpp
@@ -202,13 +202,15 @@ class MTLD3D12CommandQueueImpl : public MTLD3D12Pageable<MTLD3D12CommandQueue, I
   // B6: barrier calls between merged passes may stay inside the merged pass in strict order (the default), which puts
   // all earlier work behind the base (Order), when they order nothing between the passes: none is opaque (an unknown
   // resource, a split barrier's end, simultaneous access, COMMON, UNORDERED_ACCESS), and none names a resource the base,
-  // a pass merged so far or `next` writes (their attachments among those writes).
-  bool
+  // a pass merged so far or `next` writes (their attachments among those writes). -1 when they may; otherwise why not,
+  // for DXMT_STATS: the first opaque barrier's BarrierOpacity, kCrossOverlap or kCrossWrite.
+  enum { kCrossOverlap = MTLD3D12GraphicsCommandList::kOpaqueKinds, kCrossWrite };
+  int
   Crossable(RenderEncoderData *base, RenderEncoderData *next) {
     if (crossings_.empty())
-      return true;
+      return -1;
     if (!serial_)
-      return false;
+      return kCrossOverlap;
     auto writes = [&](const void *key) {
       auto by = [&](EncoderData *e) {
         if (e->writes_unknown)
@@ -222,14 +224,29 @@ class MTLD3D12CommandQueueImpl : public MTLD3D12Pageable<MTLD3D12CommandQueue, I
              std::any_of(folds_.begin(), folds_.end(), by);
     };
     for (auto &c : crossings_) {
-      for (auto call : c.list->barrier_opaque)
+      for (auto [call, why] : c.list->barrier_opaque)
         if (call > c.after && call <= c.until)
-          return false;
+          return why;
       for (auto &[call, key] : c.list->barrier_names)
         if (call > c.after && call <= c.until && (!key || writes(key)))
-          return false;
+          return kCrossWrite;
     }
-    return true;
+    return -1;
+  }
+  static void
+  RefuseCrossing(int why) {
+    if (!g_stats_on)
+      return;
+    static const unsigned ids[] = {StatId("#render pass merges refused (barrier): UNORDERED_ACCESS"),
+                                   StatId("#render pass merges refused (barrier): a UAV barrier"),
+                                   StatId("#render pass merges refused (barrier): an aliasing barrier"),
+                                   StatId("#render pass merges refused (barrier): a split barrier's end"),
+                                   StatId("#render pass merges refused (barrier): an unknown resource"),
+                                   StatId("#render pass merges refused (barrier): simultaneous access"),
+                                   StatId("#render pass merges refused (barrier): COMMON"),
+                                   StatId("#render pass merges refused (barrier): overlap order"),
+                                   StatId("#render pass merges refused (barrier): a resource the passes write")};
+    StatCount(ids[why]);
   }
   unsigned merged_list_ = 0;                                // the list of merged_'s last pass
   std::vector<std::pair<EncoderData *, uint16_t>> skipped_; // encoders M3 already encoded, with their fence
@@ -320,8 +337,9 @@ class MTLD3D12CommandQueueImpl : public MTLD3D12Pageable<MTLD3D12CommandQueue, I
       if (cursor->type != EncoderType::Render)
         break;
       auto *next = static_cast<RenderEncoderData *>(cursor);
-      if (!Crossable(base, next)) {
+      if (int why = Crossable(base, next); why >= 0) {
         RefuseMerge(next, kRefusedBarrier);
+        RefuseCrossing(why);
         break;
       }
       unsigned n = samples;
diff --git a/src/d3d12/d3d12_device.hpp b/src/d3d12/d3d12_device.hpp
index 42dbfbb..a534cd0 100644
--- a/src/d3d12/d3d12_device.hpp
+++ b/src/d3d12/d3d12_device.hpp
@@ -67,10 +67,19 @@ public:
   // GPU efficiency spec E7: the resources each barrier call names, as {call index (1-based), ResourceKey}; null: any
   // (an aliasing or UAV barrier without a resource, or one we don't know).
   std::vector<std::pair<uint32_t, const void *>> barrier_names;
-  // MacNeutron (B6): the barrier calls (1-based) a merge can't see through: an unknown resource, a split barrier's
-  // end, simultaneous access, a move into or out of COMMON or UNORDERED_ACCESS. (A read state's move to another write
-  // state also joins, but only for the resource it names.)
-  std::vector<uint32_t> barrier_opaque;
+  // MacNeutron (B6): the barrier calls (1-based) a merge can't see through, with why (BarrierOpacity). (A read state's
+  // move to another write state also joins, but only for the resource it names.)
+  enum BarrierOpacity : uint8_t {
+    kOpaqueUavState, // a move into or out of UNORDERED_ACCESS: no render pass lists its UAV writes
+    kOpaqueUavBarrier,
+    kOpaqueAliasing,
+    kOpaqueSplitEnd,
+    kOpaqueUnknown,
+    kOpaqueSimultaneous,
+    kOpaqueCommon, // a move into or out of COMMON, which hides promoted writes
+    kOpaqueKinds
+  };
+  std::vector<std::pair<uint32_t, BarrierOpacity>> barrier_opaque;
 };
 
 class MTLD3D12CommandAllocator : public ID3D12CommandAllocator {
-- 
