From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Sun, 11 Oct 2026 08:41:22 -0400
Subject: [PATCH] airconv: Refuse a WaveSize range that excludes 32 lanes.

ReadEntry reads [WaveSize] into EntryInfo::wave_size_min and
wave_size_max (0 without it): entry property 11 (WaveSize, one value N)
sets both to N, and 23 (WaveSizeRange, Shader Model 6.8: min, max,
preferred) sets min and max, a max of 0 meaning min alone.

Apple GPUs run 32-lane SIMD groups, and the device reports
WaveLaneCountMin and WaveLaneCountMax 32. InitializeDXIL refuses a shader
whose range leaves out 32 instead of running it at 32 lanes:
"DXIL: [WaveSize(<min>, <max>)] excludes this device's 32-lane waves".
D3D12's CachedShader::Parse then answers E_FAIL, so the pipeline fails.
The preferred size is a hint and is ignored.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/airconv/dxil/dxil_initialize.cpp | 5 +++++
 src/airconv/dxil/dxil_metadata.cpp   | 6 ++++++
 src/airconv/dxil/dxil_types.hpp      | 2 ++
 3 files changed, 13 insertions(+)

diff --git a/src/airconv/dxil/dxil_initialize.cpp b/src/airconv/dxil/dxil_initialize.cpp
index bea599b..46c4a65 100644
--- a/src/airconv/dxil/dxil_initialize.cpp
+++ b/src/airconv/dxil/dxil_initialize.cpp
@@ -149,6 +149,11 @@ InitializeDXIL(const Container &container, SM50ShaderInternal *shader, MTL_SHADE
   auto entry = ReadEntry(**module);
   if (!entry)
     return entry.takeError();
+  // Apple GPUs run 32-lane SIMD groups (d3d12_device.cpp's WaveLaneCountMin/Max); the preferred size is a hint.
+  if (entry->wave_size_min && !(entry->wave_size_min <= 32 && 32 <= entry->wave_size_max))
+    return llvm::make_error<UnsupportedFeature>("DXIL: [WaveSize(" + std::to_string(entry->wave_size_min) + ", " +
+                                                std::to_string(entry->wave_size_max) +
+                                                ")] excludes this device's 32-lane waves");
   switch (entry->kind) {
   case ShaderKind::Vertex: shader->shader_type = microsoft::D3D10_SB_VERTEX_SHADER; break;
   case ShaderKind::Pixel: shader->shader_type = microsoft::D3D10_SB_PIXEL_SHADER; break;
diff --git a/src/airconv/dxil/dxil_metadata.cpp b/src/airconv/dxil/dxil_metadata.cpp
index 2bb0404..8194b8f 100644
--- a/src/airconv/dxil/dxil_metadata.cpp
+++ b/src/airconv/dxil/dxil_metadata.cpp
@@ -188,6 +188,12 @@ ReadEntry(const llvm::Module &module) {
         entry.gs_output_topology = Int(n->getOperand(3));
         entry.gs_instances = Int(n->getOperand(4));
       }
+      if (tag == 11 && n && n->getNumOperands() >= 1) // WaveSize: N
+        entry.wave_size_min = entry.wave_size_max = Int(n->getOperand(0));
+      if (tag == 23 && n && n->getNumOperands() >= 2) { // WaveSizeRange: min, max (0: min alone), preferred
+        entry.wave_size_min = Int(n->getOperand(0));
+        entry.wave_size_max = Int(n->getOperand(1)) ? Int(n->getOperand(1)) : entry.wave_size_min;
+      }
     }
   return entry;
 }
diff --git a/src/airconv/dxil/dxil_types.hpp b/src/airconv/dxil/dxil_types.hpp
index e857f67..ee31956 100644
--- a/src/airconv/dxil/dxil_types.hpp
+++ b/src/airconv/dxil/dxil_types.hpp
@@ -99,6 +99,8 @@ struct EntryInfo {
   uint32_t sm_major = 0, sm_minor = 0;
   std::string name;
   uint32_t numthreads[3] = {0, 0, 0};
+  // [WaveSize] (entry property WaveSize, or WaveSizeRange from 6.8): the wave widths the shader runs at; 0 without it.
+  uint32_t wave_size_min = 0, wave_size_max = 0;
   // Geometry shaders (entry property GSState): primitive and topology values are D3D10_SB_PRIMITIVE(_TOPOLOGY)'s.
   uint32_t gs_input_primitive = 0, gs_max_vertex_count = 0, gs_stream_mask = 0, gs_output_topology = 0, gs_instances = 1;
   std::vector<SignatureElement> inputs, outputs;
