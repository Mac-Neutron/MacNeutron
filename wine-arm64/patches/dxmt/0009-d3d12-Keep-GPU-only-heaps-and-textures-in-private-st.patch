From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Tue, 6 Oct 2026 11:06:51 -0400
Subject: [PATCH] d3d12: Keep GPU-only heaps and textures in private storage.

A heap the CPU can't see (DEFAULT, or CUSTOM with no CPU pages) is
created Private, and so are the committed textures on such heaps and
the textures and buffers placed in them: a placed resource gets its
heap's properties, so it gets the heap's storage mode, which Metal
requires. Committed buffers and every resource on a CPU-visible heap
stay Shared. Sizes are still asked for Shared: Private measured the
same on the M5 Pro. DXMT_D3D12_PRIVATE=0 keeps everything Shared.

Write/ReadFromSubresource refuse a texture on a heap the CPU can't see,
as D3D12 does.

MetalFX wants its output ShaderRead|ShaderWrite|RenderTarget and
Private, so a 2D UAV texture whose format Metal renders to also gets
RenderTarget usage: the temporal upscale bridge writes a UAV-only
output directly instead of through a scratch texture and a copy. The
copy stays for the outputs MetalFX can't write, and DXMT_STATS counts
it as "upscale output copied".

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/d3d12/d3d12_buffer.cpp          |  2 ++
 src/d3d12/d3d12_command_list.cpp    |  6 ++++--
 src/d3d12/d3d12_device.cpp          |  4 ++--
 src/d3d12/d3d12_device.hpp          |  2 ++
 src/d3d12/d3d12_heap.cpp            |  2 +-
 src/d3d12/d3d12_resource_helper.cpp | 13 +++++++++++++
 src/d3d12/d3d12_texture.cpp         | 24 ++++++++++++++++++------
 7 files changed, 42 insertions(+), 11 deletions(-)

diff --git a/src/d3d12/d3d12_buffer.cpp b/src/d3d12/d3d12_buffer.cpp
index a5d333e..679b849 100644
--- a/src/d3d12/d3d12_buffer.cpp
+++ b/src/d3d12/d3d12_buffer.cpp
@@ -61,6 +61,8 @@ public:
     buffer = new Buffer(desc_.Width, device_->GetMTLDevice());
 
     Flags<BufferAllocationFlag> flags;
+    if (pHeap && IsPrivateHeap(&heap_props_)) // committed buffers stay Shared
+      flags.set(BufferAllocationFlag::CpuInvisible);
     if (pHeap)
       buffer->rename(buffer->allocate(flags, pHeap->heap, Offset));
     else
diff --git a/src/d3d12/d3d12_command_list.cpp b/src/d3d12/d3d12_command_list.cpp
index 8896fe5..1a32403 100644
--- a/src/d3d12/d3d12_command_list.cpp
+++ b/src/d3d12/d3d12_command_list.cpp
@@ -2067,8 +2067,9 @@ public:
   // MacNeutron (XeSS answered by MetalFX): IMTLD3D12CommandListExt. Everything is checked before anything is recorded.
   // An input MetalFX can't take as it is (another Metal format than the upscaler's, or not readable: a depth/stencil
   // depth, typeless motion vectors) is copied into a scratch texture first, in a blit of its own; an output it can't
-  // write (MetalFX wants ShaderRead, ShaderWrite and RenderTarget, and private storage: D3D12's textures here are
-  // shared, so every output today) is written to a scratch texture and copied out after.
+  // write (MetalFX wants ShaderRead, ShaderWrite and RenderTarget, and private storage: a render-target-only output, a
+  // format Metal can't render to, a texture on a CPU-visible heap, or any with DXMT_D3D12_PRIVATE=0) is written to a
+  // scratch texture and copied out after.
   // The copies take the region MetalFX uses to the scratch texture's origin, so their offsets become 0.
   HRESULT STDMETHODCALLTYPE
   TemporalUpscale(IMTLD3D12TemporalScaler *pScaler, const MTL_TEMPORAL_UPSCALE_D3D12_DESC *pDesc) {
@@ -2175,6 +2176,7 @@ public:
     Texture *target = output;
     bool output_private = output->current()->flags().test(TextureAllocationFlag::GpuPrivate);
     if ((output->usage() & writable) != writable || !output_private) {
+      DXMT_STAT_COUNT("#upscale output copied", 1);
       output_scratch = scaler->GetScratch(Scratch::Output);
       props.output_offset_x = props.output_offset_y = 0;
       target = output_scratch.ptr();
diff --git a/src/d3d12/d3d12_device.cpp b/src/d3d12/d3d12_device.cpp
index d36e77f..cd979fc 100644
--- a/src/d3d12/d3d12_device.cpp
+++ b/src/d3d12/d3d12_device.cpp
@@ -37,7 +37,7 @@ namespace dxmt {
 
 const GUID kD3D12DeviceDownlevelUUID = {0x74eaee3f, 0x2f4b, 0x476d, {0x82, 0xba, 0x2b, 0x85, 0xcb, 0x49, 0xe3, 0x10}};
 
-HRESULT PopulateWMTTextureInfo(WMT::Device Device, WMTTextureInfo &InfoOut, const D3D12_RESOURCE_DESC &Desc);
+HRESULT PopulateWMTTextureInfo(MTLD3D12Device *Device, WMTTextureInfo &InfoOut, const D3D12_RESOURCE_DESC &Desc);
 
 // Fills either description from a pipeline stream, with D3D12's defaults for what the stream leaves out (MacNeutron:
 // shared by CreatePipelineState and pipeline libraries' LoadPipeline).
@@ -1742,7 +1742,7 @@ public:
         resource_info.SizeInBytes = size_and_align.size;
       } else {
         WMTTextureInfo texture_info{};
-        if (FAILED(PopulateWMTTextureInfo(GetMTLDevice(), texture_info, *desc))) {
+        if (FAILED(PopulateWMTTextureInfo(this, texture_info, *desc))) {
           DEBUG("GetResourceAllocationInfo: invalid texture descriptor\n");
           goto invalid;
         }
diff --git a/src/d3d12/d3d12_device.hpp b/src/d3d12/d3d12_device.hpp
index a6f5dbe..bffd2d1 100644
--- a/src/d3d12/d3d12_device.hpp
+++ b/src/d3d12/d3d12_device.hpp
@@ -427,6 +427,8 @@ UINT DecomposeSubresource(
 
 bool IsCpuVisibleHeap(const D3D12_HEAP_PROPERTIES *pHeapProps);
 
+bool IsPrivateHeap(const D3D12_HEAP_PROPERTIES *pHeapProps);
+
 bool IsD3D12BoxInBounds(D3D12_BOX &box, D3D12_BOX &bounds);
 
 } // namespace dxmt
\ No newline at end of file
diff --git a/src/d3d12/d3d12_heap.cpp b/src/d3d12/d3d12_heap.cpp
index 57c9e92..b5bd78b 100644
--- a/src/d3d12/d3d12_heap.cpp
+++ b/src/d3d12/d3d12_heap.cpp
@@ -84,7 +84,7 @@ public:
       return E_INVALIDARG;
 
     WMTHeapInfo info;
-    info.options = {}; // FIXME: ensure this agrees with {Buffer|Texture}AllocationFlag?
+    info.options = IsPrivateHeap(&desc_.Properties) ? WMTResourceStorageModePrivate : WMTResourceOptions{};
     info.size = size_aligned;
     info.sparse_page_size = WMTSparsePageSize16;
     info.type = WMTHeapTypePlacement;
diff --git a/src/d3d12/d3d12_resource_helper.cpp b/src/d3d12/d3d12_resource_helper.cpp
index 402bcc9..69cce81 100644
--- a/src/d3d12/d3d12_resource_helper.cpp
+++ b/src/d3d12/d3d12_resource_helper.cpp
@@ -18,6 +18,7 @@
 
 #include "d3d12_device.hpp"
 #include "util_bit.hpp"
+#include "util_env.hpp"
 
 namespace dxmt {
 
@@ -309,6 +310,18 @@ IsCpuVisibleHeap(const D3D12_HEAP_PROPERTIES *pHeapProps) {
   }
 }
 
+// MacNeutron: a heap the CPU can't see (DEFAULT, CUSTOM with no CPU pages) is Private, and so are the committed
+// textures and the placed textures and buffers on it (a placed resource is given its heap's properties, so it gets
+// the heap's storage mode, which Metal requires). DXMT_D3D12_PRIVATE=0 keeps everything Shared.
+// ponytail: sizes and alignments (GetResourceAllocationInfo, the placement bounds) are still asked for Shared: Private
+// measured the same on the M5 Pro (36 texture cases, compressed ones included, and 2 buffer cases); ask with the
+// heap's storage mode if a GPU ever differs.
+bool
+IsPrivateHeap(const D3D12_HEAP_PROPERTIES *pHeapProps) {
+  static const bool on = env::getEnvVar("DXMT_D3D12_PRIVATE") != "0";
+  return on && !IsCpuVisibleHeap(pHeapProps);
+}
+
 HRESULT
 ValidateResourceDescs(const D3D12_RESOURCE_DESC *pDesc, const D3D12_HEAP_PROPERTIES *pHeapProps) {
   auto HeapType = pHeapProps->Type;
diff --git a/src/d3d12/d3d12_texture.cpp b/src/d3d12/d3d12_texture.cpp
index 4158b10..c123dfd 100644
--- a/src/d3d12/d3d12_texture.cpp
+++ b/src/d3d12/d3d12_texture.cpp
@@ -26,9 +26,9 @@
 namespace dxmt {
 
 HRESULT
-PopulateWMTTextureInfo(WMT::Device Device, WMTTextureInfo &InfoOut, const D3D12_RESOURCE_DESC &Desc) {
+PopulateWMTTextureInfo(MTLD3D12Device *Device, WMTTextureInfo &InfoOut, const D3D12_RESOURCE_DESC &Desc) {
   MTL_DXGI_FORMAT_DESC Format;
-  HRESULT hr = MTLQueryDXGIFormat(Device, Desc.Format, Format);
+  HRESULT hr = MTLQueryDXGIFormat(Device->GetMTLDevice(), Desc.Format, Format);
   if (FAILED(hr))
     return hr;
 
@@ -112,13 +112,19 @@ PopulateWMTTextureInfo(WMT::Device Device, WMTTextureInfo &InfoOut, const D3D12_
     Usage |= WMTTextureUsageRenderTarget;
   if (Desc.Flags & D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL)
     Usage |= WMTTextureUsageRenderTarget;
-  if (Desc.Flags & D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS)
+  if (Desc.Flags & D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS) {
     Usage |= WMTTextureUsageShaderRead | WMTTextureUsageShaderWrite;
+    // MacNeutron: MetalFX wants its output ShaderRead|ShaderWrite|RenderTarget (and Private): a 2D UAV of a format
+    // Metal renders to can then be the temporal upscaler's output, written directly (no scratch, no copy).
+    if (Desc.Dimension == D3D12_RESOURCE_DIMENSION_TEXTURE2D &&
+        any_bit_set(Device->GetMTLPixelFormatCapability(InfoOut.pixel_format) & FormatCapability::Color))
+      Usage |= WMTTextureUsageRenderTarget;
+  }
   if (!(Desc.Flags & D3D12_RESOURCE_FLAG_DENY_SHADER_RESOURCE))
     Usage |= WMTTextureUsageShaderRead;
   InfoOut.usage = Usage;
 
-  // TODO: decide storage mode
+  // The storage mode is the heap's (IsPrivateHeap): Initialize passes it to allocate().
   InfoOut.options = WMTResourceHazardTrackingModeUntracked;
 
   // MacNeutron (GPU efficiency spec E1): lossless compression, which PixelFormatView usage would otherwise turn off
@@ -149,7 +155,7 @@ PopulateWMTTextureInfo(WMT::Device Device, WMTTextureInfo &InfoOut, const D3D12_
       WMTTextureInfo info_one_slice = InfoOut;
       info_one_slice.mipmap_level_count = 1;
       info_one_slice.array_length = 1;
-      auto size_and_align = Device.heapTextureSizeAndAlign(info_one_slice);
+      auto size_and_align = Device->GetMTLDevice().heapTextureSizeAndAlign(info_one_slice);
       // Applications can create smaller aligned resources when the estimated size of the most-detailed mip level is a
       // total of the larger alignment restriction or less.
       if (size_and_align.size > D3D12_DEFAULT_RESOURCE_PLACEMENT_ALIGNMENT)
@@ -206,7 +212,7 @@ public:
     }
 
     WMTTextureInfo texture_info{};
-    HRESULT hr = PopulateWMTTextureInfo(device_->GetMTLDevice(), texture_info, desc_);
+    HRESULT hr = PopulateWMTTextureInfo(device_, texture_info, desc_);
     if (FAILED(hr))
       return hr;
 
@@ -228,6 +234,8 @@ public:
       DXMT_STAT_COUNT("#textures created compressed", 1);
     texture = new Texture(texture_info, device_->GetMTLDevice());
     Flags<TextureAllocationFlag> flags = {};
+    if (IsPrivateHeap(&heap_props_)) // committed, or placed on a heap with these properties
+      flags.set(TextureAllocationFlag::CpuInvisible);
     if (pHeap) {
       texture->rename(texture->allocate(flags, pHeap->heap, HeapOffset));
     } else {
@@ -301,6 +309,8 @@ public:
       UINT DstSubresource, const D3D12_BOX *pDstBox, const void *pSrcData, UINT SrcRowPitch, UINT SrcSlicePitch
   ) {
     DXMT_STAT_SCOPE("texture.WriteToSubresource");
+    if (!IsCpuVisibleHeap(&heap_props_))
+      return E_INVALIDARG;
     if (desc_.Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE3D)
       SrcSlicePitch = 0;
     if (desc_.Flags & D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL)
@@ -339,6 +349,8 @@ public:
       void *pDstData, UINT DstRowPitch, UINT DstSlicePitch, UINT SrcSubresource, const D3D12_BOX *pSrcBox
   ) {
     DXMT_STAT_SCOPE("texture.ReadFromSubresource");
+    if (!IsCpuVisibleHeap(&heap_props_))
+      return E_INVALIDARG;
     if (desc_.Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE3D)
       DstSlicePitch = 0;
     if (desc_.Flags & D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL)
