@@ -0,0 +1,58 @@
+#include <iostream>
+#include <snmalloc/snmalloc.h>
+#include <stdlib.h>
+#include <string.h>
+#include <test/setup.h>
+
+extern "C" void* oe_memset_s(void* p, size_t p_size, int c, size_t size)
+{
+  snmalloc::UNUSED(p_size);
+  return memset(p, c, size);
