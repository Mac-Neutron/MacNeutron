+        size,
+        align);
+      size_t allocated = Sallocx(ptr, 0);
+      EXPECT(
+        allocated == expected,
+        "Expected to have allocated {} bytes, got {} bytes",
+        expected,
+        allocated);
+      Dallocx(ptr, 0);
+    });
+  }
