+  class PalTimerDefaultImpl
+  {
+    inline static PalTimer timers{};
+
+  public:
+    static uint64_t time_in_ms()
+    {
+      auto time = PalTime::internal_time_in_ms();
+
+      // Process timers
+      timers.check(time);
