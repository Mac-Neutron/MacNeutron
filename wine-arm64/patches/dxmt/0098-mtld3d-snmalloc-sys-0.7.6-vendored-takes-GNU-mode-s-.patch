+    START_TEST("nallocx and mallocx return the same size");
+    test_sizes_and_alignments([](size_t size, int align) {
+      int flags = MALLOCX_LG_ALIGN(align);
+      size_t expected = Nallocx(size, flags);
+      void* ptr = Mallocx(size, flags);
+      EXPECT(
+        ptr != nullptr,
