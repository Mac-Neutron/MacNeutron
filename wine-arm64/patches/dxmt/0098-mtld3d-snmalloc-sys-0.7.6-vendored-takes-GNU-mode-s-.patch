+void test_calloc()
+{
+  for (size_t size = 16; size <= (1 << 24); size <<= 1)
+  {
+    void* p = snmalloc::alloc(size);
+    memset(p, 0xFF, size);
+    snmalloc::dealloc(p, size);
+
+    p = snmalloc::alloc<ZeroMem::YesZero>(size);
+
+    for (size_t i = 0; i < size; i++)
+    {
+      if (((char*)p)[i] != 0)
+        abort();
+    }
+
+    snmalloc::dealloc(p, size);
+  }
+
+  snmalloc::debug_check_empty();
+}
