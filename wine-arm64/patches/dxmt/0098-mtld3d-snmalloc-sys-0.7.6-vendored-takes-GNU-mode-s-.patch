+      SNMALLOC_FAST_PATH operator T()
+      {
+        return load();
+      }
+
+      SNMALLOC_FAST_PATH T load(MemoryOrder mem_ord = MemoryOrder::SEQ_CST)
+      {
+        T res;
+        __atomic_load(addressof(val), addressof(res), order(mem_ord));
+        return res;
+      }
+
+      // Atomic store.
+      // NOLINTNEXTLINE(misc-unconventional-assign-operator)
+      SNMALLOC_FAST_PATH
