+      }
+      stl::Array<char, 20> buf{{0}};
+      const char digits[] = "0123456789";
+      for (long i = static_cast<long>(buf.size() - 1); i >= 0; i--)
+      {
+        buf[static_cast<size_t>(i)] = digits[s % 10];
+        s /= 10;
+      }
+      bool skipZero = true;
+      for (auto c : buf)
+      {
+        if (skipZero && (c == '0'))
