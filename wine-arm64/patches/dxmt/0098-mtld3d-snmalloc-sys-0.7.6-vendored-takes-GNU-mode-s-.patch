+      int flags = MALLOCX_LG_ALIGN(align) | MALLOCX_ZERO;
+      char* ptr = static_cast<char*>(Mallocx(size, flags));
+      ptr = static_cast<char*>(Rallocx(ptr, size * 2, flags));
+      EXPECT(
