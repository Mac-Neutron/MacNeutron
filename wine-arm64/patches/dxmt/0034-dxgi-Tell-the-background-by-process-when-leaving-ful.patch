From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Thu, 8 Oct 2026 06:50:34 -0400
Subject: [PATCH] dxgi: Tell the background by process when leaving fullscreen.

A fullscreen window left while it isn't the foreground window was
minimised, so a leave with the game's own popup in front (a dialog, an
overlay window owned by the game window) minimised the game too. Ask
whether the foreground window belongs to this process instead; another
process's window, or none (another Mac app active), is the background.
dxgi.handleAltTab keeps its exact-window check. Both swapchains (D3D11,
D3D12).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/d3d11/d3d11_swapchain.cpp    | 7 ++++---
 src/d3d12/d3d12_swapchain.cpp    | 7 ++++---
 src/util/wsi_window.hpp          | 9 +++++++++
 src/util/wsi_window_headless.cpp | 2 ++
 src/util/wsi_window_win32.cpp    | 6 ++++++
 5 files changed, 25 insertions(+), 6 deletions(-)

diff --git a/src/d3d11/d3d11_swapchain.cpp b/src/d3d11/d3d11_swapchain.cpp
index 8892b58..8ba8a90 100644
--- a/src/d3d11/d3d11_swapchain.cpp
+++ b/src/d3d11/d3d11_swapchain.cpp
@@ -372,9 +372,10 @@ public:
 
     // MacNeutron: a fullscreen window the game leaves while it's in the background is minimised, so it doesn't sit
     // at its windowed size and place after the mode reset (a corner of the screen under Wine's emulated modes); the
-    // game enters fullscreen again when it's restored. Async: the caller may not be the window's thread (Unreal's RHI
-    // thread), and must not wait for that thread's message loop.
-    if (!wsi::isForeground(hWnd)) {
+    // game enters fullscreen again when it's restored. In the background means another process's window in front, or
+    // none: the game's own popup in front of its window is still the game. Async: the caller may not be the window's
+    // thread (Unreal's RHI thread), and must not wait for that thread's message loop.
+    if (!wsi::isProcessForeground()) {
       Logger::info("Leaving fullscreen in the background: minimising");
       wsi::minimizeWindow(hWnd);
     }
diff --git a/src/d3d12/d3d12_swapchain.cpp b/src/d3d12/d3d12_swapchain.cpp
index c19eb51..d470694 100644
--- a/src/d3d12/d3d12_swapchain.cpp
+++ b/src/d3d12/d3d12_swapchain.cpp
@@ -392,9 +392,10 @@ public:
 
     // MacNeutron: a fullscreen window the game leaves while it's in the background is minimised, so it doesn't sit
     // at its windowed size and place after the mode reset (a corner of the screen under Wine's emulated modes); the
-    // game enters fullscreen again when it's restored. Async: the caller may not be the window's thread (Unreal's RHI
-    // thread), and must not wait for that thread's message loop.
-    if (!wsi::isForeground(hWnd)) {
+    // game enters fullscreen again when it's restored. In the background means another process's window in front, or
+    // none: the game's own popup in front of its window is still the game. Async: the caller may not be the window's
+    // thread (Unreal's RHI thread), and must not wait for that thread's message loop.
+    if (!wsi::isProcessForeground()) {
       Logger::info("Leaving fullscreen in the background: minimising");
       wsi::minimizeWindow(hWnd);
     }
diff --git a/src/util/wsi_window.hpp b/src/util/wsi_window.hpp
index 86285fa..2140b7a 100644
--- a/src/util/wsi_window.hpp
+++ b/src/util/wsi_window.hpp
@@ -118,6 +118,15 @@ bool isForeground(HWND hWindow);
 
 bool isMinimized(HWND hWindow);
 
+/**
+ * \brief Is a window of this process in front?
+ *
+ * A game's own popups (a dialog, an overlay) count as the game; another
+ * process's window, or none (another Mac app active), doesn't.
+ * \returns Whether the foreground window belongs to this process
+ */
+bool isProcessForeground();
+
 /**
  * \brief Minimizes a window without waiting for its thread
  *
diff --git a/src/util/wsi_window_headless.cpp b/src/util/wsi_window_headless.cpp
index 5c600ed..2d96260 100644
--- a/src/util/wsi_window_headless.cpp
+++ b/src/util/wsi_window_headless.cpp
@@ -64,6 +64,8 @@ bool isForeground(HWND hWindow) { return true; }
 
 bool isMinimized(HWND hWindow) { return false; }
 
+bool isProcessForeground() { return true; }
+
 void minimizeWindow(HWND hWindow) {}
 
 } // namespace dxmt::wsi
diff --git a/src/util/wsi_window_win32.cpp b/src/util/wsi_window_win32.cpp
index b816ecf..426709e 100644
--- a/src/util/wsi_window_win32.cpp
+++ b/src/util/wsi_window_win32.cpp
@@ -269,6 +269,12 @@ bool isMinimized(HWND hWindow) {
   return ::IsIconic(hWindow);
 }
 
+bool isProcessForeground() {
+  DWORD pid = 0;
+  ::GetWindowThreadProcessId(::GetForegroundWindow(), &pid);
+  return pid == ::GetCurrentProcessId();
+}
+
 void minimizeWindow(HWND hWindow) {
   ::ShowWindowAsync(hWindow, SW_MINIMIZE);
 }
