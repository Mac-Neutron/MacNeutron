From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Wed, 7 Oct 2026 00:12:12 -0400
Subject: [PATCH] d3d12, d3d11: Bind a zeroed buffer to unbound vertex buffer
 slots.

Shaders pull vertex attributes through a table of the slots a pipeline
uses, and check every attribute's buffer address for null, so an
unbound slot reads zeros. That branch costs 3-5 % of vertex fetch.

Unbound slots (no view, a null view, a null VERTEX_BUFFER_VIEW argument
in ExecuteIndirect, a null D3D11 buffer) now point at a zeroed buffer
with stride 0 instead, so the shaders can read without checking: the
D3D12 device keeps a 4 KB one (an element ends within 2048 bytes), the
D3D11 context uses its zeroed dummy constant buffer.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/d3d12/d3d12_command_allocator.cpp |  1 +
 src/d3d12/d3d12_command_allocator.hpp |  1 +
 src/d3d12/d3d12_command_list.cpp      |  5 +++++
 src/d3d12/d3d12_command_signature.cpp | 10 +++++++---
 src/d3d12/d3d12_device.cpp            | 14 ++++++++++++++
 src/d3d12/d3d12_device.hpp            |  4 ++++
 src/dxmt/dxmt_context.cpp             |  6 ++++--
 7 files changed, 36 insertions(+), 5 deletions(-)

diff --git a/src/d3d12/d3d12_command_allocator.cpp b/src/d3d12/d3d12_command_allocator.cpp
index d73b5da..eb6dd17 100644
--- a/src/d3d12/d3d12_command_allocator.cpp
+++ b/src/d3d12/d3d12_command_allocator.cpp
@@ -308,6 +308,7 @@ MTLD3D12CommandAllocatorImpl::EncodeIndirectRenderCommand(
     data->vertex_buffer = 0;
     data->vertex_argbuf_stride = 0;
     data->vertex_slot_mask = 0;
+    data->null_vertex_buffer = 0;
     data->primitive_type = 0;
     data->index_buffer = 0;
     data->index_buffer_format = {};
diff --git a/src/d3d12/d3d12_command_allocator.hpp b/src/d3d12/d3d12_command_allocator.hpp
index 6d1e530..eab3987 100644
--- a/src/d3d12/d3d12_command_allocator.hpp
+++ b/src/d3d12/d3d12_command_allocator.hpp
@@ -68,6 +68,7 @@ struct IndirectRenderCommandData {
   DXGI_FORMAT index_buffer_format;
   uint32_t vertex_argbuf_stride;
   uint32_t vertex_slot_mask; // the pipeline's: which slots vertex_buffer's table holds
+  uint64_t null_vertex_buffer; // for null VERTEX_BUFFER_VIEW arguments (Task F2: shaders don't check)
 };
 
 class MTLD3D12CommandAllocatorImpl : public MTLD3D12Pageable<MTLD3D12CommandAllocator> {
diff --git a/src/d3d12/d3d12_command_list.cpp b/src/d3d12/d3d12_command_list.cpp
index 8ad5acc..687380a 100644
--- a/src/d3d12/d3d12_command_list.cpp
+++ b/src/d3d12/d3d12_command_list.cpp
@@ -370,6 +370,10 @@ public:
         if (!(slot_mask & (1 << slot)))
           continue;
         auto &state = vertex_buffers_[slot];
+        if (!state.BufferLocation) { // unbound: zeros (shaders no longer check, Task F2)
+          entries[index++] = {device_->NullVertexBuffer(), 0, 0};
+          continue;
+        }
         entries[index].buffer_handle = state.BufferLocation;
         entries[index].stride = state.StrideInBytes;
         entries[index++].length = state.SizeInBytes;
@@ -2023,6 +2027,7 @@ public:
     cmd->vertex_buffer = allocator_->gpu_heap_buffer_address_ + VBOffset;
     cmd->vertex_argbuf_stride = VBStride;
     cmd->vertex_slot_mask = pso_graphics_ ? pso_graphics_->slot_mask : 0;
+    cmd->null_vertex_buffer = device_->NullVertexBuffer();
   };
 
   void STDMETHODCALLTYPE
diff --git a/src/d3d12/d3d12_command_signature.cpp b/src/d3d12/d3d12_command_signature.cpp
index 4a29d02..02985e3 100644
--- a/src/d3d12/d3d12_command_signature.cpp
+++ b/src/d3d12/d3d12_command_signature.cpp
@@ -86,6 +86,7 @@ struct dxmt_render_command_data {
   uint index_buffer_format;
   uint vertex_argbuf_stride;
   uint vertex_slot_mask;
+  device void * null_vertex_buffer;
 };
 
 )";
@@ -253,11 +254,14 @@ public:
       }
       case D3D12_INDIRECT_ARGUMENT_TYPE_VERTEX_BUFFER_VIEW: {
         // MacNeutron: the table holds the slots the pipeline uses, in order (PopulateVertexBufferTable): a view goes to
-        // its slot's place there, and one for a slot the pipeline doesn't use goes nowhere.
+        // its slot's place there, and one for a slot the pipeline doesn't use goes nowhere. A null view reads zeros
+        // (Task F2), as an unbound slot does.
         auto slot = arg.VertexBuffer.Slot;
+        auto vb = "arg.vb_" + std::to_string(i);
         source << "if (command_data.vertex_slot_mask & " << (1u << slot) << "u) vertex_buffer[popcount(command_data."
-               << "vertex_slot_mask & " << ((1u << slot) - 1) << "u)] = {arg.vb_" << i << ".buffer,arg.vb_" << i
-               << ".stride_in_bytes,arg.vb_" << i << ".size_in_bytes};\n";
+               << "vertex_slot_mask & " << ((1u << slot) - 1) << "u)] = " << vb << ".buffer ? dxmt_vertex_buffer{" << vb
+               << ".buffer," << vb << ".stride_in_bytes," << vb << ".size_in_bytes} : "
+               << "dxmt_vertex_buffer{command_data.null_vertex_buffer,0,0};\n";
         break;
       }
       case D3D12_INDIRECT_ARGUMENT_TYPE_INDEX_BUFFER_VIEW: {
diff --git a/src/d3d12/d3d12_device.cpp b/src/d3d12/d3d12_device.cpp
index cd979fc..bc9b3ec 100644
--- a/src/d3d12/d3d12_device.cpp
+++ b/src/d3d12/d3d12_device.cpp
@@ -353,6 +353,7 @@ class MTLD3D12DeviceImpl : public MTLD3D12Object<ComObject<MTLD3D12Device, IMTLD
   std::map<WMTTextureType, Rc<Texture>> null_textures_;
   Rc<Buffer> null_buffer_;
   BufferViewKey null_buffer_view_;
+  Rc<Buffer> null_vertex_buffer_;
   WMT::Reference<WMT::ResidencySet> residency_set_;
   // MacNeutron: by GPU address. Placed buffers at one heap offset share theirs (aliasing): a lookup finds the newest
   // registered, and a release removes only its own entry (it used to remove the address, or keep a released buffer).
@@ -1861,6 +1862,19 @@ public:
     return {null_buffer_.ptr(), null_buffer_view_};
   }
 
+  uint64_t
+  NullVertexBuffer() {
+    std::lock_guard<dxmt::mutex> lock(null_lock_);
+    if (!null_vertex_buffer_) {
+      // Read with stride 0: an element ends within 2048 bytes (D3D12_REQ_MULTI_ELEMENT_STRUCTURE_SIZE_IN_BYTES).
+      null_vertex_buffer_ = new Buffer(4096, GetMTLDevice());
+      null_vertex_buffer_->rename(null_vertex_buffer_->allocate({}));
+      memset(null_vertex_buffer_->current()->mappedMemory(0), 0, 4096);
+      RegisterResidencyAndVA(null_vertex_buffer_->current());
+    }
+    return null_vertex_buffer_->current()->gpuAddress();
+  }
+
   HRESULT
   RegisterResidencyAndVA(BufferAllocation *allocation) {
     std::unique_lock<dxmt::mutex> lock(residency_lock_);
diff --git a/src/d3d12/d3d12_device.hpp b/src/d3d12/d3d12_device.hpp
index 53a86d6..ca1127a 100644
--- a/src/d3d12/d3d12_device.hpp
+++ b/src/d3d12/d3d12_device.hpp
@@ -248,6 +248,10 @@ public:
   // use. Null UAV textures stay nil (Metal: reads zero, writes discarded).
   virtual std::pair<Texture *, TextureViewKey> NullTexture(WMTTextureType type) = 0;
   virtual std::pair<Buffer *, BufferViewKey> NullTexelBuffer() = 0;
+  // A zeroed buffer's GPU address for vertex buffer slots a pipeline reads but nobody bound (Task F2): read with
+  // stride 0, each element reads zeros, which its format widens as D3D's rules say ((0,0,0,1) for fewer than four
+  // components). Shaders pull vertices without a null check since.
+  virtual uint64_t NullVertexBuffer() = 0;
 
   // GPU timestamp ticks per second (MacNeutron), measured once against QueryPerformanceCounter.
   virtual uint64_t TimestampFrequency() = 0;
diff --git a/src/dxmt/dxmt_context.cpp b/src/dxmt/dxmt_context.cpp
index 7b29f1e..1dbba87 100644
--- a/src/dxmt/dxmt_context.cpp
+++ b/src/dxmt/dxmt_context.cpp
@@ -94,10 +94,12 @@ ArgumentEncodingContext::encodeVertexBuffers(uint32_t slot_mask, uint64_t offset
       continue;
     auto &state = vbuf_[slot];
     auto &buffer = state.buffer;
-    if (!buffer.ptr()) {
-      entries[index].buffer_handle = 0;
+    if (!buffer.ptr()) { // unbound: the zeroed dummy buffer, stride 0 (shaders don't check, MacNeutron Task F2)
+      entries[index].buffer_handle = dummy_cbuffer_info_.gpu_address;
       entries[index].stride = 0;
       entries[index++].length = 0;
+      makeResident<PipelineStage::Vertex, kind>(dummy_cbuffer_,
+                                                GetResidencyMask<kind>(PipelineStage::Vertex, true, false));
       continue;
     }
     auto valid_length = buffer->length() > state.offset ? buffer->length() - state.offset : 0;
