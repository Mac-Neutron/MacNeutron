diff --git a/mtld3d/unix/shared/src/mtl.rs b/mtld3d/unix/shared/src/mtl.rs
index cb609bf6..ae4cba1b 100644
--- a/mtld3d/unix/shared/src/mtl.rs
+++ b/mtld3d/unix/shared/src/mtl.rs
@@ -788,6 +788,11 @@ bitflags! {
         /// waits for the last submitted command buffer before it copies
         /// out of a resolve target when this is set.
         const RESOLVE_NEEDS_RETIRE = 1 << 6;
+        /// MacNeutron: `PageBox` pages come from the Unix side (`AllocPages`/`FreePages`).
+        ///
+        /// Set by the winemetal facade's build (D3D9 spec §5.1): in the VM's guest a buffer made over memory must
+        /// be over memory winemetal handed out, which the PE side's own allocator never is.
+        const PAGES_FROM_UNIX = 1 << 7;
     }
 }
 
diff --git a/mtld3d/unix/shared/src/params.rs b/mtld3d/unix/shared/src/params.rs
index 91f6ffee..307fb136 100644
--- a/mtld3d/unix/shared/src/params.rs
+++ b/mtld3d/unix/shared/src/params.rs
@@ -170,6 +170,28 @@ impl Thunk for GetDeviceInfoParams {
     const CODE: u32 = Thunks::GetDeviceInfo as u32;
 }
 
+/// MacNeutron: `len` bytes of zeroed pages for a `PageBox`, from the Unix side (`ptr` 0 on failure).
+#[repr(C, align(8))]
+pub struct AllocPagesParams {
+    pub len: u64,
+    pub ptr: u64, // out
+}
+
+impl Thunk for AllocPagesParams {
+    const CODE: u32 = Thunks::AllocPages as u32;
+}
+
+/// MacNeutron: gives back what `AllocPages` handed out.
+#[repr(C, align(8))]
+pub struct FreePagesParams {
+    pub ptr: u64,
+    pub len: u64,
+}
+
+impl Thunk for FreePagesParams {
+    const CODE: u32 = Thunks::FreePages as u32;
+}
+
 #[repr(C, align(8))]
 pub struct CreateCommandQueueParams {
     pub device_handle: MetalHandle<MTLDeviceKind>, // out
