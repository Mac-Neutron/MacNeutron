diff --git a/mtld3d/unix/unix/src/metal.rs b/mtld3d/unix/unix/src/metal.rs
index 244cce49..d526ddd9 100644
--- a/mtld3d/unix/unix/src/metal.rs
+++ b/mtld3d/unix/unix/src/metal.rs
@@ -58,3 +58,25 @@ pub use texture::{
 };
 pub use upload_quad::ensure_upload_pipeline;
 pub use upscale::is_supported as upscale_is_supported;
+
+/// MacNeutron: `len` bytes of zeroed pages Metal can be made over, or null (the `AllocPages` thunk).
+///
+/// macOS (the facade's loopback build, and the product build, which never asks): anonymous pages, 16 KiB-aligned as
+/// the kernel maps them on Apple Silicon. The VM's guest: winemetal's own allocator (M2b).
+#[must_use]
+pub fn alloc_pages(len: usize) -> *mut u8 {
+    // SAFETY: an anonymous private mapping; nothing else names the range.
+    let ptr = unsafe {
+        libc::mmap(core::ptr::null_mut(), len, libc::PROT_READ | libc::PROT_WRITE, libc::MAP_ANON | libc::MAP_PRIVATE, -1, 0)
+    };
+    if ptr == libc::MAP_FAILED { core::ptr::null_mut() } else { ptr.cast() }
+}
+
+/// MacNeutron: gives back `alloc_pages`' pages (the `FreePages` thunk).
+pub fn free_pages(ptr: *mut u8, len: usize) {
+    if !ptr.is_null() {
+        // SAFETY: a mapping alloc_pages made of `len` bytes, no longer used (the PE side frees a PageBox once
+        // Metal no longer reads it).
+        unsafe { libc::munmap(ptr.cast(), len) };
+    }
+}
diff --git a/mtld3d/unix/unix/src/metal/command.rs b/mtld3d/unix/unix/src/metal/command.rs
index d430a235..8b485b6c 100644
--- a/mtld3d/unix/unix/src/metal/command.rs
+++ b/mtld3d/unix/unix/src/metal/command.rs
@@ -3823,17 +3823,23 @@ pub fn blit_texture_to_buffer(args: &BlitArgs<'_>) -> bool {
     // CPU read on `waitUntilCompleted` return. On UMA the storage mode
     // collapses to Shared semantics and synchronize is a no-op, so
     // there's no Apple-Silicon overhead.
+    // MacNeutron: under the winemetal facade the GPU writes a staging buffer of its own, copied into the caller's
+    // memory once complete: in the VM the caller's pages are guest memory Metal can't be given.
+    #[cfg(mtl_facade)]
+    let dst_buffer = device.newBufferWithLength_options(to_usize(dst_len), MTLResourceOptions::StorageModeShared);
     // SAFETY: `ptr` is the PE-supplied dst pointer (non-null by the check
     // above); `dst_len` matches its allocation; deallocator is None so the
     // PE allocation is never freed by Metal.
-    let Some(dst_buffer) = (unsafe {
+    #[cfg(not(mtl_facade))]
+    let dst_buffer = unsafe {
         device.newBufferWithBytesNoCopy_length_options_deallocator(
             ptr,
             to_usize(dst_len),
             MTLResourceOptions::StorageModeManaged,
             None,
         )
-    }) else {
+    };
+    let Some(dst_buffer) = dst_buffer else {
         error!(target: LOG_TARGET, "blit_texture_to_buffer: newBufferWithBytesNoCopy failed");
         return false;
     };
@@ -4029,11 +4035,26 @@ pub fn blit_texture_to_buffer(args: &BlitArgs<'_>) -> bool {
     let status = cmd_buf.status();
     diagnostics::completion(&cmd_buf, status, None, "readback-wait");
     // The wrapper owns no pages; the caller keeps the destination allocation.
-    readback_completed(status, || {
+    let completed = readback_completed(status, || {
         let error = cmd_buf.error();
         diagnostics::failure(&cmd_buf, None, "readback-wait", error.as_deref());
         error
-    })
+    });
+    #[cfg(mtl_facade)]
+    if completed {
+        // SAFETY: the staging buffer's `dst_len` bytes, written by the completed blit, into the caller's
+        // allocation of that length.
+        unsafe {
+            core::ptr::copy_nonoverlapping(
+                dst_buffer.contents().as_ptr().cast::<u8>(),
+                ptr.as_ptr().cast::<u8>(),
+                to_usize(dst_len),
+            );
+        }
+    }
+    #[cfg(not(mtl_facade))]
+    let _ = ptr;
+    completed
 }
 
 /// Accept a readback only after Metal reports successful completion.
diff --git a/mtld3d/windows/core/src/page_box.rs b/mtld3d/windows/core/src/page_box.rs
index eab55d9d..4c989263 100644
--- a/mtld3d/windows/core/src/page_box.rs
+++ b/mtld3d/windows/core/src/page_box.rs
@@ -270,9 +270,31 @@ pub struct PageBox {
     readers: AtomicU32,
 }
 
+/// MacNeutron: where `PageBox` pages come from when the Unix side asks for them (`PAGES_FROM_UNIX`): the VM's guest
+/// Metal is made only over memory winemetal handed out. Zeroed pages of a whole number of [`PAGE_SIZE`]s.
+#[derive(Clone, Copy)]
+pub struct PageAllocator {
+    pub alloc: fn(usize) -> Option<NonNull<u8>>,
+    pub free: fn(NonNull<u8>, usize),
+}
+
+/// The allocator `set_page_allocator` installed.
+///
+/// Process-wide by necessity: every `PageBox` constructor reads it, from any device and thread, and the Unix side's
+/// answer it follows is one per process (the `GetDeviceInfo` cache). Set once, before the first page.
+static PAGE_ALLOCATOR: std::sync::OnceLock<PageAllocator> = std::sync::OnceLock::new();
+
+/// Installs the Unix side's page allocator for every `PageBox` made from here on (each keeps the allocator it came
+/// from: one made before is freed as it was made).
+pub fn set_page_allocator(allocator: PageAllocator) {
+    let _ = PAGE_ALLOCATOR.set(allocator);
+}
+
 /// The runtime responsible for releasing a page allocation.
 enum PageOwnership {
     Native(Layout),
+    /// MacNeutron: pages from the [`PageAllocator`].
+    Hooked,
     #[cfg(not(windows))]
     Guest {
         completion: LeaseCompletionPtr,
@@ -337,6 +359,9 @@ impl PageBox {
     /// staging.
     #[must_use]
     pub fn try_new_uninit(logical_len: usize) -> Option<Self> {
+        if let Some(allocator) = PAGE_ALLOCATOR.get() {
+            return Self::try_new_hooked(allocator, logical_len);
+        }
         let (len, layout) = Self::try_layout_for(logical_len)?;
         // SAFETY: `try_layout_for` returns a non-zero-size, page-aligned Layout.
         let ptr = NonNull::new(unsafe { alloc::alloc(layout) })?;
@@ -348,12 +373,24 @@ impl PageBox {
     /// The same fallback-only contract as [`Self::try_new_uninit`].
     #[must_use]
     pub fn try_new_zeroed(logical_len: usize) -> Option<Self> {
+        if let Some(allocator) = PAGE_ALLOCATOR.get() {
+            return Self::try_new_hooked(allocator, logical_len);
+        }
         let (len, layout) = Self::try_layout_for(logical_len)?;
         // SAFETY: `try_layout_for` returns a non-zero-size, page-aligned Layout.
         let ptr = NonNull::new(unsafe { alloc::alloc_zeroed(layout) })?;
         Some(Self::adopt(ptr, len, logical_len, layout))
     }
 
+    /// MacNeutron: zeroed pages from the installed allocator, counted as `adopt` counts.
+    fn try_new_hooked(allocator: &PageAllocator, logical_len: usize) -> Option<Self> {
+        let (len, _) = Self::try_layout_for(logical_len)?;
+        let ptr = (allocator.alloc)(len)?;
+        let mut page_box = Self::adopt(ptr, len, logical_len, Layout::new::<u8>());
+        page_box.ownership = PageOwnership::Hooked;
+        Some(page_box)
+    }
+
     /// Wrap a fresh allocation of `layout` and count it.
     fn adopt(ptr: NonNull<u8>, len: usize, logical_len: usize, layout: Layout) -> Self {
         note_alloc(len);
@@ -418,7 +455,7 @@ impl PageBox {
     /// Whether the allocating runtime can park this box in its recycle pool.
     #[must_use]
     pub const fn is_native_owned(&self) -> bool {
-        matches!(self.ownership, PageOwnership::Native(_))
+        matches!(self.ownership, PageOwnership::Native(_) | PageOwnership::Hooked)
     }
 
     /// Address of the fixed-width reader count kept alive by a page lease.
@@ -429,7 +466,7 @@ impl PageBox {
 
     const fn reader_count(&self) -> &AtomicU32 {
         match &self.ownership {
-            PageOwnership::Native(_) => &self.readers,
+            PageOwnership::Native(_) | PageOwnership::Hooked => &self.readers,
             #[cfg(not(windows))]
             PageOwnership::Guest { readers, .. } => {
                 // SAFETY: from_guest_lease pins the original aligned counter until Drop.
@@ -544,6 +581,14 @@ impl Drop for PageBox {
     fn drop(&mut self) {
         let layout = match &self.ownership {
             PageOwnership::Native(layout) => *layout,
+            PageOwnership::Hooked => {
+                note_free(self.len);
+                PAGEBOX_LIVE_BYTES.fetch_sub(self.len as u64, core::sync::atomic::Ordering::Relaxed);
+                if let Some(allocator) = PAGE_ALLOCATOR.get() {
+                    (allocator.free)(self.ptr, self.len);
+                }
+                return;
+            }
             #[cfg(not(windows))]
             PageOwnership::Guest { completion, .. } => {
                 // SAFETY: from_guest_lease keeps this cell alive until this final acknowledgment.
diff --git a/mtld3d/windows/d3d9/src/direct3d9.rs b/mtld3d/windows/d3d9/src/direct3d9.rs
index 0f802fbf..9c338477 100644
--- a/mtld3d/windows/d3d9/src/direct3d9.rs
+++ b/mtld3d/windows/d3d9/src/direct3d9.rs
@@ -756,6 +756,25 @@ fn device_info() -> &'static CachedDeviceInfo {
     &INFO
 }
 
+/// MacNeutron: `PageBox` pages from the Unix side when it asks (`PAGES_FROM_UNIX`, the winemetal facade's build):
+/// installed at the first interface, before any page.
+pub fn install_page_allocator() {
+    if !device_info().caps.contains(DeviceCapsFlags::PAGES_FROM_UNIX) {
+        return;
+    }
+    fn alloc(len: usize) -> Option<core::ptr::NonNull<u8>> {
+        let mut params = mtld3d_shared::AllocPagesParams { len: len as u64, ptr: 0 };
+        unix_call(&mut params);
+        core::ptr::NonNull::new(params.ptr as usize as *mut u8)
+    }
+    fn free(ptr: core::ptr::NonNull<u8>, len: usize) {
+        let mut params = mtld3d_shared::FreePagesParams { ptr: ptr.as_ptr() as usize as u64, len: len as u64 };
+        unix_call(&mut params);
+    }
+    mtld3d_core::page_box::set_page_allocator(mtld3d_core::page_box::PageAllocator { alloc, free });
+    log::info!(target: LOG_TARGET, "page boxes: pages from the unix side (winemetal)");
+}
+
