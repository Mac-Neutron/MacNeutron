From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Sun, 11 Oct 2026 18:29:45 -0400
Subject: [PATCH] airconv, d3d12: Float atomics on R32_FLOAT typed UAVs through
 an R32Uint view.

Shader Model 6.6's float InterlockedExchange and the two FloatBitwise
compares reach DXIL as i32 atomics on the float's bits. Raw, structured and
groupshared locations already took the integer paths; a typed RWBuffer<float>
or RWTexture*<float> was refused, because Metal's texture atomics take
integer textures only.

A typed UAV with element type F32 that an AtomicBinOp or
AtomicCompareExchange reaches is now declared uint (atomic_view): its handle
comes from the descriptor's third qword instead of the first, its loads and
stores bitcast, and its atomics take the integer path. The DXBC path never
sets it.

The runtime keeps that handle: a texture or texel-buffer UAV of format
R32_FLOAT also creates an R32Uint view of the same subresources (every
D3D12 texture has PixelFormatView usage; an R32Uint buffer view gets
ShaderAtomic usage) and writes its GPU resource ID into the third qword,
atomic_resource_id (padding[0] before). Every other UAV and every SRV writes
0 there; CopyDescriptors copies all 32 bytes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/airconv/dxbc_binding_rootsig.cpp | 16 ++++++++++------
 src/airconv/dxbc_converter.hpp       |  3 +++
 src/airconv/dxil/dxil_initialize.cpp |  9 +++++++--
 src/d3d12/d3d12_buffer.cpp           |  7 ++++++-
 src/d3d12/d3d12_descriptor_heap.cpp  | 21 ++++++++++++++++-----
 src/d3d12/d3d12_descriptor_heap.hpp  | 10 ++++++++--
 src/d3d12/d3d12_texture.cpp          | 10 +++++++++-
 7 files changed, 59 insertions(+), 17 deletions(-)

diff --git a/src/airconv/dxbc_binding_rootsig.cpp b/src/airconv/dxbc_binding_rootsig.cpp
index 8cdd132..f8fe668 100644
--- a/src/airconv/dxbc_binding_rootsig.cpp
+++ b/src/airconv/dxbc_binding_rootsig.cpp
@@ -186,7 +186,7 @@ public:
   std::pair<llvm::Value *, llvm::Value *>
   GetTextureDescriptor(
       llvm::air::AIRBuilder &AIR, llvm::Value *IntPtr, llvm::Value *Index, Texture::ResourceKind Kind, RangeId RangeId,
-      uint32_t DescriptorOffset
+      uint32_t DescriptorOffset, uint32_t HandleField = 0 /* MacNeutron: 2, an atomic_view's R32Uint view */
   ) {
     auto TyTextureHandle = AIR.getTextureHandleType(Kind);
     auto TyTextureDescriptor = llvm::StructType::get(
@@ -198,9 +198,12 @@ public:
     return {
         B.CreateLoad(
             TyTextureHandle, //
-            B.CreateGEP(
-                TyTextureDescriptor, B.CreatePointerCast(IntPtr, TyTextureDescriptor->getPointerTo(2)),
-                {IdxDescriptor, AIR.getInt(0) /* pointer */}
+            B.CreatePointerCast(
+                B.CreateGEP(
+                    TyTextureDescriptor, B.CreatePointerCast(IntPtr, TyTextureDescriptor->getPointerTo(2)),
+                    {IdxDescriptor, AIR.getInt(HandleField) /* pointer */}
+                ),
+                TyTextureHandle->getPointerTo(2)
             )
         ),
         B.CreateLoad(
@@ -269,8 +272,9 @@ public:
     auto MemoryAccess = UAV.written
                             ? (UAV.read ? Texture::MemoryAccess::acesss_readwrite : Texture::MemoryAccess::access_write)
                             : Texture::MemoryAccess::access_read;
-    auto [Handle, Metadata] =
-        GetTextureDescriptor(Builder, HeapPointer, Index, ResourceKind, UAV.range.lower_bound, DescriptorOffset);
+    auto [Handle, Metadata] = GetTextureDescriptor(
+        Builder, HeapPointer, Index, ResourceKind, UAV.range.lower_bound, DescriptorOffset, UAV.atomic_view ? 2 : 0
+    );
     return TextureDescirptor{Handle,       Metadata,  UAV.global_coherent, ResourceKind, ResourceKindLogical,
                              MemoryAccess, SampleType};
   }
diff --git a/src/airconv/dxbc_converter.hpp b/src/airconv/dxbc_converter.hpp
index e0e38af..d863859 100644
--- a/src/airconv/dxbc_converter.hpp
+++ b/src/airconv/dxbc_converter.hpp
@@ -51,6 +51,9 @@ struct UnorderedAccessViewInfo {
   bool global_coherent = false;
   bool rasterizer_order = false;
   bool with_counter = false;
+  // MacNeutron (DXIL): a float typed UAV that atomics reach. Metal's texture atomics take integer textures only, so it's
+  // declared uint and read through the R32Uint view in its descriptor's third qword (d3d12_descriptor_heap.cpp).
+  bool atomic_view = false;
 
   uint32_t structure_stride = 0;
   uint32_t arg_index;
diff --git a/src/airconv/dxil/dxil_initialize.cpp b/src/airconv/dxil/dxil_initialize.cpp
index b3cee5f..8915bc6 100644
--- a/src/airconv/dxil/dxil_initialize.cpp
+++ b/src/airconv/dxil/dxil_initialize.cpp
@@ -122,7 +122,7 @@ llvm::Error RefuseGroupshared64BitAtomics(const llvm::Module &module) {
 }
 
 struct Usage {
-  bool read = false, written = false, sampled = false, compared = false;
+  bool read = false, written = false, sampled = false, compared = false, atomic = false;
 };
 
 // What each resource is used for: airconv's binding maps pick Metal access modes and depth textures from it.
@@ -158,7 +158,7 @@ ScanUsage(const EntryInfo &entry, const llvm::Module &module) {
           u.written = true;
           break;
         case op::AtomicBinOp: case op::AtomicCompareExchange:
-          u.read = u.written = true;
+          u.read = u.written = u.atomic = true;
           break;
         }
       }
@@ -189,6 +189,11 @@ void FillResourceMaps(const EntryInfo &entry, const llvm::Module &module, Shader
       uav.global_coherent = r.globally_coherent;
       uav.rasterizer_order = r.rasterizer_ordered;
       uav.with_counter = r.has_counter;
+      // Float atomics on a typed R32_FLOAT UAV (SM 6.6; spec 3.7) go through an R32Uint view of it: its loads and
+      // stores bitcast (Cast), its atomics take the integer path.
+      uav.atomic_view = u.atomic && r.element_type == ComponentType::F32 && uav.resource_type != ResourceType::NonApplicable;
+      if (uav.atomic_view)
+        uav.scaler_type = ScalerDataType::Uint;
       uav.structure_stride = r.stride;
       uav.arg_index = uav.arg_metadata_index = uav.arg_counter_index = ~0u;
       info.uavMap[r.id] = uav;
diff --git a/src/d3d12/d3d12_buffer.cpp b/src/d3d12/d3d12_buffer.cpp
index f7c778e..9364878 100644
--- a/src/d3d12/d3d12_buffer.cpp
+++ b/src/d3d12/d3d12_buffer.cpp
@@ -249,7 +249,12 @@ public:
     Slice.byteLength = Format.BytesPerTexel * ViewDesc.Buffer.NumElements;
 
     auto view = buffer->createView(view_descriptor);
-    return Heap->AddUnorderedAccessView(Index, buffer.ptr(), view, Slice);
+    // MacNeutron: an R32_FLOAT UAV also carries an R32Uint view, for a shader's float atomics (it gets ShaderAtomic usage).
+    // ponytail: an R32Uint view for every R32_FLOAT UAV, used or not; make it on a shader's first atomic use if view counts ever matter
+    std::optional<BufferViewKey> AtomicView;
+    if (Format.PixelFormat == WMTPixelFormatR32Float)
+      AtomicView = buffer->createView(BufferViewDescriptor{WMTPixelFormatR32Uint});
+    return Heap->AddUnorderedAccessView(Index, buffer.ptr(), view, Slice, AtomicView);
   };
 
   virtual HRESULT STDMETHODCALLTYPE
diff --git a/src/d3d12/d3d12_descriptor_heap.cpp b/src/d3d12/d3d12_descriptor_heap.cpp
index 934d7dc..ad51383 100644
--- a/src/d3d12/d3d12_descriptor_heap.cpp
+++ b/src/d3d12/d3d12_descriptor_heap.cpp
@@ -26,10 +26,13 @@
 
 namespace dxmt {
 
+// atomic_resource_id (MacNeutron): a UAV's R32Uint view, for float atomics on an R32_FLOAT view (airconv's
+// UnorderedAccessViewInfo::atomic_view reads it); 0 for other formats and for SRVs.
 struct SRVTextureGPUStorage {
   uint64_t resource_id;
   uint64_t metadata;
-  uint64_t padding[2];
+  uint64_t atomic_resource_id;
+  uint64_t padding;
 };
 
 using UAVTextureGPUStorage = SRVTextureGPUStorage;
@@ -37,7 +40,8 @@ using UAVTextureGPUStorage = SRVTextureGPUStorage;
 struct UAVTexelBufferGPUStorage {
   uint64_t resource_id;
   uint64_t metadata;
-  uint64_t padding[2];
+  uint64_t atomic_resource_id;
+  uint64_t padding;
 };
 
 using SRVTexelBufferGPUStorage = UAVTexelBufferGPUStorage;
@@ -210,6 +214,7 @@ public:
       auto &gpu_storage = mapped_argument_buffer_[Index];
       gpu_storage.SRVTexture.resource_id = texture_view.gpuResourceID;
       gpu_storage.SRVTexture.metadata = TextureMetadata(Texture->arrayLength(View), ResourceMinLODClamp);
+      gpu_storage.SRVTexture.atomic_resource_id = 0;
     }
     return S_OK;
   }
@@ -230,7 +235,7 @@ public:
   }
 
   virtual HRESULT
-  AddUnorderedAccessView(UINT Index, Texture *Texture, TextureViewKey View) {
+  AddUnorderedAccessView(UINT Index, Texture *Texture, TextureViewKey View, std::optional<TextureViewKey> AtomicView) {
     if (Index >= descriptors_.size())
       return E_INVALIDARG;
     auto &cpu_storage = descriptors_[Index];
@@ -242,12 +247,15 @@ public:
       auto &gpu_storage = mapped_argument_buffer_[Index];
       gpu_storage.UAVTexture.resource_id = texture_view.gpuResourceID;
       gpu_storage.UAVTexture.metadata = TextureMetadata(Texture->arrayLength(View), 0);
+      gpu_storage.UAVTexture.atomic_resource_id = AtomicView ? Texture->view(*AtomicView).gpuResourceID : 0;
     }
     return S_OK;
   }
 
   virtual HRESULT
-  AddUnorderedAccessView(UINT Index, Buffer *UAVBuffer, BufferViewKey View, BufferSlice Slice) {
+  AddUnorderedAccessView(
+      UINT Index, Buffer *UAVBuffer, BufferViewKey View, BufferSlice Slice, std::optional<BufferViewKey> AtomicView
+  ) {
     if (Index >= descriptors_.size())
       return E_INVALIDARG;
     auto &cpu_storage = descriptors_[Index];
@@ -265,6 +273,8 @@ public:
         gpu_storage.UAVTexelBuffer.resource_id = 0;
         gpu_storage.UAVTexelBuffer.metadata = 0;
       }
+      gpu_storage.UAVTexelBuffer.atomic_resource_id =
+          UAVBuffer && AtomicView ? UAVBuffer->view_(*AtomicView).gpu_resource_id : 0;
     }
     return S_OK;
   }
@@ -302,6 +312,7 @@ public:
     cpu_storage.SRVTexelBuffer.view = View;
     if (mapped_argument_buffer_) { 
       auto &gpu_storage = mapped_argument_buffer_[Index];
+      gpu_storage.UAVTexelBuffer.atomic_resource_id = 0;
       if (Buffer) {
         auto &buffer_view = Buffer->view_(View);
         gpu_storage.UAVTexelBuffer.resource_id = buffer_view.gpu_resource_id;
@@ -371,7 +382,7 @@ public:
       if (pDesc->Format == DXGI_FORMAT_UNKNOWN || (pDesc->Buffer.Flags & D3D12_BUFFER_UAV_FLAG_RAW))
         return AddUnorderedAccessView(Index, (Buffer *)nullptr, BufferSlice{}, nullptr, 0);
       auto [buffer, view] = device_->NullTexelBuffer();
-      return AddUnorderedAccessView(Index, buffer, view, BufferSlice{});
+      return AddUnorderedAccessView(Index, buffer, view, BufferSlice{}, std::nullopt);
     }
     descriptors_[Index].type = ShaderVisibleDescriptorType::Null;
     if (mapped_argument_buffer_)
diff --git a/src/d3d12/d3d12_descriptor_heap.hpp b/src/d3d12/d3d12_descriptor_heap.hpp
index 3d8a1f2..8a25275 100644
--- a/src/d3d12/d3d12_descriptor_heap.hpp
+++ b/src/d3d12/d3d12_descriptor_heap.hpp
@@ -21,6 +21,7 @@
 #include "dxmt_buffer.hpp"
 #include "dxmt_texture.hpp"
 #include <cstdint>
+#include <optional>
 
 #if UINTPTR_MAX == 0xffffffffffffffffULL
 #define DXMT_USE_EMBEDDED_HEAP_POINTER
@@ -135,9 +136,14 @@ public:
 
   virtual HRESULT AddConstantBufferView(UINT Index, UINT64 VA, UINT32 SizeInBytes) = 0;
 
-  virtual HRESULT AddUnorderedAccessView(UINT Index, Texture *Texture, TextureViewKey View) = 0;
+  // AtomicView (MacNeutron): an R32Uint view of an R32_FLOAT UAV's subresources, for float atomics; its GPU resource ID
+  // goes in the descriptor's third qword, 0 without one.
+  virtual HRESULT
+  AddUnorderedAccessView(UINT Index, Texture *Texture, TextureViewKey View, std::optional<TextureViewKey> AtomicView) = 0;
 
-  virtual HRESULT AddUnorderedAccessView(UINT Index, Buffer *Buffer, BufferViewKey View, BufferSlice Slice) = 0;
+  virtual HRESULT AddUnorderedAccessView(
+      UINT Index, Buffer *Buffer, BufferViewKey View, BufferSlice Slice, std::optional<BufferViewKey> AtomicView
+  ) = 0;
 
   virtual HRESULT AddUnorderedAccessView(
       UINT Index, Buffer *UAVBuffer, BufferSlice Slice, Buffer *Counter, UINT CounterOffsetInBytes
diff --git a/src/d3d12/d3d12_texture.cpp b/src/d3d12/d3d12_texture.cpp
index 9b239e8..d157355 100644
--- a/src/d3d12/d3d12_texture.cpp
+++ b/src/d3d12/d3d12_texture.cpp
@@ -647,7 +647,15 @@ public:
       return E_INVALIDARG;
     }
 
-    return Heap->AddUnorderedAccessView(Index, texture.ptr(), View);
+    // MacNeutron: an R32_FLOAT UAV also carries an R32Uint view of the same subresources, for a shader's float atomics
+    // (Metal's texture atomics take integer textures only; every D3D12 texture has PixelFormatView usage).
+    // ponytail: an R32Uint view for every R32_FLOAT UAV, used or not; make it on a shader's first atomic use if view counts ever matter
+    std::optional<TextureViewKey> AtomicView;
+    if (view_descriptor.format == WMTPixelFormatR32Float) {
+      view_descriptor.format = WMTPixelFormatR32Uint;
+      AtomicView = texture->createView(view_descriptor);
+    }
+    return Heap->AddUnorderedAccessView(Index, texture.ptr(), View, AtomicView);
   };
 
   virtual HRESULT STDMETHODCALLTYPE
