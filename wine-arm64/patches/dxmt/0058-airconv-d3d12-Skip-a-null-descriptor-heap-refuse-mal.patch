From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Sun, 11 Oct 2026 22:57:11 -0400
Subject: [PATCH] airconv, d3d12: Skip a null descriptor heap; refuse malformed
 WaveSize and f64 wave ops.

Hardening found by the SM 6.8 task reviews:
- SetDescriptorHeaps dereferenced every entry; a null one now binds nothing instead of crashing.
- A WaveSize or WaveSizeRange entry property too short to read was skipped, so the shader ran with no wave-size
  check; it is now refused ("DXIL: malformed WaveSize metadata").
- WaveMatch and WaveMultiPrefixOp on f64 built a bogus simdgroup function name; they are now refused by name
  (unreachable while the device reports no double ops).
- EncodeRootArgument takes its staging as a pointer, not a 66-qword array; Simd() documents that its calls must stay
  non-speculatable, which the 64-bit lock path's election and fences rely on.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/airconv/dxil/dxil_initialize.cpp |  2 ++
 src/airconv/dxil/dxil_lower.cpp      |  6 +++++-
 src/airconv/dxil/dxil_metadata.cpp   | 15 ++++++++++-----
 src/airconv/dxil/dxil_types.hpp      |  3 +++
 src/d3d12/d3d12_command_list.cpp     |  7 ++++---
 5 files changed, 24 insertions(+), 9 deletions(-)

diff --git a/src/airconv/dxil/dxil_initialize.cpp b/src/airconv/dxil/dxil_initialize.cpp
index 8d73e44..ad7cacc 100644
--- a/src/airconv/dxil/dxil_initialize.cpp
+++ b/src/airconv/dxil/dxil_initialize.cpp
@@ -254,6 +254,8 @@ InitializeDXIL(const Container &container, SM50ShaderInternal *shader, MTL_SHADE
   if (!gs_locks)
     return gs_locks.takeError();
   AddHeapRanges(**module, *entry);
+  if (entry->wave_size_min == kMalformedWaveSize)
+    return llvm::make_error<UnsupportedFeature>("DXIL: malformed WaveSize metadata");
   // Apple GPUs run 32-lane SIMD groups (d3d12_device.cpp's WaveLaneCountMin/Max); the preferred size is a hint.
   if (entry->wave_size_min && !(entry->wave_size_min <= 32 && 32 <= entry->wave_size_max))
     return llvm::make_error<UnsupportedFeature>("DXIL: [WaveSize(" + std::to_string(entry->wave_size_min) + ", " +
diff --git a/src/airconv/dxil/dxil_lower.cpp b/src/airconv/dxil/dxil_lower.cpp
index 6efdafd..2df559d 100644
--- a/src/airconv/dxil/dxil_lower.cpp
+++ b/src/airconv/dxil/dxil_lower.cpp
@@ -251,6 +251,8 @@ Lowering::RegisterElementPointer(dxbc::register_file &file, const SignatureEleme
   return ir.CreateGEP(array_ty, file.ptr_int4, {ir.getInt32(0), reg, ir.getInt32(e.start_col + col)});
 }
 
+// A simdgroup function call: convergent, never readnone or speculatable. The 64-bit lock path's election
+// (air.simd_is_first behind a branch) and its fence ordering rely on that: a speculatable call could be hoisted.
 llvm::Value *Simd(llvm::IRBuilder<> &ir, llvm::StringRef name, llvm::Type *ret, llvm::ArrayRef<llvm::Value *> args) {
   auto &context = ir.getContext();
   auto attrs = llvm::AttributeList::get(context, llvm::AttributeList::FunctionIndex,
@@ -690,6 +692,8 @@ Lowering::LowerOther(uint32_t opcode, llvm::CallInst *call) {
     // with their ballot. That first lane always leaves, a NaN too: the loop ends, and D3D's own-lane bit is set.
     auto v = call->getArgOperand(1);
     auto ty = v->getType();
+    if (ty->isDoubleTy()) // no f64 simdgroup functions in Metal (unreachable while DoubleOps is FALSE)
+      return Unsupported(call);
     auto head = call->getParent();
     auto done = head->splitBasicBlock(call);
     auto loop = llvm::BasicBlock::Create(ir.getContext(), "", head->getParent(), done);
@@ -721,7 +725,7 @@ Lowering::LowerOther(uint32_t opcode, llvm::CallInst *call) {
     auto ty = v->getType();
     bool fp = ty->isFloatingPointTy();
     uint32_t kind = ConstantU32(call->getArgOperand(6), ~0u);
-    if (kind > 4 || (fp && kind >= 1 && kind <= 3))
+    if (kind > 4 || (fp && kind >= 1 && kind <= 3) || ty->isDoubleTy())
       return Unsupported(call);
     // The sign operand changes nothing: a sum or a product wraps the same either way.
     using llvm::Instruction;
diff --git a/src/airconv/dxil/dxil_metadata.cpp b/src/airconv/dxil/dxil_metadata.cpp
index 8194b8f..053a529 100644
--- a/src/airconv/dxil/dxil_metadata.cpp
+++ b/src/airconv/dxil/dxil_metadata.cpp
@@ -188,11 +188,16 @@ ReadEntry(const llvm::Module &module) {
         entry.gs_output_topology = Int(n->getOperand(3));
         entry.gs_instances = Int(n->getOperand(4));
       }
-      if (tag == 11 && n && n->getNumOperands() >= 1) // WaveSize: N
-        entry.wave_size_min = entry.wave_size_max = Int(n->getOperand(0));
-      if (tag == 23 && n && n->getNumOperands() >= 2) { // WaveSizeRange: min, max (0: min alone), preferred
-        entry.wave_size_min = Int(n->getOperand(0));
-        entry.wave_size_max = Int(n->getOperand(1)) ? Int(n->getOperand(1)) : entry.wave_size_min;
+      if (tag == 11 || tag == 23) { // WaveSize: N; WaveSizeRange: min, max (0: min alone), preferred
+        if (!n || n->getNumOperands() < (tag == 11 ? 1u : 2u)) { // malformed: refused (InitializeDXIL), not skipped
+          entry.wave_size_min = kMalformedWaveSize;
+          entry.wave_size_max = 0;
+        } else if (tag == 11) {
+          entry.wave_size_min = entry.wave_size_max = Int(n->getOperand(0));
+        } else {
+          entry.wave_size_min = Int(n->getOperand(0));
+          entry.wave_size_max = Int(n->getOperand(1)) ? Int(n->getOperand(1)) : entry.wave_size_min;
+        }
       }
     }
   return entry;
diff --git a/src/airconv/dxil/dxil_types.hpp b/src/airconv/dxil/dxil_types.hpp
index 0feba8c..8f5b661 100644
--- a/src/airconv/dxil/dxil_types.hpp
+++ b/src/airconv/dxil/dxil_types.hpp
@@ -101,6 +101,9 @@ struct Resource {
 // Heap ranges' register space (no root parameter's) and their first range ID (MacNeutron).
 constexpr uint32_t kHeapSpace = ~0u, kHeapRangeBase = 1u << 24;
 
+// EntryInfo::wave_size_min for a WaveSize or WaveSizeRange node too short to read (InitializeDXIL refuses it).
+constexpr uint32_t kMalformedWaveSize = ~0u;
+
 struct EntryInfo {
   ShaderKind kind = ShaderKind::Invalid;
   uint32_t sm_major = 0, sm_minor = 0;
diff --git a/src/d3d12/d3d12_command_list.cpp b/src/d3d12/d3d12_command_list.cpp
index cad2d27..05eed93 100644
--- a/src/d3d12/d3d12_command_list.cpp
+++ b/src/d3d12/d3d12_command_list.cpp
@@ -718,7 +718,7 @@ public:
   };
 
   uint64_t
-  EncodeRootArgument(MTLD3D12RootSignature *pRootSig, uint64_t const pStaging[66], UINT Count = 1) {
+  EncodeRootArgument(MTLD3D12RootSignature *pRootSig, uint64_t const *pStaging, UINT Count = 1) {
     auto [Ptr, Offset] = allocator_->AllocateGPUHeap(sizeof(uint64_t) * pRootSig->UploadQwords * Count, 64);
     for (unsigned i = 0; i < Count; i++)
       memcpy(
@@ -1378,8 +1378,9 @@ public:
     DXMT_STAT_SCOPE("list.SetDescriptorHeaps");
     memset(heap_bases_, 0, sizeof(heap_bases_));
     for (UINT i = 0; i < HeapCount; i++)
-      heap_bases_[Heaps[i]->GetDesc().Type == D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER] =
-          Heaps[i]->GetGPUDescriptorHandleForHeapStart().ptr;
+      if (Heaps[i]) // MacNeutron: a null entry binds nothing (D3D12 leaves it undefined; a crash helps no game)
+        heap_bases_[Heaps[i]->GetDesc().Type == D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER] =
+            Heaps[i]->GetGPUDescriptorHandleForHeapStart().ptr;
     StageHeapBases(rootsig_compute_.ptr(), rootarg_compute_staging_);
     StageHeapBases(rootsig_graphics_.ptr(), rootarg_graphics_staging_);
     dirty_state_.set(DirtyState::ComputeRootArguments, DirtyState::GraphicsRootArguments);
-- 
