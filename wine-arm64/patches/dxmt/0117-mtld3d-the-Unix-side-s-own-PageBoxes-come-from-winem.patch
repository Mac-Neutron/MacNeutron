From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Wed, 21 Oct 2026 14:57:47 -0400
Subject: [PATCH] mtld3d: the Unix side's own PageBoxes come from winemetal's
 allocator in the VM
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The encoder stages upload rows in a PageBox on the Unix side and wraps
it in a no-copy buffer. Only the PE side installed the Unix pages
(PAGES_FROM_UNIX), so in the VM's guest those boxes were plain pages the
host can't map: newBufferWithBytesNoCopy was refused (108 times in
Wine's visual tests), textures stayed empty and the guest's x64 visual
lane failed 401 sites against macOS's 31. The Unix side now installs
alloc_pages/free_pages as its PageBox allocator at the first device
(Linux only; macOS keeps native pages). visual: 401 → 63.

Assisted-by: Claude Code: claude-opus-5-5
---
 mtld3d/unix/unix/src/handlers.rs |  1 +
 mtld3d/unix/unix/src/metal.rs    | 20 ++++++++++++++++++++
 2 files changed, 21 insertions(+)

diff --git a/mtld3d/unix/unix/src/handlers.rs b/mtld3d/unix/unix/src/handlers.rs
index 50b05b6a..1212681d 100644
--- a/mtld3d/unix/unix/src/handlers.rs
+++ b/mtld3d/unix/unix/src/handlers.rs
@@ -293,6 +293,7 @@ pub extern "C" fn create_command_queue_handler(args: *mut c_void) -> i32 {
         return -1;
     };
     let params: &mut CreateCommandQueueParams = &mut params;
+    metal::install_page_allocator();
 
     let gate = if params.gate_file_ptr == 0 || params.gate_file_len == 0 {
         None
diff --git a/mtld3d/unix/unix/src/metal.rs b/mtld3d/unix/unix/src/metal.rs
index 89895049..999a4f29 100644
--- a/mtld3d/unix/unix/src/metal.rs
+++ b/mtld3d/unix/unix/src/metal.rs
@@ -120,3 +120,23 @@ pub fn free_pages(ptr: *mut u8, _len: usize) {
         mtld3d_mtl::memory::free(ptr);
     }
 }
+
+/// The Unix side's own `PageBox`es from `alloc_pages` too, in the VM's guest.
+///
+/// The encoder's staging rows become no-copy buffers, which there must be made over the guest
+/// allocator's memory, the host's mapping; any other page fails (the PE side's boxes take the same
+/// pages through `PAGES_FROM_UNIX`). Set at the first device, before the encoder's first page.
+#[cfg(target_os = "linux")]
+pub fn install_page_allocator() {
+    fn alloc(len: usize) -> Option<core::ptr::NonNull<u8>> {
+        core::ptr::NonNull::new(alloc_pages(len))
+    }
+    fn free(ptr: core::ptr::NonNull<u8>, len: usize) {
+        free_pages(ptr.as_ptr(), len);
+    }
+    mtld3d_core::page_box::set_page_allocator_source(|| Some(mtld3d_core::page_box::PageAllocator { alloc, free }));
+}
+
+/// Native pages on macOS: Metal takes any page-aligned memory there.
+#[cfg(not(target_os = "linux"))]
+pub const fn install_page_allocator() {}
-- 
