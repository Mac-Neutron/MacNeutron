From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Sun, 11 Oct 2026 12:34:16 -0400
Subject: [PATCH] airconv: Lay 2D compute quads out as D3D's 2x2 blocks.

Metal's kernel quads are four consecutive lanes of the threadgroup's flat
index; a D3D compute shader whose numthreads X and Y are both even has 2x2
quads of SV_GroupThreadID instead (Shader Model 6.6 derivatives). Until now its
derivatives, quad reads and votes took a row of four.

When such a shader calls a derivative, an implicit-LOD sample, CalculateLOD or a
quad op (60, 61, 64, 81, 83-86, 122, 123, 222, 255), DXILShader::quads_2d is
set and the compute handler gives Metal thread t the D3D IDs:

  slice = X * Y;  z = t / slice;  r = t % slice;  q = r >> 2;  l = r & 3
  x = 2 * (q % (X / 2)) + (l & 1);  y = 2 * (q / (X / 2)) + (l >> 1)

so Metal's lane quad l is D3D's quad lane l. SV_GroupThreadID is (x, y, z),
SV_GroupIndex D3D's flattening of it, SV_DispatchThreadID SV_GroupID *
numthreads + (x, y, z); the handler always defines the flat index and the
group position for it. Derivatives keep reading Metal's simd lane. 1D groups
and shaders without those ops keep today's IDs.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/airconv/dxil/dxil.hpp            |  4 ++--
 src/airconv/dxil/dxil_initialize.cpp | 10 +++++++-
 src/airconv/dxil/dxil_signature.cpp  | 35 +++++++++++++++++++++++++---
 src/airconv/dxil/dxil_types.hpp      |  3 +++
 4 files changed, 46 insertions(+), 6 deletions(-)

diff --git a/src/airconv/dxil/dxil.hpp b/src/airconv/dxil/dxil.hpp
index e3c1cb1..5c699c9 100644
--- a/src/airconv/dxil/dxil.hpp
+++ b/src/airconv/dxil/dxil.hpp
@@ -53,9 +53,9 @@ bool ModuleCallsOp(const llvm::Module &module, uint32_t opcode);
 llvm::Error InitializeDXIL(const Container &container, dxbc::SM50ShaderInternal *shader, MTL_SHADER_REFLECTION *refl);
 
 // dxil_signature.cpp: pushes the signature handlers (entry point inputs/outputs) for this stage, and fills
-// `unpacked_inputs` (see DXILShader).
+// `unpacked_inputs` (see DXILShader). `quads_2d` (DXILShader's) remaps a compute shader's thread IDs.
 llvm::Error AddSignatureHandlers(const EntryInfo &entry, const llvm::Module &module, dxbc::SM50ShaderInternal *shader,
-                                 std::map<uint32_t, uint32_t> &unpacked_inputs);
+                                 std::map<uint32_t, uint32_t> &unpacked_inputs, bool quads_2d);
 // dxil_signature.cpp: defines the simdgroup lane inputs when the module uses wave operations.
 void AddWaveInputs(const llvm::Module &module, dxbc::SM50ShaderInternal *shader, uint32_t &lane_index_arg, uint32_t &lane_count_arg);
 
diff --git a/src/airconv/dxil/dxil_initialize.cpp b/src/airconv/dxil/dxil_initialize.cpp
index 46c4a65..a8c3168 100644
--- a/src/airconv/dxil/dxil_initialize.cpp
+++ b/src/airconv/dxil/dxil_initialize.cpp
@@ -174,8 +174,15 @@ InitializeDXIL(const Container &container, SM50ShaderInternal *shader, MTL_SHADE
   shader->shader_info.use_msad = ModuleCallsOp(**module, op::Msad);
   shader->shader_info.use_samplepos = ModuleCallsOp(**module, op::Texture2DMSGetSamplePosition) ||
                                       ModuleCallsOp(**module, op::RenderTargetGetSamplePosition);
+  // 2D compute quads (HLSL_SM_6_6_Derivatives.md): numthreads X and Y even (Y = 1 is the 1D layout, Metal's own), in a
+  // shader that takes derivatives, samples with an implicit LOD, calculates a LOD or reads its quad.
+  std::initializer_list<uint32_t> quad_ops = {op::Sample, op::SampleBias, op::SampleCmp, op::CalculateLOD,
+                                              op::DerivCoarseX, op::DerivCoarseY, op::DerivFineX, op::DerivFineY,
+                                              op::QuadReadLaneAt, op::QuadOp, op::QuadVote, op::SampleCmpBias};
+  bool quads_2d = entry->kind == ShaderKind::Compute && entry->numthreads[0] % 2 == 0 && entry->numthreads[1] % 2 == 0 &&
+                  std::any_of(quad_ops.begin(), quad_ops.end(), [&](uint32_t o) { return ModuleCallsOp(**module, o); });
   std::map<uint32_t, uint32_t> unpacked_inputs;
-  if (auto err = AddSignatureHandlers(*entry, **module, shader, unpacked_inputs))
+  if (auto err = AddSignatureHandlers(*entry, **module, shader, unpacked_inputs, quads_2d))
     return err;
   uint32_t lane_index_arg = ~0u, lane_count_arg = ~0u;
   AddWaveInputs(**module, shader, lane_index_arg, lane_count_arg);
@@ -190,6 +197,7 @@ InitializeDXIL(const Container &container, SM50ShaderInternal *shader, MTL_SHADE
   dxil->capture_hash = container.capture_hash;
   dxil->entry = std::move(*entry);
   dxil->unpacked_inputs = std::move(unpacked_inputs);
+  dxil->quads_2d = quads_2d;
   dxil->lane_index_arg = lane_index_arg;
   dxil->lane_count_arg = lane_count_arg;
   shader->dxil = dxil;
diff --git a/src/airconv/dxil/dxil_signature.cpp b/src/airconv/dxil/dxil_signature.cpp
index 314b88c..0e77e7c 100644
--- a/src/airconv/dxil/dxil_signature.cpp
+++ b/src/airconv/dxil/dxil_signature.cpp
@@ -19,6 +19,7 @@
 #include "../airconv_error.hpp"
 #include "../dxbc_converter.hpp"
 #include <algorithm>
+#include <array>
 
 // Entry-point inputs and outputs for DXIL shaders, built from the entry's signature metadata with airconv's IO helpers
 // (as dxbc_signature.cpp builds them from DXBC dcl_* instructions). Elements live in airconv's register file at
@@ -130,7 +131,35 @@ void Grow(uint32_t &max_register, const SignatureElement &e) {
 }
 
 llvm::Error
-AddComputeHandlers(const llvm::Module &module, SM50ShaderInternal *shader) {
+AddComputeHandlers(const EntryInfo &entry, const llvm::Module &module, SM50ShaderInternal *shader, bool quads_2d) {
+  if (quads_2d) {
+    // Metal's quads are four consecutive lanes, t & ~3 .. t | 3 of its flat thread index t; D3D's 2D quads are 2x2
+    // blocks of SV_GroupThreadID. Metal thread t runs D3D's thread (x, y, z), quad lane l = t & 3 at (l & 1, l >> 1) of
+    // the block, so derivatives and quad reads see D3D's quad. SV_GroupIndex stays D3D's flattening of (x, y, z).
+    auto t = shader->func_signature.DefineInput(air::InputThreadIndexInThreadgroup{});
+    auto group = shader->func_signature.DefineInput(air::InputThreadgroupPositionInGrid{});
+    std::array<uint32_t, 3> n = {entry.numthreads[0], entry.numthreads[1], entry.numthreads[2]};
+    shader->signature_handlers.push_back([=](SignatureContext &sig) {
+      sig.prologue << make_effect([=](struct context ctx) {
+        auto &b = ctx.builder;
+        llvm::Value *flat = ctx.function->getArg(t), *slice = b.getInt32(n[0] * n[1]), *half = b.getInt32(n[0] / 2);
+        auto z = b.CreateUDiv(flat, slice), r = b.CreateURem(flat, slice);
+        auto q = b.CreateLShr(r, 2), l = b.CreateAnd(r, 3);
+        auto x = b.CreateAdd(b.CreateShl(b.CreateURem(q, half), 1), b.CreateAnd(l, 1));
+        auto y = b.CreateAdd(b.CreateShl(b.CreateUDiv(q, half), 1), b.CreateLShr(l, 1));
+        llvm::Value *id = llvm::UndefValue::get(llvm::FixedVectorType::get(b.getInt32Ty(), 3));
+        id = b.CreateInsertElement(b.CreateInsertElement(b.CreateInsertElement(id, x, (uint64_t)0), y, 1), z, 2);
+        auto group_id = ctx.function->getArg(group);
+        ctx.resource.thread_group_id_arg = group_id;
+        ctx.resource.thread_id_in_group_arg = id;
+        ctx.resource.thread_id_in_group_flat_arg =
+            b.CreateAdd(b.CreateMul(z, slice), b.CreateAdd(b.CreateMul(y, b.getInt32(n[0])), x));
+        ctx.resource.thread_id_arg = b.CreateAdd(b.CreateMul(group_id, llvm::ConstantDataVector::get(ctx.llvm, n)), id);
+        return std::monostate{};
+      });
+    });
+    return llvm::Error::success();
+  }
   // Compute IDs aren't signature elements in DXIL: define the inputs the module's dx.op calls read.
   if (ModuleCallsOp(module, op::ThreadId))
     DefineSpecial<air::InputThreadPositionInGrid>(shader, &io_binding_map::thread_id_arg);
@@ -425,9 +454,9 @@ AddWaveInputs(const llvm::Module &module, SM50ShaderInternal *shader, uint32_t &
 
 llvm::Error
 AddSignatureHandlers(const EntryInfo &entry, const llvm::Module &module, SM50ShaderInternal *shader,
-                     std::map<uint32_t, uint32_t> &unpacked_inputs) {
+                     std::map<uint32_t, uint32_t> &unpacked_inputs, bool quads_2d) {
   switch (entry.kind) {
-  case ShaderKind::Compute: return AddComputeHandlers(module, shader);
+  case ShaderKind::Compute: return AddComputeHandlers(entry, module, shader, quads_2d);
   case ShaderKind::Vertex: return AddVertexHandlers(entry, shader, unpacked_inputs);
   case ShaderKind::Pixel: return AddPixelHandlers(entry, shader, unpacked_inputs);
   case ShaderKind::Geometry: return AddGeometryHandlers(entry, shader);
diff --git a/src/airconv/dxil/dxil_types.hpp b/src/airconv/dxil/dxil_types.hpp
index ee31956..4a5b8dd 100644
--- a/src/airconv/dxil/dxil_types.hpp
+++ b/src/airconv/dxil/dxil_types.hpp
@@ -125,6 +125,9 @@ struct DXILShader {
   // The entry has [WaveOpsIncludeHelperLanes] ("waveops-include-helper-lanes"): a pixel shader's wave operations count
   // its helper lanes, which D3D otherwise leaves out (MacNeutron).
   bool include_helper_lanes = false;
+  // A compute shader with 2D numthreads (X and Y even) that reads quads (InitializeDXIL): its thread IDs are remapped
+  // so that Metal's lane quads run D3D's 2x2 quads (AddComputeHandlers) (MacNeutron).
+  bool quads_2d = false;
   uint64_t capture_hash = 0; // FNV-1a of the whole container, as capture mode names the shader (MacNeutron)
 };
 
