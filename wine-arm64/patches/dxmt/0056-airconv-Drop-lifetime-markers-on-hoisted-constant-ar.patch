From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Sun, 11 Oct 2026 21:38:14 -0400
Subject: [PATCH] airconv: Drop lifetime markers on hoisted constant arrays.

DXC hoists a local array that only ever holds constants to a global (<name>.hca) and, for Shader Model 6.6 and
later, keeps the array's llvm.lifetime.start/end markers on it. MoveConstantsToConstantSpace refused any user of
such a global other than GEPs, bitcasts and loads, so the shader failed with "a static const array used other
than by loads" (Palworld: two vertex shaders using NeighborOffset; starting a new game crashed). The markers mean
nothing on a constant: drop them, and the bitcast that only fed them.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/airconv/dxil/dxil_converter.cpp | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/airconv/dxil/dxil_converter.cpp b/src/airconv/dxil/dxil_converter.cpp
index b89726e..a9d0a49 100644
--- a/src/airconv/dxil/dxil_converter.cpp
+++ b/src/airconv/dxil/dxil_converter.cpp
@@ -20,6 +20,7 @@
 #include "../airconv_error.hpp"
 #include "llvm/IR/IRBuilder.h"
 #include "llvm/IR/Instructions.h"
+#include "llvm/IR/IntrinsicInst.h"
 #include "llvm/IR/ModuleSlotTracker.h"
 #include "llvm/IR/Verifier.h"
 #include "llvm/Support/raw_ostream.h"
@@ -77,8 +78,14 @@ llvm::Error Retarget(llvm::Value *from, llvm::Value *to) {
       if (auto err = Retarget(cast, moved))
         return err;
       cast->eraseFromParent();
+      if (moved->use_empty()) // it only fed lifetime markers
+        moved->eraseFromParent();
     } else if (auto load = llvm::dyn_cast<llvm::LoadInst>(user)) {
       load->setOperand(load->getPointerOperandIndex(), to);
+    } else if (auto marker = llvm::dyn_cast<llvm::IntrinsicInst>(user); marker && marker->isLifetimeStartOrEnd()) {
+      // DXC hoists a local array of constants to a global (<name>.hca) and keeps the array's lifetime markers on it
+      // (Palworld's NeighborOffset, SM 6.6): they mean nothing on a constant.
+      marker->eraseFromParent();
     } else {
       return llvm::make_error<UnsupportedFeature>("DXIL: a static const array used other than by loads");
     }
