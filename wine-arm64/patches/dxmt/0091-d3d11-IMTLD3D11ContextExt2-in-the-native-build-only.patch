From edb0d919f286a0ebd817ba2a03606bc40b2e9428 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Sun, 18 Oct 2026 19:54:35 -0400
Subject: [PATCH] d3d11: IMTLD3D11ContextExt2 in the native build only.

A VM host's pieces interface (0089) was answered by the Windows build
too, where nothing asks for it.

Assisted-by: Claude Code: claude-opus-5-5
---
 src/d3d11/d3d11_context_impl.cpp | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/src/d3d11/d3d11_context_impl.cpp b/src/d3d11/d3d11_context_impl.cpp
index 0ac5d52..43314f7 100644
--- a/src/d3d11/d3d11_context_impl.cpp
+++ b/src/d3d11/d3d11_context_impl.cpp
@@ -645,12 +645,19 @@ public:
       return S_OK;
     }
 
-    if (riid == __uuidof(IMTLD3D11ContextExt) || riid == __uuidof(IMTLD3D11ContextExt1) ||
-        riid == __uuidof(IMTLD3D11ContextExt2)) {
+    if (riid == __uuidof(IMTLD3D11ContextExt) || riid == __uuidof(IMTLD3D11ContextExt1)) {
       *ppvObject = ref(&ext_);
       return S_OK;
     }
 
+#ifndef _WIN32
+    // MacNeutron: a VM host's pieces (IMTLD3D11ContextExt2), the native build's only.
+    if (riid == __uuidof(IMTLD3D11ContextExt2)) {
+      *ppvObject = ref(&ext_);
+      return S_OK;
+    }
+#endif
+
     if (riid == __uuidof(ID3DUserDefinedAnnotation)) {
       *ppvObject = ref(&annotation_);
       return S_OK;
-- 
