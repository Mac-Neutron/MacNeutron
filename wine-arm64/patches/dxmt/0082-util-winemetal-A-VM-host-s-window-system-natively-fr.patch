From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Sun, 18 Oct 2026 08:06:11 -0400
Subject: [PATCH] util, winemetal: A VM host's window system, natively, from
 its guest.

Natively the window system was headless (every window 1024x1024, no
monitor). A VM host now hooks it (WMTSetWsiHooks, in winemetal so the
dylibs share one): a window's size, monitor, minimised and foreground
state, the displays, their names, desktop rectangles and modes, all as its
guest last told it. With hooks set, the window's own changes are the
guest's: the actions succeed and do nothing, and a minimised window's
present takes no 60 Hz sleep (the guest sleeps for it).

Assisted-by: Claude Code: claude-opus-5-5
---
 src/d3d12/d3d12_swapchain.cpp       |  5 ++++
 src/util/meson.build                |  3 +-
 src/util/wsi_monitor_headless.cpp   | 45 +++++++++++++++++++++++++----
 src/util/wsi_window_headless.cpp    | 42 ++++++++++++++++++++-------
 src/winemetal/unix/winemetal_unix.c | 12 ++++++++
 src/winemetal/winemetal.h           | 14 +++++++++
 6 files changed, 104 insertions(+), 17 deletions(-)

diff --git a/src/d3d12/d3d12_swapchain.cpp b/src/d3d12/d3d12_swapchain.cpp
index 3e9fd36..4170912 100644
--- a/src/d3d12/d3d12_swapchain.cpp
+++ b/src/d3d12/d3d12_swapchain.cpp
@@ -791,7 +791,12 @@ public:
       ReleaseSemaphore(present_semaphore_, 1, nullptr);
       presentation_count_ += 1;
       StatsFrame();  // still a frame: DXMT_STATS's per-frame figures and its 5 s reports go on
+#ifdef _WIN32
       Sleep(16);
+#else
+      if (!WMTGetWsiHooks()) // a VM host's guest sleeps for itself (its Present): never on the host's vCPU thread
+        Sleep(16);
+#endif
       return hr;
     }
 
diff --git a/src/util/meson.build b/src/util/meson.build
index 93dd7bc..b8cfdf5 100644
--- a/src/util/meson.build
+++ b/src/util/meson.build
@@ -38,8 +38,9 @@ else
   ])
 endif
 
+# MacNeutron: natively, the window system asks winemetal for a VM host's hooks (WMTGetWsiHooks).
 util_lib = static_library('util', util_src,
-  include_directories : [ dxmt_include_path ],
+  include_directories : [ dxmt_include_path ] + (dxmt_crossbuild ? [] : [ include_directories('../winemetal') ]),
 )
 
 util_dep = declare_dependency(
diff --git a/src/util/wsi_monitor_headless.cpp b/src/util/wsi_monitor_headless.cpp
index 2aaa61c..ab18eec 100644
--- a/src/util/wsi_monitor_headless.cpp
+++ b/src/util/wsi_monitor_headless.cpp
@@ -9,28 +9,61 @@
  */
 
 #include "wsi_monitor.hpp"
+#include "winemetal.h"
 
 namespace dxmt::wsi {
 
+// MacNeutron: a VM host's displays (WMTSetWsiHooks), its guest's; else none.
+static bool hookedDisplay(uint32_t index, WMTWsiDisplay *pDisplay) {
+  const WMTWsiHooks *hooks = WMTGetWsiHooks();
+  return hooks && hooks->display(index, pDisplay);
+}
+
+static bool displayOf(HMONITOR hMonitor, WMTWsiDisplay *pDisplay) {
+  for (uint32_t i = 0; hookedDisplay(i, pDisplay); i++)
+    if (pDisplay->monitor == (uint64_t)(uintptr_t)hMonitor)
+      return true;
+  return false;
+}
+
 HMONITOR getDefaultMonitor() {
-  return nullptr;
+  WMTWsiDisplay d;
+  return hookedDisplay(0, &d) ? (HMONITOR)(uintptr_t)d.monitor : nullptr;
 }
 
 HMONITOR enumMonitors(uint32_t index) {
-  return nullptr;
+  WMTWsiDisplay d;
+  return hookedDisplay(index, &d) ? (HMONITOR)(uintptr_t)d.monitor : nullptr;
 }
 
 bool getDisplayName(HMONITOR hMonitor, WCHAR (&Name)[32]) {
-  return false;
+  WMTWsiDisplay d;
+  if (!displayOf(hMonitor, &d))
+    return false;
+  for (uint32_t i = 0; i < 32; i++)
+    Name[i] = d.name[i]; // UTF-16 to the native WCHAR: a display's name is ASCII
+  Name[31] = 0;
+  return true;
 }
 
 bool getDesktopCoordinates(HMONITOR hMonitor, RECT *pRect) {
-  return false;
+  WMTWsiDisplay d;
+  if (!displayOf(hMonitor, &d))
+    return false;
+  *pRect = {d.left, d.top, d.right, d.bottom};
+  return true;
 }
 
+// The current mode is the hooks' first, EnumDisplaySettings' list after it; the registry's is the current one.
 static inline bool retrieveDisplayMode(HMONITOR hMonitor, DWORD modeNumber,
                                        WsiMode *pMode) {
-  return false;
+  const WMTWsiHooks *hooks = WMTGetWsiHooks();
+  uint32_t index = modeNumber == ENUM_CURRENT_SETTINGS || modeNumber == ENUM_REGISTRY_SETTINGS ? 0 : modeNumber + 1;
+  WMTWsiMode m;
+  if (!hooks || !hooks->mode((uint64_t)(uintptr_t)hMonitor, index, &m))
+    return false;
+  *pMode = {m.width, m.height, {m.refresh_num, m.refresh_den}, 32, false};
+  return true;
 }
 
 bool getDisplayMode(HMONITOR hMonitor, uint32_t modeNumber, WsiMode *pMode) {
@@ -45,4 +78,4 @@ bool getDesktopDisplayMode(HMONITOR hMonitor, WsiMode *pMode) {
   return retrieveDisplayMode(hMonitor, ENUM_REGISTRY_SETTINGS, pMode);
 }
 
-} // namespace dxmt::wsi
\ No newline at end of file
+} // namespace dxmt::wsi
diff --git a/src/util/wsi_window_headless.cpp b/src/util/wsi_window_headless.cpp
index 2d96260..44e0121 100644
--- a/src/util/wsi_window_headless.cpp
+++ b/src/util/wsi_window_headless.cpp
@@ -13,15 +13,27 @@
 
 #include "util_string.hpp"
 #include "log/log.hpp"
+#include "winemetal.h"
 
 namespace dxmt::wsi {
 
+// MacNeutron: a VM host's window system (WMTSetWsiHooks), from what its guest last said; else headless. The window's
+// own changes are the guest's, so the actions only succeed.
+static bool hooked() { return WMTGetWsiHooks() != nullptr; }
+
+static bool hookedWindow(HWND hWindow, WMTWsiWindow *pWindow) {
+  const WMTWsiHooks *hooks = WMTGetWsiHooks();
+  return hooks && hooks->window((uint64_t)(uintptr_t)hWindow, pWindow);
+}
+
 void getWindowSize(HWND hWindow, uint32_t *pWidth, uint32_t *pHeight) {
+  WMTWsiWindow w = {0, 1024, 1024, 0};
+  hookedWindow(hWindow, &w);
   if (pWidth)
-    *pWidth = 1024;
+    *pWidth = w.width;
 
   if (pHeight)
-    *pHeight = 1024;
+    *pHeight = w.height;
 }
 
 void resizeWindow(HWND hWindow, DXMTWindowState *pState, uint32_t width,
@@ -29,7 +41,7 @@ void resizeWindow(HWND hWindow, DXMTWindowState *pState, uint32_t width,
 }
 
 bool setWindowMode(HMONITOR hMonitor, HWND hWindow, const WsiMode &mode) {
-  return false;
+  return hooked();
 }
 
 void saveWindowState(HWND hWindow, DXMTWindowState *pState) {
@@ -38,31 +50,41 @@ void saveWindowState(HWND hWindow, DXMTWindowState *pState) {
 bool enterFullscreenMode(HMONITOR hMonitor, HWND hWindow,
                          DXMTWindowState *pState,
                          [[maybe_unused]] bool modeSwitch) {
-  return false;
+  return hooked();
 }
 
 bool leaveFullscreenMode(HWND hWindow, DXMTWindowState *pState,
                          bool restoreCoordinates) {
-  return false;
+  return hooked();
 }
 
 bool restoreDisplayMode(HMONITOR hMonitor) {
-  return false;
+  return hooked();
 }
 
 HMONITOR getWindowMonitor(HWND hWindow) {
-  return 0;
+  WMTWsiWindow w = {};
+  return hookedWindow(hWindow, &w) ? (HMONITOR)(uintptr_t)w.monitor : 0;
 }
 
-bool isWindow(HWND hWindow) { return true; }
+bool isWindow(HWND hWindow) {
+  WMTWsiWindow w = {};
+  return hookedWindow(hWindow, &w) ? (w.flags & 4) != 0 : true;
+}
 
 void updateFullscreenWindow(HMONITOR hMonitor, HWND hWindow,
                             bool forceTopmost) {
 }
 
-bool isForeground(HWND hWindow) { return true; }
+bool isForeground(HWND hWindow) {
+  WMTWsiWindow w = {};
+  return hookedWindow(hWindow, &w) ? (w.flags & 2) != 0 : true;
+}
 
-bool isMinimized(HWND hWindow) { return false; }
+bool isMinimized(HWND hWindow) {
+  WMTWsiWindow w = {};
+  return hookedWindow(hWindow, &w) && (w.flags & 1) != 0;
+}
 
 bool isProcessForeground() { return true; }
 
diff --git a/src/winemetal/unix/winemetal_unix.c b/src/winemetal/unix/winemetal_unix.c
index 928a946..13dd2cb 100644
--- a/src/winemetal/unix/winemetal_unix.c
+++ b/src/winemetal/unix/winemetal_unix.c
@@ -1391,6 +1391,18 @@ WMTSetPresentHook(void (*hook)(void *cmdbuf, void *drawable)) {
   present_hook = hook;
 }
 #define PRESENT_HOOK(cmdbuf, drawable) (present_hook ? present_hook((void *)(cmdbuf), (void *)(drawable)) : (void)0)
+
+static const struct WMTWsiHooks *wsi_hooks;
+
+__attribute__((visibility("default"))) void
+WMTSetWsiHooks(const struct WMTWsiHooks *hooks) {
+  wsi_hooks = hooks;
+}
+
+__attribute__((visibility("default"))) const struct WMTWsiHooks *
+WMTGetWsiHooks(void) {
+  return wsi_hooks;
+}
 #else
 #define PRESENT_HOOK(cmdbuf, drawable) ((void)0)
 #endif
diff --git a/src/winemetal/winemetal.h b/src/winemetal/winemetal.h
index 2414483..5f59b23 100644
--- a/src/winemetal/winemetal.h
+++ b/src/winemetal/winemetal.h
@@ -2265,6 +2265,20 @@ WINEMETAL_API void WMTSetPresentHook(void (*hook)(void *cmdbuf, void *drawable))
 #if defined(DXMT_NATIVE) || !defined(_WIN32)
 /* Whether they are set: then a CPU-visible D3D12 heap is DXMT's own over one buffer of theirs (d3d12_heap.cpp). */
 WINEMETAL_API int WMTMemoryHooked(void);
+/* MacNeutron, the native build: the window system a VM host answers for its guest (Direct3D forwarding), from what the
+ * guest last told it; set before any device. Unset, the native build's window system is headless. window: a window's
+ * state (flags: 1 minimised, 2 foreground, 4 a window), 1, or 0 for one it doesn't know; display: the index-th display,
+ * 1, or 0 past the last; mode: a display's index-th mode, 0 the current one, 1, or 0 past the last. */
+struct WMTWsiWindow { uint64_t monitor; uint32_t width, height, flags; };
+struct WMTWsiDisplay { uint64_t monitor; int32_t left, top, right, bottom; uint16_t name[32]; };
+struct WMTWsiMode { uint32_t width, height, refresh_num, refresh_den; };
+struct WMTWsiHooks {
+  int (*window)(uint64_t hwnd, struct WMTWsiWindow *out);
+  int (*display)(uint32_t index, struct WMTWsiDisplay *out);
+  int (*mode)(uint64_t monitor, uint32_t index, struct WMTWsiMode *out);
+};
+WINEMETAL_API void WMTSetWsiHooks(const struct WMTWsiHooks *hooks);
+WINEMETAL_API const struct WMTWsiHooks *WMTGetWsiHooks(void); /* NULL: none */
 #endif
 
 #endif
\ No newline at end of file
