From 2e9c75667320c3299779487be2cc8c795349c239 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Sat, 17 Oct 2026 23:49:08 -0400
Subject: [PATCH] dxgi: The adapter's description in the native build's WCHAR.

The native build's WCHAR is wchar_t, 4 bytes: Metal's device name went
in as UTF-16 (two units a WCHAR, garbage as text). UTF-32 there, UTF-16
in the PE build as before.

Assisted-by: Claude Code: claude-opus-5-5
---
 src/dxgi/dxgi_adapter.cpp | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/dxgi/dxgi_adapter.cpp b/src/dxgi/dxgi_adapter.cpp
index abccc65..a0c2068 100644
--- a/src/dxgi/dxgi_adapter.cpp
+++ b/src/dxgi/dxgi_adapter.cpp
@@ -153,7 +153,10 @@ public:
           sizeof(pDesc->Description) / sizeof(pDesc->Description[0]) - 1,
           options_.customDeviceDesc.c_str(), options_.customDeviceDesc.size());
     } else {
-      device_.name().getCString((char *)pDesc->Description, sizeof(pDesc->Description), WMTUTF16StringEncoding);
+      // MacNeutron: the native build's WCHAR is wchar_t, 4 bytes: UTF-32 there, UTF-16 in the PE build.
+      device_.name().getCString((char *)pDesc->Description, sizeof(pDesc->Description),
+                                sizeof(pDesc->Description[0]) == 4 ? WMTUTF32LittleEndianStringEncoding
+                                                                    : WMTUTF16StringEncoding);
     }
 
     if (options_.customVendorId >= 0) {
-- 
