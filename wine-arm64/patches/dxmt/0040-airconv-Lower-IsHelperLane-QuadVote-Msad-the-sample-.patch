diff --git a/src/airconv/dxbc_converter.cpp b/src/airconv/dxbc_converter.cpp
index 0073a7e..5bd7fd0 100644
--- a/src/airconv/dxbc_converter.cpp
+++ b/src/airconv/dxbc_converter.cpp
@@ -1369,6 +1369,18 @@ AIRCONV_API void SM50Destroy(sm50_shader_t pShader) {
   delete (dxmt::dxbc::SM50ShaderInternal *)pShader;
 }
 
+// Links airconv's Metal helpers (msad, sample positions) a module calls. A DXIL module (`dxil`: its stage) keeps the
+// DXIL float policy in them too: Metal compiled them with fast math. (MacNeutron)
+static void
+LinkHelpers(llvm::Module &M, bool msad, bool samplepos, std::optional<dxmt::dxil::ShaderKind> dxil) {
+  if (msad)
+    dxmt::linkMSAD(M);
+  if (samplepos)
+    dxmt::linkSamplePos(M);
+  if (dxil && (msad || samplepos))
+    dxmt::dxil::StripFastMath(M, *dxil);
+}
+
 AIRCONV_API int SM50Compile(
   sm50_shader_t pShader, SM50_SHADER_COMPILATION_ARGUMENT_DATA *pArgs,
   const char *FunctionName, sm50_bitcode_t *ppBitcode, sm50_error_t *ppError
@@ -1415,10 +1427,9 @@ AIRCONV_API int SM50Compile(
     return 1;
   }
 
-  if (shader_info.use_msad)
-    linkMSAD(*pModule);
-  if (shader_info.use_samplepos)
-    linkSamplePos(*pModule);
+  auto &dxil_shader = ((dxmt::dxbc::SM50ShaderInternal *)pShader)->dxil;
+  LinkHelpers(*pModule, shader_info.use_msad, shader_info.use_samplepos,
+              dxil_shader ? std::optional(dxil_shader->entry.kind) : std::nullopt);
 
   runOptimizationPasses(*pModule);
 
@@ -1647,10 +1658,13 @@ AIRCONV_API int SM50CompileGeometryPipelineVertex(
     return 1;
   }
 
-  if (shader_info.use_msad)
-    linkMSAD(*pModule);
-  if (shader_info.use_samplepos)
-    linkSamplePos(*pModule);
+  // The object function runs the vertex shader, so a DXIL pipeline links its helpers too (D3D11 links the geometry
+  // shader's only, as upstream). (MacNeutron)
+  auto vs = (dxbc::SM50ShaderInternal *)pVertexShader;
+  bool dxil_pipeline = vs->dxil || ((dxbc::SM50ShaderInternal *)pGeometryShader)->dxil;
+  LinkHelpers(*pModule, shader_info.use_msad || (dxil_pipeline && vs->shader_info.use_msad),
+              shader_info.use_samplepos || (dxil_pipeline && vs->shader_info.use_samplepos),
+              dxil_pipeline ? std::optional(dxmt::dxil::ShaderKind::Geometry) : std::nullopt);
 
   runOptimizationPasses(*pModule);
 
@@ -1722,10 +1736,11 @@ AIRCONV_API int SM50CompileGeometryPipelineGeometry(
     return 1;
   }
 
-  if (shader_info.use_msad)
-    linkMSAD(*pModule);
-  if (shader_info.use_samplepos)
-    linkSamplePos(*pModule);
+  // The mesh function runs the geometry shader alone: its helpers are the ones to link.
+  LinkHelpers(*pModule, shader_info.use_msad, shader_info.use_samplepos,
+              ((dxbc::SM50ShaderInternal *)pVertexShader)->dxil || ((dxbc::SM50ShaderInternal *)pGeometryShader)->dxil
+                  ? std::optional(dxmt::dxil::ShaderKind::Geometry)
+                  : std::nullopt);
   
   runOptimizationPasses(*pModule);
 
diff --git a/src/airconv/dxil/dxil.hpp b/src/airconv/dxil/dxil.hpp
index 745f9a1..e3c1cb1 100644
--- a/src/airconv/dxil/dxil.hpp
+++ b/src/airconv/dxil/dxil.hpp
@@ -73,6 +73,12 @@ llvm::Expected<std::unique_ptr<llvm::Module>> ConvertDXILGeometryPipeline(
     SM50_SHADER_COMPILATION_ARGUMENT_DATA *pArgs
 );
 
+// dxil_converter.cpp: applies the DXIL float policy (no NaN or infinity assumed away; no reassociation, contraction
+// or reciprocals before the rasterizer) to every function defined in `module`, and drops their fast-math function
+// attributes. SM50Compile runs it after linking airconv's Metal helpers (msad, sample positions), which Metal compiled
+// with fast math.
+void StripFastMath(llvm::Module &module, ShaderKind kind);
+
 // dxil_converter.cpp: SM50Compile's DXIL branch; returns the AIR module, ready for airconv's passes.
 llvm::Expected<std::unique_ptr<llvm::Module>> ConvertDXIL(
     dxbc::SM50ShaderInternal *shader, const char *name, llvm::LLVMContext &context,
diff --git a/src/airconv/dxil/dxil_converter.cpp b/src/airconv/dxil/dxil_converter.cpp
index 1910442..1a59519 100644
--- a/src/airconv/dxil/dxil_converter.cpp
+++ b/src/airconv/dxil/dxil_converter.cpp
@@ -218,6 +218,32 @@ ApplyProbe(const DXILShader &dxil, llvm::Function &main) {
       }
 }
 
+// DXC marks most float math `fast`. D3D keeps NaN and infinity, so no stage assumes them away, and compares keep no
+// fast flag at all (Metal's compiler treats any as leave to ignore NaN: (x < y) || (x >= y) came out true for a NaN).
+// As airconv's DXBC path (Converter::UseFastMath), pre-raster stages neither reassociate, fuse nor use reciprocals,
+// so a depth prepass and a base pass compute the same positions (their depth EQUAL test holds). (MacNeutron)
+// A non-precise FMad still becomes air.fma there (Lowering): an explicit fma is the same in every shader the same
+// DXIL is lowered into, whatever Metal's compiler would contract.
+bool
+PreRaster(ShaderKind kind) {
+  return kind == ShaderKind::Vertex || kind == ShaderKind::Geometry || kind == ShaderKind::Hull || kind == ShaderKind::Domain;
+}
+
+void
+StripFastMath(llvm::Instruction &inst, bool pre_raster) {
+  if (llvm::isa<llvm::FCmpInst>(&inst)) {
+    inst.copyFastMathFlags(llvm::FastMathFlags());
+  } else if (llvm::isa<llvm::FPMathOperator>(&inst)) {
+    inst.setHasNoNaNs(false);
+    inst.setHasNoInfs(false);
+    if (pre_raster) {
+      inst.setHasAllowReassoc(false);
+      inst.setHasAllowContract(false);
+      inst.setHasAllowReciprocal(false);
+    }
+  }
+}
+
 // Moves the DXIL entry's blocks to the end of the function being built, turns its returns into branches to
 // `epilogue`, lowers every dx.op call, and returns the block that enters the body. The insertion point is kept (the
 // caller branches to the body from where its prologue ended; the prologue may have added blocks, e.g. vertex pulls).
@@ -232,31 +258,14 @@ LowerBody(const DXILShader &dxil, struct context &ctx, llvm::Function *dxil_main
     blocks.push_back(&bb);
   ctx.function->getBasicBlockList().splice(ctx.function->end(), dxil_main->getBasicBlockList());
   std::vector<llvm::CallInst *> calls; // collected first: lowering erases them
-  // DXC marks most float math `fast`. D3D keeps NaN and infinity, so no stage assumes them away, and compares keep no
-  // fast flag at all (Metal's compiler treats any as leave to ignore NaN: (x < y) || (x >= y) came out true for a NaN).
-  // As airconv's DXBC path (Converter::UseFastMath), pre-raster stages neither reassociate, fuse nor use reciprocals,
-  // so a depth prepass and a base pass compute the same positions (their depth EQUAL test holds). (MacNeutron)
-  // A non-precise FMad still becomes air.fma there (Lowering): an explicit fma is the same in every shader the same
-  // DXIL is lowered into, whatever Metal's compiler would contract.
-  bool pre_raster = dxil.entry.kind == ShaderKind::Vertex || dxil.entry.kind == ShaderKind::Geometry ||
-                    dxil.entry.kind == ShaderKind::Hull || dxil.entry.kind == ShaderKind::Domain;
+  bool pre_raster = PreRaster(dxil.entry.kind);
   for (auto *bb : blocks) {
     if (auto ret = llvm::dyn_cast_or_null<llvm::ReturnInst>(bb->getTerminator())) {
       llvm::BranchInst::Create(epilogue, ret);
       ret->eraseFromParent();
     }
     for (auto &inst : *bb) {
-      if (llvm::isa<llvm::FCmpInst>(&inst)) {
-        inst.copyFastMathFlags(llvm::FastMathFlags());
-      } else if (llvm::isa<llvm::FPMathOperator>(&inst)) {
-        inst.setHasNoNaNs(false);
-        inst.setHasNoInfs(false);
-        if (pre_raster) {
-          inst.setHasAllowReassoc(false);
-          inst.setHasAllowContract(false);
-          inst.setHasAllowReciprocal(false);
-        }
-      }
+      StripFastMath(inst, pre_raster);
       if (auto call = llvm::dyn_cast<llvm::CallInst>(&inst); call && OpCode(*call) != ~0u)
         calls.push_back(call);
     }
@@ -290,6 +299,21 @@ llvm::Error Finish(llvm::Module &module, llvm::Function *dxil_main) {
 
 } // namespace
 
+void
+StripFastMath(llvm::Module &module, ShaderKind kind) {
+  for (auto &fn : module) {
+    if (fn.isDeclaration())
+      continue;
+    // The function-level fast math Metal's compiler gives the helpers, which would allow what the flags no longer do.
+    for (auto attr :
+         {"unsafe-fp-math", "no-nans-fp-math", "no-infs-fp-math", "no-signed-zeros-fp-math", "approx-func-fp-math"})
+      fn.removeFnAttr(attr);
+    for (auto &bb : fn)
+      for (auto &inst : bb)
+        StripFastMath(inst, PreRaster(kind));
+  }
+}
+
 llvm::Expected<std::unique_ptr<llvm::Module>>
 ConvertDXIL(SM50ShaderInternal *shader, const char *name, llvm::LLVMContext &context, SM50_SHADER_COMPILATION_ARGUMENT_DATA *pArgs) {
   auto &dxil = *shader->dxil;
diff --git a/src/airconv/dxil/dxil_initialize.cpp b/src/airconv/dxil/dxil_initialize.cpp
index 07c6eaf..5e06407 100644
--- a/src/airconv/dxil/dxil_initialize.cpp
+++ b/src/airconv/dxil/dxil_initialize.cpp
@@ -165,6 +165,10 @@ InitializeDXIL(const Container &container, SM50ShaderInternal *shader, MTL_SHADE
   default: return llvm::make_error<UnsupportedFeature>("DXIL: only vertex, pixel, geometry and compute shaders are supported");
   }
   FillResourceMaps(*entry, **module, shader->shader_info);
+  // SM50Compile links airconv's msad and sample position libraries for these.
+  shader->shader_info.use_msad = ModuleCallsOp(**module, op::Msad);
+  shader->shader_info.use_samplepos = ModuleCallsOp(**module, op::Texture2DMSGetSamplePosition) ||
+                                      ModuleCallsOp(**module, op::RenderTargetGetSamplePosition);
   std::map<uint32_t, uint32_t> unpacked_inputs;
   if (auto err = AddSignatureHandlers(*entry, **module, shader, unpacked_inputs))
     return err;
diff --git a/src/airconv/dxil/dxil_lower.cpp b/src/airconv/dxil/dxil_lower.cpp
index 7751753..6abef7c 100644
--- a/src/airconv/dxil/dxil_lower.cpp
+++ b/src/airconv/dxil/dxil_lower.cpp
@@ -149,6 +149,8 @@ Lowering::Lower(llvm::CallInst *call) {
       (opcode >= op::BitcastI16toF16 && opcode <= op::LegacyF16ToF32) ||
       (opcode >= op::Dot2AddHalf && opcode <= op::Dot4AddU8Packed) || opcode == op::Unpack4x8 || opcode == op::Pack4x8)
     return LowerMath(opcode, call);
+  if (opcode == op::RenderTargetGetSamplePosition || opcode == op::RenderTargetGetSampleCount)
+    return LowerOther(opcode, call); // inside the resource range, but they take no handle
   if ((opcode >= op::CBufferLoad && opcode <= op::AtomicCompareExchange) || opcode == op::CalculateLOD ||
       opcode == op::RawBufferLoad || opcode == op::RawBufferStore)
     return LowerResource(opcode, call);
@@ -487,6 +489,28 @@ Lowering::LowerOther(uint32_t opcode, llvm::CallInst *call) {
     Replace(call, nullptr);
     return llvm::Error::success();
   }
+  case op::IsHelperLane: // (221): only a pixel shader has helper lanes
+    Replace(call, entry.kind == ShaderKind::Pixel ? Simd(ir, "air.simd_is_helper_thread", ir.getInt1Ty(), {})
+                                                  : ir.getFalse());
+    return llvm::Error::success();
+  case op::QuadVote: { // (222, i1, i8 op: 0 any, 1 all)
+    uint32_t kind = ConstantU32(call->getArgOperand(2), ~0u);
+    if (kind > 1)
+      return Unsupported(call);
+    Replace(call, Simd(ir, kind ? "air.quad_all" : "air.quad_any", ir.getInt1Ty(), {call->getArgOperand(1)}));
+    return llvm::Error::success();
+  }
+  case op::RenderTargetGetSampleCount: // (77)
+    Replace(call, air.CreateGetNumSamples());
+    return llvm::Error::success();
+  case op::RenderTargetGetSamplePosition: { // (76, i32 index) -> {f32, f32}: D3D's standard positions (air_samplepos)
+    auto pos = conv.GetSamplePos(air.CreateGetNumSamples(), call->getArgOperand(1));
+    Replace(call, Aggregate(call->getType(), {ir.CreateExtractElement(pos, (uint64_t)0), ir.CreateExtractElement(pos, 1)}));
+    return llvm::Error::success();
+  }
+  case op::ViewID: // (138): ViewInstancingTier is NOT_SUPPORTED, so the only view is 0
+    Replace(call, ir.getInt32(0));
+    return llvm::Error::success();
   default:
     return Unsupported(call);
   }
diff --git a/src/airconv/dxil/dxil_lower_math.cpp b/src/airconv/dxil/dxil_lower_math.cpp
index 8745644..49e27d7 100644
--- a/src/airconv/dxil/dxil_lower_math.cpp
+++ b/src/airconv/dxil/dxil_lower_math.cpp
@@ -221,6 +221,16 @@ Lowering::LowerMath(uint32_t opcode, llvm::CallInst *call) {
     }
     return done(packed);
   }
+  case op::Msad: { // (ref, src, accum): airconv's msad library, linked when use_msad is set (as the DXBC msad lowering)
+    if (!ty->isIntegerTy(32))
+      return Unsupported(call);
+    auto &context = ir.getContext();
+    auto attrs = llvm::AttributeList::get(context, {{~0U, llvm::Attribute::get(context, llvm::Attribute::ReadNone)},
+                                                    {~0U, llvm::Attribute::get(context, llvm::Attribute::NoUnwind)},
+                                                    {~0U, llvm::Attribute::get(context, llvm::Attribute::WillReturn)}});
+    auto fn = air.getModule()->getOrInsertFunction("dxmt.msad.i32", llvm::FunctionType::get(ty, {ty, ty, ty}, false), attrs);
+    return done(ir.CreateCall(fn, {arg(1), arg(2), arg(3)}));
+  }
   default:
     return Unsupported(call);
   }
diff --git a/src/airconv/dxil/dxil_lower_resources.cpp b/src/airconv/dxil/dxil_lower_resources.cpp
index d8fc762..ecb2819 100644
--- a/src/airconv/dxil/dxil_lower_resources.cpp
+++ b/src/airconv/dxil/dxil_lower_resources.cpp
@@ -579,6 +579,19 @@ Lowering::LowerResource(uint32_t opcode, llvm::CallInst *call) {
   case op::TextureGatherCmp:
   case op::CalculateLOD:
     return LowerTexture(opcode, call, h);
+  case op::Texture2DMSGetSamplePosition: { // (75, srv, i32 index) -> {f32, f32}: D3D's standard positions (air_samplepos)
+    llvm::Value *count = ir.getInt32(0); // no texture: (0, 0), as the DXBC samplepos lowering
+    if (auto d = Texture(h)) {
+      llvm::air::Texture tex;
+      tex.kind = d->ResourceKind;
+      tex.sample_type = d->SampleType;
+      tex.memory_access = d->MemoryAccess;
+      count = air.CreateTextureQuery(tex, d->ResourceHandle, Texture::num_samples, ir.getInt32(0));
+    }
+    auto pos = conv.GetSamplePos(count, call->getArgOperand(2));
+    Replace(call, Aggregate(call->getType(), {ir.CreateExtractElement(pos, (uint64_t)0), ir.CreateExtractElement(pos, 1)}));
+    return llvm::Error::success();
+  }
   default:
     return Unsupported(call);
   }
