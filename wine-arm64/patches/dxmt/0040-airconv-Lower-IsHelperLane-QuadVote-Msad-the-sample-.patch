diff --git a/src/airconv/dxbc_converter.cpp b/src/airconv/dxbc_converter.cpp
index 0073a7e..e217e93 100644
--- a/src/airconv/dxbc_converter.cpp
+++ b/src/airconv/dxbc_converter.cpp
@@ -1419,6 +1419,9 @@ AIRCONV_API int SM50Compile(
     linkMSAD(*pModule);
   if (shader_info.use_samplepos)
     linkSamplePos(*pModule);
+  // DXIL's float policy (no NaN or infinity assumed away) holds in the helpers too: Metal compiled them with fast math.
+  if (auto d = ((dxmt::dxbc::SM50ShaderInternal *)pShader)->dxil; d && (shader_info.use_msad || shader_info.use_samplepos))
+    dxmt::dxil::StripFastMath(*pModule, d->entry.kind); // (MacNeutron)
 
   runOptimizationPasses(*pModule);
 
@@ -1651,6 +1654,10 @@ AIRCONV_API int SM50CompileGeometryPipelineVertex(
     linkMSAD(*pModule);
   if (shader_info.use_samplepos)
     linkSamplePos(*pModule);
+  // DXIL's float policy holds in the helpers too: Metal compiled them with fast math. Pre-raster. (MacNeutron)
+  if ((((dxbc::SM50ShaderInternal *)pVertexShader)->dxil || ((dxbc::SM50ShaderInternal *)pGeometryShader)->dxil) &&
+      (shader_info.use_msad || shader_info.use_samplepos))
+    dxmt::dxil::StripFastMath(*pModule, dxmt::dxil::ShaderKind::Geometry);
 
   runOptimizationPasses(*pModule);
 
@@ -1726,6 +1733,10 @@ AIRCONV_API int SM50CompileGeometryPipelineGeometry(
     linkMSAD(*pModule);
   if (shader_info.use_samplepos)
     linkSamplePos(*pModule);
+  // DXIL's float policy holds in the helpers too: Metal compiled them with fast math. Pre-raster. (MacNeutron)
+  if ((((dxbc::SM50ShaderInternal *)pVertexShader)->dxil || ((dxbc::SM50ShaderInternal *)pGeometryShader)->dxil) &&
+      (shader_info.use_msad || shader_info.use_samplepos))
+    dxmt::dxil::StripFastMath(*pModule, dxmt::dxil::ShaderKind::Geometry);
   
   runOptimizationPasses(*pModule);
 
diff --git a/src/airconv/dxil/dxil.hpp b/src/airconv/dxil/dxil.hpp
index 745f9a1..cfe8642 100644
--- a/src/airconv/dxil/dxil.hpp
