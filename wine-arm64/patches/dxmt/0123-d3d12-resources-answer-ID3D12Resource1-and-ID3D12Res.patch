From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Fri, 23 Oct 2026 22:50:06 -0400
Subject: [PATCH] d3d12: resources answer ID3D12Resource1 and ID3D12Resource2

3DMark's Steel Nomad asks a swapchain's GetBuffer for one of them and stopped on E_NOINTERFACE ("IDXGISwapChain::
GetBuffer ... 0x80004002"). No protected sessions (GetProtectedResourceSession: E_NOTIMPL, as vkd3d-proton), and
GetDesc1 is the description with no sampler feedback.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/d3d12/d3d12_buffer.cpp  |  3 ++-
 src/d3d12/d3d12_device.hpp  | 18 +++++++++++++++++-
 src/d3d12/d3d12_texture.cpp |  3 ++-
 3 files changed, 21 insertions(+), 3 deletions(-)

diff --git a/src/d3d12/d3d12_buffer.cpp b/src/d3d12/d3d12_buffer.cpp
index faf69ea..8c71554 100644
--- a/src/d3d12/d3d12_buffer.cpp
+++ b/src/d3d12/d3d12_buffer.cpp
@@ -93,7 +93,8 @@ public:
     *ppvObject = nullptr;
 
     if (riid == __uuidof(IUnknown) || riid == __uuidof(ID3D12Object) || riid == __uuidof(ID3D12DeviceChild) ||
-        riid == __uuidof(ID3D12Pageable) || riid == __uuidof(ID3D12Resource)) {
+        riid == __uuidof(ID3D12Pageable) || riid == __uuidof(ID3D12Resource) || riid == __uuidof(ID3D12Resource1) ||
+        riid == __uuidof(ID3D12Resource2)) {
       *ppvObject = ref(this);
       return S_OK;
     }
diff --git a/src/d3d12/d3d12_device.hpp b/src/d3d12/d3d12_device.hpp
index 6fe9f82..9c07b1d 100644
--- a/src/d3d12/d3d12_device.hpp
+++ b/src/d3d12/d3d12_device.hpp
@@ -107,11 +107,27 @@ public:
   virtual HRESULT Present(Presenter *presenter, ID3D12Resource *backbuffer, HANDLE hLantecyWaitable, double after) = 0;
 };
 
-class MTLD3D12Resource : public ID3D12Resource {
+class MTLD3D12Resource : public ID3D12Resource2 {
 public:
   Rc<Texture> texture;
   Rc<Buffer> buffer;
 
+  // ID3D12Resource1 and 2, which a swapchain's GetBuffer may be asked for (3DMark's Steel Nomad stopped on
+  // E_NOINTERFACE): no protected sessions, and the description with no sampler feedback.
+  HRESULT STDMETHODCALLTYPE GetProtectedResourceSession(REFIID riid, void **ppProtectedSession) final {
+    if (ppProtectedSession)
+      *ppProtectedSession = nullptr;
+    return E_NOTIMPL;
+  }
+
+  D3D12_RESOURCE_DESC1 *STDMETHODCALLTYPE GetDesc1(D3D12_RESOURCE_DESC1 *__ret) final {
+    D3D12_RESOURCE_DESC d;
+    GetDesc(&d);
+    *__ret = {d.Dimension, d.Alignment, d.Width, d.Height, d.DepthOrArraySize, d.MipLevels, d.Format, d.SampleDesc,
+              d.Layout, d.Flags, {}};
+    return __ret;
+  }
+
   virtual HRESULT STDMETHODCALLTYPE
   CreateShaderResourceView(const D3D12_SHADER_RESOURCE_VIEW_DESC *pDesc, D3D12_CPU_DESCRIPTOR_HANDLE Descriptor) = 0;
 
diff --git a/src/d3d12/d3d12_texture.cpp b/src/d3d12/d3d12_texture.cpp
index 8b39882..ef7905f 100644
--- a/src/d3d12/d3d12_texture.cpp
+++ b/src/d3d12/d3d12_texture.cpp
@@ -278,7 +278,8 @@ public:
     *ppvObject = nullptr;
 
     if (riid == __uuidof(IUnknown) || riid == __uuidof(ID3D12Object) || riid == __uuidof(ID3D12DeviceChild) ||
-        riid == __uuidof(ID3D12Pageable) || riid == __uuidof(ID3D12Resource)) {
+        riid == __uuidof(ID3D12Pageable) || riid == __uuidof(ID3D12Resource) || riid == __uuidof(ID3D12Resource1) ||
+        riid == __uuidof(ID3D12Resource2)) {
       *ppvObject = ref(this);
       return S_OK;
     }
-- 
