From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Tue, 6 Oct 2026 20:17:25 -0400
Subject: [PATCH] d3d12: Put ExecuteIndirect vertex buffer views at their table
 entry.

Shaders read the vertex buffers from a table of the slots the pipeline
uses, in slot order (PopulateVertexBufferTable), but the command
signature's resolver wrote a VERTEX_BUFFER_VIEW argument at its raw
slot: with a gap in the used slots (slots 0 and 2), a view for slot 2
landed where nothing reads it while slot 2's entry kept the
IASetVertexBuffers view, and a view for a slot past the pipeline's last
one wrote into the next command's table. The resolver now gets the
pipeline's slot mask with the command data and writes entry
popcount(mask below the slot), and nothing for a slot the pipeline
doesn't use.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/d3d12/d3d12_command_allocator.cpp | 1 +
 src/d3d12/d3d12_command_allocator.hpp | 1 +
 src/d3d12/d3d12_command_list.cpp      | 1 +
 src/d3d12/d3d12_command_signature.cpp | 6 +++++-
 4 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/src/d3d12/d3d12_command_allocator.cpp b/src/d3d12/d3d12_command_allocator.cpp
index 1d7035e..d73b5da 100644
--- a/src/d3d12/d3d12_command_allocator.cpp
+++ b/src/d3d12/d3d12_command_allocator.cpp
@@ -307,6 +307,7 @@ MTLD3D12CommandAllocatorImpl::EncodeIndirectRenderCommand(
     data->static_samplers = 0;
     data->vertex_buffer = 0;
     data->vertex_argbuf_stride = 0;
+    data->vertex_slot_mask = 0;
     data->primitive_type = 0;
     data->index_buffer = 0;
     data->index_buffer_format = {};
diff --git a/src/d3d12/d3d12_command_allocator.hpp b/src/d3d12/d3d12_command_allocator.hpp
index 32acdb4..6d1e530 100644
--- a/src/d3d12/d3d12_command_allocator.hpp
+++ b/src/d3d12/d3d12_command_allocator.hpp
@@ -67,6 +67,7 @@ struct IndirectRenderCommandData {
   uint64_t index_buffer;
   DXGI_FORMAT index_buffer_format;
   uint32_t vertex_argbuf_stride;
+  uint32_t vertex_slot_mask; // the pipeline's: which slots vertex_buffer's table holds
 };
 
 class MTLD3D12CommandAllocatorImpl : public MTLD3D12Pageable<MTLD3D12CommandAllocator> {
diff --git a/src/d3d12/d3d12_command_list.cpp b/src/d3d12/d3d12_command_list.cpp
index 1a32403..0a0a7da 100644
--- a/src/d3d12/d3d12_command_list.cpp
+++ b/src/d3d12/d3d12_command_list.cpp
@@ -2017,6 +2017,7 @@ public:
     auto [VBOffset, VBStride] = PopulateVertexBufferTable(MaxCommandCount);
     cmd->vertex_buffer = allocator_->gpu_heap_buffer_address_ + VBOffset;
     cmd->vertex_argbuf_stride = VBStride;
+    cmd->vertex_slot_mask = pso_graphics_ ? pso_graphics_->slot_mask : 0;
   };
 
   void STDMETHODCALLTYPE
diff --git a/src/d3d12/d3d12_command_signature.cpp b/src/d3d12/d3d12_command_signature.cpp
index ac0d50a..4a29d02 100644
--- a/src/d3d12/d3d12_command_signature.cpp
+++ b/src/d3d12/d3d12_command_signature.cpp
@@ -85,6 +85,7 @@ struct dxmt_render_command_data {
   device void * index_buffer;
   uint index_buffer_format;
   uint vertex_argbuf_stride;
+  uint vertex_slot_mask;
 };
 
 )";
@@ -251,8 +252,11 @@ public:
         break;
       }
       case D3D12_INDIRECT_ARGUMENT_TYPE_VERTEX_BUFFER_VIEW: {
+        // MacNeutron: the table holds the slots the pipeline uses, in order (PopulateVertexBufferTable): a view goes to
+        // its slot's place there, and one for a slot the pipeline doesn't use goes nowhere.
         auto slot = arg.VertexBuffer.Slot;
-        source << "vertex_buffer[" << slot << "] = {arg.vb_" << i << ".buffer,arg.vb_" << i
+        source << "if (command_data.vertex_slot_mask & " << (1u << slot) << "u) vertex_buffer[popcount(command_data."
+               << "vertex_slot_mask & " << ((1u << slot) - 1) << "u)] = {arg.vb_" << i << ".buffer,arg.vb_" << i
                << ".stride_in_bytes,arg.vb_" << i << ".size_in_bytes};\n";
         break;
       }
-- 
