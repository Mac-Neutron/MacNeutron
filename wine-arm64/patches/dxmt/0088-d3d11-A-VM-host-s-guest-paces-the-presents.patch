From 6a0f322a9ad87644cdffbea37c9822e38c9bbbb1 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Sun, 18 Oct 2026 14:41:05 -0400
Subject: [PATCH] d3d11: A VM host's guest paces the presents.

In the native build with a VM host's window-system hooks set, a
swapchain's present no longer waits for the GPU: neither the frame
latency object's wait (SyncFrame) nor the device's frame latency
(PresentBoundary). The guest paces its own frames on fences of its own,
so the host's vCPU thread never sleeps there; the command chunks'
backpressure stays. The Windows build and an unhooked native process
wait as before.

Assisted-by: Claude Code: claude-opus-5-5
---
 src/d3d11/d3d11_swapchain.cpp   | 14 ++++++++++++--
 src/dxmt/dxmt_command_queue.hpp |  5 +++--
 2 files changed, 15 insertions(+), 4 deletions(-)

diff --git a/src/d3d11/d3d11_swapchain.cpp b/src/d3d11/d3d11_swapchain.cpp
index 6b19ab7..bc3e800 100644
--- a/src/d3d11/d3d11_swapchain.cpp
+++ b/src/d3d11/d3d11_swapchain.cpp
@@ -739,9 +739,19 @@ public:
     }
   };
 
+  // MacNeutron: a VM host's guest paces its frames (its own frame latency object and fence), so the host's vCPU never
+  // waits for the GPU here; the chunks' backpressure stays.
+  static bool GuestPaces() {
+#ifdef _WIN32
+    return false;
+#else
+    return WMTGetWsiHooks() != nullptr;
+#endif
+  }
+
   SyncFrameState SyncFrame(uint64_t current_frame_id) {
     if (frame_latency_fence_) {
-      if (current_frame_id > frame_latency)
+      if (current_frame_id > frame_latency && !GuestPaces())
         frame_latency_fence_->wait(current_frame_id - frame_latency);
       return SyncFrameState(current_frame_id, frame_latency_fence_.get());
     }
@@ -827,7 +837,7 @@ public:
 
     lock.unlock(); // since PresentBoundary() will and should only stall current thread
 
-    cmd_queue.PresentBoundary();
+    cmd_queue.PresentBoundary(!GuestPaces());
 
     return hr;
   };
diff --git a/src/dxmt/dxmt_command_queue.hpp b/src/dxmt/dxmt_command_queue.hpp
index e109af7..c886025 100644
--- a/src/dxmt/dxmt_command_queue.hpp
+++ b/src/dxmt/dxmt_command_queue.hpp
@@ -257,13 +257,14 @@ public:
     return statistics.at(frame_count);
   }
 
+  // wait: false, a VM host's (its guest paces the frames): the frame isn't waited for here
   void
-  PresentBoundary() {
+  PresentBoundary(bool wait = true) {
     statistics.compute(frame_count);
     frame_count++;
     statistics.at(frame_count).reset();
     // After present N-th frame (N starts from 1), wait for (N - max_latency)-th frame to finish rendering 
-    if (likely(frame_count > max_latency_)) {
+    if (wait && likely(frame_count > max_latency_)) {
       auto t0 = clock::now();
       frame_latency_fence_.wait(frame_count - max_latency_);
       auto t1 = clock::now();
-- 
