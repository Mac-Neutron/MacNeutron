From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Sat, 24 Oct 2026 10:38:16 -0400
Subject: [PATCH] d3d12: render passes, emulated

BeginRenderPass clears what its beginning accesses clear (FoldClears makes
them the pass's load actions at its first draw), binds the targets (the
depth-stencil view unless both planes are NO_ACCESS) and keeps its resolve
endings; EndRenderPass resolves them through ResolveSubresourceRegion. The
flags change nothing: suspend and resume only say a flow of passes crosses
command lists, and both passes' accesses still happen (DirectX-Specs,
RenderPasses, Suspend and Resume).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/d3d12/d3d12_command_list.cpp | 61 ++++++++++++++++++++++++++++++--
 1 file changed, 59 insertions(+), 2 deletions(-)

diff --git a/src/d3d12/d3d12_command_list.cpp b/src/d3d12/d3d12_command_list.cpp
index f3ee400..3ab4601 100644
--- a/src/d3d12/d3d12_command_list.cpp
+++ b/src/d3d12/d3d12_command_list.cpp
@@ -170,6 +170,14 @@ class MTLD3D12GraphicsCommandListImpl
 
   Com<MTLD3D12CommandAllocatorImpl, false> allocator_;
   std::vector<const void *> transitioned_; // ResourceBarrier's scratch
+  // MacNeutron: the open render pass's resolves, from its BeginRenderPass, done by its EndRenderPass.
+  struct PendingResolve {
+    ID3D12Resource *src, *dst;
+    DXGI_FORMAT format;
+    D3D12_RESOLVE_MODE mode;
+    std::vector<D3D12_RENDER_PASS_ENDING_ACCESS_RESOLVE_SUBRESOURCE_PARAMETERS> subresources;
+  };
+  std::vector<PendingResolve> pass_resolves_;
 
   /* state */
 
@@ -295,6 +303,7 @@ public:
     custom_resolves = false;
     barrier_names.clear();
     barrier_opaque.clear();
+    pass_resolves_.clear();
     return allocator_->StartRecord(&entry);
   }
 
@@ -2198,19 +2207,67 @@ public:
       WARN_ONCE("SetProtectedResourceSession: protected sessions not supported");
   }
 
+  // Render passes, emulated (RenderPassesTier 0): BeginRenderPass clears what its beginning accesses clear (FoldClears
+  // makes them the pass's load actions at its first draw) and binds the targets; EndRenderPass resolves what its
+  // ending accesses resolve. The flags change nothing: SUSPENDING_PASS and RESUMING_PASS only say a flow of passes
+  // crosses command lists, and both passes' accesses still happen (DirectX-Specs, RenderPasses, "Suspend and
+  // Resume"); ALLOW_UAV_WRITES and the read-only depth and stencil ones are the views' and pipelines' own.
   void STDMETHODCALLTYPE
   BeginRenderPass(
       UINT NumRenderTargets, const D3D12_RENDER_PASS_RENDER_TARGET_DESC *pRenderTargets,
       const D3D12_RENDER_PASS_DEPTH_STENCIL_DESC *pDepthStencil, D3D12_RENDER_PASS_FLAGS Flags
   ) {
     DXMT_STAT_SCOPE("list.BeginRenderPass");
-    WARN("BeginRenderPass: not implemented yet");
+    if (NumRenderTargets > D3D12_SIMULTANEOUS_RENDER_TARGET_COUNT || (NumRenderTargets && !pRenderTargets))
+      return;
+    pass_resolves_.clear();
+    auto keep = [&](const D3D12_RENDER_PASS_ENDING_ACCESS &end) {
+      if (end.Type != D3D12_RENDER_PASS_ENDING_ACCESS_TYPE_RESOLVE)
+        return;
+      auto &r = end.Resolve;
+      auto *params = r.pSubresourceParameters;
+      pass_resolves_.push_back(
+          {r.pSrcResource, r.pDstResource, r.Format, r.ResolveMode, {params, params + (params ? r.SubresourceCount : 0)}}
+      );
+    };
+    D3D12_CPU_DESCRIPTOR_HANDLE rtvs[D3D12_SIMULTANEOUS_RENDER_TARGET_COUNT];
+    for (UINT i = 0; i < NumRenderTargets; i++) {
+      auto &rt = pRenderTargets[i];
+      rtvs[i] = rt.cpuDescriptor;
+      if (rt.BeginningAccess.Type == D3D12_RENDER_PASS_BEGINNING_ACCESS_TYPE_CLEAR)
+        ClearRenderTargetView(rt.cpuDescriptor, rt.BeginningAccess.Clear.ClearValue.Color, 0, nullptr);
+      keep(rt.EndingAccess);
+    }
+    bool bind_dsv = false;
+    if (pDepthStencil) {
+      auto &ds = *pDepthStencil;
+      D3D12_CLEAR_FLAGS clear = {};
+      if (ds.DepthBeginningAccess.Type == D3D12_RENDER_PASS_BEGINNING_ACCESS_TYPE_CLEAR)
+        clear |= D3D12_CLEAR_FLAG_DEPTH;
+      if (ds.StencilBeginningAccess.Type == D3D12_RENDER_PASS_BEGINNING_ACCESS_TYPE_CLEAR)
+        clear |= D3D12_CLEAR_FLAG_STENCIL;
+      if (clear)
+        ClearDepthStencilView(
+            ds.cpuDescriptor, clear, ds.DepthBeginningAccess.Clear.ClearValue.DepthStencil.Depth,
+            ds.StencilBeginningAccess.Clear.ClearValue.DepthStencil.Stencil, 0, nullptr
+        );
+      keep(ds.DepthEndingAccess);
+      keep(ds.StencilEndingAccess);
+      bind_dsv = ds.DepthBeginningAccess.Type != D3D12_RENDER_PASS_BEGINNING_ACCESS_TYPE_NO_ACCESS ||
+                 ds.StencilBeginningAccess.Type != D3D12_RENDER_PASS_BEGINNING_ACCESS_TYPE_NO_ACCESS;
+    }
+    OMSetRenderTargets(NumRenderTargets, rtvs, FALSE, bind_dsv ? &pDepthStencil->cpuDescriptor : nullptr);
   }
 
   void STDMETHODCALLTYPE
   EndRenderPass() {
     DXMT_STAT_SCOPE("list.EndRenderPass");
-    WARN("EndRenderPass: not implemented yet");
+    for (auto &r : pass_resolves_)
+      for (auto &s : r.subresources)
+        ResolveSubresourceRegion(
+            r.dst, s.DstSubresource, s.DstX, s.DstY, r.src, s.SrcSubresource, &s.SrcRect, r.format, r.mode
+        );
+    pass_resolves_.clear();
   }
 
   void STDMETHODCALLTYPE
