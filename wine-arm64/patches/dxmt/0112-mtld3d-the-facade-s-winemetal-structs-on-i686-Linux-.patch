-        a: u32,
-        b: u64,
+    #[cfg(not(all(target_arch = "x86", target_os = "linux")))]
+    {
+        #[repr(C)]
+        struct U64After4 {
+            a: u32,
+            b: u64,
+        }
+        // 8 (not 4) ⇒ repr(C) u64 is 8-aligned on this target.
