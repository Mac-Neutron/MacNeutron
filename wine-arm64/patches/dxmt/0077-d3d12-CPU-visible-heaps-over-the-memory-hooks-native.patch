From feab55f433d4236b2a714ce7b0012aa476e63bdf Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Sat, 17 Oct 2026 23:19:08 -0400
Subject: [PATCH] d3d12: CPU-visible heaps over the memory hooks, natively.

With native winemetal's memory hooks set (a VM host), a CPU-visible
heap is no MTLHeap but one buffer from the hooks, and its placed buffers
are buffers over that memory (in the device's residency set themselves):
a VM's guest then maps the memory of every mappable resource. A texture
placed in such a heap is refused. WMTMemoryHooked says whether the hooks
are set. Without hooks nothing changes.

Assisted-by: Claude Code: claude-opus-5-5
---
 src/d3d12/d3d12_buffer.cpp          |  5 ++++-
 src/d3d12/d3d12_device.hpp          |  4 ++++
 src/d3d12/d3d12_heap.cpp            |  8 ++++++++
 src/d3d12/d3d12_texture.cpp         |  4 ++++
 src/dxmt/dxmt_buffer.cpp            | 11 +++++++++++
 src/dxmt/dxmt_buffer.hpp            |  3 +++
 src/winemetal/unix/winemetal_unix.c |  5 +++++
 src/winemetal/winemetal.h           |  4 ++++
 8 files changed, 43 insertions(+), 1 deletion(-)

diff --git a/src/d3d12/d3d12_buffer.cpp b/src/d3d12/d3d12_buffer.cpp
index 9364878..faf69ea 100644
--- a/src/d3d12/d3d12_buffer.cpp
+++ b/src/d3d12/d3d12_buffer.cpp
@@ -64,7 +64,10 @@ public:
     Flags<BufferAllocationFlag> flags;
     if (pHeap && IsPrivateHeap(&heap_props_)) // committed buffers stay Shared
       flags.set(BufferAllocationFlag::CpuInvisible);
-    if (pHeap) {
+    if (pHeap && pHeap->cpu_memory) {
+      buffer->rename(buffer->allocate_over(flags, (char *)pHeap->cpu_memory + Offset));
+      heap_ = pHeap;
+    } else if (pHeap) {
       buffer->rename(buffer->allocate(flags, pHeap->heap, Offset));
       heap_ = pHeap;
     } else {
diff --git a/src/d3d12/d3d12_device.hpp b/src/d3d12/d3d12_device.hpp
index efb589b..582366f 100644
--- a/src/d3d12/d3d12_device.hpp
+++ b/src/d3d12/d3d12_device.hpp
@@ -141,6 +141,10 @@ public:
 class MTLD3D12Heap : public ID3D12Heap {
 public:
   WMT::Reference<WMT::Heap> heap;
+  // MacNeutron, the native build with memory hooks (a VM host): a CPU-visible heap is no MTLHeap but one buffer's
+  // memory from the hooks, which a VM's guest shares; its placed buffers are buffers over it (d3d12_buffer.cpp).
+  Rc<Buffer> cpu_buffer;
+  void *cpu_memory = nullptr;
 
   virtual void AddRefPrivate() = 0;
   virtual void ReleasePrivate() = 0;
diff --git a/src/d3d12/d3d12_heap.cpp b/src/d3d12/d3d12_heap.cpp
index 0c7b4c4..4f956aa 100644
--- a/src/d3d12/d3d12_heap.cpp
+++ b/src/d3d12/d3d12_heap.cpp
@@ -84,6 +84,14 @@ public:
     if (!size_aligned)
       return E_INVALIDARG;
 
+#ifndef _WIN32 // the native build
+    if (!IsPrivateHeap(&desc_.Properties) && WMTMemoryHooked()) {
+      cpu_buffer = new Buffer(size_aligned, device_->GetMTLDevice());
+      cpu_buffer->rename(cpu_buffer->allocate({}));
+      cpu_memory = cpu_buffer->current()->mappedMemory(0);
+      return cpu_memory ? S_OK : E_OUTOFMEMORY;
+    }
+#endif
     WMTHeapInfo info;
     info.options = IsPrivateHeap(&desc_.Properties) ? WMTResourceStorageModePrivate : WMTResourceOptions{};
     info.size = size_aligned;
diff --git a/src/d3d12/d3d12_texture.cpp b/src/d3d12/d3d12_texture.cpp
index d987800..8b39882 100644
--- a/src/d3d12/d3d12_texture.cpp
+++ b/src/d3d12/d3d12_texture.cpp
@@ -248,6 +248,10 @@ public:
     Flags<TextureAllocationFlag> flags = {};
     if (IsPrivateHeap(&heap_props_)) // committed, or placed on a heap with these properties
       flags.set(TextureAllocationFlag::CpuInvisible);
+    if (pHeap && pHeap->cpu_memory) {
+      ERR("CreatePlacedResource: a texture in a CPU-visible heap is not supported with memory hooks");
+      return E_INVALIDARG;
+    }
     if (pHeap) {
       texture->rename(texture->allocate(flags, pHeap->heap, HeapOffset));
       heap_ = pHeap;
diff --git a/src/dxmt/dxmt_buffer.cpp b/src/dxmt/dxmt_buffer.cpp
index 3889498..322913c 100644
--- a/src/dxmt/dxmt_buffer.cpp
+++ b/src/dxmt/dxmt_buffer.cpp
@@ -215,6 +215,17 @@ Buffer::allocate(Flags<BufferAllocationFlag> flags, WMT::Heap heap, uint64_t hea
   return new BufferAllocation(device_, info, flags, heap, heap_offset);
 };
 
+Rc<BufferAllocation>
+Buffer::allocate_over(Flags<BufferAllocationFlag> flags, void *memory) {
+  WMTBufferInfo info;
+  info.memory.set(memory);
+  info.length = align(length_, 16384ull); // newBufferWithBytesNoCopy takes whole pages
+  info.options = WMTResourceHazardTrackingModeUntracked;
+  if (flags.test(BufferAllocationFlag::CpuWriteCombined))
+    info.options |= WMTResourceOptionCPUCacheModeWriteCombined;
+  return new BufferAllocation(device_, info, flags);
+}
+
 Rc<BufferAllocation>
 Buffer::rename(Rc<BufferAllocation> &&newAllocation) {
   Rc<BufferAllocation> old = std::move(current_);
diff --git a/src/dxmt/dxmt_buffer.hpp b/src/dxmt/dxmt_buffer.hpp
index 057e767..2e357d3 100644
--- a/src/dxmt/dxmt_buffer.hpp
+++ b/src/dxmt/dxmt_buffer.hpp
@@ -185,6 +185,9 @@ public:
 
   Rc<BufferAllocation> allocate(Flags<BufferAllocationFlag> flags);
   Rc<BufferAllocation> allocate(Flags<BufferAllocationFlag> flags, WMT::Heap heap, uint64_t heap_offset);
+  // MacNeutron: over memory it doesn't own (a CPU-visible heap's, natively with memory hooks): no heap's buffer, so in
+  // the device's residency set itself.
+  Rc<BufferAllocation> allocate_over(Flags<BufferAllocationFlag> flags, void *memory);
 
   Rc<BufferAllocation> rename(Rc<BufferAllocation> &&newAllocation);
 
diff --git a/src/winemetal/unix/winemetal_unix.c b/src/winemetal/unix/winemetal_unix.c
index 19e8a2e..1a7ce88 100644
--- a/src/winemetal/unix/winemetal_unix.c
+++ b/src/winemetal/unix/winemetal_unix.c
@@ -162,6 +162,11 @@ WMTSetMemoryHooks(void *(*alloc)(uint64_t length, void *ctx), void (*free)(void
   memory_alloc = alloc, memory_free = free, memory_ctx = ctx;
 }
 
+__attribute__((visibility("default"))) int
+WMTMemoryHooked(void) {
+  return memory_alloc != NULL;
+}
+
 /* A CPU-visible buffer over the hooks' memory (whole pages, as newBufferWithBytesNoCopy takes them); nil if they gave
  * none. */
 static id<MTLBuffer>
diff --git a/src/winemetal/winemetal.h b/src/winemetal/winemetal.h
index 8d09fd1..15cb873 100644
--- a/src/winemetal/winemetal.h
+++ b/src/winemetal/winemetal.h
@@ -2255,5 +2255,9 @@ WINEMETAL_API void WMTMemoryFree(void *ptr);
 WINEMETAL_API void WMTSetMemoryHooks(void *(*alloc)(uint64_t length, void *ctx), void (*free)(void *ptr, void *ctx),
                                      void *ctx);
 #endif
+#if defined(DXMT_NATIVE) || !defined(_WIN32)
+/* Whether they are set: then a CPU-visible D3D12 heap is DXMT's own over one buffer of theirs (d3d12_heap.cpp). */
+WINEMETAL_API int WMTMemoryHooked(void);
+#endif
 
 #endif
\ No newline at end of file
