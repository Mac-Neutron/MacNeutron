-    d.log += name + " q" + std::to_string(queue_index_) + " " + ((unsigned)pass->type < 6 ? kinds[(unsigned)pass->type] : "other");
+    static const char *const kinds[] = {"null", "clear", "render", "blit", "compute", "resolve", "upscale"};
