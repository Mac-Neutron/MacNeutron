   HRESULT STDMETHODCALLTYPE QueryInterface(REFIID riid,
                                            void **ppvObject) final {
     return ctx_->QueryInterface(riid, ppvObject);
diff --git a/src/d3d11/d3d11_interfaces.hpp b/src/d3d11/d3d11_interfaces.hpp
index ff4bb2b..79531c1 100644
--- a/src/d3d11/d3d11_interfaces.hpp
+++ b/src/d3d11/d3d11_interfaces.hpp
@@ -39,6 +39,26 @@ DEFINE_COM_INTERFACE("19a8e35a-38be-418f-94e3-9f7323936870", IMTLD3D11ContextExt
   ) = 0;
 };
 
+// MacNeutron: a VM host's guest answers a dynamic resource's WRITE_DISCARD and WRITE_NO_OVERWRITE maps itself, in
+// pieces of its memory the immediate context lends it. GetPieces lends count pieces of the subresource's memory not
+// in use (the recycled ones first, then new ones), each the caller's until UsePiece makes it the subresource's memory
+// (WRITE_DISCARD's rename, and a dynamic texture's Unmap upload), which returns the one it replaces to the recycling;
+// count 0 answers the current piece. E_NOTIMPL: a resource whose maps the context makes itself (not dynamic, a
+// linear dynamic texture), or a deferred context. A piece's id means nothing but to UsePiece, which takes only the
+// ids it lent out or the current one's.
+struct MTLD3D11Piece {
+  UINT64 id;
+  void *cpu;
+  UINT row_pitch;
+  UINT depth_pitch;
+};
+
+DEFINE_COM_INTERFACE("a5253c74-3ff9-497f-b184-f137c5a7b928", IMTLD3D11ContextExt2) : public IMTLD3D11ContextExt1 {
+  virtual HRESULT STDMETHODCALLTYPE GetPieces(ID3D11Resource *resource, UINT subresource, UINT count,
+                                              MTLD3D11Piece *pieces) = 0;
+  virtual void STDMETHODCALLTYPE UsePiece(ID3D11Resource *resource, UINT subresource, UINT64 piece) = 0;
+};
+
 DEFINE_COM_INTERFACE("efc77ae6-2179-4c0a-b844-7661ca0dcde7", IMTLD3D11DeviceExt)
     : public IUnknown {
   virtual void STDMETHODCALLTYPE SetShaderExtensionSlot(UINT Slot) = 0;
diff --git a/src/dxmt/dxmt_dynamic.cpp b/src/dxmt/dxmt_dynamic.cpp
index ce7941e..318a36d 100644
--- a/src/dxmt/dxmt_dynamic.cpp
+++ b/src/dxmt/dxmt_dynamic.cpp
@@ -47,6 +47,7 @@ DynamicBuffer::updateImmediateName(uint64_t current_seq_id, Rc<BufferAllocation>
   name_ = std::move(allocation);
   name_suballocation_ = suballocation;
   owned_by_command_list_ = owned_by_command_list;
+  name_piece_ = 0;
 }
 
 void
@@ -62,6 +63,46 @@ DynamicBuffer::recycle(uint64_t current_seq_id, Rc<BufferAllocation> &&allocatio
   fifo.push(QueueEntry{.allocation = std::move(allocation), .will_free_at = current_seq_id});
 }
 
+std::pair<uint64_t, Rc<BufferAllocation>>
+DynamicBuffer::lend(uint64_t coherent_seq_id) {
+  Rc<BufferAllocation> ret = allocate(coherent_seq_id);
+  std::lock_guard<dxmt::mutex> lock(mutex_);
+  uint64_t id = next_piece_++;
+  lent_[id] = ret;
+  return {id, ret};
+}
+
+Rc<BufferAllocation>
+DynamicBuffer::takeLent(uint64_t id) {
+  std::lock_guard<dxmt::mutex> lock(mutex_);
+  auto it = lent_.find(id);
+  if (it == lent_.end())
+    return {};
+  Rc<BufferAllocation> ret = std::move(it->second);
+  lent_.erase(it);
+  return ret;
+}
+
+uint64_t
+DynamicBuffer::immediatePiece() {
+  std::lock_guard<dxmt::mutex> lock(mutex_);
+  if (!name_piece_)
+    name_piece_ = next_piece_++;
+  return name_piece_;
+}
+
+void
+DynamicBuffer::setImmediatePiece(uint64_t id) {
+  std::lock_guard<dxmt::mutex> lock(mutex_);
+  name_piece_ = id;
+}
+
+void
+DynamicBuffer::useImmediateSuballocation(uint32_t suballocation) {
+  std::lock_guard<dxmt::mutex> lock(mutex_);
+  name_suballocation_ = suballocation;
+}
+
 uint32_t
 DynamicBuffer::nextSuballocation() {
   if (name_->hasSuballocatoin(name_suballocation_ + 1)) {
diff --git a/src/dxmt/dxmt_dynamic.hpp b/src/dxmt/dxmt_dynamic.hpp
index 9ee3b1d..1edafff 100644
--- a/src/dxmt/dxmt_dynamic.hpp
+++ b/src/dxmt/dxmt_dynamic.hpp
@@ -2,6 +2,7 @@
 #include "dxmt_buffer.hpp"
 #include "dxmt_texture.hpp"
 #include <queue>
+#include <unordered_map>
 
 namespace dxmt {
 
@@ -15,6 +16,16 @@ public:
   void recycle(uint64_t current_seq_id, Rc<BufferAllocation> &&allocation);
   uint32_t nextSuballocation();
 
+  // MacNeutron (IMTLD3D11ContextExt2's pieces): an allocation lent out under an id of its own (never its address), as
+  // allocate() finds one, until taken back to become the immediate name (takeLent: nullptr, that id isn't lent);
+  // the immediate name's id (one given it when it has none: an allocation DXMT renamed to itself), set as it's made
+  // the immediate name from a lent one; its suballocation set.
+  std::pair<uint64_t, Rc<BufferAllocation>> lend(uint64_t coherent_seq_id);
+  Rc<BufferAllocation> takeLent(uint64_t id);
+  uint64_t immediatePiece();
+  void setImmediatePiece(uint64_t id);
+  void useImmediateSuballocation(uint32_t suballocation);
+
   Rc<BufferAllocation>
   immediateName() {
     return name_;
@@ -50,6 +61,8 @@ private:
   Rc<BufferAllocation> name_;
   uint32_t name_suballocation_ = 0;
   bool owned_by_command_list_ = false;
+  std::unordered_map<uint64_t, Rc<BufferAllocation>> lent_; // they go with the buffer
+  uint64_t next_piece_ = 1, name_piece_ = 0;
 };
 
 class DynamicLinearTexture {
