From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Tue, 6 Oct 2026 01:18:11 -0400
Subject: [PATCH] d3d12: Reuse released MetalFX upscalers, and take typeless
 colour and output.

macOS 27.0.1's MetalFX never frees a temporal upscaler (~230 MB each,
natively too). The device keeps the last 4 it made; one only the device
still holds (its D3D12 object released and every allocator that recorded
it reset) serves the next CreateTemporalScaler of the same Metal
description. A reused upscaler carries another's history, so an object's
first upscale resets it.

A TYPELESS colour or output (R16G16B16A16, R32G32B32A32, R10G10B10A2,
R8G8B8A8, B8G8R8A8) is read as its float or unorm variant through a view
of the same layout; other TYPELESS formats stay refused.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/d3d12/d3d12_command_list.cpp | 17 +++++---
 src/d3d12/d3d12_device.cpp       | 74 +++++++++++++++++++++++++++-----
 src/d3d12/d3d12_device.hpp       |  2 +
 src/dxmt/dxmt_scaler.hpp         |  5 +++
 4 files changed, 82 insertions(+), 16 deletions(-)

diff --git a/src/d3d12/d3d12_command_list.cpp b/src/d3d12/d3d12_command_list.cpp
index 6d86041..8896fe5 100644
--- a/src/d3d12/d3d12_command_list.cpp
+++ b/src/d3d12/d3d12_command_list.cpp
@@ -2101,10 +2101,17 @@ public:
     auto readable = [](Texture *t, WMTPixelFormat format) {
       return t->pixelFormat() == format && (t->usage() & WMTTextureUsageShaderRead);
     };
+    // Colour and output may also be viewed in the upscaler's format if the layout is the same (a TYPELESS one read as
+    // its typed variant, Ruling 6); another layout would read a losslessly compressed texture wrong.
+    auto layout = [](Texture *t, WMTPixelFormat format) {
+      auto own = MTLGetUnsignedIntegerFormat(t->pixelFormat());
+      return t->pixelFormat() == format || (own != WMTPixelFormatInvalid && own == MTLGetUnsignedIntegerFormat(format));
+    };
     // Colour and mask go to MetalFX as they are (depth and motion vectors may be copied first, below).
     if (!color || !depth || !motion || !output || (masked ? !mask : d.ReactiveMask != nullptr) ||
-        (exposure && !exposure->texture) || !readable(color, info.color_format) ||
-        (mask && !readable(mask, info.reactive_mask_format)) || output->pixelFormat() != info.output_format)
+        (exposure && !exposure->texture) || !layout(color, info.color_format) ||
+        !(color->usage() & WMTTextureUsageShaderRead) || (mask && !readable(mask, info.reactive_mask_format)) ||
+        !layout(output, info.output_format))
       return E_INVALIDARG;
     // Content no larger than the inputs, at a scale in the upscaler's range.
     float sx = (float)sd.OutputWidth / d.InputContentWidth, sy = (float)sd.OutputHeight / d.InputContentHeight;
@@ -2116,7 +2123,7 @@ public:
     WMTFXTemporalScalerProps props{};
     props.input_content_width = d.InputContentWidth;
     props.input_content_height = d.InputContentHeight;
-    props.reset = d.Reset;
+    props.reset = d.Reset || scaler->fresh.exchange(false);
     props.depth_reversed = d.DepthReversed;
     props.motion_vector_scale_x = d.MotionVectorScaleX;
     props.motion_vector_scale_y = d.MotionVectorScaleY;
@@ -2177,14 +2184,14 @@ public:
     auto e = allocator_->AllocatePass<TemporalUpscaleEncoderData>();
     e->type = EncoderType::TemporalUpscale; // may write anything: it joins, and what follows waits on it
     e->scaler = scaler->scaler;
-    e->color = color->view(color->fullView);
+    e->color = color->view(color->checkViewUseFormat(color->fullView, info.color_format));
     e->depth = depth->view(depth->fullView);
     e->motion = motion->view(motion->fullView);
     if (exposure)
       e->exposure = exposure->texture->view(exposure->texture->fullView);
     if (mask)
       e->reactive = mask->view(mask->fullView);
-    e->output = target->view(target->fullView);
+    e->output = target->view(target->checkViewUseFormat(target->fullView, info.output_format));
     e->depth_scratch = std::move(depth_scratch);
     e->motion_scratch = std::move(motion_scratch);
     e->output_scratch = output_scratch;
diff --git a/src/d3d12/d3d12_device.cpp b/src/d3d12/d3d12_device.cpp
index e2df3e5..24758aa 100644
--- a/src/d3d12/d3d12_device.cpp
+++ b/src/d3d12/d3d12_device.cpp
@@ -268,11 +268,11 @@ class MTLD3D12TemporalScalerImpl : public ComObject<MTLD3D12TemporalScaler> {
 
 public:
   MTLD3D12TemporalScalerImpl(WMT::Device device, const MTL_TEMPORAL_SCALER_D3D12_DESC &desc,
-                             const WMTFXTemporalScalerInfo &info)
+                             const WMTFXTemporalScalerInfo &info, Rc<TemporalScaler> scaler)
       : device_(device) {
     this->desc = desc;
     this->info = info;
-    scaler = new TemporalScaler(device, info);
+    this->scaler = std::move(scaler);
   }
 
   HRESULT STDMETHODCALLTYPE
@@ -312,6 +312,20 @@ public:
   }
 };
 
+static bool
+SameTemporalScaler(const WMTFXTemporalScalerInfo &a, const WMTFXTemporalScalerInfo &b) {
+  return a.color_format == b.color_format && a.output_format == b.output_format && a.depth_format == b.depth_format &&
+         a.motion_format == b.motion_format && a.input_width == b.input_width && a.input_height == b.input_height &&
+         a.output_width == b.output_width && a.output_height == b.output_height &&
+         a.input_content_min_scale == b.input_content_min_scale &&
+         a.input_content_max_scale == b.input_content_max_scale && a.auto_exposure == b.auto_exposure &&
+         a.input_content_properties_enabled == b.input_content_properties_enabled &&
+         a.requires_synchronous_initialization == b.requires_synchronous_initialization &&
+         a.reactive_mask_enabled == b.reactive_mask_enabled && a.reactive_mask_format == b.reactive_mask_format &&
+         a.output_resolution_motion_vectors == b.output_resolution_motion_vectors &&
+         a.jittered_motion_vectors == b.jittered_motion_vectors;
+}
+
 class MTLD3D12DeviceImpl : public MTLD3D12Object<ComObject<MTLD3D12Device, IMTLD3D12DeviceExt>> {
 
   Com<IMTLDXGIAdapter> adapter_;
@@ -319,6 +333,9 @@ class MTLD3D12DeviceImpl : public MTLD3D12Object<ComObject<MTLD3D12Device, IMTLD
   bool advertise_numa_ = false;
 
   dxmt::mutex residency_lock_;
+  // MacNeutron (XeSS answered by MetalFX): the last temporal upscalers made, oldest first (CreateTemporalScaler).
+  dxmt::mutex scalers_lock_;
+  std::vector<std::pair<WMTFXTemporalScalerInfo, Rc<TemporalScaler>>> scalers_;
   std::once_flag timestamp_once_;
   uint64_t timestamp_frequency_ = 1;
   dxmt::mutex null_lock_;
@@ -467,9 +484,28 @@ public:
     auto colour = [&](DXGI_FORMAT format) {
       auto f = query(format);
       bool ok = f.PixelFormat != WMTPixelFormatInvalid && !IsIntegerFormat(f.PixelFormat) &&
-                !(f.Flag & (MTL_DXGI_FORMAT_BC | MTL_DXGI_FORMAT_DEPTH_PLANER | MTL_DXGI_FORMAT_STENCIL_PLANER));
+                !(f.Flag & (MTL_DXGI_FORMAT_BC | MTL_DXGI_FORMAT_DEPTH_PLANER | MTL_DXGI_FORMAT_STENCIL_PLANER |
+                            MTL_DXGI_FORMAT_TYPELESS));
       return ok ? f.PixelFormat : WMTPixelFormatInvalid;
     };
+    // A TYPELESS colour or output (Unreal's are often) is read as its float or unorm variant, through a view of the
+    // same layout (TemporalUpscale); other TYPELESS formats stay refused (Ruling 6).
+    auto typed = [](DXGI_FORMAT format) {
+      switch (format) {
+      case DXGI_FORMAT_R16G16B16A16_TYPELESS:
+        return DXGI_FORMAT_R16G16B16A16_FLOAT;
+      case DXGI_FORMAT_R32G32B32A32_TYPELESS:
+        return DXGI_FORMAT_R32G32B32A32_FLOAT;
+      case DXGI_FORMAT_R10G10B10A2_TYPELESS:
+        return DXGI_FORMAT_R10G10B10A2_UNORM;
+      case DXGI_FORMAT_R8G8B8A8_TYPELESS:
+        return DXGI_FORMAT_R8G8B8A8_UNORM;
+      case DXGI_FORMAT_B8G8R8A8_TYPELESS:
+        return DXGI_FORMAT_B8G8R8A8_UNORM;
+      default:
+        return format;
+      }
+    };
     // Depth: 32-bit float depth, which a depth/stencil depth (or an R32 one) is copied into first.
     WMTPixelFormat depth = WMTPixelFormatInvalid;
     switch (query(d.DepthFormat).PixelFormat) {
@@ -508,8 +544,8 @@ public:
       break;
     }
     WMTFXTemporalScalerInfo info{};
-    info.color_format = colour(d.ColorFormat);
-    info.output_format = colour(d.OutputFormat);
+    info.color_format = colour(typed(d.ColorFormat));
+    info.output_format = colour(typed(d.OutputFormat));
     info.depth_format = depth;
     info.motion_format = motion;
     info.reactive_mask_enabled = d.ReactiveMaskFormat != DXGI_FORMAT_UNKNOWN;
@@ -528,13 +564,29 @@ public:
     info.requires_synchronous_initialization = false;
     info.output_resolution_motion_vectors = d.OutputResolutionMotionVectors;
     info.jittered_motion_vectors = d.JitteredMotionVectors;
-    auto scaler = Com(new MTLD3D12TemporalScalerImpl(device, d, info));
-    if (!scaler->scaler->scaler()) {
-      ERR("CreateTemporalScaler: MetalFX made no upscaler for ", d.InputWidth, "x", d.InputHeight, " to ",
-          d.OutputWidth, "x", d.OutputHeight);
-      return E_OUTOFMEMORY;
+    // macOS 27.0.1's MetalFX never frees a temporal upscaler (~230 MB each, natively too; Ruling 5): the last 4 made
+    // are kept, and one only the device still holds (its D3D12 object released and every allocator that recorded it
+    // reset, so the GPU is done with it) serves the next request for the same info.
+    Rc<TemporalScaler> metal;
+    std::lock_guard<dxmt::mutex> lock(scalers_lock_);
+    auto kept = std::find_if(scalers_.begin(), scalers_.end(), [&](auto &s) {
+      return SameTemporalScaler(s.first, info) && s.second->refCount() == 1;
+    });
+    if (kept != scalers_.end()) {
+      metal = std::move(kept->second);
+      scalers_.erase(kept);
+    } else {
+      metal = new TemporalScaler(device, info);
+      if (!metal->scaler()) {
+        ERR("CreateTemporalScaler: MetalFX made no upscaler for ", d.InputWidth, "x", d.InputHeight, " to ",
+            d.OutputWidth, "x", d.OutputHeight);
+        return E_OUTOFMEMORY;
+      }
     }
-    *ppScaler = scaler.ref();
+    scalers_.emplace_back(info, metal); // the newest last
+    if (scalers_.size() > 4)
+      scalers_.erase(scalers_.begin());
+    *ppScaler = Com(new MTLD3D12TemporalScalerImpl(device, d, info, std::move(metal))).ref();
     return S_OK;
   }
 
diff --git a/src/d3d12/d3d12_device.hpp b/src/d3d12/d3d12_device.hpp
index 00ae382..a6f5dbe 100644
--- a/src/d3d12/d3d12_device.hpp
+++ b/src/d3d12/d3d12_device.hpp
@@ -105,11 +105,13 @@ public:
 // MacNeutron (XeSS answered by MetalFX): a MetalFX temporal upscaler, the description it was made from and the Metal
 // formats it takes. Scratch textures stand in for an input MetalFX can't take as it is (copied in first) and for an
 // output it can't write (copied out after), made on first use at the description's sizes in the upscaler's formats.
+// The upscaler may be one the device kept from an earlier object, with that one's history: the first upscale resets.
 class MTLD3D12TemporalScaler : public IMTLD3D12TemporalScaler {
 public:
   MTL_TEMPORAL_SCALER_D3D12_DESC desc;
   WMTFXTemporalScalerInfo info;
   Rc<TemporalScaler> scaler;
+  std::atomic<bool> fresh = true;
 
   enum class Scratch { Depth, Motion, Output };
   virtual Rc<Texture> GetScratch(Scratch which) = 0;
diff --git a/src/dxmt/dxmt_scaler.hpp b/src/dxmt/dxmt_scaler.hpp
index 6bc68d1..9b989a8 100644
--- a/src/dxmt/dxmt_scaler.hpp
+++ b/src/dxmt/dxmt_scaler.hpp
@@ -33,6 +33,11 @@ public:
 
   TemporalScaler(WMT::Device device, const WMTFXTemporalScalerInfo &info);
 
+  // MacNeutron: 1 when only its last holder has it (D3D12's pool of released upscalers)
+  uint32_t refCount() const {
+    return refcount_.load(std::memory_order_acquire);
+  }
+
   WMT::FXTemporalScaler scaler() {
     return scaler_;
   }
-- 
2.54.0 (Apple Git-157)

