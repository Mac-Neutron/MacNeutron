+    assert_eq!(h.read_pixel(10, 10), GREEN, "background cleared green");
+    let overlap = Rgba8::from_pixel(h.read_pixel(280, 300));
+    assert!(
+        overlap.b > overlap.r,
+        "overlap: near blue wins, got {overlap:?}"
+    );
+    let far_only = Rgba8::from_pixel(h.read_pixel(500, 350));
