diff --git a/mtld3d/windows/Cargo.toml b/mtld3d/windows/Cargo.toml
new file mode 100644
index 00000000..cd78fe49
--- /dev/null
+++ b/mtld3d/windows/Cargo.toml
@@ -0,0 +1,113 @@
+[workspace]
+members = ["shim", "d3d9", "core", "tests", "types"]
+resolver = "2"
+
+[workspace.package]
+edition = "2024"
+rust-version = "1.99"
+version = "0.14.1"
+license = "Zlib"
+description = "Direct3D 9 translation layer for Wine on macOS, backed by Metal"
+authors = ["Alexander Theissen <alex.theissen@me.com>"]
+keywords = ["direct3d", "d3d9", "metal", "wine", "macos"]
+categories = ["graphics", "emulators", "api-bindings"]
+repository = "https://github.com/athei/mtld3d"
+homepage = "https://github.com/athei/mtld3d"
+
+[workspace.dependencies]
+mtld3d-core = { path = "core" }
+mtld3d-shared = { path = "../unix/shared" }
+mtld3d-types = { path = "types" }
+bitflags = "2"
+log = "0.4"
+objc2 = "0.6"
+objc2-foundation = { version = "0.3", features = ["NSString", "NSError"] }
+objc2-metal = { version = "0.3", features = ["MTLDevice", "MTLLibrary"] }
+rustc-hash = "2"
+snmalloc-rs = { version = "0.7.6", features = ["build_cc"] }
+strum = { version = "0.28", default-features = false }
+xbr = { version = "0.2", default-features = false }
+xxhash-rust = { version = "0.8.19", features = ["xxh3"] }
+zstd = { version = "0.14", default-features = false }
+
+[profile.dev]
+panic = "abort"
+
+[profile.release]
+panic = "abort"
+lto = "thin"
+# Limited debug info for post-mortem symbolication of crash backtraces
+# (the `abort_backtrace` handler in d3d9, and any game-side crash dumper).
+# Function names + line tables + inline frame chain — last bit is
+# load-bearing because the codebase uses `#[inline(always)]` heavily,
+# so `line-tables-only` would collapse most call sites into their
+# parents. Skips variable type info (only useful in a live debugger).
+# On MSVC the bytes land in the side-by-side `.pdb`, not the shipped DLL.
+debug = 1
+
+# `release` is our dev/debug profile — the everyday `make` build and the e2e
+# both run against release-built DLLs, so a `cfg(debug_assertions)` guard (and
+# `overflow-checks`) would otherwise be compiled out of exactly the build under
+# test. Both are on so bugs trip during dev + testing: `debug-assertions`
+# carries every `debug_assert!` including the `LastBoundCache` cache-in-sync
+# guard; `overflow-checks` turns silent integer wraps into panics. `production`
+# (PROD=1, the only shipped artifact) overrides both back off below.
+debug-assertions = true
+overflow-checks = true
+
+# snmalloc-sys 0.7's build.rs reads cargo's `DEBUG` env var (set when the
+# package's debuginfo is enabled) and switches its cmake build to `Debug`
+# mode + `cargo:rustc-link-lib=msvcrtd`. xwin only ships `msvcrt.lib`, and
+# mixing CRTs in one DLL is unsound — force `DEBUG=false` for snmalloc-sys
+# alone so its build script picks the release CRT. Applied to both
+# profiles since dev defaults to `debug = 2`.
+[profile.release.package.snmalloc-sys]
+debug = 0
+
+[profile.dev.package.snmalloc-sys]
+debug = 0
+
+# zstd-sys's build.rs goes through the `cc` crate, which reads cargo's
+# `DEBUG` env var the same way snmalloc-sys does and would link `msvcrtd`
+# on i686/x64 windows-msvc when our workspace `debug = 1` is set. Same
+# mitigation: force `DEBUG=false` so its `cc::Build` picks the release
+# CRT (`/MD`, not `/MDd`). The DLLs do not link zstd, since `mtld3d-core`
+# builds its disk cache only with the `disk-cache` feature. The e2e test
+# executables do, because they read and write cache files.
+[profile.release.package.zstd-sys]
+debug = 0
+
+[profile.dev.package.zstd-sys]
+debug = 0
+
+# Shipped builds — fat cross-crate LTO + a single codegen unit so the
+# linker can inline and DCE across the whole DLL. Inherits everything
+# else from `release`, including the per-package `debug = 0` overrides
+# on `snmalloc-sys` / `zstd-sys` (cargo merges per-package overrides
+# through the `inherits` chain), but overrides `debug-assertions` +
+# `overflow-checks` back off (release carries them for dev/test; the shipped
+# artifact must not pay the cost or panic in users' hands). Activated by
+# `PROD=1 make`.
+[profile.production]
+inherits = "release"
+lto = "fat"
+codegen-units = 1
+debug-assertions = false
+overflow-checks = false
+
+# Warn-level so a plain `cargo clippy` (or an editor) reports findings without
+# hard-failing; the hard gate is `make check`, which denies every warning via
+# cargo's `build.warnings = "deny"`.
+[workspace.lints.clippy]
+nursery = { level = "warn", priority = -1 }
+pedantic = { level = "warn", priority = -1 }
+# Length is a poor proxy for complexity; allow long procedural functions
+# (frame encoder, MSL codegen templates, per-opcode dispatchers) where the
+# structural alternative is fragmented helpers threading the same state.
+too_many_lines = "allow"
+# Stricter unsafe discipline (see docs/CONVENTIONS.md §"Unsafe is a last resort").
+missing_safety_doc = "warn"
+not_unsafe_ptr_arg_deref = "warn"
+transmute_ptr_to_ref = "warn"
+multiple_unsafe_ops_per_block = "warn"
+undocumented_unsafe_blocks = "warn"
diff --git a/mtld3d/windows/core/Cargo.toml b/mtld3d/windows/core/Cargo.toml
new file mode 100644
index 00000000..b88f506b
--- /dev/null
+++ b/mtld3d/windows/core/Cargo.toml
@@ -0,0 +1,52 @@
+[package]
+name = "mtld3d-core"
+version.workspace = true
+edition.workspace = true
+rust-version.workspace = true
+license.workspace = true
+description.workspace = true
+authors.workspace = true
+
+[dependencies]
+mtld3d-shared = { workspace = true }
+mtld3d-types = { workspace = true }
+bitflags = { workspace = true }
+log = { workspace = true }
+rustc-hash = { workspace = true }
+strum = { workspace = true, features = ["derive"] }
+xxhash-rust = { workspace = true }
+zstd = { workspace = true, optional = true }
+
+# `disk-cache` builds `shader_cache`, the on-disk shader and pipeline cache and
+# its zstd framing. Only the Unix dylib reads and writes the cache, so it and the
+# host tests enable it; the PE DLLs leave it off and link no zstd.
+[features]
+disk-cache = ["dep:zstd"]
+
+[[example]]
+name = "emit_corpus"
+required-features = ["disk-cache"]
+
+[build-dependencies]
+xxhash-rust = { workspace = true }
+
+# Used by the `dxso::emit_tests` MSL-compile checks (`metal_compile_or_fail`)
+# to compile every emitted shader through
+# `MTLDevice::newLibraryWithSource_options_error`. Same crates the
+# production unix .so uses (`unix/unix/Cargo.toml`) so test and runtime
+# stay aligned. mtld3d-core tests only ever build on macOS (`make clippy`
+# only passes `--all-targets` for the unix target), so no target-gate is
+# needed.
+[dev-dependencies]
+objc2 = { workspace = true }
+objc2-foundation = { workspace = true }
+objc2-metal = { workspace = true }
+# `tests/snmalloc_drift.rs` installs this as its own `#[global_allocator]` so
+# the `page_box` chunk-size model can be checked against the allocator that
+# actually ships, rather than against a comment. Integration tests are separate
+# binaries, so only that one runs on snmalloc; the unit-test binary keeps the
+# system allocator. Same `build_cc` config as `d3d9` uses in production.
+snmalloc-rs = { workspace = true }
+
+[lints]
+workspace = true
diff --git a/mtld3d/windows/core/build.rs b/mtld3d/windows/core/build.rs
new file mode 100644
index 00000000..fce21687
--- /dev/null
+++ b/mtld3d/windows/core/build.rs
@@ -0,0 +1,61 @@
+use std::{fs, hash::Hasher, path::Path};
+
+use xxhash_rust::xxh3::Xxh3;
+
+fn main() {
+    emitter_fingerprint();
+    println!("cargo::rustc-check-cfg=cfg(perf_tracking)");
+    println!("cargo:rerun-if-env-changed=MTLD3D_PERF");
+    if std::env::var("MTLD3D_PERF").is_ok_and(|v| !v.is_empty() && v != "0") {
+        println!("cargo:rustc-cfg=perf_tracking");
+    }
+}
+
+// Paths and lengths delimit the hash input, independent of checkout path and target.
+fn emitter_fingerprint() {
+    let mut paths = Vec::new();
+    collect_sources(Path::new("src/dxso"), &mut paths);
+    paths.extend([
+        "src/dxso.rs".into(),
+        "src/vs_draw.rs".into(),
+        "src/ps_draw.rs".into(),
+        "../../unix/shared/src/mtl.rs".into(),
+        "../../unix/shared/src/shader_create.rs".into(),
+    ]);
+    paths.sort();
+    let mut hash = Xxh3::new();
+    for path in paths {
+        println!("cargo:rerun-if-changed={}", path.display());
+        let name = path.to_str().expect("source path is UTF-8");
+        let bytes = fs::read(&path).expect("read shader emission source");
+        hash.write(&(name.len() as u64).to_le_bytes());
+        hash.write(name.as_bytes());
+        hash.write(&(bytes.len() as u64).to_le_bytes());
+        hash.write(&bytes);
+    }
+    let out = std::env::var_os("OUT_DIR").expect("Cargo OUT_DIR");
+    fs::write(
+        Path::new(&out).join("emitter_version.rs"),
+        format!("u64::from_le_bytes({:?})", hash.finish().to_le_bytes()),
+    )
+    .expect("write shader emitter fingerprint");
+}
+
+fn collect_sources(dir: &Path, paths: &mut Vec<std::path::PathBuf>) {
+    println!("cargo:rerun-if-changed={}", dir.display());
+    for entry in fs::read_dir(dir).expect("read shader source directory") {
+        let path = entry.expect("shader source entry").path();
+        let name = path
+            .file_stem()
+            .and_then(|name| name.to_str())
+            .expect("source name");
+        if name == "tests" || name.ends_with("_tests") {
+            continue;
+        }
+        if path.is_dir() {
+            collect_sources(&path, paths);
+        } else if path.extension().is_some_and(|ext| ext == "rs") {
+            paths.push(path);
+        }
+    }
+}
diff --git a/mtld3d/windows/core/examples/disasm.rs b/mtld3d/windows/core/examples/disasm.rs
new file mode 100644
index 00000000..a5e51ced
--- /dev/null
+++ b/mtld3d/windows/core/examples/disasm.rs
@@ -0,0 +1,87 @@
+//! Offline disassembler for DXSO bytecode dumped via `MTLD3D_BYTECODE_DUMP`.
+//!
+//! Usage: `cargo run --example disasm --target x86_64-apple-darwin -- <file.dxso>`
+//!
+//! Prints the parsed IR as Debug and the MSL the emitter produces, so a
+//! captured bytecode blob can be inspected without launching Wine.
+
+use std::{env, fs, process};
+
+use mtld3d_core::dxso::{self, VariantKey};
+
+fn main() {
+    let path = env::args().nth(1).unwrap_or_else(|| {
+        eprintln!("usage: disasm <file.dxso>");
+        process::exit(2);
+    });
+    let bytes = match fs::read(&path) {
+        Ok(b) => b,
+        Err(e) => {
+            eprintln!("read {path}: {e}");
+            process::exit(2);
+        }
+    };
+    if bytes.len() % 4 != 0 {
+        eprintln!(
+            "file size {} not a multiple of 4 — not a DXSO token stream",
+            bytes.len()
+        );
+        process::exit(2);
+    }
+    let tokens: Vec<u32> = bytes
+        .as_chunks::<4>()
+        .0
+        .iter()
+        .map(|c| u32::from_le_bytes(*c))
+        .collect();
+
+    println!("== tokens ({n} words) ==", n = tokens.len());
+    for (i, t) in tokens.iter().enumerate() {
+        println!("  [{i:3}] {t:#010x}");
+    }
+    println!();
+
+    let program = match dxso::parse(&tokens) {
+        Ok(p) => p,
+        Err(e) => {
+            eprintln!("parse failed: {e:?}");
+            process::exit(1);
+        }
+    };
+    println!("== parsed IR ==");
+    println!("shader_type: {:?}", program.shader_type);
+    println!("declarations:");
+    for d in &program.declarations {
+        println!("  {d:?}");
+    }
+    println!("def constants:");
+    for c in &program.def_constants {
+        println!("  {c:?}");
+    }
+    println!("instructions:");
+    for (i, inst) in program.instructions.iter().enumerate() {
+        println!("  [{i:3}] {inst:#?}");
+    }
+    println!();
+
+    let depth_mask: u16 = env::args()
+        .nth(2)
+        .and_then(|s| {
+            s.strip_prefix("0x")
+                .map_or_else(|| s.parse().ok(), |hex| u16::from_str_radix(hex, 16).ok())
+        })
+        .unwrap_or(0);
+    let variant = VariantKey {
+        depth_sampler_mask: depth_mask,
+        ..VariantKey::default()
+    };
+    println!("== emitted MSL (depth_sampler_mask = {depth_mask:#x}) ==");
+    let msl = match program.shader_type {
+        dxso::ShaderType::Vertex => dxso::emit_vs_programmable(&program),
+        dxso::ShaderType::Pixel => dxso::emit_ps_programmable(&program, variant),
+    };
+    match msl {
+        Ok(s) => println!("{s}"),
+        Err(e) => eprintln!("emit failed: {e:?}"),
+    }
+}
