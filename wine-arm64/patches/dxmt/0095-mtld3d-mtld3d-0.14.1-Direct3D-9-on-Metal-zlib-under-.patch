+        sample_at(&h, &tex, 160, 240).to_pixel(),
+        RED,
+        "surface edit explicitly published",
+    );
+    assert_eq!(h.reset(640, 480), 0);
+    assert_pixel_eq(
+        sample_center(&h, &tex).to_pixel(),
+        RED,
