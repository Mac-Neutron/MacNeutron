+    // EXP2 squares the density-scaled distance.
+    let exp2 = emit_pair_for_tests(
+        &vs,
+        &ps,
+        VariantKey {
+            fog_table_mode: 2,
+            flags: VariantFlags::FOG_SOURCE_W,
+            ..VariantKey::default()
+        },
+    );
+    assert!(
+        exp2.contains("float fog_f = saturate(precise::exp(-fog_dz * fog_dz));"),
+        "{exp2}"
+    );
