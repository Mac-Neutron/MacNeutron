+    pub fn create_offscreen_plain_surface(
+        &self,
+        width: u32,
+        height: u32,
+        format: u32,
+        pool: u32,
+    ) -> Surface<'_> {
+        let mut out: *mut c_void = core::ptr::null_mut();
