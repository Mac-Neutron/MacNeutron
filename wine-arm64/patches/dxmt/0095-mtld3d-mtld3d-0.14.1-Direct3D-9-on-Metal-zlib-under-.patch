+    // stored, and a render target 1 that loads beside a stored clear of
+    // render target 0.
+    assert_eq!(s.passes[0].color_load, ColorLoad::DontCare);
+    assert_eq!(s.passes[1].color_load, ColorLoad::Load);
+    s.passes[2].color_load = ColorLoad::Clear {
+        r: 1,
+        g: 2,
+        b: 3,
