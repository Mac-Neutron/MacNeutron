+            // component (index n-1) into `.w` as the divisor.
+            if projected && n >= 1 {
+                let comp = ['x', 'y', 'z', 'w'][(n - 1) as usize];
+                let _ = writeln!(
+                    out,
+                    "    out.texcoord{i} = float4(raw{i}.xyz, raw{i}.{comp});"
