+            expected,
+            "a whole-surface copy"
+        );
+        assert_eq!(
+            h.stretch_rect_rects(&src, (0, 0, 8, 8), &dst, (0, 0, 8, 8), D3DTEXF_NONE),
+            D3DERR_INVALIDCALL,
+            "rects, even whole ones, make it a stretch"
+        );
+        if expected == D3D_OK {
+            assert_pixel_eq(sample_center(h, &destination), BLUE, "the copy landed");
+        }
+    }
