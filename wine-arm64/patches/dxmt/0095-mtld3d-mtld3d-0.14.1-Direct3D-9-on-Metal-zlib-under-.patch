+    );
+    assert_eq!(h.clear(D3DCLEAR_TARGET, BLACK, 1.0, 0), 0);
+    let second = sample_center();
+    assert!(
+        (170..=210).contains(&second.r),
+        "the second sample reads the resolved 0.75 as light gray, got {second:?}"
+    );
