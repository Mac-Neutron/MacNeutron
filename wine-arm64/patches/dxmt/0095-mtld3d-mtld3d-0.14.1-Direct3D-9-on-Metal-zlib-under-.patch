+/// The meta of a host benchmark file: its own arch and profile, and its binary's image.
+fn meta_host<'a>(layer: &'a str, image: &'a str) -> Vec<(&'a str, &'a str)> {
+    vec![
+        ("kind", "host"),
+        ("layer", layer),
+        ("host_image", image),
+        ("arch", "aarch64"),
+        ("profile", "production"),
+        ("debug_assertions", "off"),
+    ]
+}
