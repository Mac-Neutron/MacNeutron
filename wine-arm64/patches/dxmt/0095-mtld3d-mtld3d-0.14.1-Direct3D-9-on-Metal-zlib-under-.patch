+    assert_eq!(group.faults.wait_interruptions, 0);
+    assert_waitable(pid);
+    group.faults.wait_interruptions = 1;
+    group.kill().expect("kill retries an interruption");
+    assert_eq!(group.faults.wait_interruptions, 0);
+    group.faults.reap_interruptions = 1;
+    assert_eq!(
