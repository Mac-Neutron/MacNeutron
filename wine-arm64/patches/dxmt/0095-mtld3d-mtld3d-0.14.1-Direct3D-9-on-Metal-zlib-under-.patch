+fn dotproduct3_alpha_cascade(
+    h: &Harness,
+    color_arg: u32,
+    alpha_arg: u32,
+    diffuse: u32,
+    factor: u32,
+) -> Rgba8 {
+    use mtld3d_types::{D3DTA_ALPHAREPLICATE, D3DTA_CURRENT, D3DTOP_DOTPRODUCT3};
+
+    assert_eq!(h.set_render_state(D3DRS_LIGHTING, 0), 0);
