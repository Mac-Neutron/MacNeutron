+}
+
+#[test]
+fn texture_caps_matches_implementation() {
+    let expected = TextureCaps::ALPHA
+        | TextureCaps::PERSPECTIVE
+        | TextureCaps::TEXREPEATNOTSCALEDBYSIZE
+        | TextureCaps::PROJECTED
+        | TextureCaps::MIPMAP
+        | TextureCaps::CUBEMAP
+        | TextureCaps::MIPCUBEMAP
