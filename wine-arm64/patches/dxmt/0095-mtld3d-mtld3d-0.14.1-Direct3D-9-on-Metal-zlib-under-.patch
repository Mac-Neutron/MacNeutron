+            r: red.0,
+            g: red.1,
+            b: red.2,
+            a: red.3
+        }
+    );
+    assert_eq!(pass.color_clear_rgba(), Some(red));
+    assert_eq!(s.passes()[1].color_clear_rgba(), Some(blue));
+}
