+            msaa_srgb,
+            sample_count,
+            format,
+            has_alpha,
+            width,
+            height,
+        } => capture_fixed!(
+            recorder,
+            scratch,
+            tag,
+            1,
+            BindColorStandaloneRecord {
+                handle: handle.raw(),
+                srgb: srgb.raw(),
+                msaa: msaa.raw(),
+                msaa_srgb: msaa_srgb.raw(),
