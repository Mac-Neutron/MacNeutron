+                self.record_typed(scratch, value)
+            }
+            Op::DestroyTexture(value) => {
+                #[cfg(not(windows))]
+                let value = *value;
+                self.record_typed(scratch, value)
+            }
+            Op::DestroyBuffer(value) => {
+                #[cfg(not(windows))]
+                let value = *value;
+                self.record_typed(scratch, value)
+            }
+            Op::NoteColorRead(value) => {
+                #[cfg(not(windows))]
+                let value = *value;
+                self.record_typed(scratch, value)
+            }
+            Op::ResolveDepthSurface(value) => {
+                #[cfg(not(windows))]
