+        0
+    );
+    assert_eq!(
+        h.set_texture_stage_state(0, D3DTSS_COLORARG1, D3DTA_TEXTURE),
+        0
+    );
+    assert_eq!(h.set_fvf(D3DFVF_XYZ | D3DFVF_DIFFUSE | D3DFVF_TEX1), 0);
+
+    let v = |x: f32, y: f32| TexturedVertex {
+        x,
+        y,
+        z: 0.5,
+        color: 0,
+        u: 0.75,
+        v: 0.5,
