+        "hidden mip stays unchanged",
+    );
+    assert_eq!(tex.add_dirty_rect(), 0);
+    assert_pixel_eq(
+        sample_center(&h, &tex).to_pixel(),
+        GREEN,
+        "published base regenerates hidden mip",
+    );
+}
