+fn uneven_command_frame(s: &mut PassState) {
+    for pass in 0..37 {
+        for _ in 0..(65 << (pass % 6)) {
+            s.emit_command(dummy_draw());
+        }
+        s.end_current_pass("test");
+    }
+}
