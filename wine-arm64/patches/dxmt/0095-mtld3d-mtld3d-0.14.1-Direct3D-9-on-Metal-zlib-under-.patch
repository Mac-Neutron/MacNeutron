+            h.create_depth_stencil_surface_ms_hr((4, 4), format, (D3DMULTISAMPLE_NONE, 0));
+        drop(ds);
+        sweep.compare(
+            "CreateDepthStencilSurface",
+            format,
+            check(&h, D3DUSAGE_DEPTHSTENCIL, D3DRTYPE_SURFACE, format),
+            hr,
