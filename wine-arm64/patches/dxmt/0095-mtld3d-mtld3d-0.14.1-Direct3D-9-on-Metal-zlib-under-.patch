+        .into_frame()
+        .unwrap_or_else(|(error, _)| panic!("complete: {error:?}"));
+    assert!(!owner.maintain());
+    let (vertices, indices) = retained.unwrap();
+    assert_eq!(vertices.as_slice(), &[0x5a; 4800]);
+    assert_eq!(indices.as_slice(), &[0, 0, 1, 0, 2, 0]);
+    drop(submitted);
+    drain_all(&owner);
+    assert!(owner.maintain());
