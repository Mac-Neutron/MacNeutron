+    resolved_row(
+        &h,
+        &h.back_buffer(0),
+        &staging,
+        "the depth-tested 4x edge resolves and the near draw's white survives the occluded blue",
+        "intermediate pixels along the edge and 0xffffffff at x=4",
+        |row| count_intermediate(row) > 0 && row[INSIDE_X as usize] == WHITE,
