+            DirtyRect {
+                x: rx,
+                y: ry,
+                w: rw,
+                h: rh,
+            },
+            (dx, dy),
+            (sw, sh),
+            (dw, dh),
+            (bw, bh),
+        ) else {
+            return false;
+        };
