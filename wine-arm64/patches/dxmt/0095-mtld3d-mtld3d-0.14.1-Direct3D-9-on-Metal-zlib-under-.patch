+            let tex = h.create_texture(64, 64, 0, D3DUSAGE_AUTOGENMIPMAP, format, pool);
+            tex.lock_rect(0, 0).write(&[texel; 64 * 64]);
+            assert_pixel_approx(
+                sample_center(&h, &tex).to_pixel(),
+                expected,
+                2,
+                &format!("{name} pool {pool}: generated level 4"),
