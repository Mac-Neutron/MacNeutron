+#[test]
+fn scaled_resz_resamples_common_planes_in_logical_space() {
+    use mtld3d_types::D3DRECT;
+    for config_entries in ["render.scale=0.75", "render.scale=0.67"] {
+        let h = Harness::create(&HarnessConfig {
