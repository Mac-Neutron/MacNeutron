+    pub fn additional_swapchain_params(&self, pp: &mut D3DPRESENT_PARAMETERS) -> SwapChain<'_> {
+        let (hr, chain) = self.try_additional_swapchain(pp);
+        expect_ok(hr, "CreateAdditionalSwapChain");
+        chain.expect("a created swap chain")
+    }
