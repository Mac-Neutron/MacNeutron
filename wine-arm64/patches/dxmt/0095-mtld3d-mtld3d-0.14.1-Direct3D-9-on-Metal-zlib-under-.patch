+        "clear the 1x1 target"
+    );
+    masked_draw(&h, 0.5);
+    let right_half = D3DRECT {
+        x1: 128,
+        y1: 0,
+        x2: 256,
+        y2: 256,
+    };
+    assert_eq!(
+        h.set_scissor_rect(&right_half),
+        D3D_OK,
+        "scissor over the right half"
+    );
