+        s.passes()[0].color_attachment_texture(),
+        rt_msaa,
+        "the clear paints the companion the resolve reads"
+    );
+    assert_eq!(
+        s.passes()[1].extra_color()[0].resolve_texture(),
+        rt,
+        "the middle pass resolves into the cleared target"
+    );
+    s.coalesce_clear_only_passes();
