+        &tex.lock_rect_partial(0, &[0, 0, 32, 64], D3DLOCK_NO_DIRTY_UPDATE),
+        32,
+        64,
+        GREEN,
+    );
+    assert_pixel_eq(
+        sample_at(&h, &tex, 160, 240).to_pixel(),
+        GREEN,
+        "initial edited pixels",
+    );
+    assert_pixel_eq(
+        sample_at(&h, &tex, 480, 240).to_pixel(),
+        RED,
+        "initial unedited pixels",
+    );
+    tex.surface_level(0)
+        .lock_rect(D3DLOCK_NO_DIRTY_UPDATE)
+        .write_u32(&[RED; 64 * 64]);
