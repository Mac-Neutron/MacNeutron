+#[test]
+fn set_get_round_trip() {
+    let h = Harness::new();
+    for (state, value) in [
+        (D3DRS_CULLMODE, D3DCULL_CW),
+        (D3DRS_SRCBLEND, D3DBLEND_SRCALPHA),
+        (D3DRS_DESTBLEND, D3DBLEND_INVSRCALPHA),
+        (D3DRS_COLORWRITEENABLE, 0x0000_0007),
