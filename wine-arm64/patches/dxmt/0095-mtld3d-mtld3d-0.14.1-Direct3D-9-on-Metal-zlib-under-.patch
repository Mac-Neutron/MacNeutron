+        | RasterCaps::ZTEST
+        | RasterCaps::COLORPERSPECTIVE
+        | RasterCaps::FOGTABLE
+        | RasterCaps::WFOG
+        | RasterCaps::FOGVERTEX
+        | RasterCaps::FOGRANGE
+        | RasterCaps::MIPMAPLODBIAS
+        | RasterCaps::ANISOTROPY
+        | RasterCaps::ZFOG
+        | RasterCaps::SCISSORTEST
+        | RasterCaps::SLOPESCALEDEPTHBIAS
+        | RasterCaps::DEPTHBIAS;
