+        0,
+        "1:1 same-format StretchRect between DEFAULT RTs",
+    );
+    assert_eq!(h.set_render_target(0, &bb), 0, "restore backbuffer");
+    assert_eq!(
+        read_surface_pixel(&h, &dst, 32, 32),
+        GREEN,
+        "the copy reads the source after its pending clear"
+    );
