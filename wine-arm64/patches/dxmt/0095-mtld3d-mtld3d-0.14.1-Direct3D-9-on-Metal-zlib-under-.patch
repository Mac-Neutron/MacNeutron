+    assert_eq!(hr, 0, "PS const I get");
+    assert_eq!(ps_i, [5, 6, 7, 8], "PS const I round-trip");
+
+    let (hr, ps_b) = h.get_pixel_shader_constant_b(0, 2);
+    assert_eq!(hr, 0, "PS const B get");
