+/// A cached texture whose level slots are `levels`.
+fn wrapped_texture(levels: Vec<MipStagingBuffer>) -> TextureGpuState {
+    TextureGpuState {
+        views: mtld3d_shared::texture_views::TextureViews::EMPTY,
+        mip_staging_buffers: levels,
+    }
+}
