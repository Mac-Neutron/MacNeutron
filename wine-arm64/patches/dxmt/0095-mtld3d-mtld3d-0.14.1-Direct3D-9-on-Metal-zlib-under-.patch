+        assert_eq!(h.update_texture_hr(&staging, &source), D3D_OK);
+        let destination = h.create_texture(8, 8, 1, 0, D3DFMT_A8R8G8B8, D3DPOOL_DEFAULT);
+        let (src, dst) = (source.surface_level(0), destination.surface_level(0));
+        assert_eq!(
