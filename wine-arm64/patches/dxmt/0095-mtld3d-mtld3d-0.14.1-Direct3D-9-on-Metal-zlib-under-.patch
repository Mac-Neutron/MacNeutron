+}
+
+/// A state block recorded before the `Reset` binds the replacement after it.
+#[test]
+fn a_state_block_from_before_a_same_size_reset_binds_the_replacement() {
+    let h = Harness::new();
+    run(
+        &h,
+        &Scenario {
