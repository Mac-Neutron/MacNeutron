+        D3D_OK,
+        "depth clear of the right half"
+    );
+    assert_eq!(h.set_render_state(D3DRS_SCISSORTESTENABLE, 0), D3D_OK);
+    let (probes, small) = s.probe(&h);
+    assert_probes(
+        probes,
+        [RED, GREEN, GREEN],
+        "the right half was cleared back, the left half kept the draw",
