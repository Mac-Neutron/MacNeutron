+    let masked_vs = parse(&masked_bc).expect("masked vs_1_1 parse");
+    let masked_msl = emit_vs_programmable(&masked_vs).expect("emit masked vs_1_1");
+    assert!(
+        masked_msl.contains("r[0].yz =")
