+    /// across frames just like the API mirror.
+    vs_constants_mirror: Box<[[f32; 4]; CONSTANT_ROWS]>,
+    ps_constants_mirror: Box<[[f32; 4]; CONSTANT_ROWS]>,
+    /// High-watermark of populated rows in each mirror.
