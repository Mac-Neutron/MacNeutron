+    for cmd in pass.commands() {
+        if cmd.cmd == CommandType::SetTriangleFillMode as u32 {
+            fill = cmd.param_a;
+        }
+        if cmd.is_draw() {
+            draw_modes.push(fill);
+        }
+    }
+    assert_eq!(
+        draw_modes,
+        [
