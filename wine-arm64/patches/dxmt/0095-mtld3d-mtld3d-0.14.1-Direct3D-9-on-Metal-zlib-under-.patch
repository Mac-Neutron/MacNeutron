+        0xC00F_0000,
+        0x90E4_0000, // mov oPos, v0
+        0x0000_0001,
+        0xD00F_0000,
+        0xA0E4_0000, // mov oD0, c0
+        0x0000_FFFF, // end
+    ];
+    let vs = parse(&bc).expect("vs_1_1 parse");
+    let msl = emit_vs_programmable(&vs).expect("vs_1_1 emit");
+    assert!(
