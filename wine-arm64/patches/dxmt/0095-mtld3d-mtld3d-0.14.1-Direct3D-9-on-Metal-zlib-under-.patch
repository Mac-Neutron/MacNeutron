+    // vs_1_1 { expp r0, c0.x; mov oPos, c1; mov oD0, r0; }
+    let bc = [
+        0xFFFE_0101,
+        0x0000_004E,
+        0x800F_0000,
+        0xA000_0000,
+        0x0000_0001,
+        0xC00F_0000,
+        0xA0E4_0001,
+        0x0000_0001,
+        0xD00F_0000,
+        0x80E4_0000,
