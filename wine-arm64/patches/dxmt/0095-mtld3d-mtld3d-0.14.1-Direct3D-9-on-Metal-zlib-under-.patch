+    let ib = h.create_index_buffer(12, D3DUSAGE_WRITEONLY, D3DFMT_INDEX16, D3DPOOL_DEFAULT);
+    let (hr, desc) = ib.desc();
+    assert_eq!(hr, 0, "GetDesc");
