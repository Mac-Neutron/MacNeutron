+                    "        diffuseAccum += atten * ndotl * (vs_c[{d}] * {mat_diffuse});",
+                    d = base + 2
+                );
+            }
+            let _ = writeln!(
+                out,
+                "        diffuseAccum += atten * (vs_c[{a}] * {mat_ambient});",
+                a = base + 3
