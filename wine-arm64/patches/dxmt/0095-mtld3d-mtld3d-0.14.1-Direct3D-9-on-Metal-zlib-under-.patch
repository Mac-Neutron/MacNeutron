+#[test]
+fn query_core_u32_clamp() {
+    let core = VisibilityQueryCore::new();
+    core.begin(0, 0, (640, 480), (640, 480), 0);
+    core.end(0, 1);
+    core.accumulate_segment(u64::MAX);
