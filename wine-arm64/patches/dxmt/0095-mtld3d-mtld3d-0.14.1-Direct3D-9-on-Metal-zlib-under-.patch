+/// A position and a colour, 16 bytes, the stride the short-stride tests bind.
+#[repr(C)]
+#[derive(Clone, Copy)]
+struct PackedVertex {
+    x: f32,
+    y: f32,
+    z: f32,
+    color: u32,
+}
