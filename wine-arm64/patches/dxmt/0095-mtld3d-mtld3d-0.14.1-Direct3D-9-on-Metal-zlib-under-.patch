+    let mut ps = default_ps_key();
+    ps.stages[0] = FfStage {
+        color_op: 4,
+        color_arg1: 2,
+        color_arg2: 1,
+        alpha_op: 4,
+        alpha_arg1: 2,
+        alpha_arg2: 1,
