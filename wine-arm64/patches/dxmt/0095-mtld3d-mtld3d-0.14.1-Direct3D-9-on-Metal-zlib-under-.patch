+                    bytes: vertices,
+                    size: 4800,
+                    stride: 16,
+                },
+                index_source: IndexSource::Up {
+                    bytes: index_data,
+                    index_count: 3,
+                    index_type: IndexType::UInt16,
+                },
+            },
