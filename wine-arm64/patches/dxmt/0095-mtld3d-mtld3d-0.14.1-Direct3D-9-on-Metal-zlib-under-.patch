+    assert_eq!(s.passes()[0].color_texture(), MetalHandle::NULL);
+    assert_eq!(s.passes()[0].depth_load(), DepthLoad::Clear { value: z });
+    assert_eq!(s.passes()[1].depth_load(), DepthLoad::Load);
+}
