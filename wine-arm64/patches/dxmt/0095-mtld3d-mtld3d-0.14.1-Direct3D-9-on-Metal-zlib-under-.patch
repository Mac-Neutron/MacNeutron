+/// The position at byte 0 and a colour read at byte 28 of a 16-byte vertex.
+pub const fn crossing_color_elements() -> [D3DVERTEXELEMENT9; 3] {
+    [
+        element(0, D3DDECLTYPE_FLOAT3, D3DDECLUSAGE_POSITION),
+        D3DVERTEXELEMENT9 {
