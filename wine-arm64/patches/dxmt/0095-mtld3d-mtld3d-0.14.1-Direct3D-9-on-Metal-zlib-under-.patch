+    let px = h.read_pixel(320, 280);
+    let (r, g) = ((px >> 16) & 0xff, (px >> 8) & 0xff);
+    assert!(
+        r <= 2 && g.abs_diff(0x80) <= 2,
+        "specular add disabled leaves diffuse only, got 0x{px:08x}",
