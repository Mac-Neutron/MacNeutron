+        );
+        let (hr, src) = h.try_create_volume_texture([2, 2, 2], 0, 0, D3DFMT_V16U16, pool);
+        assert_eq!(hr, 0);
+        let src = src.expect("volume");
+        assert_eq!(src.level_count(), 2);
+        src.write_u32(
+            0,
+            &[
+                0x0000_7fff,
+                0x0000_7fff,
+                0x0000_7fff,
+                0x0000_7fff,
+                0x7fff_0000,
+                0x7fff_0000,
+                0x7fff_0000,
+                0x7fff_0000,
