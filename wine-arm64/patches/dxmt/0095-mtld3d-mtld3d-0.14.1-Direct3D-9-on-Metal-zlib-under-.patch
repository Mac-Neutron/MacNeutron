+            msl.contains(
+                "out.point_size = clamp(psize, vs_draw.point.y, vs_draw.point.z) * pos_fixup.w;"
+            ),
+            "FF VS must convert the clamped point size to render pixels:\n{msl}"
+        );
+    }
