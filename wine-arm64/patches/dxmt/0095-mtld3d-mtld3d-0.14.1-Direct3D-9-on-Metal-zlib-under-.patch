+    );
+    assert_eq!(
+        h.set_sampler_state(D3DVERTEXTEXTURESAMPLER0, D3DSAMP_MAXMIPLEVEL, 3),
+        0
+    );
+    assert_eq!(
+        vertex_fetch_at_lod(&h, 1.0),
+        MIP_TINTS[3],
