+/// Bind [`PS_SAMPLE_TEXTURE_LOD`] over the armed mip-tinted stage.
+fn arm_explicit_lod_shader(h: &Harness) {
+    let ps = h.create_pixel_shader(&PS_SAMPLE_TEXTURE_LOD);
