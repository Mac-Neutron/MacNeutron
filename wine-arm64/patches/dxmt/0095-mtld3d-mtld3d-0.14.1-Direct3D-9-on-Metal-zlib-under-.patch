+/// An untouched mip uploaded in the same frame survives a texture rename.
+#[test]
+fn intra_frame_rename_preserves_earlier_mip_upload() {
+    const RED: u32 = 0xFFFF_0000;
+    const YELLOW: u32 = 0xFFFF_FF00;
