+#[test]
+fn the_same_work_under_other_handles_is_the_same_shape() {
+    let log = trace(&steady());
+    let base = frame_of(&log).unwrap();
+    let cand = frame_of(&moved(&log)).unwrap();
+    assert!(diff(&base, &cand).is_empty(), "{:?}", diff(&base, &cand));
+}
