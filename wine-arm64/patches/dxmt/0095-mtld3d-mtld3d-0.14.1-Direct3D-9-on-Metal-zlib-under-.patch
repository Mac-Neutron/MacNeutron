+/// Whether some pass of `s` still clears render target 0 `texture`.
+fn clears_colour_of(s: &PassState, texture: MetalHandle<MTLTextureKind>) -> bool {
+    s.passes()
+        .iter()
+        .any(|p| p.color_texture() == texture && matches!(p.color_load(), ColorLoad::Clear { .. }))
+}
