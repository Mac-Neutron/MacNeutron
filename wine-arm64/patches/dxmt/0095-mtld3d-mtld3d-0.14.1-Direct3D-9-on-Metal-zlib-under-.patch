+/// A cached level wrapper over `length` staging bytes, or an empty slot for a null `handle`.
+fn wrapper(handle: u64, length: u64) -> MipStagingBuffer {
+    MipStagingBuffer {
+        handle: buffer(handle),
+        backing_ptr: handle << 16,
+        length,
+        keepalive: None,
+        kept_after_release: false,
+    }
+}
