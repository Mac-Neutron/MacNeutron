+/// Render target 1's `(src, dst, src_alpha, dst_alpha)` in a native description.
+fn extra_factors(
+    p: &PipelineDescription<'_>,
+) -> (BlendFactor, BlendFactor, BlendFactor, BlendFactor) {
+    (
+        p.extra[0].src_blend,
+        p.extra[0].dst_blend,
+        p.extra[0].src_blend_alpha,
+        p.extra[0].dst_blend_alpha,
+    )
+}
