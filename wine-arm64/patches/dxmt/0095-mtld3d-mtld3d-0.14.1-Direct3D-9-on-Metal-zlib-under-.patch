+    fn inner(&self) -> &SurfaceInner {
+        // SAFETY: `self.inner` was installed by `Self::new` as a
+        // `Box::into_raw` and is dropped only in `surface_release` at
+        // refcount zero, so it stays live for every live wrapper
+        // reference.
+        unsafe { &*self.inner }
+    }
