+/// Position, normal, diffuse and specular: the `XYZ | NORMAL | DIFFUSE | SPECULAR` FVF.
+#[repr(C)]
+struct LitSpecularVertex {
+    position: [f32; 3],
+    normal: [f32; 3],
+    diffuse: u32,
+    specular: u32,
+}
