+            &mut bytes,
+            RECORD_KIND_PIPELINE,
+            sample_recipe().disk_key(),
+            &frame,
+        );
+        let records = read_records(&bytes);
+        assert!(records.pipelines.is_empty());
+        assert!(records.needs_compaction);
+    }
+}
