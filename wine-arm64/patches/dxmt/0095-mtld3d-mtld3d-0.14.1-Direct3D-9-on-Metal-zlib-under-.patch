+fn front_buffer_readback_accepts_the_implicit_swapchain_entry_point() {
+    let h = Harness::new();
+    assert_eq!(h.clear_target(MAGENTA), D3D_OK);
+    assert_eq!(h.present(), D3D_OK);
+    let (_, desc) = h.render_target(0).desc();
