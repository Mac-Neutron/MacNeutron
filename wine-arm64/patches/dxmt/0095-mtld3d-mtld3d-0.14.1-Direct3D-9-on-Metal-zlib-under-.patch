+    let tex = h.create_texture(64, 64, 1, 0, D3DFMT_A8R8G8B8, D3DPOOL_MANAGED);
+    // Initialize the full CPU image before narrowing the first no-dirty lock.
+    tex.lock_rect(0, D3DLOCK_READONLY)
+        .write_u32(&[RED; 64 * 64]);
