+    assert!(
+        msl.contains("float4 raw0 = float4(in.v6.xy, 0.0, 0.0);"),
+        "{msl}"
+    );
+    assert!(msl.contains("out.texcoord0 = raw0;"), "{msl}");
+    // PS still samples slot 0 (stage-aligned varying).
+    assert!(msl.contains("s0.sample(samp0, in.texcoord0.xy)"), "{msl}");
