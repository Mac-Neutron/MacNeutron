+});
+capture_control!(ColorFillOp, ColorFill, v, recorder, scratch, tag, {
+    capture_fixed!(
+        recorder,
+        scratch,
+        tag,
+        ColorFillRecord {
+            identity: identity(&v.kind),
+            handle: v.fill.texture.raw(),
+            msaa: v.fill.msaa.raw(),
