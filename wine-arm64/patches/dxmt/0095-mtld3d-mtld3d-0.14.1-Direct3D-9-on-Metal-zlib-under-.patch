+    let tri = specular_triangle(0xFF00_FF00, 0xFFFF_0000);
+    h.render_once(BLUE, |d| {
+        assert_eq!(d.draw_primitive_up(D3DPT_TRIANGLELIST, 1, &tri), 0, "draw");
+    });
+    assert_eq!(
+        h.read_pixel(320, 280),
+        0xFFFF_0000,
+        "stage selects vertex specular red"
+    );
