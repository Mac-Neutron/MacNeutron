+    assert_eq!(h.set_sampler_state(0, D3DSAMP_MAXMIPLEVEL, 3), 0);
+    assert_eq!(
+        sample_at_explicit_lod(&h, 1.0),
+        MIP_TINTS[3],
+        "MAXMIPLEVEL 3 clamps an explicit LOD of 1"
+    );
+    assert_eq!(
+        sample_at_explicit_lod(&h, 4.0),
+        MIP_TINTS[4],
+        "a coarser explicit LOD is kept, not shifted"
