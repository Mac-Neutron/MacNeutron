+    let kv = render_kv(&w, &w, &captured, 2.01).finish();
+    let want = render_kv(&w, &w, &sample_caches(), 2.01).finish().replace(
+        " metal_capture_layer_count=0",
+        " metal_capture_layer_count=1",
+    );
+    assert_eq!(kv, want, "only the flag key changes");
+}
