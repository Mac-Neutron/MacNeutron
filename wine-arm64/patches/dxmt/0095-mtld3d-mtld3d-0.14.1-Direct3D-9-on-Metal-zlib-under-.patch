+fn single_stream_binding() -> crate::draw_data::StreamBinding {
+    crate::draw_data::StreamBinding {
+        stream: 5,
+        buffer_id: BufferId::new_unique(),
+        backing_ptr: 0x0001_2340,
+        backing_len: 8192,
+        backing_generation: 0x1122_3344_5566_7788,
+        offset: 12,
+        stride: 24,
+        freq: 0x4000_0011,
+    }
+}
