+    // and four of five pairs worse, but the MAD of 0.04 puts 3 sigma at 18 %.
+    let base = [100.0; 5];
+    let cand = [105.0, 95.0, 115.0, 110.0, 106.0];
+    assert_eq!(
+        verdict_of("frame.mean", "ms lower time", &base, &cand),
+        Verdict::Neutral
+    );
