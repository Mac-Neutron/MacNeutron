+fn create_fixture_phase(path: &Path, contents: &str) {
+    let mut file = fs::OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .open(path)
+        .expect("create fixture phase");
+    file.write_all(contents.as_bytes())
+        .expect("write fixture phase");
