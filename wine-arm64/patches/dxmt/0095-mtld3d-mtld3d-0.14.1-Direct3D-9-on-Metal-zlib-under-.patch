+        if bound.is_null() {
+            return depth_format_has_stencil(self.depth_stencil_format);
+        }
+        // SAFETY: non-null check passed; the bound-RT refcount holds it live.
+        depth_format_has_stencil(unsafe { (*bound).standalone_format() })
+    }
