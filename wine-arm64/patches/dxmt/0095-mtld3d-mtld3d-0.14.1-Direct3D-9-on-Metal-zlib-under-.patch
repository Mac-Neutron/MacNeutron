+#[cfg(perf_tracking)]
+struct Style {
+    bold: &'static str,
+    dim: &'static str,
+    green: &'static str,
+    yellow: &'static str,
+    red: &'static str,
+    reset: &'static str,
+}
+
+#[cfg(perf_tracking)]
+impl Style {
+    const fn from_flag(ansi: bool) -> Self {
+        if ansi {
+            Self {
+                bold: "\x1b[1m",
+                dim: "\x1b[2m",
