+fn rule_c_applies_per_attachment() {
+    // Pass 0: backbuffer + rt_a (slot 1). Pass 1: rt_a alone as render
+    // target 0 with a clear, then rt_b (slot 2) never used again.
+    let rt_a = tex(0x3000);
+    let rt_b = tex(0x3001);
+    let mut s = fresh();
