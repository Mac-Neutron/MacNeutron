+    depth_transfer(
+        &cb,
+        &DepthTransfer {
+            source: &fixture.source,
+            source_level: 0,
+            destination: &fixture.source,
+            destination_level: 0,
+            width: 8,
+            height: 4,
+        },
+    );
+    depth_transfer_resample(&cb, &fixture.pass());
+}
