+        params.draw_retirement.address(),
+        params.upload_retirement.address(),
+    ] {
+        retire_finished(record.pending(), counter, 0, "test");
+    }
+    assert_eq!(coherent.load(Ordering::Acquire), 1);
+    assert_eq!(upload.load(Ordering::Acquire), 1);
