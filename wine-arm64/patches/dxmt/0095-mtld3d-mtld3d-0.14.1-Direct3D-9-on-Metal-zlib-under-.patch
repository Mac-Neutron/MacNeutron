index 00000000..67a2f5f4
--- /dev/null
+++ b/mtld3d/windows/core/src/guest_queries/tests.rs
@@ -0,0 +1,144 @@
+use std::sync::Arc;
+
+use mtld3d_shared::{
+    MetalHandle,
+    encoder_wire::{FrameSlab, WireReader},
+};
+
+use super::{GuestQueryDescriptor, GuestQueryLease, QueryLeaseCache};
+use crate::{
+    encoder_value::WireValue,
+    page_box::PageBox,
+    visibility::{QueryStatus, RetiredVisibilityBuffer, VisibilityQueryCore, VisibilityQueryState},
+};
+
+fn descriptor(lease: &GuestQueryLease) -> GuestQueryDescriptor {
+    let mut slab = FrameSlab::new();
+    slab.push_record(1, |writer| lease.descriptor().write_wire(writer))
+        .expect("encode lease");
+    let mut reader = WireReader::new(slab.as_bytes());
+    let mut record = reader
+        .next_record()
+        .expect("record stream")
+        .expect("one record");
+    GuestQueryDescriptor::read_wire(&mut record.payload).expect("query descriptor")
+}
+
+#[test]
+fn begin_and_end_share_native_arc_identity() {
+    let original = VisibilityQueryCore::new();
+    let begin_lease = GuestQueryLease::new(Arc::clone(&original));
+    let end_lease = GuestQueryLease::new(original);
+    let mut cache = QueryLeaseCache::default();
+    // SAFETY: distinct leases remain live until completion and each is adopted exactly once.
+    let begin = unsafe { cache.adopt(descriptor(&begin_lease)) }.expect("begin core");
+    // SAFETY: end_lease is a distinct retained publication of the same mailbox.
+    let end = unsafe { cache.adopt(descriptor(&end_lease)) }.expect("end core");
+    assert!(Arc::ptr_eq(&begin, &end));
+    assert!(end_lease.completed());
+    assert!(!begin_lease.completed());
+    let mut state = VisibilityQueryState::new();
+    state.push_active(&begin);
+    state.remove_active(&end);
+    assert_eq!(state.active_count(), 0);
+    drop(begin);
+    assert!(!begin_lease.completed());
+    drop(end);
+    assert!(begin_lease.completed());
+}
+
+#[test]
+fn original_query_survives_com_owner_release_until_native_drop() {
+    let original = VisibilityQueryCore::new();
+    let weak = Arc::downgrade(&original);
+    let lease = GuestQueryLease::new(original);
+    let mut cache = QueryLeaseCache::default();
+    // SAFETY: lease is the sole guest owner and remains retained through native completion.
+    let native = unsafe { cache.adopt(lease.descriptor()) }.expect("native core");
+    native.mark_armed();
+    assert_eq!(
+        weak.upgrade().expect("guest remains live").status(),
+        QueryStatus::Pending
+    );
+    assert!(!lease.completed());
+    drop(native);
+    assert!(lease.completed());
+    drop(lease);
+    assert!(weak.upgrade().is_none());
+    cache.maintain();
+    assert!(cache.cores.is_empty());
+}
+
+#[test]
+fn rejection_and_malformed_descriptor_leave_no_native_owner() {
+    let lease = GuestQueryLease::new(VisibilityQueryCore::new());
+    let mut bad = lease.descriptor();
+    bad.mailbox = 1;
+    let mut cache = QueryLeaseCache::default();
+    // SAFETY: the malformed address is rejected numerically before any pointer is accessed.
+    assert!(unsafe { cache.adopt(bad) }.is_err());
+    assert!(!lease.completed());
+    // SAFETY: adoption failed without constructing a core, and no other consumer exists.
+    unsafe { lease.cancel_unadopted() };
+    assert!(lease.completed());
+    assert!(cache.cores.is_empty());
+}
+
+#[test]
+fn reissue_preserves_pending_segment_generation_checks() {
+    let original = VisibilityQueryCore::new();
+    let first_lease = GuestQueryLease::new(Arc::clone(&original));
+    let second_lease = GuestQueryLease::new(Arc::clone(&original));
+    let mut cache = QueryLeaseCache::default();
+    // SAFETY: first_lease retains the query mailbox until the final native reference drops.
+    let first = unsafe { cache.adopt(first_lease.descriptor()) }.expect("first core");
+    let mut state = VisibilityQueryState::new();
+    let mut backing = PageBox::new_zeroed(16);
+    backing.as_mut_slice()[..8].copy_from_slice(&100u64.to_le_bytes());
+    backing.as_mut_slice()[8..16].copy_from_slice(&7u64.to_le_bytes());
+    state.install_current_buffer(RetiredVisibilityBuffer::new(backing, MetalHandle::NULL, 0));
+    assert!(state.retire_current_buffer(1).is_none());
+    first.begin(1, 0, (1, 1), (1, 1), 0);
+    first.end(1, 1);
+    state.push_pending(1, Arc::clone(&first), (0, 1), true);
+    // SAFETY: second_lease is a fresh retained publication of the original mailbox.
+    let second = unsafe { cache.adopt(second_lease.descriptor()) }.expect("second core");
+    second.begin(1, 1, (1, 1), (1, 1), 1);
+    second.end(1, 2);
+    state.push_pending(1, Arc::clone(&second), (1, 2), true);
+    state.intake_completed(1);
+    assert_eq!(original.status(), QueryStatus::Issued);
+    assert_eq!(original.get_u32(), 7);
+    drop(first);
+    drop(second);
+    assert!(first_lease.completed());
+    assert!(second_lease.completed());
+}
+
+#[test]
+fn api_reissue_rejects_delayed_native_result_before_new_begin() {
+    let original = VisibilityQueryCore::new();
+    let lease = GuestQueryLease::new(Arc::clone(&original));
+    let mut cache = QueryLeaseCache::default();
+    // SAFETY: lease retains its original mailbox and completion through final native drop.
+    let native = unsafe { cache.adopt(lease.descriptor()) }.expect("native core");
+    let first = original.mark_armed();
+    native.begin_recorded(first, 1, 0, (1, 1), (1, 1), 0);
+    assert_eq!(original.mark_end_requested(), first);
+    native.end_recorded(first, 1, 0);
+    let mut state = VisibilityQueryState::new();
+    state.push_pending(1, Arc::clone(&native), (0, 0), true);
+    let second = original.mark_armed();
+    state.intake_completed(1);
+    assert_eq!(original.status(), QueryStatus::Pending);
+    assert_eq!(original.seq_end_loaded(), 0);
+    assert_eq!(original.mark_end_requested(), second);
+    native.begin_recorded(second, 2, 0, (1, 1), (1, 1), 0);
+    native.end_recorded(second, 2, 0);
+    state.push_pending(2, Arc::clone(&native), (0, 0), true);
+    state.intake_completed(2);
+    assert_eq!(original.status(), QueryStatus::Issued);
+    assert_eq!(original.seq_end_loaded(), 2);
+    drop(native);
+    assert!(lease.completed());
+}
diff --git a/mtld3d/windows/core/src/held_pages.rs b/mtld3d/windows/core/src/held_pages.rs
new file mode 100644
index 00000000..d36626c3
--- /dev/null
+++ b/mtld3d/windows/core/src/held_pages.rs
@@ -0,0 +1,137 @@
+//! Page boxes charged to a live-bytes gauge for as long as their holder keeps them.
+//!
+//! The address-space watch walks the texture registry for texture staging and
+//! reads the vertex/index backing gauge, but two more holders keep page boxes
+//! in the 32-bit address space that neither sees, so their pages would be
+//! counted only in the page-box total. [`HeldPages`] charges a box to its
+//! holder's gauge while held:
+//!
+//! - [`PageHolder::Surface`]: the backing of a system-memory or scratch
+//!   offscreen plain surface, the staging of a lockable render target, and the
+//!   read-back page a back-buffer `LockRect` or `GetDC` holds until released.
+//! - [`PageHolder::EncoderLease`]: a renamed vertex/index backing or an upload
+//!   snapshot the PE side keeps until the encoder acknowledges its last read.
+
+use core::{
+    ops::{Deref, DerefMut},
+    sync::atomic::{AtomicU64, Ordering},
+};
+
+use crate::page_box::PageBox;
+
+/// Padded bytes of every live [`HeldPages`] a surface holds.
+///
+/// Process-wide, because the resource it measures is: the watch reads it
+/// against the one 32-bit address space and the process-wide page-box
+/// total, and a surface can outlive the device that created it, which would
+/// leave a per-device count with no owner to give the bytes back to.
+static SURFACE_BYTES: AtomicU64 = AtomicU64::new(0);
+
+/// Padded bytes of every live [`HeldPages`] an encoder lease holds.
+///
+/// Process-wide on the same argument as [`SURFACE_BYTES`]: the 32-bit
+/// address space is one resource, and a lease retires on whichever thread
+/// sees the encoder's acknowledgment, after the frame that recorded it, so
+/// it has no device record to reach at that point.
+static ENCODER_LEASE_BYTES: AtomicU64 = AtomicU64::new(0);
+
+/// Who holds a [`HeldPages`], and so which gauge it is charged to.
+pub enum PageHolder {
+    /// A surface's system-memory backing, lockable staging or read-back page.
+    Surface,
+    /// A retired backing or upload snapshot awaiting the encoder's last read.
+    EncoderLease,
+}
+
+impl PageHolder {
+    const fn gauge(&self) -> &'static AtomicU64 {
+        match self {
+            Self::Surface => &SURFACE_BYTES,
+            Self::EncoderLease => &ENCODER_LEASE_BYTES,
+        }
+    }
+}
+
+/// Padded bytes the surfaces keep in page boxes now.
+#[must_use]
+pub fn live_surface_bytes() -> u64 {
+    SURFACE_BYTES.load(Ordering::Relaxed)
+}
+
+/// Padded bytes the encoder leases keep in page boxes now.
+#[must_use]
+pub fn live_encoder_lease_bytes() -> u64 {
+    ENCODER_LEASE_BYTES.load(Ordering::Relaxed)
+}
+
+/// A page box charged to its holder's gauge until it drops or is handed back.
+pub struct HeldPages {
+    /// The box; `None` only inside [`Self::into_page`], which consumes `self`.
+    page: Option<PageBox>,
+    /// The bytes charged at construction, returned exactly on release.
+    ///
+    /// Kept apart from the box because `DerefMut` lets a holder replace the
+    /// box with one of another length, and returning that length would leave
+    /// the gauge off by the difference.
+    charged: u64,
+    holder: PageHolder,
+}
+
+impl HeldPages {
+    /// Take `page` for `holder` and charge its padded length to that holder's gauge.
+    #[must_use]
+    pub fn new(page: PageBox, holder: PageHolder) -> Self {
+        let charged = page.len() as u64;
+        holder.gauge().fetch_add(charged, Ordering::Relaxed);
+        Self {
+            page: Some(page),
+            charged,
+            holder,
+        }
+    }
+
+    /// Give the box back, returning its charge to the gauge.
+    ///
+    /// # Panics
+    ///
+    /// Never: the box is present until this call takes it.
+    #[must_use]
+    pub fn into_page(mut self) -> PageBox {
+        self.page
+            .take()
+            .expect("a held box is present until into_page")
+    }
+
+    const fn page(&self) -> &PageBox {
+        self.page
+            .as_ref()
+            .expect("a held box is present until into_page")
+    }
+}
+
+impl Deref for HeldPages {
+    type Target = PageBox;
+
+    fn deref(&self) -> &PageBox {
+        self.page()
+    }
+}
+
+impl DerefMut for HeldPages {
+    fn deref_mut(&mut self) -> &mut PageBox {
+        self.page
+            .as_mut()
+            .expect("a held box is present until into_page")
+    }
+}
+
+impl Drop for HeldPages {
+    fn drop(&mut self) {
+        self.holder
+            .gauge()
+            .fetch_sub(self.charged, Ordering::Relaxed);
+    }
+}
+
+#[cfg(test)]
+mod tests;
diff --git a/mtld3d/windows/core/src/held_pages/tests.rs b/mtld3d/windows/core/src/held_pages/tests.rs
new file mode 100644
index 00000000..166a589e
--- /dev/null
+++ b/mtld3d/windows/core/src/held_pages/tests.rs
@@ -0,0 +1,56 @@
+//! Each holder's gauge follows the pages it holds.
+//!
+//! The gauges are process-wide and `cargo test` runs tests as threads of one
+//! process. `PageHolder::Surface` is created by these tests alone, so they
+//! hold `GAUGE` while they assert deltas on it. `PageHolder::EncoderLease`
+//! is also created by every test that builds an encoder packet with a
+//! retired backing, so its deltas are not asserted here.
+
+use std::sync::{Mutex, PoisonError};
+
+use super::*;
+use crate::page_box::PAGE_SIZE;
+
+/// The lock the tests that assert on the surface gauge hold.
+///
+/// A `static` because the resource is process-wide: the gauge is, and the
+/// tests share the process.
+static GAUGE: Mutex<()> = Mutex::new(());
+
+#[test]
+fn the_gauge_charges_padded_bytes_while_held_and_returns_them_on_drop() {
+    let _gauge = GAUGE.lock().unwrap_or_else(PoisonError::into_inner);
+    let before = live_surface_bytes();
+    let one = HeldPages::new(PageBox::new_uninit(100), PageHolder::Surface);
+    assert_eq!(live_surface_bytes() - before, PAGE_SIZE as u64);
+    let mut two = HeldPages::new(PageBox::new_zeroed(PAGE_SIZE + 1), PageHolder::Surface);
+    assert_eq!(live_surface_bytes() - before, 3 * PAGE_SIZE as u64);
+    assert_eq!(two.len(), 2 * PAGE_SIZE);
+    assert_eq!(two.logical_len(), PAGE_SIZE + 1);
+    two.as_mut_slice()[3] = 7;
+    assert_eq!(two.as_slice()[3], 7);
+    drop(one);
+    assert_eq!(live_surface_bytes() - before, 2 * PAGE_SIZE as u64);
+    drop(two);
+    assert_eq!(live_surface_bytes(), before);
+}
+
+#[test]
+fn handing_the_box_back_returns_its_charge() {
+    let _gauge = GAUGE.lock().unwrap_or_else(PoisonError::into_inner);
+    let before = live_surface_bytes();
+    let held = HeldPages::new(PageBox::new_uninit(3 * PAGE_SIZE), PageHolder::Surface);
+    let page = held.into_page();
+    assert_eq!(live_surface_bytes(), before);
+    assert_eq!(page.len(), 3 * PAGE_SIZE);
+}
+
+#[test]
+fn replacing_the_box_through_deref_mut_returns_the_charged_length() {
+    let _gauge = GAUGE.lock().unwrap_or_else(PoisonError::into_inner);
+    let before = live_surface_bytes();
+    let mut held = HeldPages::new(PageBox::new_uninit(1), PageHolder::Surface);
+    *held = PageBox::new_uninit(4 * PAGE_SIZE);
+    drop(held);
+    assert_eq!(live_surface_bytes(), before);
+}
diff --git a/mtld3d/windows/core/src/hud_stats.rs b/mtld3d/windows/core/src/hud_stats.rs
new file mode 100644
index 00000000..ba17bbe5
--- /dev/null
+++ b/mtld3d/windows/core/src/hud_stats.rs
@@ -0,0 +1,347 @@
+//! What the Metal HUD's `mtld3d` rows say, and the rules that keep them readable.
+//!
+//! On macOS 27 the HUD lists every state reporter under its "State Reporters"
+//! caption: the domain and its label on one row, then one row per metadata
+//! key, indented by two spaces. The layer reports its release identity as the
+//! label and a handful of figures as volatile metadata; this module holds
+//! everything about those rows that needs no Objective-C: the counters the
+//! encoder keeps, the row keys, the values and the width budget.
+//!
+//! The HUD draws a metadata value only when it is a number or a date: a
+//! string value has no `stringValue`, so the HUD skips its row. Every value is
+//! therefore an integer, and a unit goes into the key (`MiB`).
+//!
+//! Five rules keep the panel readable whatever the figures are, and the tests
+//! hold each one:
+//!
+//! 1. Width. The HUD centre-truncates a row whose indent, key and value
+//!    together exceed the panel's character columns. [`HUD_COLUMNS`] is the
+//!    budget the default panel gives, and every key with its widest possible
+//!    value leaves at least one column between them.
+//! 2. Bounded values. Counts are `u32`, at most ten digits; byte figures are
+//!    whole MiB, saturating at `u32::MAX`; the 32-bit address-space row never
+//!    exceeds the 4096 MiB such a space has.
+//! 3. Order. The HUD sorts the keys with `compare:`, which orders ASCII by
+//!    code point. Every key starts with its group word, and the groups read in
+//!    the order `Frame`, `Live`, `Mem`, `Shaders`. Wherever two adjacent keys
+//!    first differ, byte order and case-insensitive order agree, so a HUD that
+//!    sorted either way would show the same order.
+//! 4. Header. The domain row carries [`HUD_DOMAIN`] and the release identity,
+//!    which [`hud_label`] shortens to fit beside the domain.
+//! 5. Stability. A row appears only once it carries information, its first
+//!    nonzero sampled value on the device, and never disappears afterwards,
+//!    so the panel does not jump as a figure falls back to 0 ([`HudRowLatch`]).
+
+/// The `StateReporting` domain the layer reports under, which the HUD prints as the header row.
+pub const HUD_DOMAIN: &str = "mtld3d";
+
+/// Character columns the HUD's default panel gives a row.
+///
+/// The HUD derives its budget from the panel's width in points divided by
+/// the advance of its monospace "M"; the default panel holds 33.
+pub const HUD_COLUMNS: usize = 33;
+
+/// Columns the HUD puts before every metadata key.
+pub const HUD_KEY_INDENT: usize = 2;
+
+/// The longest release identity the domain row carries beside the domain and one space.
+pub const HUD_LABEL_MAX: usize = HUD_COLUMNS - HUD_DOMAIN.len() - 1;
+
+/// How many rows the layer can report under its domain.
+pub const HUD_ROW_COUNT: usize = 10;
+
+/// The metadata keys, in the order the HUD sorts them, indexed like [`hud_rows`]' answer.
+///
+/// `UP` draws come from user-pointer data (`DrawPrimitiveUP`,
+/// `DrawIndexedPrimitiveUP`), `VB` draws from vertex buffers. Both shader rows
+/// count distinct shaders seen since the device was created, not live objects,
+/// and neither drops an entry when the game releases a shader. `Shaders FF`
+/// counts the fixed-function shader keys the encoder built from the game's
+/// draw state: those of a stage with no shader bound, and the vertex shader of
+/// a pre-transformed (`XYZRHW`, `POSITIONT`) draw. They are not D3D objects.
+/// Fixed-function vertex keys whose build failed leave the count when the
+/// encoder's reset cleanup runs (a `Reset` that changes the implicit surfaces
+/// or the device window, or an automatic back-buffer resize), until a draw
+/// that uses one records it again. `Shaders programmable` counts the game's
+/// own shader programs by bytecode, so the same bytecode created twice counts
+/// once, and only shrinks when the device is destroyed.
+pub const HUD_ROW_KEYS: [&str; HUD_ROW_COUNT] = [
+    "Frame draws UP",
+    "Frame draws VB",
+    "Frame passes",
+    "Live textures",
+    "Mem 32-bit largest MiB",
+    "Mem guest pages MiB",
+    "Mem in flight MiB",
+    "Mem reuse pool MiB",
+    "Shaders FF",
+    "Shaders programmable",
+];
+
+/// How many samples a second the encoder reports at most.
+pub const HUD_SAMPLE_HZ: u64 = 2;
+
+/// The size of a 32-bit address space in MiB, which bounds the address-space row.
+const ADDRESS_SPACE_32_MIB: u32 = 4096;
+
+/// The index of the address-space row, `Mem 32-bit largest MiB`, in [`HUD_ROW_KEYS`].
+const ADDRESS_SPACE_ROW: usize = 4;
+
+const _: () = assert!(HUD_ROW_COUNT <= u16::BITS as usize, "one latch bit per row");
+
+/// Shortest commit hash [`hud_label`] keeps when it shortens a development identity.
+const MIN_LABEL_HASH: usize = 4;
+
+/// Draw and pass counts of the frame being encoded, and of the last presented one.
+///
+/// The encoder counts every draw it replays and every render pass it
+/// submits. A mid-frame flush submits part of a frame, so its passes add to
+/// the frame's; a presenting submission freezes the frame's counts as the
+/// ones the HUD shows and starts the next frame at zero.
+#[derive(Default)]
+pub struct HudFrameStats {
+    draws: u32,
+    draws_up: u32,
+    passes: u32,
+    shown: HudFrame,
+}
+
+impl HudFrameStats {
+    /// Count one replayed draw; `up` when its vertices are user-pointer data.
+    ///
+    /// Two wrapping adds and no branch, since it runs once per draw.
+    #[inline]
+    pub fn count_draw(&mut self, up: bool) {
+        self.draws = self.draws.wrapping_add(1);
+        self.draws_up = self.draws_up.wrapping_add(u32::from(up));
+    }
+
+    /// Add one submission's render passes, and freeze the frame when the submission presents.
+    pub fn end_submit(&mut self, passes: usize, presented: bool) {
+        self.passes = self
+            .passes
+            .wrapping_add(u32::try_from(passes).unwrap_or(u32::MAX));
+        if presented {
+            self.shown = HudFrame {
+                draws_up: self.draws_up,
+                draws_vb: self.draws.wrapping_sub(self.draws_up),
+                passes: self.passes,
+            };
+            self.draws = 0;
+            self.draws_up = 0;
+            self.passes = 0;
+        }
+    }
+
+    /// The counts of the last presented frame.
+    #[must_use]
+    pub const fn shown(&self) -> &HudFrame {
+        &self.shown
+    }
+}
+
+/// The draw and pass counts of one presented frame.
+#[derive(Default)]
+pub struct HudFrame {
+    draws_up: u32,
+    draws_vb: u32,
+    passes: u32,
+}
+
+impl HudFrame {
+    /// Draws whose vertices were user-pointer data.
+    #[must_use]
+    pub const fn draws_up(&self) -> u32 {
+        self.draws_up
+    }
+
+    /// Draws whose vertices came from vertex buffers.
+    #[must_use]
+    pub const fn draws_vb(&self) -> u32 {
+        self.draws_vb
+    }
+
+    /// Render passes the frame's submissions carried.
+    #[must_use]
+    pub const fn passes(&self) -> u32 {
+        self.passes
+    }
+}
+
+/// Lets a sample through at most once per period of a monotonic clock.
+#[derive(Default)]
+pub struct SampleGate {
+    last: Option<u64>,
+}
+
+impl SampleGate {
+    /// Whether a sample is due at `now`: the first call, and then once `period` has passed.
+    pub const fn due(&mut self, now: u64, period: u64) -> bool {
+        if let Some(last) = self.last
+            && now.wrapping_sub(last) < period
+        {
+            return false;
+        }
+        self.last = Some(now);
+        true
+    }
+}
+
+/// Which rows a device has shown, so each appears once it carries information and then stays.
+///
+/// A row is hidden until its first nonzero sampled value and shown from then
+/// on, at 0 too. The latch sees only the samples its reporter takes: at most
+/// [`HUD_SAMPLE_HZ`] a second, the frame counts from the last presented frame,
+/// and only while this device's encoder holds the rows. A device that never
+/// draws from user-pointer data shows no `Frame draws UP` row, and one that
+/// does keeps the row through frames that have none. The address-space row
+/// latches on any value, since a walk that found less than 1 MiB free shows 0
+/// and that is the state the row exists to show. One latch lives as long as
+/// its device's reporter.
+#[derive(Default)]
+pub struct HudRowLatch {
+    /// Bit `i` set once row `i` of [`HUD_ROW_KEYS`] has carried information.
+    seen: u16,
+}
+
+impl HudRowLatch {
+    /// The rows the panel shows of `rows`: each one latched so far, with its current value.
+    #[must_use]
+    pub fn visible(
+        &mut self,
+        mut rows: [Option<u32>; HUD_ROW_COUNT],
+    ) -> [Option<u32>; HUD_ROW_COUNT] {
+        for (row, value) in rows.iter_mut().enumerate() {
+            let bit = 1_u16 << row;
+            if value.is_some_and(|value| value != 0 || row == ADDRESS_SPACE_ROW) {
+                self.seen |= bit;
+            }
+            if self.seen & bit == 0 {
+                *value = None;
+            }
+        }
+        rows
+    }
+}
+
+/// Every figure one sample reports, gathered by the encoder.
+///
+/// The frame counts, the textures, the in-flight bytes and both shader
+/// counts belong to the reporting device; the largest free block, the guest
+/// pages and the reuse pool are the process's, read from `d3d9.dll`.
+pub struct HudSample {
+    /// The last presented frame's user-pointer draws.
+    pub draws_up: u32,
+    /// The last presented frame's vertex-buffer draws.
+    pub draws_vb: u32,
+    /// The last presented frame's render passes.
+    pub passes: u32,
+    /// Textures alive on the device.
+    pub textures: usize,
+    /// The watch's last walk as [`largest_free_word`] stores it; zero before a walk.
+    pub largest_free_word: u64,
+    /// Bytes `d3d9.dll` holds in live page boxes, the parked ones of the reuse pool included.
+    pub guest_page_bytes: u64,
+    /// Vertex and index buffer copies held until the GPU has finished with them.
+    pub in_flight_bytes: u64,
+    /// Page boxes `d3d9.dll` keeps parked for reuse.
+    pub reuse_pool_bytes: u64,
+    /// Distinct fixed-function shader keys the game's draws used since device creation.
+    pub fixed_function: usize,
+    /// Distinct shader bytecode the game created since device creation, both stages.
+    pub programs: usize,
+}
+
+/// The value of every row, indexed like [`HUD_ROW_KEYS`]; `None` leaves the row out.
+///
+/// The address-space row is left out until the watch has walked once, which
+/// a 64-bit process never does; a walk that found less than 1 MiB free shows 0.
+/// Every other row carries its value, 0 included; [`HudRowLatch`] decides
+/// which rows the panel shows. The guest pages row leaves out the reuse pool,
+/// whose parked boxes are live page boxes too, so the two rows add up to what
+/// `d3d9.dll` holds, to within 1 MiB, since each rounds down to whole MiB.
+#[must_use]
+pub fn hud_rows(sample: &HudSample) -> [Option<u32>; HUD_ROW_COUNT] {
+    let largest = sample.largest_free_word.checked_sub(1).map(|mib| {
+        u32::try_from(mib)
+            .unwrap_or(u32::MAX)
+            .min(ADDRESS_SPACE_32_MIB)
+    });
+    // Two Relaxed loads of counters other threads move, not one snapshot: a
+    // box parked between them can make the pool read larger than the live
+    // total, which saturates to 0 rather than wrapping.
+    let pages_in_use = sample
+        .guest_page_bytes
+        .saturating_sub(sample.reuse_pool_bytes);
+    [
+        Some(sample.draws_up),
+        Some(sample.draws_vb),
+        Some(sample.passes),
+        Some(count(sample.textures)),
+        largest,
+        Some(mib(pages_in_use)),
+        Some(mib(sample.in_flight_bytes)),
+        Some(mib(sample.reuse_pool_bytes)),
+        Some(count(sample.fixed_function)),
+        Some(count(sample.programs)),
+    ]
+}
+
+/// The word the address-space watch stores for a walk whose largest free block is `mib` MiB.
+///
+/// One more than the figure, saturating, so that 0 means only that no walk
+/// has happened yet: a walk that found less than 1 MiB free, the state the
+/// row exists to show, stores 1 and still shows, as 0.
+#[must_use]
+pub const fn largest_free_word(mib: u64) -> u64 {
+    mib.saturating_add(1)
+}
+
+/// The release identity as the domain row shows it, at most [`HUD_LABEL_MAX`] bytes.
+///
+/// An identity that fits is returned as it is. A longer development identity
+/// (`<tag>-<n>-g<hash>`, with or without `-dirty`) keeps its tag, its commit
+/// distance and `-dirty`, and gives up hash digits, down to four; with room
+/// for fewer it drops the hash and its `-g` altogether. Anything longer still
+/// keeps its first [`HUD_LABEL_MAX`] bytes.
+#[must_use]
+pub fn hud_label(build: &str) -> String {
+    if build.len() <= HUD_LABEL_MAX {
+        return build.to_owned();
+    }
+    let (body, dirty) = build
+        .strip_suffix("-dirty")
+        .map_or((build, ""), |body| (body, "-dirty"));
+    if let Some(at) = body.rfind("-g") {
+        let (head, hash) = body.split_at(at + 2);
+        let room = HUD_LABEL_MAX.saturating_sub(head.len() + dirty.len());
+        if hash.bytes().all(|byte| byte.is_ascii_hexdigit()) {
+            if room >= MIN_LABEL_HASH {
+                return format!("{head}{}{dirty}", &hash[..room.min(hash.len())]);
+            }
+            // Too little room for a useful hash: drop it with its `-g`.
+            let short = format!("{}{dirty}", &body[..at]);
+            if short.len() <= HUD_LABEL_MAX {
+                return short;
+            }
+        }
+    }
+    let mut end = HUD_LABEL_MAX;
+    while !build.is_char_boundary(end) {
+        end -= 1;
+    }
+    build[..end].to_owned()
+}
+
+/// A collection length as a row value, saturating at `u32::MAX`.
+fn count(len: usize) -> u32 {
+    u32::try_from(len).unwrap_or(u32::MAX)
+}
+
+/// Whole MiB of `bytes`, saturating at `u32::MAX`.
+fn mib(bytes: u64) -> u32 {
+    u32::try_from(bytes >> 20).unwrap_or(u32::MAX)
+}
