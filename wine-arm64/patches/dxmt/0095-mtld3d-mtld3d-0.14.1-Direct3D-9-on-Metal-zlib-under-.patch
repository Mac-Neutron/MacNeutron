+#[test]
+fn pixel_inputs_read_their_semantic_member() {
+    let ps = program(
+        PS3_HEADER,
+        &[
+            dcl(TEXCOORD, 2, INPUT, 0, 0x3),
+            dcl(NORMAL, 0, INPUT, 1, 0x7),
