+    // exercise the unlit vertex-colour path (the colours are depth markers).
+    assert_eq!(h.set_render_state(D3DRS_LIGHTING, 0), 0, "lighting off");
+
+    let far = [
+        Vertex {
+            x: 0.0,
+            y: 0.8,
+            z: 0.7,
+            color: RED,
+        },
+        Vertex {
+            x: 0.8,
+            y: -0.8,
+            z: 0.7,
+            color: RED,
+        },
+        Vertex {
+            x: -0.8,
+            y: -0.8,
+            z: 0.7,
+            color: RED,
+        },
+    ];
+    let near = [
+        Vertex {
+            x: -0.2,
+            y: 0.8,
+            z: 0.3,
+            color: 0xFF00_00FF,
+        },
+        Vertex {
+            x: 0.6,
+            y: -0.8,
+            z: 0.3,
+            color: 0xFF00_00FF,
+        },
