+    states[D3DRS_FOGCOLOR as usize] = 0xFFFF_00FF;
+    let variant = VariantKey::default();
+    assert_eq!(variant.fog_mode, 0);
+    assert_eq!(build_fog_color_bytes(&states, variant).1, 0);
+}
