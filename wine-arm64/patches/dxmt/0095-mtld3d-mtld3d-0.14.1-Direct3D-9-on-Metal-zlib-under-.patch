+    let mut last = 0;
+    for seq in 1..=100 {
+        last = state.note_present_in_flight(seq, 0);
+    }
+    assert_eq!(last, 64);
+    assert_eq!(
+        state.note_present_in_flight(101, 90),
+        11,
+        "91 to 101 outstanding"
+    );
+}
diff --git a/mtld3d/windows/core/src/perf/window_line.rs b/mtld3d/windows/core/src/perf/window_line.rs
