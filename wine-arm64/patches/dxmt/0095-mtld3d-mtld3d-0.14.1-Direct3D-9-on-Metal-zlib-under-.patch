+#[test]
+fn vertex_texldl_takes_max_mip_level_as_its_finest_level() {
+    // A vertex sampler's `D3DSAMP_MAXMIPLEVEL` clamps the level a vertex
+    // `texldl` names, as a pixel sampler's does.
+    use mtld3d_types::D3DVERTEXTEXTURESAMPLER0;
+
+    let h = Harness::new();
