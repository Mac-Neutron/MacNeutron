+    let dev = obj.inner();
+    let scissor = dev.scissor_rect();
+    // SAFETY: `rect` is non-null (checked above) and per the D3D9 ABI
+    // points to a writable `RECT` (alias for `D3DRECT`) owned by the
+    // caller; alignment is not assumed.
+    unsafe {
