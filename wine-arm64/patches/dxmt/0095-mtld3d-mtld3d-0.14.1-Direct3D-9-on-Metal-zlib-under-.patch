+#[test]
+fn a_pixel_shader_below_sm3_keeps_its_structural_colour_inputs() {
+    let ps = parse(&[0xFFFF_0200, DCL, 0x8000_0000, 0x900F_0001, END_TOKEN]).expect("ps_2_0");
+    let plan = PsInputs::build(&ps, 0);
