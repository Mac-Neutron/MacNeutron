+/// Dozens of the `fixme:dbghelp` lines Wine prints around a backtrace.
+fn chatter(count: usize) -> String {
+    (0..count)
+        .map(|i| format!("fixme:dbghelp:elf_search_auxv can't find symbol {i}\n"))
+        .collect::<Vec<_>>()
+        .concat()
+}
