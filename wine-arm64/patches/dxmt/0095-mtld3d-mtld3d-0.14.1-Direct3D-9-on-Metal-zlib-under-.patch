+    /// populated prefix.
+    vs_constants_populated_rows: u16,
+    ps_constants_populated_rows: u16,
+    /// Per-pass cache for the programmable VS const slice.
+    ///
+    /// Bumped into the current frame's `ScratchArena`. `emit_draw` reuses
