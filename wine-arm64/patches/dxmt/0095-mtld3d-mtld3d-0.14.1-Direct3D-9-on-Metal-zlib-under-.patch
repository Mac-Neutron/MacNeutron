+}
+
+#[test]
+fn pixel_relative_constant_read_is_reported() {
+    // ps_3_0: defi i0, 4, 0, 1, 0; mov r0, c1; loop aL, i0;
+    // add r0, r0, c[aL + 2]; endloop; mov oC0, r0
+    let tokens = [
+        0xffff_0300,
+        0x0500_0030,
+        0xf00f_0000,
+        4,
+        0,
+        1,
+        0,
+        0x0200_0001,
