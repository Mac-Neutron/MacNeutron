+/// The centred triangle with every colour field set to `color`.
+fn packed_triangle(color: u32) -> [PackedVertex; 3] {
+    centered_triangle().map(|p| PackedVertex {
+        x: p.x,
+        y: p.y,
+        z: p.z,
+        color,
+    })
