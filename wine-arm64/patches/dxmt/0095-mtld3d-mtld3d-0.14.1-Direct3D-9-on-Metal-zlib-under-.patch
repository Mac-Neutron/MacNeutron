+    /// `GetSurfaceLevel` keeps handing back one identity; `finalize_texture`
+    /// frees it. See [`SurfaceFlags::CONTAINER_CACHED`].
+    fn container_cached(&self) -> bool {
+        self.inner().flags.contains(SurfaceFlags::CONTAINER_CACHED)
+    }
