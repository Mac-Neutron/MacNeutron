+                // D3DRS_NORMALIZENORMALS), so a magnitude > 1 can push the dot
+                // past 1 — D3D9 clamps the diffuse N·L term.
+                out.push_str("        float ndotl = clamp(dot(n, L), 0.0, 1.0);\n");
