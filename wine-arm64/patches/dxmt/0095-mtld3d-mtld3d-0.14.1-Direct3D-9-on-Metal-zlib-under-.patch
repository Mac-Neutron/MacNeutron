+const PSO_WITH: u64 = 0xAAAA_1111;
+const PSO_NO_COLOR: u64 = 0xBBBB_2222;
+
+fn set_pso(handle: u64) -> Command {
+    Command::set_render_pipeline_state(handle)
+}
