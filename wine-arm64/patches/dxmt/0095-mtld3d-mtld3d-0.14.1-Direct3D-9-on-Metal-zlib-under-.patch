+/// A white-diffuse directional light shining down +z, onto the quads' faces.
+fn frontal_light(diffuse: D3DCOLORVALUE) -> D3DLIGHT9 {
+    D3DLIGHT9 {
+        type_: D3DLIGHT_DIRECTIONAL,
+        diffuse,
+        direction: D3DVECTOR {
+            x: 0.0,
+            y: 0.0,
+            z: 1.0,
+        },
+        ..D3DLIGHT9::default()
+    }
+}
