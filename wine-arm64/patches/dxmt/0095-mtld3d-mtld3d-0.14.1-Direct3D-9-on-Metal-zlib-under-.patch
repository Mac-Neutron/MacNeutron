+fn make_vs_key(flags: super::FfVsFlags, fog_mode: u8) -> super::FfVsKey {
+    super::FfVsKey {
+        reserved: 0,
+        flags,
+        input_tex_coord_count: 0,
+        tex_coord_count: 0,
+        light_active_mask: 0,
+        light_directional_mask: 0,
+        light_spot_mask: 0,
+        diffuse_source: 0,
+        ambient_source: 0,
+        specular_source: 0,
+        emissive_source: 0,
+        fog_mode,
+        tci: [0; 8],
+        tex_coord_dims: [0; 8],
+        tt_flags: [0; 8],
+        vertex_blend_count: 0,
+        declared_weights_count: 0,
+        clip_plane_count: 0,
+        passthrough: [0; 8],
+    }
+}
