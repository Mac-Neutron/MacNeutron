+#[test]
+fn query_interface_unknown_is_rejected() {
+    let h = Harness::new();
+    assert_eq!(
+        h.device_query_interface_unknown(),
+        E_NOINTERFACE,
+        "QueryInterface for an unknown GUID returns E_NOINTERFACE",
