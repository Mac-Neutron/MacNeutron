+use std::{
+    path::PathBuf,
+    sync::{Arc, LazyLock},
+};
+
+use mtld3d_shared::{
+    MetalHandle,
+    mtl::{DeviceCapsFlags, PresentDebugFlags},
+    mtl_handle::{MTLCommandQueueKind, MTLDeviceKind, MTLTextureKind, NSViewKind},
+    record_handle::DeviceRecordHandle,
+};
+use objc2::{rc::Retained, runtime::ProtocolObject};
+use objc2_metal::{
+    MTLCommandBuffer, MTLCommandQueue, MTLCreateSystemDefaultDevice, MTLDevice, MTLGPUFamily,
+    MTLPixelFormat, MTLStorageMode,
+};
+
+use super::{
+    handle::{IntoRetained, ReleaseRetain},
+    macdrv::{detach_metal_layer, retire_metal_view},
+    record::DeviceRecord,
+};
+use crate::LOG_TARGET;
+
+// MTLCreateSystemDefaultDevice requires CoreGraphics to be linked.
+#[link(name = "CoreGraphics", kind = "framework")]
+unsafe extern "C" {}
+
+/// The one `MTLDevice` the process uses, as a retained handle.
+///
+/// The process-wide Metal caches (the present and cursor pipelines, the
+/// readback resolve library and its pipelines, the null textures, and the
+/// upload, clear and blit quads) hold objects built on whichever device first
+/// reached them, and Metal rejects an encode that mixes objects of two
+/// devices. Resolving the system default device once and handing that same
+/// object to every D3D device is what makes their grain correct rather than
+/// assumed.
+///
+/// The retain this handle carries is never released: the device is a
+/// process-lifetime object, like the caches built on it. `MetalHandle` is a
+/// transparent `u64` newtype, so the static is trivially `Send + Sync`.
+static PINNED_DEVICE: LazyLock<MetalHandle<MTLDeviceKind>> = LazyLock::new(|| {
+    let Some(device) = MTLCreateSystemDefaultDevice() else {
+        log::error!(
+            target: LOG_TARGET,
+            "MTLCreateSystemDefaultDevice returned no device; the process has no Metal device"
+        );
+        return MetalHandle::<MTLDeviceKind>::NULL;
+    };
+    // SAFETY: `Retained::into_raw` transfers the retain into the `u64` and
+    // `MetalHandle::new` adopts it. Nothing releases this handle, so the
+    // retain stays live for the rest of the process.
+    unsafe { MetalHandle::<MTLDeviceKind>::new(Retained::into_raw(device) as u64) }
+});
+
+/// The process's Metal device, with one retain for the caller.
+///
+/// Warns once when the system default device is no longer the pinned one,
+/// which automatic graphics switching on a dual-GPU Mac can arrange between
+/// two D3D device creations. The pinned device is kept in that case, so every
+/// object in the process-wide caches keeps belonging to the device the next
+/// command buffer encodes against.
+fn pinned_device() -> Option<Retained<ProtocolObject<dyn MTLDevice>>> {
+    let device = PINNED_DEVICE.into_retained()?;
+    if let Some(current) = MTLCreateSystemDefaultDevice()
+        && current.registryID() != device.registryID()
+    {
+        mtld3d_shared::log_once_warn!(
+            target: LOG_TARGET,
+            "the system default Metal device is now {} (registry id {}), not the pinned {} \
+             (registry id {}); the pinned device is kept, since the process-wide pipeline, \
+             texture and buffer caches were built on it",
+            current.name(),
+            current.registryID(),
+            device.name(),
+            device.registryID(),
+        );
+    }
+    Some(device)
+}
+
+/// Returns (`device_name`, `registry_id`, capability bits) from the process's Metal device.
+pub fn default_device_info() -> Option<(String, u64, DeviceCapsFlags)> {
+    let device = pinned_device()?;
+    let name = device.name().to_string();
+    let registry_id = device.registryID();
+    let mut caps = DeviceCapsFlags::empty();
+    caps.set(
+        DeviceCapsFlags::SAMPLER_BORDER,
+        supports_sampler_border(&device),
+    );
+    caps.set(
+        DeviceCapsFlags::NATIVE_PACKED16,
+        supports_native_packed16(&device),
+    );
+    caps.set(
+        DeviceCapsFlags::FLOAT32_FILTERING,
+        supports_float32_filtering(&device),
+    );
+    caps.set(
+        DeviceCapsFlags::SAMPLE_COUNT_2,
+        device.supportsTextureSampleCount(2),
+    );
+    caps.set(
+        DeviceCapsFlags::SAMPLE_COUNT_4,
+        device.supportsTextureSampleCount(4),
+    );
+    caps.set(
+        DeviceCapsFlags::SAMPLE_COUNT_8,
+        device.supportsTextureSampleCount(8),
+    );
+    caps.set(
+        DeviceCapsFlags::RESOLVE_NEEDS_RETIRE,
+        resolve_needs_retire(&device),
+    );
+    Some((name, registry_id, caps))
+}
+
+/// True when the device can create border-colour samplers.
+///
+/// On paper a Mac2-family feature, but the paravirtualized device on CI
+/// runners claims Mac2 and still aborts sampler creation on a border
+/// colour, so the device is checked for that as well.
+pub fn supports_sampler_border(device: &ProtocolObject<dyn MTLDevice>) -> bool {
+    device.supportsFamily(MTLGPUFamily::Mac2) && !is_paravirtual(device)
+}
+
+/// True when the device implements the `MirrorClampToEdge` address mode.
+///
+/// Every GPU family macOS runs on implements it and Metal offers no query for
+/// it, so the paravirtualized device is the whole predicate: it rejects the
+/// descriptor with `MTLSamplerAddressModeMirrorClampToEdge is not supported on
+/// this device`. The sampler path substitutes `MirrorRepeat` when this is
+/// false, up front, because the rejected creation is API misuse the validation
+/// layer logs whether or not a retry succeeds.
+pub fn supports_sampler_mirror_clamp(device: &ProtocolObject<dyn MTLDevice>) -> bool {
+    !is_paravirtual(device)
+}
+
+/// True when the Metal device is the paravirtualized one a CI runner exposes.
+///
+/// It answers `supportsFamily:` like the Mac2 device it stands in for while
+/// implementing less than one, so a feature it is known to reject is gated on
+/// its name instead.
+fn is_paravirtual(device: &ProtocolObject<dyn MTLDevice>) -> bool {
+    is_paravirtual_name(&device.name().to_string())
+}
+
+/// True when a Metal device name is the paravirtualized device's.
+fn is_paravirtual_name(name: &str) -> bool {
+    name.contains("Paravirtual")
+}
+
+/// True when a copy out of a resolve target has to wait for the resolve's command buffer.
+///
+/// Every real GPU orders the command buffers of one queue, so a copy in a
+/// later command buffer reads the resolved content. The paravirtualized
+/// device can hand that copy the content the target held before the
+/// resolve, so the encoder waits for the resolving command buffer to
+/// complete first on it. Metal offers no query for the fault, so the
+/// device's name is the whole predicate.
+fn resolve_needs_retire(device: &ProtocolObject<dyn MTLDevice>) -> bool {
+    is_paravirtual(device)
+}
+
+/// True when a refused texture or view create on the device is worth asking for again.
+///
+/// Every real GPU refuses a valid descriptor only when it is out of memory,
+/// and asking again at once gets the same answer. The paravirtualized device
+/// refuses one now and then while several threads create and release
+/// textures, with its kernel logging the new object's id as one that already
+/// exists; requests on other threads succeed within the same second, so the
+/// refusal is not a lasting state of the device. Metal offers no query for
+/// the fault, so the device's name is the whole predicate. The name also
+/// matches the Apple-silicon virtual device of a VM, which has not shown the
+/// fault and gains only the retry's bounded wait on a create it refuses.
+pub fn refuses_creates_transiently(device: &ProtocolObject<dyn MTLDevice>) -> bool {
+    is_paravirtual(device)
+}
+
+/// True when the device belongs to Metal's Apple GPU family.
+///
+/// The Apple family is what an Apple Silicon Mac's GPU claims; an Intel or
+/// AMD GPU claims Mac2 only, and the paravirtualized device a CI runner
+/// exposes claims nothing. Two texture rules branch on it: which pixel
+/// formats exist natively, and whether a view that changes only transfer
+/// function or swizzle needs the `PixelFormatView` usage on its base texture.
+pub fn is_apple_family(device: &ProtocolObject<dyn MTLDevice>) -> bool {
+    device.supportsFamily(MTLGPUFamily::Apple2)
+}
+
+/// True when the packed 16-bit pixel formats exist natively on this device.
+///
+/// `B5G6R5Unorm` / `Bgr5A1Unorm` / `Abgr4Unorm` are listed Apple-family-only
+/// in Metal's pixel-format capability table; the Mac2 Bronze driver
+/// (Intel/AMD) raises a validation abort when a texture descriptor names one.
+/// When false, the PE side backs the corresponding D3D formats with
+/// `Bgra8Unorm` and widens their texels in the GPU upload pass.
+pub fn supports_native_packed16(device: &ProtocolObject<dyn MTLDevice>) -> bool {
+    is_apple_family(device)
+}
+
+/// Storage mode for a texture the CPU writes with `replaceRegion:`.
+///
+/// `Shared` where the CPU and GPU share memory; a device without unified
+/// memory rejects `Shared` textures outright, and `Managed` is the mode that
+/// keeps a CPU-writable copy there. `replaceRegion:` carries the write across
+/// on its own for a `Managed` texture, so the caller needs nothing further.
+pub fn cpu_written_texture_storage(device: &ProtocolObject<dyn MTLDevice>) -> MTLStorageMode {
+    if device.hasUnifiedMemory() {
+        MTLStorageMode::Shared
+    } else {
+        MTLStorageMode::Managed
+    }
+}
+
+/// True when single-precision float textures sample with linear filtering.
+///
+/// The query covers exactly `R32Float` / `RG32Float` / `RGBA32Float`; the
+/// half-float formats are filterable on every family Metal's pixel-format
+/// capability table lists for macOS, so they need no query. The PE side
+/// answers `CheckDeviceFormat(D3DUSAGE_QUERY_FILTER)` for R32F / G32R32F /
+/// A32B32G32R32F with this bit.
+pub fn supports_float32_filtering(device: &ProtocolObject<dyn MTLDevice>) -> bool {
+    device.supports32BitFloatFiltering()
+}
+
+/// Snapshot of the Metal device values the PE side needs.
+///
+/// Used to pick storage modes, alignment, and `didModifyRange:` policy.
+/// Captured once at device creation, never re-queried.
+pub struct DeviceCaps {
+    pub device_handle: MetalHandle<MTLDeviceKind>,
+    /// The device's record, which owns the queue and its presentation state.
+    pub record_handle: DeviceRecordHandle,
+    /// `MTLDevice.hasUnifiedMemory`. False on Intel/AMD discrete GPUs.
+    pub unified_memory: bool,
+    /// `device.minimumLinearTextureAlignmentForPixelFormat(BGRA8Unorm)`, in bytes.
+    ///
+    /// 16 on Apple Silicon, 256 on Mac2 (AMD/Intel).
+    pub min_linear_texture_align: u32,
+}
+
+/// Creates an `MTLCommandQueue` on the process's Metal device.
+///
+/// Snapshots the device caps the PE side needs at creation time. Every D3D
+/// device is handed the same `MTLDevice`, so the process-wide Metal caches and
+/// the command buffers that bind from them always name one device.
+pub fn create_command_queue(
+    gate: Option<PathBuf>,
+    present_debug: PresentDebugFlags,
+) -> Option<DeviceCaps> {
+    let device = pinned_device()?;
+    let queue = device.newCommandQueue()?;
+    let queue_label = objc2_foundation::NSString::from_str("mtld3d");
+    queue.setLabel(Some(&queue_label));
+    // The record takes the queue's retain before the presenter thread
+    // exists, so the thread's own retain at start lands on a live object.
+    // SAFETY: `Retained::into_raw` transfers the retain into the raw
+    // address, which the record's `Drop` releases.
+    let queue_handle =
+        unsafe { MetalHandle::<MTLCommandQueueKind>::new(Retained::into_raw(queue) as u64) };
+    let record = DeviceRecord::new(queue_handle, gate, present_debug);
+    if !super::presenter::spawn(&record) {
+        return None;
+    }
+    let unified_memory = device.hasUnifiedMemory();
+    let min_linear_texture_align = u32::try_from(
+        device.minimumLinearTextureAlignmentForPixelFormat(MTLPixelFormat::BGRA8Unorm),
+    )
+    .expect("Metal min linear texture alignment fits u32");
+
+    // SAFETY: `Retained::into_raw` transfers the retain into the returned
+    // `u64`; `MetalHandle::new` adopts that retain into a typed handle. The
+    // PE side keeps the handle alive until the matching destroy thunk fires.
+    // The device retain is the one `pinned_device` took for this caller, not
+    // the pin's own, so `destroy_command_queue` releasing it leaves the
+    // pinned device live for the next D3D device and for the process-wide
+    // caches.
+    let device_handle =
+        unsafe { MetalHandle::<MTLDeviceKind>::new(Retained::into_raw(device) as u64) };
+    Some(DeviceCaps {
+        device_handle,
+        record_handle: record.into_handle(),
+        unified_memory,
+        min_linear_texture_align,
+    })
+}
+
+/// Releases `MTLDevice` + `MTLCommandQueue` + backbuffer + depth texture.
+///
+/// If `view_handle` is non-null, retires the macdrv metal view: kept for the
+/// window's next device, see `macdrv::retire_metal_view`.
+pub fn destroy_command_queue(
+    device_handle: MetalHandle<MTLDeviceKind>,
+    device_record: &Arc<DeviceRecord>,
+    view_handle: MetalHandle<NSViewKind>,
+    backbuffer_handle: MetalHandle<MTLTextureKind>,
+    depth_texture_handle: MetalHandle<MTLTextureKind>,
+) {
+    let queue_handle = device_record.queue();
+    // The presenter first: it may still be inside `nextDrawable` on the
+    // layer this call retires, and its last present must be committed before
+    // the fence below can order it. The PE side has already drained its
+    // submit thread and waited for presentation to go idle.
+    super::presenter::stop_and_join(device_record.present());
+    // Drop the latched view, layer and window first: the main thread
+    // reconciles them against the display it is told about, and this call is
+    // about to release the view all three belong to.
+    let record = detach_metal_layer(view_handle);
+
+    // Force-drain any in-flight or recently-completed command buffers
+    // before we drop the queue + device. The PE-side encoder already
+    // waited for `coherent_seq` to catch up before destroying its
+    // resource handles, but Apple's `addCompletedHandler` can fire
+    // *before* Metal's queue-internal release of the command buffer
+    // and its referenced resources. Without this fence, MTLBuffers
+    // wrapping `bytesNoCopy` PE pages can stay alive past our
+    // `objc_release` because Metal's queue-internal retain hasn't
+    // dropped yet — a subsequent `newBufferWithBytesNoCopy:` over the
+    // same page on a fresh device returns nil ("page already wired").
+    // Committing an empty command buffer and `waitUntilCompleted` on
+    // the soon-to-be-destroyed queue gives Metal a synchronisation
+    // point to flush that internal cleanup.
+    if let Some(queue) = queue_handle.into_retained()
+        && let Some(fence) = queue.commandBuffer()
+    {
+        let label = objc2_foundation::NSString::from_str("mtld3d-shutdown-fence");
+        fence.setLabel(Some(&label));
+        fence.commit();
+        fence.waitUntilCompleted();
+    }
+    // The device's scratch targets (readback resolve, HDR present) and its
+    // MetalFX scalers go after the fence, which is what proves no command
+    // buffer of this queue still touches them, and before the queue itself.
+    super::upscale::retire(device_record.upscale());
+
+    // The PE side has flushed the GPU and is dropping its only copy of each
+    // handle, so the canonical retain transferred at creation time is now
+    // ours to release.
+    crate::metal::destroy_texture(depth_texture_handle.raw());
+    crate::metal::destroy_texture(backbuffer_handle.raw());
+    // The queue's own retain rides on the record, which the caller drops
+    // once this returns.
+    // SAFETY: as above: the device's canonical retain is ours to release.
+    unsafe { device_handle.release_retain() };
+    if !view_handle.is_null() {
+        retire_metal_view(view_handle, record.as_deref());
+    }
+}
+
+#[cfg(test)]
+mod tests;
diff --git a/mtld3d/unix/unix/src/metal/device/tests.rs b/mtld3d/unix/unix/src/metal/device/tests.rs
new file mode 100644
index 00000000..585cd6fa
--- /dev/null
+++ b/mtld3d/unix/unix/src/metal/device/tests.rs
@@ -0,0 +1,96 @@
+//! Unit tests for the process-pinned Metal device.
+//!
+//! The pin is what makes the process-wide Metal caches sound: they hold
+//! pipeline states, textures and buffers built on one `MTLDevice`, and Metal
+//! rejects an encode that mixes objects of two. Every Mac these tests run on
+//! has one GPU, so the assertions pin the invariant rather than reproduce the
+//! dual-GPU divergence, which needs graphics switching to observe.
+
+use mtld3d_shared::mtl::PresentDebugFlags;
+use objc2_metal::MTLDevice;
+
+use super::{DeviceCaps, create_command_queue, default_device_info, is_paravirtual_name};
+use crate::metal::handle::{IntoRetained, ReleaseRetain};
+
+/// Retires the presenter and drops the retains of one `DeviceCaps`, as the destroy thunk does.
+///
+/// The caller must be done with both handles, and no copy of either may be
+/// used afterwards.
+fn release(caps: &DeviceCaps) {
+    // SAFETY: this stands in for `destroy_command_queue`: the handle came
+    // from `create_command_queue` and nothing names it afterwards.
+    let record = unsafe { crate::metal::DeviceRecord::consume(caps.record_handle) }
+        .expect("the record of a created device");
+    crate::metal::presenter::stop_and_join(record.present());
+    // The queue's retain rides on the record, released as it drops here.
+    drop(record);
+    // SAFETY: the device handle carries the retain `create_command_queue`
+    // took for this D3D device, not the pin's own.
+    unsafe { caps.device_handle.release_retain() };
+}
+
+/// Two `create_command_queue` calls hand out one device, and the caps agree with it.
+///
+/// The second call must name the same `id<MTLDevice>` as the first, and
+/// `default_device_info`, which answers the PE side's `GetDeviceInfo`, must
+/// report that device's registry id rather than a second resolution's. The
+/// third call proves the pin keeps a retain of its own: the device is still
+/// live after both handed-out retains are dropped.
+#[test]
+fn create_command_queue_hands_out_the_pinned_device() {
+    let Some(first) = create_command_queue(None, PresentDebugFlags::empty()) else {
+        eprintln!("MTLCreateSystemDefaultDevice returned nil, skipping");
+        return;
+    };
+    let second = create_command_queue(None, PresentDebugFlags::empty())
+        .expect("a second queue on the pinned device");
+    assert_eq!(
+        first.device_handle.raw(),
+        second.device_handle.raw(),
+        "every D3D device gets the same MTLDevice"
+    );
+    assert_ne!(
+        first.record_handle.raw(),
+        second.record_handle.raw(),
+        "each D3D device gets its own record, and its own MTLCommandQueue with it"
+    );
+
+    let (_, registry_id, _) = default_device_info().expect("caps for the pinned device");
+    let device = first
+        .device_handle
+        .into_retained()
+        .expect("the handed-out device handle is live");
+    assert_eq!(
+        device.registryID(),
+        registry_id,
+        "the caps answer describes the device the queues were made on"
+    );
+    drop(device);
+
+    release(&first);
+    release(&second);
+
+    let third = create_command_queue(None, PresentDebugFlags::empty())
+        .expect("a queue after both devices were destroyed");
+    let device = third
+        .device_handle
+        .into_retained()
+        .expect("the pinned device outlives the handles it was handed out through");
+    assert_eq!(device.registryID(), registry_id);
+    drop(device);
+    release(&third);
+}
+
+#[test]
+fn only_the_paravirtual_device_name_takes_the_paravirtual_answers() {
+    assert!(is_paravirtual_name("Apple Paravirtual device"));
+    for real in [
+        "Apple M1",
+        "Apple M4 Max",
+        "AMD Radeon Pro 5500M",
+        "Intel(R) UHD Graphics 630",
+        "Intel(R) Iris(TM) Plus Graphics",
+    ] {
+        assert!(!is_paravirtual_name(real), "{real} is a real GPU");
+    }
+}
diff --git a/mtld3d/unix/unix/src/metal/frame_signal.rs b/mtld3d/unix/unix/src/metal/frame_signal.rs
new file mode 100644
index 00000000..5dcd84df
--- /dev/null
+++ b/mtld3d/unix/unix/src/metal/frame_signal.rs
@@ -0,0 +1,303 @@
+//! When a presented frame counts as finished, and the `Present` wait for one.
+//!
+//! A device keeps at most its maximum frame latency of presented frames
+//! unfinished: at the end of `Present(k)` the API thread waits until frame
+//! `k - L` has finished. A frame finishes when its draw command buffer has
+//! ended on the GPU, which the device's draw counter says, and, when its
+//! present is paced (it carries a minimum duration: vsync, a divided
+//! interval or the frame cap), once that present has reached the screen or
+//! been discarded. Into a window the compositor does not show, the presenter
+//! holds each paced present to that duration on its own clock before it
+//! skips the drawable, or acquires one under `debug.presentOccluded`; into a
+//! visible window whose recent paced presents all came back undisplayed it
+//! holds them the same way and still presents them. An `IMMEDIATE` present
+//! without a frame cap counts GPU completion alone.
+//!
+//! The paced half is the device's [`FrameSignal`]: the submit thread notes
+//! each submission before its draw buffer commits, the presenter resolves a
+//! paced present when the drawable is presented or the packet is dropped,
+//! and the signal publishes into a PE-owned counter the sequence below which
+//! nothing paced is outstanding, so a `Present` whose target has finished
+//! never crosses into native code. The wait itself runs on the API thread
+//! and wakes on every event that can end it: a draw buffer retiring, a paced
+//! present resolving, a `Reset`, a present the presenter drops because the
+//! window is covered or no drawable came, a failure that ends the encoder,
+//! and teardown. The paced half of a wait is also capped at
+//! [`PACED_PRESENT_CAP`], or three of the present's minimum durations when
+//! that is longer, logged once when it fires, since what shows a present is
+//! the compositor's and not ours; the presents it gave up on are released,
+//! so the `Present` after it does not wait for them again.
+
+use std::{
+    collections::VecDeque,
+    sync::{Arc, Condvar, Mutex, MutexGuard, PoisonError},
+    time::{Duration, Instant},
+};
+
+use super::submission::RetirementCounter;
+use crate::LOG_TARGET;
+
+/// How long a wait gives a paced present to be shown once its frame's GPU work has finished.
+///
+/// The layer's drawable timeout (`allowsNextDrawableTimeout`, documented
+/// as one second): the presenter gives up on a drawable after as long, so
+/// a present still unshown that much later is held by the compositor, not
+/// by the GPU or the presenter.
+pub const PACED_PRESENT_CAP: Duration = Duration::from_secs(1);
+
+/// How a frame wait ended.
+#[derive(Debug, PartialEq, Eq)]
+pub enum FrameWait {
+    /// The frame finished.
+    Finished,
+    /// The encoder ended (a failure, or teardown) before it did; nothing more will finish.
+    Ended,
+}
+
+/// One device's frame-latency signal, shared by its submit, presenter and API threads.
+pub struct FrameSignal {
+    state: Mutex<SignalState>,
+    /// Woken when anything a [`FrameSignal::wait`] reads may have moved.
+    changed: Condvar,
+}
+
+/// A paced present still owed to the frame-latency signal.
+///
+/// Rides the present packet and, once the present commits, the drawable's
+/// presented handler. Resolving is idempotent, and dropping resolves, so a
+/// packet the presenter drops, a handler Metal releases without calling, and
+/// a `Reset` that already cleared the entry all end it.
+pub struct PacedMark {
+    signal: Arc<FrameSignal>,
+    seq: u64,
+}
+
+struct SignalState {
+    /// Sequences of paced presents not yet presented or discarded, ascending.
+    paced: VecDeque<u64>,
+    /// Newest submission the submit thread noted.
+    latest: u64,
+    /// The minimum present duration of the newest paced present: the display's pace.
+    pacing: Duration,
+    /// The PE-owned counter the paced floor is published into; none once ended.
+    floor: RetirementCounter,
+    /// API threads inside [`FrameSignal::wait`].
+    waiters: u32,
+    /// The encoder ended; no frame outstanding now will finish.
+    ended: bool,
+}
+
+impl Default for FrameSignal {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl FrameSignal {
+    #[must_use]
+    pub const fn new() -> Self {
+        Self {
+            state: Mutex::new(SignalState {
+                paced: VecDeque::new(),
+                latest: 0,
+                pacing: Duration::ZERO,
+                floor: RetirementCounter::NONE,
+                waiters: 0,
+                ended: true,
+            }),
+            changed: Condvar::new(),
+        }
+    }
+
+    fn lock(&self) -> MutexGuard<'_, SignalState> {
+        self.state.lock().unwrap_or_else(PoisonError::into_inner)
+    }
+
+    /// Start serving an encoder whose paced floor is `floor`.
+    pub fn attach(&self, floor: RetirementCounter) {
+        let mut state = self.lock();
+        state.paced.clear();
+        state.latest = 0;
+        state.pacing = Duration::ZERO;
+        state.floor = floor;
+        state.ended = false;
+    }
+
+    /// Note a submission before its draw buffer commits; a paced present gets its mark.
+    ///
+    /// `pacing` is the present's minimum duration when it waits for the
+    /// display, `None` for any other submission. Every submission is noted,
+    /// presenting or not, so the floor reaches a sequence once nothing paced
+    /// at or below it is outstanding. Noting before the commit is what lets a
+    /// reader of the draw counter trust the floor: a draw counter at a
+    /// sequence means that sequence was noted.
+    pub fn note_submission(
+        self: &Arc<Self>,
+        seq: u64,
+        pacing: Option<Duration>,
+    ) -> Option<PacedMark> {
+        let mut state = self.lock();
+        if state.ended || seq == 0 {
+            return None;
+        }
+        state.latest = state.latest.max(seq);
+        let mark = pacing.map(|pacing| {
+            state.paced.push_back(seq);
+            state.pacing = pacing;
+            PacedMark {
+                signal: Arc::clone(self),
+                seq,
+            }
+        });
+        self.publish(&state);
+        drop(state);
+        mark
+    }
+
+    /// Wake the waiters: a draw buffer of this device retired.
+    pub fn retired(&self) {
+        let state = self.lock();
+        if state.waiters > 0 {
+            self.changed.notify_all();
+        }
+    }
+
+    /// Resolve every paced present still owed.
+    ///
+    /// A `Reset` calls it once it has drained presentation, since the layer
+    /// the presents were waiting on may be replaced. The presenter calls it
+    /// when it drops a present because no drawable came: the compositor has
+    /// stopped handing this layer drawables, so the ones already committed
+    /// may not be shown for as long as that lasts, and a `Present` waiting on
+    /// one of them has to go on.
+    pub fn release_paced(&self) {
+        let mut state = self.lock();
+        state.paced.clear();
+        self.publish(&state);
+        drop(state);
+    }
+
+    /// Resolve the paced presents at or below `seq`, and keep the ones after it owed.
+    ///
+    /// The presenter calls it when it drops the present of `seq` because the
+    /// window is covered: the drawables committed before it may not be shown
+    /// while that lasts, and the presents behind it are still to be held to
+    /// the window's pace, one by one, when the presenter reaches them.
+    pub fn release_paced_through(&self, seq: u64) {
+        let mut state = self.lock();
+        self.release_through(&mut state, seq);
+        drop(state);
+    }
+
+    /// End the signal: the encoder failed or is going away, and nothing outstanding will finish.
+    ///
+    /// Also stops every later publication into the PE counter, which the PE
+    /// side frees once the encoder is destroyed, so a presented handler that
+    /// runs after that writes nothing.
+    pub fn end(&self) {
+        let mut state = self.lock();
+        state.ended = true;
+        state.paced.clear();
+        state.floor = RetirementCounter::NONE;
+        drop(state);
+        self.changed.notify_all();
+    }
+
+    /// Wait until the frame submitted as `target` finished, or the signal ended.
+    ///
+    /// `draw` is the device's draw counter. Returns at once when the frame
+    /// has finished already. Once the frame's GPU work has finished, the wait
+    /// for its paced present lasts at most `paced_cap`, or three of the
+    /// display's minimum present durations when that is longer, so a frame
+    /// cap of a few hertz is not mistaken for a stalled compositor. When the
+    /// cap fires, the frame counts as finished, the paced presents at or
+    /// below it are released and a warning is logged once.
+    pub fn wait(&self, draw: RetirementCounter, target: u64, paced_cap: Duration) -> FrameWait {
+        let mut state = self.lock();
+        state.waiters += 1;
+        let mut gpu_finished_at: Option<Instant> = None;
+        let outcome = loop {
+            if state.ended {
+                break FrameWait::Ended;
+            }
+            if draw.load() < target {
+                state = self
+                    .changed
+                    .wait(state)
+                    .unwrap_or_else(PoisonError::into_inner);
+                continue;
+            }
+            if floor_of(&state) >= target {
+                break FrameWait::Finished;
+            }
+            let cap = paced_cap.max(state.pacing.saturating_mul(3));
+            let since = *gpu_finished_at.get_or_insert_with(Instant::now);
+            let left = cap.saturating_sub(since.elapsed());
+            if left.is_zero() {
+                mtld3d_shared::log_once_warn!(
+                    target: LOG_TARGET,
+                    "frame latency: a paced present was not shown {cap:?} after its frame's GPU \
+                     work finished; Present goes on without it",
+                );
+                self.release_through(&mut state, target);
+                break FrameWait::Finished;
+            }
+            state = self
+                .changed
+                .wait_timeout(state, left)
+                .unwrap_or_else(PoisonError::into_inner)
+                .0;
+        };
+        state.waiters -= 1;
+        outcome
+    }
+
+    /// Resolve the paced present of `seq`; a sequence no longer listed changes nothing.
+    fn resolve(&self, seq: u64) {
+        let mut state = self.lock();
+        let Some(index) = state.paced.iter().position(|&paced| paced == seq) else {
+            return;
+        };
+        state.paced.remove(index);
+        self.publish(&state);
+        drop(state);
+    }
+
+    /// Resolve the paced presents at or below `seq` and publish, under the state's lock.
+    fn release_through(&self, state: &mut SignalState, seq: u64) {
+        state.paced.retain(|&paced| paced > seq);
+        self.publish(state);
+    }
+
+    /// Publish the floor and wake the waiters, under the state's lock.
+    fn publish(&self, state: &SignalState) {
+        state.floor.publish(floor_of(state));
+        if state.waiters > 0 {
+            self.changed.notify_all();
+        }
+    }
+}
+
+impl PacedMark {
+    /// The present this mark stands for reached the screen or was discarded.
+    pub fn resolve(&self) {
+        self.signal.resolve(self.seq);
+    }
+}
+
+impl Drop for PacedMark {
+    fn drop(&mut self) {
+        self.signal.resolve(self.seq);
+    }
+}
+
+/// The highest sequence at or below which no paced present is outstanding.
+fn floor_of(state: &SignalState) -> u64 {
+    state
+        .paced
+        .front()
+        .map_or(state.latest, |&oldest| oldest - 1)
+}
+
+#[cfg(test)]
+mod tests;
diff --git a/mtld3d/unix/unix/src/metal/frame_signal/tests.rs b/mtld3d/unix/unix/src/metal/frame_signal/tests.rs
new file mode 100644
index 00000000..cee9417b
--- /dev/null
+++ b/mtld3d/unix/unix/src/metal/frame_signal/tests.rs
@@ -0,0 +1,310 @@
+//! The frame-latency signal: what finishes a frame, and every event that wakes a waiter.
+
+use std::{
+    sync::{
+        Arc,
+        atomic::{AtomicU64, Ordering},
+        mpsc,
+    },
+    thread,
+    time::Duration,
+};
+
+use super::*;
+
+/// The minimum present duration the paced presents of these tests carry, far below any cap.
+const PACING: Duration = Duration::from_millis(1);
+/// How long a test lets a waiter run before it reads it as parked.
+const PARKED: Duration = Duration::from_millis(50);
+/// How long a test waits for a woken waiter to report.
+const WOKEN: Duration = Duration::from_secs(5);
+
+fn counter(atomic: &AtomicU64) -> RetirementCounter {
+    // SAFETY: every test keeps its atomic alive past the signal's and the waiter's last use.
+    unsafe { RetirementCounter::from_address(core::ptr::from_ref(atomic) as u64) }
+}
+
+fn attached(floor: &AtomicU64) -> Arc<FrameSignal> {
+    let signal = Arc::new(FrameSignal::new());
+    signal.attach(counter(floor));
+    signal
+}
+
+/// Start a waiter for `target` on its own thread; its outcome arrives on the receiver.
+fn spawn_waiter(
+    signal: &Arc<FrameSignal>,
+    draw: &Arc<AtomicU64>,
+    target: u64,
+) -> mpsc::Receiver<FrameWait> {
+    let (sender, receiver) = mpsc::channel();
+    let signal = Arc::clone(signal);
+    let draw = Arc::clone(draw);
+    thread::spawn(move || {
+        let _ = sender.send(signal.wait(counter(&draw), target, PACED_PRESENT_CAP));
+    });
+    assert!(
+        receiver.recv_timeout(PARKED).is_err(),
+        "the waiter parks while its frame is unfinished"
+    );
+    receiver
+}
+
+fn shared_counter() -> Arc<AtomicU64> {
+    Arc::new(AtomicU64::new(0))
+}
+
+/// An unpaced frame finishes with its draw buffer, and the floor follows the submissions.
+#[test]
+fn an_unpaced_frame_finishes_with_its_draw_buffer() {
+    let draw = AtomicU64::new(0);
+    let floor = AtomicU64::new(0);
+    let signal = attached(&floor);
+    assert!(signal.note_submission(1, None).is_none());
+    assert!(signal.note_submission(2, None).is_none());
+    assert_eq!(
+        floor.load(Ordering::Acquire),
+        2,
+        "nothing paced holds the floor"
+    );
+    draw.store(2, Ordering::Release);
+    assert_eq!(
+        signal.wait(counter(&draw), 2, PACED_PRESENT_CAP),
+        FrameWait::Finished
+    );
+}
+
+/// A paced present holds the floor below it until it resolves, whatever came after it.
+#[test]
+fn a_paced_present_holds_the_floor_until_it_resolves() {
+    let floor = AtomicU64::new(0);
+    let signal = attached(&floor);
+    let mark = signal
+        .note_submission(3, Some(PACING))
+        .expect("a paced present gets a mark");
+    signal.note_submission(4, None);
+    let later = signal.note_submission(5, Some(PACING)).expect("a mark");
+    assert_eq!(floor.load(Ordering::Acquire), 2);
+    later.resolve();
+    assert_eq!(
+        floor.load(Ordering::Acquire),
+        2,
+        "an older paced present still holds it"
+    );
+    mark.resolve();
+    assert_eq!(floor.load(Ordering::Acquire), 5);
+    drop(mark);
+    drop(later);
+    assert_eq!(
+        floor.load(Ordering::Acquire),
+        5,
+        "resolving twice changes nothing"
+    );
+}
+
+/// A draw buffer retiring wakes the waiter: the completion handler's and the CPU-failure path.
+#[test]
+fn a_retired_draw_buffer_wakes_the_waiter() {
+    let draw = shared_counter();
+    let floor = AtomicU64::new(0);
+    let signal = attached(&floor);
+    signal.note_submission(7, None);
+    let waiter = spawn_waiter(&signal, &draw, 7);
+    draw.store(7, Ordering::Release);
+    signal.retired();
+    assert_eq!(waiter.recv_timeout(WOKEN), Ok(FrameWait::Finished));
+}
+
+/// The presented handler resolving a paced present wakes the waiter.
+#[test]
+fn a_presented_paced_present_wakes_the_waiter() {
+    let draw = shared_counter();
+    let floor = AtomicU64::new(0);
+    let signal = attached(&floor);
+    let mark = signal.note_submission(4, Some(PACING)).expect("a mark");
+    draw.store(4, Ordering::Release);
+    let waiter = spawn_waiter(&signal, &draw, 4);
+    mark.resolve();
+    assert_eq!(waiter.recv_timeout(WOKEN), Ok(FrameWait::Finished));
+}
+
+/// A packet dropped unpresented, or a handler Metal releases uncalled, resolves through its drop.
+#[test]
+fn a_dropped_mark_wakes_the_waiter() {
+    let draw = shared_counter();
+    let floor = AtomicU64::new(0);
+    let signal = attached(&floor);
+    let mark = signal.note_submission(4, Some(PACING)).expect("a mark");
+    draw.store(4, Ordering::Release);
+    let waiter = spawn_waiter(&signal, &draw, 4);
+    drop(mark);
+    assert_eq!(waiter.recv_timeout(WOKEN), Ok(FrameWait::Finished));
+}
+
+/// Releasing the paced presents, as a `Reset` or a dropped present does, wakes the waiter.
+#[test]
+fn releasing_the_paced_presents_wakes_the_waiter() {
+    let draw = shared_counter();
+    let floor = AtomicU64::new(0);
+    let signal = attached(&floor);
+    let mark = signal.note_submission(6, Some(PACING)).expect("a mark");
+    draw.store(6, Ordering::Release);
+    let waiter = spawn_waiter(&signal, &draw, 6);
+    signal.release_paced();
+    assert_eq!(waiter.recv_timeout(WOKEN), Ok(FrameWait::Finished));
+    assert_eq!(floor.load(Ordering::Acquire), 6);
+    drop(mark);
+}
+
+/// Releasing through a sequence resolves the paced presents at or below it and wakes the waiter.
+///
+/// What a present dropped because its window is covered does: the presents
+/// behind it stay owed until the presenter holds each to the window's pace.
+#[test]
+fn releasing_through_a_present_keeps_the_later_ones_owed() {
+    let draw = shared_counter();
+    let floor = AtomicU64::new(0);
+    let signal = attached(&floor);
+    let early = signal.note_submission(3, Some(PACING)).expect("a mark");
+    let dropped = signal.note_submission(5, Some(PACING)).expect("a mark");
+    let behind = signal.note_submission(7, Some(PACING)).expect("a mark");
+    draw.store(7, Ordering::Release);
+    let waiter = spawn_waiter(&signal, &draw, 5);
+    signal.release_paced_through(5);
+    assert_eq!(waiter.recv_timeout(WOKEN), Ok(FrameWait::Finished));
+    assert_eq!(
+        floor.load(Ordering::Acquire),
+        6,
+        "the present behind the release still holds the floor"
+    );
+    drop(behind);
+    assert_eq!(floor.load(Ordering::Acquire), 7);
+    drop(early);
+    drop(dropped);
+}
+
+/// A failure that ends the encoder wakes the waiter of a frame that never committed.
+#[test]
+fn an_ended_encoder_wakes_the_waiter() {
+    let draw = shared_counter();
+    let floor = AtomicU64::new(0);
+    let signal = attached(&floor);
+    let waiter = spawn_waiter(&signal, &draw, 9);
+    signal.end();
+    assert_eq!(waiter.recv_timeout(WOKEN), Ok(FrameWait::Ended));
+}
+
+/// Once ended, the signal notes nothing and writes no more into the PE counter.
+#[test]
+fn an_ended_signal_publishes_nothing() {
+    let draw = AtomicU64::new(0);
+    let floor = AtomicU64::new(0);
+    let signal = attached(&floor);
+    let mark = signal.note_submission(2, Some(PACING)).expect("a mark");
+    signal.end();
+    assert!(signal.note_submission(3, None).is_none());
+    drop(mark);
+    assert_eq!(
+        floor.load(Ordering::Acquire),
+        1,
+        "the floor stays where the end left it"
+    );
+    assert_eq!(
+        signal.wait(counter(&draw), 1, PACED_PRESENT_CAP),
+        FrameWait::Ended
+    );
+}
+
+/// A signal no encoder attached answers every wait as ended, so nothing can park on it.
+#[test]
+fn an_unattached_signal_never_parks() {
+    let draw = AtomicU64::new(0);
+    let signal = Arc::new(FrameSignal::new());
+    assert!(signal.note_submission(1, Some(PACING)).is_none());
+    assert_eq!(
+        signal.wait(counter(&draw), 1, PACED_PRESENT_CAP),
+        FrameWait::Ended
+    );
+}
+
+/// A paced present nothing shows holds the wait only for the cap, once the GPU work is done.
+#[test]
+fn an_unshown_paced_present_holds_the_wait_only_for_the_cap() {
+    const CAP: Duration = Duration::from_millis(100);
+    let draw = AtomicU64::new(5);
+    let floor = AtomicU64::new(0);
+    let signal = attached(&floor);
+    let mark = signal.note_submission(5, Some(PACING)).expect("a mark");
+    let started = std::time::Instant::now();
+    assert_eq!(signal.wait(counter(&draw), 5, CAP), FrameWait::Finished);
+    assert!(started.elapsed() >= CAP, "the wait lasted the cap");
+    drop(mark);
+}
+
+/// The cap does not shorten a wait for GPU work still running.
+#[test]
+fn the_cap_starts_when_the_gpu_work_finishes() {
+    const CAP: Duration = Duration::from_millis(20);
+    let draw = shared_counter();
+    let floor = AtomicU64::new(0);
+    let signal = attached(&floor);
+    let mark = signal.note_submission(3, Some(PACING)).expect("a mark");
+    let (sender, receiver) = mpsc::channel();
+    {
+        let signal = Arc::clone(&signal);
+        let draw = Arc::clone(&draw);
+        thread::spawn(move || {
+            let _ = sender.send(signal.wait(counter(&draw), 3, CAP));
+        });
+    }
+    assert!(
+        receiver.recv_timeout(CAP * 5).is_err(),
+        "the draw buffer still runs, so the cap has not started"
+    );
+    draw.store(3, Ordering::Release);
+    signal.retired();
+    assert_eq!(receiver.recv_timeout(WOKEN), Ok(FrameWait::Finished));
+    drop(mark);
+}
+
+/// A fired cap releases the paced presents at or below its frame, so the next wait takes none.
+#[test]
+fn a_fired_cap_releases_the_presents_it_gave_up_on() {
+    const CAP: Duration = Duration::from_millis(20);
+    let draw = AtomicU64::new(6);
+    let floor = AtomicU64::new(0);
+    let signal = attached(&floor);
+    let older = signal.note_submission(5, Some(PACING)).expect("a mark");
+    let target = signal.note_submission(6, Some(PACING)).expect("a mark");
+    let newer = signal.note_submission(7, Some(PACING)).expect("a mark");
+    assert_eq!(signal.wait(counter(&draw), 6, CAP), FrameWait::Finished);
+    assert_eq!(
+        floor.load(Ordering::Acquire),
+        6,
+        "5 and 6 released, 7 still owed"
+    );
+    let again = std::time::Instant::now();
+    assert_eq!(signal.wait(counter(&draw), 6, CAP), FrameWait::Finished);
+    assert!(
+        again.elapsed() < CAP,
+        "the next wait for it returns at once"
+    );
+    drop((older, target, newer));
+}
+
+/// A display paced slower than the cap stretches it to three of its present durations.
+#[test]
+fn a_slow_display_pace_stretches_the_cap() {
+    const CAP: Duration = Duration::from_millis(20);
+    const SLOW: Duration = Duration::from_millis(100);
+    let draw = AtomicU64::new(5);
+    let floor = AtomicU64::new(0);
+    let signal = attached(&floor);
+    let mark = signal.note_submission(5, Some(SLOW)).expect("a mark");
+    let started = std::time::Instant::now();
+    assert_eq!(signal.wait(counter(&draw), 5, CAP), FrameWait::Finished);
+    assert!(
+        started.elapsed() >= SLOW * 3,
+        "the wait lasted three present durations, not the cap"
+    );
+    drop(mark);
+}
