+/// `count` passes on the back buffer and the depth surface, each closed with nothing in it.
+fn clear_only_passes(count: usize) -> PassState {
+    let mut s = fresh();
+    for _ in 0..count {
+        s.ensure_pass_open();
+        s.end_current_pass("test");
+    }
+    s
+}
