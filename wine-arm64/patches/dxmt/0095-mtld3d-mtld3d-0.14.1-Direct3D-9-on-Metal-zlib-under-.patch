+#[test]
+fn fixed_function_cube_sampling_uses_direction_coordinates() {
+    let h = Harness::new();
+    let cube = h.create_cube_texture_owned(4, 1, 0, D3DFMT_A8R8G8B8, D3DPOOL_MANAGED);
+    {
+        let mut face = cube.lock_rect(0, 0, 0);
+        face.write_u32(&[0xFFFF_0000; 16]);
+    }
