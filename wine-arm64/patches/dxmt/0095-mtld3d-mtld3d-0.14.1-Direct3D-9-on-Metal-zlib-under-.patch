+    let ifc_lt_token = u32::from(OP_IFC) | ((4u32) << 16) | (2u32 << 24); // cmp=4 (Lt), token_count=2
+    let bc = vec![
+        PS3_HEADER,
+        opcode_token(OP_DCL, 2),
+        dcl_usage_token(DCL_TEXCOORD, 0),
+        dst_token(TYPE_INPUT, 0, 0xF, false),
