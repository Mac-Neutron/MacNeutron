+            cmd
+        };
+        let commands = [
+            make(&depth, BlitCommandType::CopyBufferToDepth),
+            make(&masks, BlitCommandType::CopyBufferToStencil),
+        ];
+        if generation != 0 {
+            for bad in 0..6 {
+                let mut rejected = commands;
+                match bad {
+                    0 => rejected[1].src_handle = 0,
+                    1 => rejected[1].dst_handle = 0,
+                    2 => rejected[1].mip_level = 1,
