+#[test]
+fn a_group_permission_error_survives_the_exit_observation_deadline() {
+    let mut observations = 0;
+    let error = super::resolve_group_signal_error(
+        std::io::Error::from_raw_os_error(libc::EPERM),
+        Duration::ZERO,
+        || {
+            observations += 1;
