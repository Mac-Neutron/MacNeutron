From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Wed, 7 Oct 2026 21:21:31 -0400
Subject: [PATCH] dxgi: Minimise a fullscreen window left in the background.

When a game loses focus it may leave fullscreen itself (Unreal does,
calling SetFullscreenState(FALSE)): the mode is reset and the window goes
back to its windowed rect. Under Wine's emulated modes that is the
fullscreen-sized window drawn 1:1 in a corner of the screen, until the
game is brought back. Minimise the window when the leave happens while
it isn't in front, and log it; the game enters fullscreen again when
restored. (wined3d minimises a d3d8/9 fullscreen window that loses
focus, swapchain.c; here the game's own leave is the only signal.)
ShowWindowAsync: the caller may be a render thread, which mustn't wait
for the window thread's message loop. Both swapchains (D3D11, D3D12).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/d3d11/d3d11_swapchain.cpp    | 9 +++++++++
 src/d3d12/d3d12_swapchain.cpp    | 9 +++++++++
 src/util/wsi_window.hpp          | 7 +++++++
 src/util/wsi_window_headless.cpp | 2 ++
 src/util/wsi_window_win32.cpp    | 4 ++++
 5 files changed, 31 insertions(+)

diff --git a/src/d3d11/d3d11_swapchain.cpp b/src/d3d11/d3d11_swapchain.cpp
index 30636a7..8892b58 100644
--- a/src/d3d11/d3d11_swapchain.cpp
+++ b/src/d3d11/d3d11_swapchain.cpp
@@ -369,6 +369,15 @@ public:
       ERR("DXGI: LeaveFullscreenMode: Failed to exit fullscreen mode");
       return DXGI_ERROR_NOT_CURRENTLY_AVAILABLE;
     }
+
+    // MacNeutron: a fullscreen window the game leaves while it's in the background is minimised, so it doesn't sit
+    // at its windowed size and place after the mode reset (a corner of the screen under Wine's emulated modes); the
+    // game enters fullscreen again when it's restored. Async: the caller may not be the window's thread (Unreal's RHI
+    // thread), and must not wait for that thread's message loop.
+    if (!wsi::isForeground(hWnd)) {
+      Logger::info("Leaving fullscreen in the background: minimising");
+      wsi::minimizeWindow(hWnd);
+    }
     
     presenter->changeGammaRamp(nullptr);
 
diff --git a/src/d3d12/d3d12_swapchain.cpp b/src/d3d12/d3d12_swapchain.cpp
index 4703b3d..8f455d4 100644
--- a/src/d3d12/d3d12_swapchain.cpp
+++ b/src/d3d12/d3d12_swapchain.cpp
@@ -390,6 +390,15 @@ public:
       return DXGI_ERROR_NOT_CURRENTLY_AVAILABLE;
     }
 
+    // MacNeutron: a fullscreen window the game leaves while it's in the background is minimised, so it doesn't sit
+    // at its windowed size and place after the mode reset (a corner of the screen under Wine's emulated modes); the
+    // game enters fullscreen again when it's restored. Async: the caller may not be the window's thread (Unreal's RHI
+    // thread), and must not wait for that thread's message loop.
+    if (!wsi::isForeground(hWnd)) {
+      Logger::info("Leaving fullscreen in the background: minimising");
+      wsi::minimizeWindow(hWnd);
+    }
+
     presenter->changeGammaRamp(nullptr);
 
     return S_OK;
diff --git a/src/util/wsi_window.hpp b/src/util/wsi_window.hpp
index 9ad5df2..86285fa 100644
--- a/src/util/wsi_window.hpp
+++ b/src/util/wsi_window.hpp
@@ -118,4 +118,11 @@ bool isForeground(HWND hWindow);
 
 bool isMinimized(HWND hWindow);
 
+/**
+ * \brief Minimizes a window without waiting for its thread
+ *
+ * \param [in] hWindow The window
+ */
+void minimizeWindow(HWND hWindow);
+
 } // namespace dxmt::wsi
diff --git a/src/util/wsi_window_headless.cpp b/src/util/wsi_window_headless.cpp
index 035352a..5c600ed 100644
--- a/src/util/wsi_window_headless.cpp
+++ b/src/util/wsi_window_headless.cpp
@@ -64,4 +64,6 @@ bool isForeground(HWND hWindow) { return true; }
 
 bool isMinimized(HWND hWindow) { return false; }
 
+void minimizeWindow(HWND hWindow) {}
+
 } // namespace dxmt::wsi
diff --git a/src/util/wsi_window_win32.cpp b/src/util/wsi_window_win32.cpp
index 37621b8..b816ecf 100644
--- a/src/util/wsi_window_win32.cpp
+++ b/src/util/wsi_window_win32.cpp
@@ -269,4 +269,8 @@ bool isMinimized(HWND hWindow) {
   return ::IsIconic(hWindow);
 }
 
+void minimizeWindow(HWND hWindow) {
+  ::ShowWindowAsync(hWindow, SW_MINIMIZE);
+}
+
 } // namespace dxmt::wsi
