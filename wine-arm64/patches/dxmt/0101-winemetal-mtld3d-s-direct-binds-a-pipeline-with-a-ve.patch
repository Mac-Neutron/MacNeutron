From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Tue, 20 Oct 2026 20:01:59 -0400
Subject: [PATCH] winemetal: mtld3d's direct binds, a pipeline with a vertex
 descriptor and a source library with options

MacNeutron's Direct3D 9 on winemetal: four render nodes appended
(vertex bytes, vertex texture, vertex and fragment sampler state), slot
156 (slot 34's pipeline with a vertex descriptor) and slot 157
(newLibraryWithSource:options:error:); 153-155 refuse in this table,
the VM guest's own there.

Assisted-by: Claude Code: claude-opus-5-5
---
 src/winemetal/unix/winemetal_unix.c | 107 ++++++++++++++++++++++++++--
 src/winemetal/winemetal.h           |  53 ++++++++++++++
 src/winemetal/winemetal_thunks.c    |  35 +++++++++
 src/winemetal/winemetal_thunks.h    |  19 +++++
 4 files changed, 208 insertions(+), 6 deletions(-)

diff --git a/src/winemetal/unix/winemetal_unix.c b/src/winemetal/unix/winemetal_unix.c
index 13dd2cbb..b3a55a82 100644
--- a/src/winemetal/unix/winemetal_unix.c
+++ b/src/winemetal/unix/winemetal_unix.c
@@ -16,6 +16,7 @@
 typedef int NTSTATUS;
 #define STATUS_SUCCESS 0
 #define STATUS_UNSUCCESSFUL 0xC0000001
+#define STATUS_NOT_IMPLEMENTED 0xC0000002
 
 void
 execute_on_main(dispatch_block_t block) {
@@ -601,10 +602,9 @@ MTLMeshRenderPipelineDescriptor ()
 
 #endif
 
-static NTSTATUS
-_MTLDevice_newRenderPipelineState(void *obj) {
-  struct unixcall_mtldevice_newrenderpso *params = obj;
-  const struct WMTRenderPipelineInfo *info = params->info.ptr;
+/* The descriptor slot 34 and MacNeutron's slot 156 share: +1, the caller releases it. */
+static MTLRenderPipelineDescriptor *
+render_pipeline_descriptor(const struct WMTRenderPipelineInfo *info) {
   MTLRenderPipelineDescriptor *descriptor = [[MTLRenderPipelineDescriptor alloc] init];
 
   for (unsigned i = 0; i < 8; i++) {
@@ -650,19 +650,62 @@ _MTLDevice_newRenderPipelineState(void *obj) {
   if (info->num_binary_archives_for_lookup && info->binary_archives_for_lookup.ptr)
     descriptor.binaryArchives = [NSArray arrayWithObjects:(id<MTLBinaryArchive> *)info->binary_archives_for_lookup.ptr
                                                     count:info->num_binary_archives_for_lookup];
+  return descriptor;
+}
+
+/* Slots 34 and 156: the pipeline of `descriptor` (released here) and its error. */
+static void
+render_pipeline_state(
+    obj_handle_t device, const struct WMTRenderPipelineInfo *info, MTLRenderPipelineDescriptor *descriptor,
+    obj_handle_t *ret_pso, obj_handle_t *ret_error
+) {
   NSError *err = NULL;
   MTLPipelineOption options =
       info->fail_on_binary_archive_miss ? MTLPipelineOptionFailOnBinaryArchiveMiss : MTLPipelineOptionNone;
-  params->ret_pso = (obj_handle_t)[(id<MTLDevice>)params->device newRenderPipelineStateWithDescriptor:descriptor
+  *ret_pso = (obj_handle_t)[(id<MTLDevice>)device newRenderPipelineStateWithDescriptor:descriptor
                                                                                               options:options
                                                                                            reflection:nil
                                                                                                 error:&err];
-  params->ret_error = (obj_handle_t)err;
+  *ret_error = (obj_handle_t)err;
   if (!err && info->binary_archive_for_serialization) {
     [(id<MTLBinaryArchive>)info->binary_archive_for_serialization addRenderPipelineFunctionsWithDescriptor:descriptor
                                                                                                      error:&err];
   }
   [descriptor release];
+}
+
+static NTSTATUS
+_MTLDevice_newRenderPipelineState(void *obj) {
+  struct unixcall_mtldevice_newrenderpso *params = obj;
+  const struct WMTRenderPipelineInfo *info = params->info.ptr;
+  render_pipeline_state(
+      params->device, info, render_pipeline_descriptor(info), &params->ret_pso, &params->ret_error
+  );
+  return STATUS_SUCCESS;
+}
+
+/* MacNeutron: slot 34's pipeline with a vertex descriptor (Direct3D 9 on winemetal). */
+static NTSTATUS
+_MTLDevice_newRenderPipelineStateWithVertexDescriptor(void *obj) {
+  struct unixcall_mtldevice_newrenderpso_vertex *params = obj;
+  const struct WMTRenderPipelineInfo *info = params->info.ptr;
+  const struct WMTVertexDescriptorInfo *vertex = params->vertex.ptr;
+  MTLRenderPipelineDescriptor *descriptor = render_pipeline_descriptor(info);
+  MTLVertexDescriptor *vd = [MTLVertexDescriptor vertexDescriptor];
+  for (unsigned i = 0; i < 31; i++) {
+    if (vertex->attributes[i].format) {
+      vd.attributes[i].format = (MTLVertexFormat)vertex->attributes[i].format;
+      vd.attributes[i].offset = vertex->attributes[i].offset;
+      vd.attributes[i].bufferIndex = vertex->attributes[i].buffer_index;
+    }
+    if (vertex->layouts[i].stride) {
+      vd.layouts[i].stride = vertex->layouts[i].stride;
+      vd.layouts[i].stepFunction = (MTLVertexStepFunction)vertex->layouts[i].step_function;
+      vd.layouts[i].stepRate = vertex->layouts[i].step_rate;
+    }
+  }
+  descriptor.vertexDescriptor = vd;
+  render_pipeline_state(params->device, info, descriptor, &params->ret_pso, &params->ret_error);
   return STATUS_SUCCESS;
 }
 
@@ -1071,6 +1114,26 @@ _MTLRenderCommandEncoder_encodeCommands(void *obj) {
       [encoder setDepthStencilState:(id<MTLDepthStencilState>)body->depth_stencil_state];
       break;
     }
+    case WMTRenderCommandSetVertexBytes: {
+      struct wmtcmd_render_setbytes *body = (struct wmtcmd_render_setbytes *)next;
+      [encoder setVertexBytes:body->bytes.ptr length:body->length atIndex:body->index];
+      break;
+    }
+    case WMTRenderCommandSetVertexTexture: {
+      struct wmtcmd_render_settexture *body = (struct wmtcmd_render_settexture *)next;
+      [encoder setVertexTexture:(id<MTLTexture>)body->texture atIndex:body->index];
+      break;
+    }
+    case WMTRenderCommandSetVertexSamplerState: {
+      struct wmtcmd_render_setsampler *body = (struct wmtcmd_render_setsampler *)next;
+      [encoder setVertexSamplerState:(id<MTLSamplerState>)body->sampler atIndex:body->index];
+      break;
+    }
+    case WMTRenderCommandSetFragmentSamplerState: {
+      struct wmtcmd_render_setsampler *body = (struct wmtcmd_render_setsampler *)next;
+      [encoder setFragmentSamplerState:(id<MTLSamplerState>)body->sampler atIndex:body->index];
+      break;
+    }
     case WMTRenderCommandSetBlendFactorAndStencilRef: {
       struct wmtcmd_render_setblendcolor *body = (struct wmtcmd_render_setblendcolor *)next;
       [encoder setBlendColorRed:body->red green:body->green blue:body->blue alpha:body->alpha];
@@ -3410,6 +3473,33 @@ _MTLDevice_newLibraryWithSource(void *obj) {
   return STATUS_SUCCESS;
 }
 
+/* MacNeutron: slot 144 with compile options (Direct3D 9 on winemetal). */
+static NTSTATUS
+_MTLDevice_newLibraryWithSourceOptions(void *obj) {
+  struct unixcall_mtldevice_newlibrarywithsource_options *params = obj;
+  const struct WMTCompileOptions *info = params->options.ptr;
+  id<MTLDevice> device = (id<MTLDevice>)params->device;
+  NSString *source =
+      [[NSString alloc] initWithBytes:params->source.ptr length:params->length encoding:NSASCIIStringEncoding];
+  MTLCompileOptions *options = [[MTLCompileOptions alloc] init];
+  if (info->language_version)
+    options.languageVersion = (MTLLanguageVersion)info->language_version;
+  options.preserveInvariance = info->preserve_invariance;
+  options.mathMode = (MTLMathMode)info->math_mode;
+  NSError *err = NULL;
+  params->ret_library = (obj_handle_t)[device newLibraryWithSource:source options:options error:&err];
+  params->ret_error = (obj_handle_t)err;
+  [options release];
+  [source release];
+  return STATUS_SUCCESS;
+}
+
+/* MacNeutron: the guest's own slots (153-154, its memory; 155, Direct3D forwarding) in this table's place. */
+static NTSTATUS
+_MacNeutron_guestOnly(void *obj) {
+  return STATUS_NOT_IMPLEMENTED;
+}
+
 static NTSTATUS
 _MTLTexture_getBytes(void *obj) {
   struct unixcall_mtltexture_replaceregion *params = obj;
@@ -3599,6 +3689,11 @@ const void *__wine_unix_call_funcs[] = {
     &_MTLDevice_temporalScalerScaleRange,
     &_MTLDevice_newFrameInterpolator,
     &_MTLCommandBuffer_encodeFrameInterpolate,
+    &_MacNeutron_guestOnly,
+    &_MacNeutron_guestOnly,
+    &_MacNeutron_guestOnly,
+    &_MTLDevice_newRenderPipelineStateWithVertexDescriptor,
+    &_MTLDevice_newLibraryWithSourceOptions,
 };
 
 #ifndef DXMT_NATIVE
diff --git a/src/winemetal/winemetal.h b/src/winemetal/winemetal.h
index e4169fbf..0209cfc6 100644
--- a/src/winemetal/winemetal.h
+++ b/src/winemetal/winemetal.h
@@ -875,6 +875,30 @@ struct WMTMeshRenderPipelineInfo {
 WINEMETAL_API obj_handle_t
 MTLDevice_newRenderPipelineState(obj_handle_t device, const struct WMTRenderPipelineInfo *info, obj_handle_t *err_out);
 
+/* MacNeutron: a render pipeline whose vertex function reads [[stage_in]] (Direct3D 9 on winemetal). Metal's raw values:
+ * an attribute of format 0 (MTLVertexFormatInvalid) and a layout of stride 0 are left unset. */
+struct WMTVertexAttributeInfo {
+  uint32_t format;
+  uint32_t offset;
+  uint32_t buffer_index;
+};
+
+struct WMTVertexBufferLayoutInfo {
+  uint32_t stride;
+  uint32_t step_function;
+  uint32_t step_rate;
+};
+
+struct WMTVertexDescriptorInfo {
+  struct WMTVertexAttributeInfo attributes[31];
+  struct WMTVertexBufferLayoutInfo layouts[31];
+};
+
+WINEMETAL_API obj_handle_t MTLDevice_newRenderPipelineStateWithVertexDescriptor(
+    obj_handle_t device, const struct WMTRenderPipelineInfo *info, const struct WMTVertexDescriptorInfo *vertex,
+    obj_handle_t *err_out
+);
+
 WINEMETAL_API obj_handle_t MTLDevice_newMeshRenderPipelineState(
     obj_handle_t device, const struct WMTMeshRenderPipelineInfo *info, obj_handle_t *err_out
 );
@@ -1244,6 +1268,13 @@ enum WMTRenderCommandType : uint16_t {
   WMTRenderCommandSetBlendFactor,
   WMTRenderCommandSetStencilRef,
   WMTRenderCommandSetDepthStencilState,
+  /* MacNeutron: mtld3d's direct binds (Direct3D 9 on winemetal), appended so every value above stays. Vertex bytes
+   * and the vertex texture take wmtcmd_render_setbytes and wmtcmd_render_settexture, both samplers
+   * wmtcmd_render_setsampler. */
+  WMTRenderCommandSetVertexBytes,
+  WMTRenderCommandSetVertexTexture,
+  WMTRenderCommandSetVertexSamplerState,
+  WMTRenderCommandSetFragmentSamplerState,
 };
 
 struct wmtcmd_render_nop {
@@ -1501,6 +1532,14 @@ struct wmtcmd_render_setdepthstencilstate {
   obj_handle_t depth_stencil_state;
 };
 
+struct wmtcmd_render_setsampler {
+  enum WMTRenderCommandType type;
+  uint16_t reserved[3];
+  struct WMTMemoryPointer next;
+  obj_handle_t sampler;
+  uint8_t index;
+};
+
 struct wmtcmd_render_setblendcolor {
   enum WMTRenderCommandType type;
   uint16_t reserved[3];
@@ -2234,6 +2273,20 @@ WINEMETAL_API obj_handle_t MTLDevice_newIndirectCommandBuffer(
 WINEMETAL_API obj_handle_t
 MTLDevice_newLibraryWithSource(obj_handle_t device, const char *source, uint64_t length, obj_handle_t *err_out);
 
+/* MacNeutron: newLibraryWithSource:options:error: with the options Direct3D 9 on winemetal sets, Metal's raw values
+ * (MTLLanguageVersion, MTLMathMode); language_version 0 keeps Metal's default. */
+struct WMTCompileOptions {
+  uint64_t language_version;
+  uint8_t preserve_invariance;
+  uint8_t math_mode;
+  uint8_t padding[6];
+};
+
+WINEMETAL_API obj_handle_t MTLDevice_newLibraryWithSourceOptions(
+    obj_handle_t device, const char *source, uint64_t length, const struct WMTCompileOptions *options,
+    obj_handle_t *err_out
+);
+
 WINEMETAL_API void MTLTexture_getBytes(
     obj_handle_t texture, struct WMTOrigin origin, struct WMTSize size, uint64_t level, uint64_t slice,
     struct WMTMemoryPointer data, uint64_t bytes_per_row, uint64_t bytes_per_image
diff --git a/src/winemetal/winemetal_thunks.c b/src/winemetal/winemetal_thunks.c
index e6de465e..1de2314d 100644
--- a/src/winemetal/winemetal_thunks.c
+++ b/src/winemetal/winemetal_thunks.c
@@ -1316,6 +1316,41 @@ MTLDevice_newLibraryWithSource(obj_handle_t device, const char *source, uint64_t
   return params.ret_library;
 }
 
+WINEMETAL_API obj_handle_t
+MTLDevice_newLibraryWithSourceOptions(
+    obj_handle_t device, const char *source, uint64_t length, const struct WMTCompileOptions *options,
+    obj_handle_t *err_out
+) {
+  struct unixcall_mtldevice_newlibrarywithsource_options params;
+  params.device = device;
+  WMT_MEMPTR_SET(params.source, source);
+  params.length = length;
+  WMT_MEMPTR_SET(params.options, options);
+  params.ret_error = 0;
+  params.ret_library = 0;
+  UNIX_CALL(157, &params);
+  if (err_out)
+    *err_out = params.ret_error;
+  return params.ret_library;
+}
+
+WINEMETAL_API obj_handle_t
+MTLDevice_newRenderPipelineStateWithVertexDescriptor(
+    obj_handle_t device, const struct WMTRenderPipelineInfo *info, const struct WMTVertexDescriptorInfo *vertex,
+    obj_handle_t *err_out
+) {
+  struct unixcall_mtldevice_newrenderpso_vertex params;
+  params.device = device;
+  WMT_MEMPTR_SET(params.info, info);
+  WMT_MEMPTR_SET(params.vertex, vertex);
+  params.ret_error = 0;
+  params.ret_pso = 0;
+  UNIX_CALL(156, &params);
+  if (err_out)
+    *err_out = params.ret_error;
+  return params.ret_pso;
+}
+
 WINEMETAL_API void
 MTLTexture_getBytes(
     obj_handle_t texture, struct WMTOrigin origin, struct WMTSize size, uint64_t level, uint64_t slice,
diff --git a/src/winemetal/winemetal_thunks.h b/src/winemetal/winemetal_thunks.h
index 6c8477a6..75c1013a 100644
--- a/src/winemetal/winemetal_thunks.h
+++ b/src/winemetal/winemetal_thunks.h
@@ -125,6 +125,16 @@ struct unixcall_mtldevice_newlibrarywithsource {
   obj_handle_t ret_library;
 };
 
+/* Slot 157 (MacNeutron). */
+struct unixcall_mtldevice_newlibrarywithsource_options {
+  obj_handle_t device;
+  struct WMTConstMemoryPointer source;
+  uint64_t length;
+  struct WMTConstMemoryPointer options;
+  obj_handle_t ret_error;
+  obj_handle_t ret_library;
+};
+
 struct unixcall_mtldevice_newcomputepso {
   obj_handle_t device;
   struct WMTConstMemoryPointer info;
@@ -139,6 +149,15 @@ struct unixcall_mtldevice_newrenderpso {
   obj_handle_t ret_pso;
 };
 
+/* Slot 156 (MacNeutron). */
+struct unixcall_mtldevice_newrenderpso_vertex {
+  obj_handle_t device;
+  struct WMTConstMemoryPointer info;
+  struct WMTConstMemoryPointer vertex;
+  obj_handle_t ret_error;
+  obj_handle_t ret_pso;
+};
+
 struct unixcall_mtldevice_newmeshrenderpso {
   obj_handle_t device;
   struct WMTConstMemoryPointer info;
-- 
