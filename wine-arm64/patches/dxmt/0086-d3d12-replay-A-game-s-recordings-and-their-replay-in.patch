From 2a9fcde049f5c08ec91e3d88ce3f2f14241b546e Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Sun, 18 Oct 2026 09:41:31 -0400
Subject: [PATCH] d3d12, replay: A game's recordings and their replay in the
 native build.

Natively (a VM host's) the program has no name, so its recording was a
hidden .pipelines file: it is game.pipelines now (one game a VM; a
DXMT_CACHE_EXE still names it). dxmt-replay builds natively too, its main
calling wmain and native DXMT loaded from its own folder: a VM host
replays a game's recordings into native DXMT's shader cache before the VM
boots, as the launcher does on macOS.

Assisted-by: Claude Code: claude-opus-5-5
---
 src/d3d12/d3d12_pipeline_record.cpp |  4 +++-
 src/meson.build                     |  5 ++---
 src/replay/dxmt_replay.cpp          |  5 +++++
 src/replay/meson.build              |  9 +++++++++
 src/replay/native_main.cpp          | 22 ++++++++++++++++++++++
 5 files changed, 41 insertions(+), 4 deletions(-)
 create mode 100644 src/replay/native_main.cpp

diff --git a/src/d3d12/d3d12_pipeline_record.cpp b/src/d3d12/d3d12_pipeline_record.cpp
index 111754c..675ee94 100644
--- a/src/d3d12/d3d12_pipeline_record.cpp
+++ b/src/d3d12/d3d12_pipeline_record.cpp
@@ -242,7 +242,9 @@ RecordingPath() {
       folder = "Z:" + folder; // the launcher passes a Mac path; Wine's Z: drive is the Mac's root
     std::wstring wide = str::tows(folder.c_str());
     CreateDirectoryW(wide.c_str(), nullptr); // may exist; any other failure shows when the file doesn't open
-    return wide + L"\\" + str::tows(env::getCacheExeName().c_str()) + L".pipelines";
+    // MacNeutron: natively (a VM host's) the program has no name: "game", one game a VM
+    std::string exe = env::getCacheExeName();
+    return wide + L"\\" + str::tows(exe.empty() ? "game" : exe.c_str()) + L".pipelines";
   }();
   return path;
 }
diff --git a/src/meson.build b/src/meson.build
index a62d323..60f43d9 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -14,11 +14,10 @@ subdir('d3d10')
 
 if get_option('enable_d3d12')
 subdir('d3d12')
-# The replay tool is a Windows program (wmain, d3d12.dll by name): the PE build's alone.
-if dxmt_crossbuild
+# The replay tool: a Windows program (wmain, d3d12.dll by name), and natively a VM host's (MacNeutron: its main, and
+# d3d12.dylib beside it).
 subdir('replay')
 endif
-endif
 
 if get_option('enable_nvapi')
 subdir('nvapi')
diff --git a/src/replay/dxmt_replay.cpp b/src/replay/dxmt_replay.cpp
index 7db0277..9536d72 100644
--- a/src/replay/dxmt_replay.cpp
+++ b/src/replay/dxmt_replay.cpp
@@ -22,6 +22,7 @@
 #include "d3d12_pipeline_record.hpp"
 #include "log/log.hpp"
 #include <windows.h>
+#include "util_win32_compat.h" // natively, the Win32 calls it makes (win32_native.h)
 #include <d3d12.h>
 #include <algorithm>
 #include <atomic>
@@ -75,7 +76,11 @@ wmain(int argc, wchar_t **argv) {
   }
   // DXMT loads only now, after DXMT_CACHE_EXE is set: dxgi.dll picks the Metal cache folder as it loads.
   using CreateDevice = HRESULT(WINAPI *)(IUnknown *, D3D_FEATURE_LEVEL, REFIID, void **);
+#ifdef _WIN32
   HMODULE d3d12 = LoadLibraryW(L"d3d12.dll");
+#else
+  HMODULE d3d12 = LoadLibraryW(L"@executable_path/d3d12.dylib"); // MacNeutron: native DXMT beside it
+#endif
   auto create = d3d12 ? reinterpret_cast<CreateDevice>(GetProcAddress(d3d12, "D3D12CreateDevice")) : nullptr;
   ID3D12Device *device = nullptr;
   if (!create || FAILED(create(nullptr, D3D_FEATURE_LEVEL_11_0, __uuidof(ID3D12Device), (void **)&device))) {
diff --git a/src/replay/meson.build b/src/replay/meson.build
index 6fb2f28..1bebdd6 100644
--- a/src/replay/meson.build
+++ b/src/replay/meson.build
@@ -1,4 +1,5 @@
 # dxmt-replay.exe (MacNeutron): rebuilds a game's recorded D3D12 pipelines; see dxmt_replay.cpp.
+if dxmt_crossbuild
 executable('dxmt-replay', [ 'dxmt_replay.cpp', '../d3d12/d3d12_pipeline_record.cpp' ],
   dependencies        : [ util_dep ],
   include_directories : [ dxmt_include_path, include_directories('../d3d12') ],
@@ -6,3 +7,11 @@ executable('dxmt-replay', [ 'dxmt_replay.cpp', '../d3d12/d3d12_pipeline_record.c
   install             : true,
   install_dir         : windows_native_install_dir,
 )
+else
+# MacNeutron, natively: a VM host replays a game's recordings before its VM boots, into native DXMT's cache.
+executable('dxmt-replay', [ 'dxmt_replay.cpp', 'native_main.cpp', '../d3d12/d3d12_pipeline_record.cpp' ],
+  dependencies        : [ util_dep ],
+  include_directories : [ dxmt_include_path, include_directories('../d3d12') ],
+  install             : false,
+)
+endif
diff --git a/src/replay/native_main.cpp b/src/replay/native_main.cpp
new file mode 100644
index 0000000..ee365ab
--- /dev/null
+++ b/src/replay/native_main.cpp
@@ -0,0 +1,22 @@
+/*
+ * MacNeutron: dxmt-replay's main in the native build (a VM host's): its arguments as wmain takes them.
+ */
+#include <cstdlib>
+#include <string>
+#include <vector>
+
+int wmain(int argc, wchar_t **argv);
+
+int
+main(int argc, char **argv) {
+  std::vector<std::wstring> wide(argc);
+  std::vector<wchar_t *> args(argc + 1, nullptr);
+  for (int i = 0; i < argc; i++) {
+    size_t n = mbstowcs(nullptr, argv[i], 0);
+    wide[i].resize(n == (size_t)-1 ? 0 : n);
+    if (n != (size_t)-1)
+      mbstowcs(wide[i].data(), argv[i], n + 1);
+    args[i] = wide[i].data();
+  }
+  return wmain(argc, args.data());
+}
-- 
