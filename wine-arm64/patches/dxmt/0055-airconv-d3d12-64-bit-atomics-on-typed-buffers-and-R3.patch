From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Sun, 11 Oct 2026 21:11:28 -0400
Subject: [PATCH] airconv, d3d12: 64-bit atomics on typed buffers and
 R32G32_UINT textures.

Shader Model 6.6's 64-bit atomics (ops 78 and 79 with the i64 overload) on
RWBuffer<uint64_t>/<int64_t> and RWTexture1D/2D/2DArray/3D<uint64_t>/<int64_t>
(R32G32_UINT), through 0054's lock table. Metal's 64-bit atomics are still
never emitted.

- Typed buffers take the raw-buffer path. The texel-buffer UAV descriptor's
  fourth qword (padding before, now buffer_address) holds the buffer's GPU
  base; the element is at base + 8 * (index + the view's first element) and
  out of bounds (skipped, reads 0) from the view's element count. So a raw and
  a typed view of the same bytes take the same lock, and no RG32Uint texture
  buffer is read or written (Apple lists only Read and Write access for it).
  UnorderedAccessViewInfo::address64 marks a typed UAV that a 64-bit atomic
  reaches: by use, since DXC 1.9 declares RWBuffer<uint64_t> U32 with an
  Atomic64Use tag that heap handles don't carry. GetUAVTexture then loads the
  fourth qword as TextureDescirptor::BufferAddress.
- Textures are keyed by the texel's (x, y) alone, h = x * 0x9E3779B1 + y;
  h ^= h >> 16, which every view of the texel agrees on (slice, z, mip and view
  ignored: they only add collisions), and read and written through the
  <4 x i32> texel (lo .x, hi .y) under air.atomic.fence(5, 5, 2), each write
  followed by air.fence_texture. Out of bounds as the 32-bit texture atomics.
- d3d12: a texel-buffer UAV writes its buffer's base (0 without one), the SRV
  writer 0. CopyDescriptors already copies all 32 bytes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/airconv/dxbc_binding_rootsig.cpp      |  14 ++-
 src/airconv/dxbc_converter.hpp            |   4 +
 src/airconv/dxil/dxil_initialize.cpp      |   6 +-
 src/airconv/dxil/dxil_lower_resources.cpp | 104 ++++++++++++++++------
 src/airconv/nt/dxbc_binding_map.hpp       |   4 +-
 src/d3d12/d3d12_descriptor_heap.cpp       |   7 +-
 6 files changed, 106 insertions(+), 33 deletions(-)

diff --git a/src/airconv/dxbc_binding_rootsig.cpp b/src/airconv/dxbc_binding_rootsig.cpp
index 5681076..72ea708 100644
--- a/src/airconv/dxbc_binding_rootsig.cpp
+++ b/src/airconv/dxbc_binding_rootsig.cpp
@@ -186,9 +186,10 @@ public:
   std::pair<llvm::Value *, llvm::Value *>
   GetTextureDescriptor(
       llvm::air::AIRBuilder &AIR, llvm::Value *IntPtr, llvm::Value *Index, Texture::ResourceKind Kind, RangeId RangeId,
-      uint32_t DescriptorOffset, uint32_t HandleField = 0 /* MacNeutron: 2, an atomic_view's R32Uint view */
+      uint32_t DescriptorOffset, uint32_t HandleField = 0 /* MacNeutron: 2, an atomic_view's R32Uint view */,
+      llvm::Type *HandleType = nullptr /* MacNeutron: the field's type, if not Kind's texture handle */
   ) {
-    auto TyTextureHandle = AIR.getTextureHandleType(Kind);
+    auto TyTextureHandle = HandleType ? HandleType : AIR.getTextureHandleType(Kind);
     auto TyTextureDescriptor = llvm::StructType::get(
         AIR.getContext(), {TyTextureHandle, llvm::Type::getInt64Ty(AIR.getContext()),
                            llvm::Type::getInt64Ty(AIR.getContext()), llvm::Type::getInt64Ty(AIR.getContext())}
@@ -275,8 +276,13 @@ public:
     auto [Handle, Metadata] = GetTextureDescriptor(
         Builder, HeapPointer, Index, ResourceKind, UAV.range.lower_bound, DescriptorOffset, UAV.atomic_view ? 2 : 0
     );
-    return TextureDescirptor{Handle,       Metadata,  UAV.global_coherent, ResourceKind, ResourceKindLogical,
-                             MemoryAccess, SampleType};
+    // MacNeutron: an address64 UAV's buffer base, the descriptor's fourth qword.
+    llvm::Value *BufferAddress = nullptr;
+    if (UAV.address64)
+      BufferAddress = GetTextureDescriptor(Builder, HeapPointer, Index, ResourceKind, UAV.range.lower_bound,
+                                           DescriptorOffset, 3, Builder.builder.getInt8PtrTy(1)).first;
+    return TextureDescirptor{Handle,       Metadata,   UAV.global_coherent, ResourceKind, ResourceKindLogical,
+                             MemoryAccess, SampleType, BufferAddress};
   }
 
   virtual llvm::Optional<BufferDescriptor>
diff --git a/src/airconv/dxbc_converter.hpp b/src/airconv/dxbc_converter.hpp
index 384e5ef..a398dff 100644
--- a/src/airconv/dxbc_converter.hpp
+++ b/src/airconv/dxbc_converter.hpp
@@ -54,6 +54,10 @@ struct UnorderedAccessViewInfo {
   // MacNeutron (DXIL): a float typed UAV that atomics reach. Metal's texture atomics take integer textures only, so it's
   // declared uint and read through the R32Uint view in its descriptor's third qword (d3d12_descriptor_heap.cpp).
   bool atomic_view = false;
+  // MacNeutron (DXIL): a typed buffer that 64-bit atomics reach (RWBuffer<uint64_t>, <int64_t>; DXIL has no 64-bit typed
+  // load or store). They take the raw-buffer path at the buffer base in its descriptor's fourth qword
+  // (d3d12_descriptor_heap.cpp).
+  bool address64 = false;
 
   uint32_t structure_stride = 0;
   uint32_t arg_index;
diff --git a/src/airconv/dxil/dxil_initialize.cpp b/src/airconv/dxil/dxil_initialize.cpp
index 7cd89d1..7a802ee 100644
--- a/src/airconv/dxil/dxil_initialize.cpp
+++ b/src/airconv/dxil/dxil_initialize.cpp
@@ -122,7 +122,7 @@ llvm::Error RefuseGroupshared64BitAtomics(const llvm::Module &module) {
 }
 
 struct Usage {
-  bool read = false, written = false, sampled = false, compared = false, atomic = false;
+  bool read = false, written = false, sampled = false, compared = false, atomic = false, atomic64 = false;
 };
 
 // What each resource is used for: airconv's binding maps pick Metal access modes and depth textures from it.
@@ -159,6 +159,7 @@ ScanUsage(const EntryInfo &entry, const llvm::Module &module) {
           break;
         case op::AtomicBinOp: case op::AtomicCompareExchange:
           u.read = u.written = u.atomic = true;
+          u.atomic64 |= call->getType()->isIntegerTy(64);
           break;
         }
       }
@@ -194,6 +195,9 @@ void FillResourceMaps(const EntryInfo &entry, const llvm::Module &module, Shader
       uav.atomic_view = u.atomic && r.element_type == ComponentType::F32 && uav.resource_type != ResourceType::NonApplicable;
       if (uav.atomic_view)
         uav.scaler_type = ScalerDataType::Uint;
+      // 64-bit atomics on a typed buffer (Task 14b) go through its buffer's address: the same lock as a raw view's. By
+      // use: DXC 1.9 declares a RWBuffer<uint64_t> or <int64_t> U32, with an Atomic64Use tag that heap handles lack.
+      uav.address64 = u.atomic64 && r.kind == ResourceKind::TypedBuffer;
       uav.structure_stride = r.stride;
       uav.arg_index = uav.arg_metadata_index = uav.arg_counter_index = ~0u;
       info.uavMap[r.id] = uav;
diff --git a/src/airconv/dxil/dxil_lower_resources.cpp b/src/airconv/dxil/dxil_lower_resources.cpp
index c5b8d0c..c38db26 100644
--- a/src/airconv/dxil/dxil_lower_resources.cpp
+++ b/src/airconv/dxil/dxil_lower_resources.cpp
@@ -545,51 +545,103 @@ Lowering::LowerDimensions(llvm::CallInst *call, const HandleInfo &h) {
   return llvm::Error::success();
 }
 
-// 64-bit atomics on raw and structured buffers (Task 14a; spec 3.8), root and heap ones included: under a lock from the
-// device's table, keyed by the element's device address (every view of the same bytes takes the same lock; a collision
-// only serialises), its halves read and written as relaxed 32-bit atomics. A pixel shader's helper lanes (D3D gives
-// them no UAV side effects, attribute or not, and a helper whose lock atomic were discarded could spin forever) and an
-// out-of-bounds element skip it and read 0.
+// 64-bit atomics (Tasks 14a-14b; spec 3.8), under a lock from the device's table (a collision only serialises). Buffers
+// (raw, structured, root and heap ones, and typed ones, which DXIL can only reach with atomics: their buffer's base comes
+// from the descriptor, their first element from its metadata) are keyed by the element's device address, so every view
+// of the same bytes takes the same lock, and their halves are read and written as relaxed 32-bit atomics. Textures
+// (R32G32_UINT: RG32Uint) are keyed by the texel's (x, y) alone, which every view of it agrees on, and read and written
+// through the <4 x i32> texel (lo .x, hi .y) under device and texture fences, with a texture fence after the write. A
+// pixel shader's helper lanes (D3D gives them no UAV side effects, attribute or not, and a helper whose lock atomic were
+// discarded could spin forever) and an out-of-bounds buffer element skip it and read 0; a texture out of bounds is left
+// to Metal, as the 32-bit texture atomics are.
 llvm::Error
 Lowering::Atomic64(uint32_t opcode, llvm::CallInst *call, const HandleInfo &h) {
+  using llvm::air::MemFlags;
   auto arg = [&](unsigned i) { return call->getArgOperand(i); };
   auto kind = h.resource->kind;
   auto locks = ctx.binding.GetAtomic64Locks(air);
-  if ((kind != ResourceKind::RawBuffer && kind != ResourceKind::StructuredBuffer) || !locks)
-    return Unsupported(call); // typed buffers and textures: Task 14b
-  auto buffer = Buffer(h);
-  if (!buffer) {
+  if (!locks)
+    return Unsupported(call);
+  bool raw = kind == ResourceKind::RawBuffer || kind == ResourceKind::StructuredBuffer;
+  bool texel = !raw && kind != ResourceKind::TypedBuffer;
+  llvm::Optional<dxbc::BufferResourceHandle> buffer;
+  llvm::Optional<dxbc::TextureDescirptor> d;
+  if (raw ? !(buffer = Buffer(h)) : !(d = Texture(h))) { // unbound
     Replace(call, ir.getInt64(0));
     return llvm::Error::success();
   }
+  if (kind == ResourceKind::TypedBuffer && !d->BufferAddress)
+    return Unsupported(call);
   bool cas = opcode == op::AtomicCompareExchange;
   unsigned c = cas ? 2 : 3; // (78, handle, op, c0, c1, c2, value); (79, handle, c0, c1, c2, compare, value)
-  auto offset = kind == ResourceKind::StructuredBuffer
-                    ? ir.CreateAdd(ir.CreateMul(arg(c), ir.getInt32(h.resource->stride)), arg(c + 1))
-                    : arg(c);
   auto i32 = ir.getInt32Ty(), i64 = ir.getInt64Ty();
-  auto ptr = ElementPointer(*buffer, offset, i64); // null out of bounds
-  llvm::Value *skip = ir.CreateIsNull(ptr);
+  llvm::Value *ptr = nullptr; // a buffer's qword, null out of bounds
+  llvm::air::Texture tex;
+  llvm::Value *pos = nullptr, *array = nullptr; // a texture's texel
+  if (raw) {
+    auto offset = kind == ResourceKind::StructuredBuffer
+                      ? ir.CreateAdd(ir.CreateMul(arg(c), ir.getInt32(h.resource->stride)), arg(c + 1))
+                      : arg(c);
+    ptr = ElementPointer(*buffer, offset, i64);
+  } else if (!texel) { // qword index + first element of the buffer's base; out of bounds from the view's element count
+    auto qwords = ir.CreateBitCast(d->BufferAddress, i64->getPointerTo(1));
+    ptr = ir.CreateGEP(i64, qwords, ir.CreateZExt(ir.CreateAdd(arg(c), conv.DecodeTextureBufferOffset(d->Metadata)), i64));
+    ptr = ir.CreateSelect(ir.CreateICmpUGE(arg(c), conv.DecodeTextureBufferElement(d->Metadata)),
+                          llvm::Constant::getNullValue(ptr->getType()), ptr);
+  } else { // c0.. as LowerTexture's: a 1D texture's y is 0, an array's slice its array component
+    tex.kind = d->ResourceKind;
+    tex.sample_type = d->SampleType;
+    tex.memory_access = d->MemoryAccess;
+    auto logical = d->ResourceKindLogical;
+    bool one_d = logical == Texture::texture1d || logical == Texture::texture1d_array;
+    pos = llvm::UndefValue::get(llvm::FixedVectorType::get(i32, Dimensions(logical)));
+    for (unsigned i = 0; i < Dimensions(logical); i++)
+      pos = ir.CreateInsertElement(pos, one_d && i == 1 ? ir.getInt32(0) : arg(c + i), i);
+    array = IsArray(logical) ? arg(c + ArrayComponent(logical)) : nullptr;
+  }
+  llvm::Value *skip = ptr ? ir.CreateIsNull(ptr) : ir.getFalse();
   if (entry.kind == ShaderKind::Pixel)
     skip = ir.CreateOr(skip, Simd(ir, "air.simd_is_helper_thread", ir.getInt1Ty(), {}));
   auto head = ir.GetInsertBlock();
   ir.SetInsertPoint(llvm::SplitBlockAndInsertIfThen(ir.CreateNot(skip), call, false));
-  // The key, in 32-bit math: a = the address's low 32 bits; h = a >> 3; h ^= h >> 16; lock h & (kAtomic64Locks - 1).
-  auto key = ir.CreateLShr(ir.CreateTrunc(ir.CreatePtrToInt(ptr, i64), i32), 3);
+  // The key, in 32-bit math: h = (the address's low 32 bits) >> 3, or x * 0x9E3779B1 + y; h ^= h >> 16; lock
+  // h & (kAtomic64Locks - 1).
+  auto key = texel ? ir.CreateAdd(ir.CreateMul(ir.CreateExtractElement(pos, (uint64_t)0), ir.getInt32(0x9E3779B1)),
+                                  ir.CreateExtractElement(pos, 1))
+                   : ir.CreateLShr(ir.CreateTrunc(ir.CreatePtrToInt(ptr, i64), i32), 3);
   key = ir.CreateAnd(ir.CreateXor(key, ir.CreateLShr(key, 16)), kAtomic64Locks - 1);
-  auto lo = ir.CreateBitCast(ptr, i32->getPointerTo(1)), hi = ir.CreateConstGEP1_32(i32, lo, 1);
-  auto old = UnderLock(ir.CreateGEP(i32, locks, key), llvm::air::MemFlags::Device, llvm::air::ThreadScope::Device, [&] {
-    auto half = [&](llvm::Value *p) {
-      auto load = ir.CreateAlignedLoad(i32, p, llvm::Align(4));
+  llvm::Value *lo = nullptr, *hi = nullptr;
+  if (!texel)
+    lo = ir.CreateBitCast(ptr, i32->getPointerTo(1)), hi = ir.CreateConstGEP1_32(i32, lo, 1);
+  auto load = [&] { // one texel read, or the two halves
+    auto t = texel ? air.CreateRead(tex, d->ResourceHandle, pos, array, nullptr, ir.getInt32(0), d->GlobalCoherent).first
+                   : nullptr;
+    auto half = [&](unsigned i) {
+      if (t)
+        return ir.CreateZExt(ir.CreateExtractElement(t, i), i64);
+      auto load = ir.CreateAlignedLoad(i32, i ? hi : lo, llvm::Align(4));
       load->setAtomic(llvm::AtomicOrdering::Monotonic);
       return ir.CreateZExt(load, i64);
     };
-    auto value = ir.CreateOr(half(lo), ir.CreateShl(half(hi), 32));
-    auto store = [&](llvm::Value *v) {
-      ir.CreateAlignedStore(ir.CreateTrunc(v, i32), lo, llvm::Align(4))->setAtomic(llvm::AtomicOrdering::Monotonic);
-      ir.CreateAlignedStore(ir.CreateTrunc(ir.CreateLShr(v, 32), i32), hi, llvm::Align(4))
-          ->setAtomic(llvm::AtomicOrdering::Monotonic);
-    };
+    auto low = half(0);
+    return ir.CreateOr(low, ir.CreateShl(half(1), 32));
+  };
+  auto store = [&](llvm::Value *v) {
+    auto half = [&](unsigned i) { return ir.CreateTrunc(i ? ir.CreateLShr(v, 32) : v, i32); };
+    if (texel) { // <lo, hi, 0, 0>, then the texture fence
+      llvm::Value *t = llvm::Constant::getNullValue(llvm::FixedVectorType::get(i32, 4));
+      for (unsigned i = 0; i < 2; i++)
+        t = ir.CreateInsertElement(t, half(i), i);
+      air.CreateWrite(tex, d->ResourceHandle, pos, array, nullptr, ir.getInt32(0), t, d->GlobalCoherent);
+      air.CreateTextureFence(tex, d->ResourceHandle);
+      return;
+    }
+    for (unsigned i = 0; i < 2; i++)
+      ir.CreateAlignedStore(half(i), i ? hi : lo, llvm::Align(4))->setAtomic(llvm::AtomicOrdering::Monotonic);
+  };
+  auto flags = texel ? MemFlags::Device | MemFlags::Texture : MemFlags::Device;
+  auto old = UnderLock(ir.CreateGEP(i32, locks, key), flags, llvm::air::ThreadScope::Device, [&] {
+    auto value = load();
     if (cas) { // stores only on a 64-bit match (CompareStore: the same, its result unused)
       auto at = &*ir.GetInsertPoint();
       ir.SetInsertPoint(llvm::SplitBlockAndInsertIfThen(ir.CreateICmpEQ(value, arg(5)), at, false));
diff --git a/src/airconv/nt/dxbc_binding_map.hpp b/src/airconv/nt/dxbc_binding_map.hpp
index 78b1dc9..b9bdf2f 100644
--- a/src/airconv/nt/dxbc_binding_map.hpp
+++ b/src/airconv/nt/dxbc_binding_map.hpp
@@ -24,7 +24,9 @@ struct TextureDescirptor {
   llvm::air::Texture::ResourceKind ResourceKindLogical;
   llvm::air::Texture::MemoryAccess MemoryAccess;
   llvm::air::Texture::SampleType SampleType;
-
+  // MacNeutron (DXIL 64-bit atomics, Task 14b): an address64 typed UAV's buffer base (i8 addrspace(1)*), from its
+  // descriptor's fourth qword; null otherwise.
+  llvm::Value *BufferAddress = nullptr;
 };
 
 struct BufferDescriptor {
diff --git a/src/d3d12/d3d12_descriptor_heap.cpp b/src/d3d12/d3d12_descriptor_heap.cpp
index ad51383..2ae908f 100644
--- a/src/d3d12/d3d12_descriptor_heap.cpp
+++ b/src/d3d12/d3d12_descriptor_heap.cpp
@@ -37,11 +37,14 @@ struct SRVTextureGPUStorage {
 
 using UAVTextureGPUStorage = SRVTextureGPUStorage;
 
+// buffer_address (MacNeutron): a texel-buffer UAV's buffer GPU base (the view's first element stays in metadata), for
+// 64-bit atomics on a typed buffer (airconv's UnorderedAccessViewInfo::address64 reads it); 0 without a buffer and for
+// SRVs. A null UAV descriptor views the device's null texel buffer with 0 elements: every index is out of bounds.
 struct UAVTexelBufferGPUStorage {
   uint64_t resource_id;
   uint64_t metadata;
   uint64_t atomic_resource_id;
-  uint64_t padding;
+  uint64_t buffer_address;
 };
 
 using SRVTexelBufferGPUStorage = UAVTexelBufferGPUStorage;
@@ -275,6 +278,7 @@ public:
       }
       gpu_storage.UAVTexelBuffer.atomic_resource_id =
           UAVBuffer && AtomicView ? UAVBuffer->view_(*AtomicView).gpu_resource_id : 0;
+      gpu_storage.UAVTexelBuffer.buffer_address = UAVBuffer ? UAVBuffer->current()->gpuAddress() : 0;
     }
     return S_OK;
   }
@@ -313,6 +317,7 @@ public:
     if (mapped_argument_buffer_) { 
       auto &gpu_storage = mapped_argument_buffer_[Index];
       gpu_storage.UAVTexelBuffer.atomic_resource_id = 0;
+      gpu_storage.UAVTexelBuffer.buffer_address = 0;
       if (Buffer) {
         auto &buffer_view = Buffer->view_(View);
         gpu_storage.UAVTexelBuffer.resource_id = buffer_view.gpu_resource_id;
-- 
