From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Sat, 24 Oct 2026 10:30:48 -0400
Subject: [PATCH] d3d12: ResolveSubresourceRegion

A whole subresource at (0, 0) is ResolveSubresource's resolve pass (shared as
EncodeResolve, which now checks the format before allocating the pass). A part
resolves the whole into a scratch texture (Metal resolves whole attachments)
and copies the rectangle out, the copy listing the scratch so it waits on the
resolve; the allocator keeps the scratch until Reset. DECOMPRESS and the
sampler-feedback modes do nothing; MIN, MAX and depth/stencil are warned and
skipped (the resolve pass has a colour attachment only).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/d3d12/d3d12_command_allocator.cpp |   1 +
 src/d3d12/d3d12_command_allocator.hpp |   8 ++
 src/d3d12/d3d12_command_list.cpp      | 132 ++++++++++++++++++--------
 3 files changed, 104 insertions(+), 37 deletions(-)

diff --git a/src/d3d12/d3d12_command_allocator.cpp b/src/d3d12/d3d12_command_allocator.cpp
index bf2391d..d856f35 100644
--- a/src/d3d12/d3d12_command_allocator.cpp
+++ b/src/d3d12/d3d12_command_allocator.cpp
@@ -122,6 +122,7 @@ MTLD3D12CommandAllocatorImpl::Reset() {
   if (encoder_last)
     return E_FAIL;
   DestroyEncoders();
+  kept_textures_.clear();
   return Initialize();
 };
 
diff --git a/src/d3d12/d3d12_command_allocator.hpp b/src/d3d12/d3d12_command_allocator.hpp
index 3587ddc..b725897 100644
--- a/src/d3d12/d3d12_command_allocator.hpp
+++ b/src/d3d12/d3d12_command_allocator.hpp
@@ -115,6 +115,8 @@ class MTLD3D12CommandAllocatorImpl : public MTLD3D12Pageable<MTLD3D12CommandAllo
   std::vector<PooledICB> icb_;
   std::unordered_map<uint64_t, std::vector<PooledICB>> icb_free_; // by key; no allocation once warm
   PooledICB &AcquireICB(WMTIndirectCommandBufferInfo &info, size_t MaxCount, WMTResourceOptions storage);
+  // MacNeutron: textures the lists made for themselves (ResolveSubresourceRegion's partial resolves), until Reset.
+  std::vector<Rc<Texture>> kept_textures_;
 
   ClearUAV<MTLD3D12CommandAllocatorImpl> clear_uav_;
   ClearRTV<MTLD3D12CommandAllocatorImpl> clear_rtv_;
@@ -341,6 +343,12 @@ public:
     e->writes[e->write_count++] = resource;
   }
 
+  void
+  KeepTexture(Rc<Texture> texture) {
+    kept_textures_.push_back(std::move(texture));
+  }
+
+
 
   // What the closing encoder `e` waits on (GPU overlap spec §3.1). A join (all earlier work) when it is the list's
   // first, may write anything, or a joining barrier came after the previous encoder began and before e's last
diff --git a/src/d3d12/d3d12_command_list.cpp b/src/d3d12/d3d12_command_list.cpp
index deacf03..f3ee400 100644
--- a/src/d3d12/d3d12_command_list.cpp
+++ b/src/d3d12/d3d12_command_list.cpp
@@ -1205,49 +1205,48 @@ public:
     if (!pDst->texture || !pSrc->texture)
       return;
 
+    MTL_DXGI_FORMAT_DESC format_desc;
+    if (FAILED(MTLQueryDXGIFormat(device_->GetMTLDevice(), Format, format_desc))) {
+      ERR("ResolveSubresource: invalid format ", Format);
+      return;
+    }
     auto DstMips = pDst->texture->miplevelCount();
-    auto DstLevel = DstSubresource % DstMips;
-    auto DstSlice = DstSubresource / DstMips;
+    EncodeResolve(
+        pSrc->texture.ptr(), SrcSubresource, pDst->texture.ptr(), DstSubresource % DstMips, DstSubresource / DstMips,
+        format_desc.PixelFormat
+    );
+  };
 
+  // A resolve pass from slice `src_slice` of `src` (a multisample texture, one level) into level `dst_level`, slice
+  // `dst_slice` of `dst`, both viewed as `format`.
+  void
+  EncodeResolve(Texture *src, UINT src_slice, Texture *dst, UINT dst_level, UINT dst_slice, WMTPixelFormat format) {
     allocator_->InvalidateCurrentPass();
     auto resolve = allocator_->AllocatePass<ResolveEncoderData>();
     resolve->type = EncoderType::Resolve;
     resolve->writes_unknown = false;
-    allocator_->Writes(pDst->texture.ptr());
-
-    MTL_DXGI_FORMAT_DESC format_desc;
-    if (FAILED(MTLQueryDXGIFormat(device_->GetMTLDevice(), Format, format_desc))) {
-      ERR("ResolveSubresource: invalid format ", Format);
-      return;
-    }
-    {
-      auto format = format_desc.PixelFormat;
-      TextureViewDescriptor src_desc;
-      auto &src = pSrc->texture;
-      auto &dst = pDst->texture;
-      src_desc.format = format;
-      src_desc.type = src->textureType();
-      src_desc.arraySize = 1;
-      src_desc.firstArraySlice = SrcSubresource; // src must be a MS(Array) texture which has exactly 1 mipmap level
-      src_desc.miplevelCount = 1;
-      src_desc.firstMiplevel = 0;
-
-      TextureViewDescriptor dst_desc;
-      dst_desc.format = format;
-      dst_desc.type = WMTTextureType2D;
-      dst_desc.arraySize = 1;
-      dst_desc.firstArraySlice = DstSlice;
-      dst_desc.miplevelCount = 1;
-      dst_desc.firstMiplevel = DstLevel;
-
-      auto src_view = src->createView(src_desc);
-      auto dst_view = dst->createView(dst_desc);
-
-      resolve->src = src->view(src_view);
-      resolve->dst = dst->view(dst_view);
-    }
+    allocator_->Writes(dst);
+
+    TextureViewDescriptor src_desc;
+    src_desc.format = format;
+    src_desc.type = src->textureType();
+    src_desc.arraySize = 1;
+    src_desc.firstArraySlice = src_slice; // src must be a MS(Array) texture which has exactly 1 mipmap level
+    src_desc.miplevelCount = 1;
+    src_desc.firstMiplevel = 0;
+
+    TextureViewDescriptor dst_desc;
+    dst_desc.format = format;
+    dst_desc.type = WMTTextureType2D;
+    dst_desc.arraySize = 1;
+    dst_desc.firstArraySlice = dst_slice;
+    dst_desc.miplevelCount = 1;
+    dst_desc.firstMiplevel = dst_level;
+
+    resolve->src = src->view(src->createView(src_desc));
+    resolve->dst = dst->view(dst->createView(dst_desc));
     allocator_->InvalidateCurrentPass();
-  };
+  }
 
   void STDMETHODCALLTYPE
   IASetPrimitiveTopology(D3D12_PRIMITIVE_TOPOLOGY Topology) {
@@ -2115,7 +2114,66 @@ public:
       UINT SrcSubresource, D3D12_RECT *pSrcRect, DXGI_FORMAT Format, D3D12_RESOLVE_MODE ResolveMode
   ) {
     DXMT_STAT_SCOPE("list.ResolveSubresourceRegion");
-    IMPLEMENT_ME
+    // MacNeutron: DECOMPRESS has nothing to expand (Metal keeps no compressed state of its own to the program), and
+    // sampler feedback isn't reported (SamplerFeedbackTier NOT_SUPPORTED).
+    if (ResolveMode == D3D12_RESOLVE_MODE_DECOMPRESS || ResolveMode == D3D12_RESOLVE_MODE_ENCODE_SAMPLER_FEEDBACK ||
+        ResolveMode == D3D12_RESOLVE_MODE_DECODE_SAMPLER_FEEDBACK)
+      return;
+    auto *pDst = static_cast<MTLD3D12Resource *>(pDstResource);
+    auto *pSrc = static_cast<MTLD3D12Resource *>(pSrcResource);
+    if (!pDst || !pSrc || !pDst->texture || !pSrc->texture)
+      return;
+    MTL_DXGI_FORMAT_DESC format_desc, dst_format;
+    if (FAILED(MTLQueryDXGIFormat(device_->GetMTLDevice(), Format, format_desc)) ||
+        FAILED(MTLQueryDXGIFormat(device_->GetMTLDevice(), pDstResource->GetDesc().Format, dst_format))) {
+      ERR("ResolveSubresourceRegion: invalid format ", Format);
+      return;
+    }
+    // ponytail: no depth resolve or colour MIN/MAX (the resolve pass has a colour attachment only); add when a game
+    // needs it
+    if (ResolveMode != D3D12_RESOLVE_MODE_AVERAGE || DepthStencilPlanarFlags(format_desc.PixelFormat)) {
+      static bool warned = false;
+      if (!std::exchange(warned, true))
+        WARN("ResolveSubresourceRegion: mode ", ResolveMode, " of format ", Format, " not supported, skipped");
+      return;
+    }
+    auto &src = pSrc->texture, &dst = pDst->texture;
+    LONG width = src->width(), height = src->height();
+    D3D12_RECT rect = pSrcRect ? *pSrcRect : D3D12_RECT{0, 0, width, height};
+    rect = {std::max(rect.left, (LONG)0), std::max(rect.top, (LONG)0), std::min(rect.right, width),
+            std::min(rect.bottom, height)};
+    if (rect.right <= rect.left || rect.bottom <= rect.top)
+      return;
+    auto DstMips = dst->miplevelCount();
+    auto DstLevel = DstSubresource % DstMips, DstSlice = DstSubresource / DstMips;
+    if (!DstX && !DstY && !rect.left && !rect.top && rect.right == width && rect.bottom == height) {
+      EncodeResolve(src.ptr(), SrcSubresource, dst.ptr(), DstLevel, DstSlice, format_desc.PixelFormat);
+      return;
+    }
+    // A part: Metal resolves whole attachments, so the whole into a scratch texture, then the rectangle copied out.
+    WMTTextureInfo info = {};
+    info.pixel_format = format_desc.PixelFormat;
+    info.type = WMTTextureType2D;
+    info.width = width;
+    info.height = height;
+    info.depth = 1;
+    info.array_length = 1;
+    info.mipmap_level_count = 1;
+    info.sample_count = 1;
+    info.usage =
+        WMTTextureUsage(WMTTextureUsageRenderTarget | WMTTextureUsageShaderRead | WMTTextureUsagePixelFormatView);
+    info.options = WMTResourceOptions(WMTResourceStorageModePrivate | WMTResourceHazardTrackingModeUntracked);
+    Rc<Texture> scratch = new Texture(info, device_->GetMTLDevice());
+    scratch->rename(scratch->allocate(TextureAllocationFlag::GpuPrivate));
+    EncodeResolve(src.ptr(), SrcSubresource, scratch.ptr(), 0, 0, format_desc.PixelFormat);
+    PreBlit(pDstResource);
+    allocator_->Writes(scratch.ptr()); // the copy waits on the resolve that wrote it (GPU overlap spec §3.1)
+    CopyReinterpret(
+        scratch.ptr(), format_desc, 0, 0, {(uint32_t)rect.left, (uint32_t)rect.top, 0},
+        {(uint32_t)(rect.right - rect.left), (uint32_t)(rect.bottom - rect.top), 1}, dst.ptr(), dst_format, DstLevel,
+        DstSlice, {DstX, DstY, 0}
+    );
+    allocator_->KeepTexture(std::move(scratch));
   }
 
   void STDMETHODCALLTYPE
-- 
