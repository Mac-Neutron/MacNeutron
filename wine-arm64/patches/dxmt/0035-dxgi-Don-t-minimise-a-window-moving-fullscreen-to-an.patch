From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Thu, 8 Oct 2026 06:50:46 -0400
Subject: [PATCH] dxgi: Don't minimise a window moving fullscreen to another
 output.

SetFullscreenState(TRUE) with another output leaves fullscreen on the
current one first and enters it on the new one at once; that leave isn't
the game going to the background, so it doesn't minimise the window even
when the game isn't in front. Both swapchains (D3D11, D3D12).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/d3d11/d3d11_swapchain.cpp | 7 ++++---
 src/d3d12/d3d12_swapchain.cpp | 7 ++++---
 2 files changed, 8 insertions(+), 6 deletions(-)

diff --git a/src/d3d11/d3d11_swapchain.cpp b/src/d3d11/d3d11_swapchain.cpp
index 8ba8a90..6b19ab7 100644
--- a/src/d3d11/d3d11_swapchain.cpp
+++ b/src/d3d11/d3d11_swapchain.cpp
@@ -274,7 +274,7 @@ public:
       target->GetDesc(&desc);
 
       if (!fullscreen_desc_.Windowed && Fullscreen && monitor_ != desc.Monitor) {
-        HRESULT hr = LeaveFullscreenMode();
+        HRESULT hr = LeaveFullscreenMode(true);
         if (FAILED(hr))
           return hr;
       }
@@ -347,7 +347,7 @@ public:
   }
   
   
-  HRESULT LeaveFullscreenMode() {
+  HRESULT LeaveFullscreenMode(bool switching_output = false) {
     ModeSetGuard::ModeSetInProgress modeset_inprogress(modeset_guard_);
     if (modeset_inprogress)
       return DXGI_STATUS_MODE_CHANGE_IN_PROGRESS;
@@ -375,7 +375,8 @@ public:
     // game enters fullscreen again when it's restored. In the background means another process's window in front, or
     // none: the game's own popup in front of its window is still the game. Async: the caller may not be the window's
     // thread (Unreal's RHI thread), and must not wait for that thread's message loop.
-    if (!wsi::isProcessForeground()) {
+    // Not when the leave is half of a move to another output: the game enters fullscreen there at once.
+    if (!switching_output && !wsi::isProcessForeground()) {
       Logger::info("Leaving fullscreen in the background: minimising");
       wsi::minimizeWindow(hWnd);
     }
diff --git a/src/d3d12/d3d12_swapchain.cpp b/src/d3d12/d3d12_swapchain.cpp
index d470694..9fd2748 100644
--- a/src/d3d12/d3d12_swapchain.cpp
+++ b/src/d3d12/d3d12_swapchain.cpp
@@ -292,7 +292,7 @@ public:
       target->GetDesc(&desc);
 
       if (!fullscreen_desc_.Windowed && Fullscreen && monitor_ != desc.Monitor) {
-        HRESULT hr = LeaveFullscreenMode();
+        HRESULT hr = LeaveFullscreenMode(true);
         if (FAILED(hr))
           return hr;
       }
@@ -366,7 +366,7 @@ public:
   }
 
   HRESULT
-  LeaveFullscreenMode() {
+  LeaveFullscreenMode(bool switching_output = false) {
     ModeSetGuard::ModeSetInProgress modeset_inprogress(modeset_guard_);
     if (modeset_inprogress)
       return DXGI_STATUS_MODE_CHANGE_IN_PROGRESS;
@@ -395,7 +395,8 @@ public:
     // game enters fullscreen again when it's restored. In the background means another process's window in front, or
     // none: the game's own popup in front of its window is still the game. Async: the caller may not be the window's
     // thread (Unreal's RHI thread), and must not wait for that thread's message loop.
-    if (!wsi::isProcessForeground()) {
+    // Not when the leave is half of a move to another output: the game enters fullscreen there at once.
+    if (!switching_output && !wsi::isProcessForeground()) {
       Logger::info("Leaving fullscreen in the background: minimising");
       wsi::minimizeWindow(hWnd);
     }
