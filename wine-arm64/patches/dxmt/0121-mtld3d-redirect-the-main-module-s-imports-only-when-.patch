From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Fri, 23 Oct 2026 00:08:05 -0400
Subject: [PATCH] mtld3d: redirect the main module's imports only when d3d9.dll
 is a static import

d3d9.dll redirected the main module's EnumDisplaySettings* and exit
imports at every DLL_PROCESS_ATTACH. A game built on another API that
loads d3d9.dll at run time (dxdiag's probe, a video renderer's device)
then found its import table changed, and a protected executable that
checks it ended itself. The redirection now happens only for a static
load, when the loader passes a non-null lpvReserved (the contract
Windows documents, which Wine's loader keeps): a game built on Direct3D
9 imports d3d9.dll, which is the case both redirections were written
for. A run-time load logs that the imports stay as they are.
---
 mtld3d/windows/d3d9/src/exit_code_hook.rs |  6 +++---
 mtld3d/windows/d3d9/src/lib.rs            | 22 ++++++++++++++++++----
 mtld3d/windows/d3d9/src/mode_list_hook.rs |  5 +++--
 3 files changed, 24 insertions(+), 9 deletions(-)

diff --git a/mtld3d/windows/d3d9/src/exit_code_hook.rs b/mtld3d/windows/d3d9/src/exit_code_hook.rs
index 483fa517..2d55343b 100644
--- a/mtld3d/windows/d3d9/src/exit_code_hook.rs
+++ b/mtld3d/windows/d3d9/src/exit_code_hook.rs
@@ -14,9 +14,9 @@
 //! Three entry points cover the ways a main module ends its own process:
 //! `ExitProcess`, `RtlExitUserProcess` under it, and the C runtime's `exit`,
 //! which the statically linked startup stub calls with what `main` returned.
-//! A process that resolves one of them through `GetProcAddress`, or that
-//! exits from a call inside another module, is not covered and still ends
-//! with 0.
+//! A process that resolves one of them through `GetProcAddress`, that
+//! exits from a call inside another module, or that loads `d3d9.dll` at run
+//! time rather than importing it, is not covered and still ends with 0.
 
 use core::{
     ffi::c_int,
diff --git a/mtld3d/windows/d3d9/src/lib.rs b/mtld3d/windows/d3d9/src/lib.rs
index ebf7faef..3a9577eb 100644
--- a/mtld3d/windows/d3d9/src/lib.rs
+++ b/mtld3d/windows/d3d9/src/lib.rs
@@ -132,12 +132,12 @@ unsafe extern "system" {
 }
 
 #[unsafe(export_name = "DllMain")]
-pub extern "system" fn dll_main(instance: *mut c_void, reason: u32, _reserved: *mut c_void) -> i32 {
+pub extern "system" fn dll_main(instance: *mut c_void, reason: u32, reserved: *mut c_void) -> i32 {
     if reason == DLL_PROCESS_DETACH && USED.load(Ordering::Relaxed) {
         // The process is exiting. A device was created, which pinned the
         // image, so no `FreeLibrary` reaches this detach unless the pin
         // failed, which was logged; only process exit does (Wine passes
-        // `_reserved` as 1 here and as 0 for the detach of a
+        // `reserved` as 1 here and as 0 for the detach of a
         // `FreeLibrary`). Skip every remaining destructor on the calling
         // thread: snmalloc's C++ thread_local teardown walks pools deeply
         // enough to overflow the 1 MB Wine main-thread stack and Wine then
@@ -171,7 +171,7 @@ pub extern "system" fn dll_main(instance: *mut c_void, reason: u32, _reserved: *
     #[cfg(any(target_arch = "aarch64", target_arch = "arm64ec", mingw_crt))]
     arm64_crt::attach();
     init_logger(instance);
-    attach_process(instance);
+    attach_process(instance, !reserved.is_null());
     1
 }
 
@@ -436,11 +436,25 @@ fn write_out(out: *mut *mut c_void, value: *mut c_void) {
 /// `not_unsafe_ptr_arg_deref` only checks `pub` functions.
 /// `DisableThreadLibraryCalls` so per-thread `DllMain` notifications don't
 /// fire.
-fn attach_process(instance: *mut c_void) {
+///
+/// The main module's imports are redirected only when the loader maps this
+/// image with the process (`static_load`: a non-null `lpvReserved`, the
+/// contract Windows documents and Wine's loader keeps), which is how a game
+/// built on Direct3D 9 has it. A run-time load, such as a diagnostics or
+/// video component's in a game built on another API, leaves them alone: a
+/// protected executable that finds its import table changed ends itself.
+fn attach_process(instance: *mut c_void, static_load: bool) {
     // SAFETY: `instance` is the HMODULE passed by the loader to `DllMain`
     // during `DLL_PROCESS_ATTACH`; Win32 `DisableThreadLibraryCalls` is
     // safe to call from `DLL_PROCESS_ATTACH` with that module handle.
     unsafe { DisableThreadLibraryCalls(instance) };
+    if !static_load {
+        log::info!(
+            target: LOG_TARGET,
+            "loaded at run time: the main module's imports stay as they are (no mode list or exit status redirection)"
+        );
+        return;
+    }
     mode_list_hook::install();
     exit_code_hook::install();
 }
diff --git a/mtld3d/windows/d3d9/src/mode_list_hook.rs b/mtld3d/windows/d3d9/src/mode_list_hook.rs
index 26a42012..4ad5d586 100644
--- a/mtld3d/windows/d3d9/src/mode_list_hook.rs
+++ b/mtld3d/windows/d3d9/src/mode_list_hook.rs
@@ -6,8 +6,9 @@
 //! size once) sees the whole list a fullscreen device may set, which under
 //! Wine's `EmulateModeset` is forty-odd sizes and overflows a menu built for
 //! a driver's short list. The `EnumDisplaySettings*` imports of the process's
-//! main module are redirected here at `DllMain`: an index into the list maps
-//! onto the n-th mode whose size `EnumAdapterModes` serves, so both menu
+//! main module are redirected here at `DllMain` when that module imports
+//! `d3d9.dll` itself (a run-time load leaves them alone): an index into the
+//! list maps onto the n-th mode whose size `EnumAdapterModes` serves, so both menu
 //! paths show one bounded list ([`served_mode_sizes`]). `ENUM_CURRENT_SETTINGS`
 //! and `ENUM_REGISTRY_SETTINGS` pass through untouched, user32's own list is
 //! never changed (a mode-set validates against all of it), and this DLL's own
-- 
