From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Sun, 18 Oct 2026 07:53:37 -0400
Subject: [PATCH] winemetal: A present hook natively, and no crash on a window
 without a view.

The native build's presentDrawable calls (and their after-minimum-duration
form) first call a hook, WMTSetPresentHook's: the VM host counts and probes
native DXMT's frames there as it does guest DXMT's. CreateMetalViewFromHWND
answers no view, instead of crashing, for a window the driver has no data
or view for.

Assisted-by: Claude Code: claude-opus-5-5
---
 src/winemetal/unix/winemetal_unix.c | 24 +++++++++++++++++++++---
 src/winemetal/winemetal.h           |  3 +++
 2 files changed, 24 insertions(+), 3 deletions(-)

diff --git a/src/winemetal/unix/winemetal_unix.c b/src/winemetal/unix/winemetal_unix.c
index 1a7ce88..928a946 100644
--- a/src/winemetal/unix/winemetal_unix.c
+++ b/src/winemetal/unix/winemetal_unix.c
@@ -1383,9 +1383,22 @@ _MTLBuffer_didModifyRange(void *obj) {
   return STATUS_SUCCESS;
 }
 
+#ifdef DXMT_NATIVE
+static void (*present_hook)(void *cmdbuf, void *drawable);
+
+__attribute__((visibility("default"))) void
+WMTSetPresentHook(void (*hook)(void *cmdbuf, void *drawable)) {
+  present_hook = hook;
+}
+#define PRESENT_HOOK(cmdbuf, drawable) (present_hook ? present_hook((void *)(cmdbuf), (void *)(drawable)) : (void)0)
+#else
+#define PRESENT_HOOK(cmdbuf, drawable) ((void)0)
+#endif
+
 static NTSTATUS
 _MTLCommandBuffer_presentDrawable(void *obj) {
   struct unixcall_generic_obj_obj_noret *params = obj;
+  PRESENT_HOOK(params->handle, params->arg);
   [(id<MTLCommandBuffer>)params->handle presentDrawable:(id<MTLDrawable>)params->arg];
   return STATUS_SUCCESS;
 }
@@ -1393,6 +1406,7 @@ _MTLCommandBuffer_presentDrawable(void *obj) {
 static NTSTATUS
 _MTLCommandBuffer_presentDrawableAfterMinimumDuration(void *obj) {
   struct unixcall_generic_obj_obj_double_noret *params = obj;
+  PRESENT_HOOK(params->handle, params->arg0);
   [(id<MTLCommandBuffer>)params->handle presentDrawable:(id<MTLDrawable>)params->arg0
                                    afterMinimumDuration:params->arg1];
   return STATUS_SUCCESS;
@@ -1805,13 +1819,17 @@ _CreateMetalViewFromHWND(void *obj) {
   if (pfn_get_win_data && pfn_release_win_data && pfn_macdrv_view_create_metal_view &&
       pfn_macdrv_view_get_metal_layer) {
     struct macdrv_win_data *win_data = pfn_get_win_data((HWND)params->hwnd);
-    macdrv_metal_view view =
-        pfn_macdrv_view_create_metal_view(win_data->client_cocoa_view, (macdrv_metal_device)params->device);
+    /* MacNeutron: no window data, or no view in it (a window the driver doesn't know): no view, as without a driver */
+    macdrv_metal_view view = win_data && win_data->client_cocoa_view
+                                 ? pfn_macdrv_view_create_metal_view(win_data->client_cocoa_view,
+                                                                     (macdrv_metal_device)params->device)
+                                 : NULL;
     params->ret_view = (obj_handle_t)view;
     if (view) {
       params->ret_layer = (obj_handle_t)pfn_macdrv_view_get_metal_layer(view);
     }
-    pfn_release_win_data(win_data);
+    if (win_data)
+      pfn_release_win_data(win_data);
   }
 
   return STATUS_SUCCESS;
diff --git a/src/winemetal/winemetal.h b/src/winemetal/winemetal.h
index b7efb28..2414483 100644
--- a/src/winemetal/winemetal.h
+++ b/src/winemetal/winemetal.h
@@ -2258,6 +2258,9 @@ WINEMETAL_API uint32_t WMTForward(uint32_t call, void *params);
  * Unset, Metal's own memory. */
 WINEMETAL_API void WMTSetMemoryHooks(void *(*alloc)(uint64_t length, void *ctx), void (*free)(void *ptr, void *ctx),
                                      void *ctx);
+/* MacNeutron, the native build: hook(cmdbuf, drawable) runs before each presentDrawable (and its after-minimum-duration
+ * form) on the presenting thread: the VM host's frame probe and count. NULL: none. */
+WINEMETAL_API void WMTSetPresentHook(void (*hook)(void *cmdbuf, void *drawable));
 #endif
 #if defined(DXMT_NATIVE) || !defined(_WIN32)
 /* Whether they are set: then a CPU-visible D3D12 heap is DXMT's own over one buffer of theirs (d3d12_heap.cpp). */
-- 
