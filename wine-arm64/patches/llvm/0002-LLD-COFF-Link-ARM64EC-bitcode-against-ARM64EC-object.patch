From ad013c89bed592bd67c3d78e1e2f232c4ecad9ca Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Wed, 14 Oct 2026 23:07:58 -0400
Subject: [PATCH] [LLD][COFF] Link ARM64EC bitcode against ARM64EC objects and
 archives

An ARM64EC bitcode file names functions demangled, while ARM64EC archives index only the mangled (#) names and object files (hand-written assembly) may call the mangled form, which only the object file LTO produces defines. So static ARM64EC libraries (libc++) weren't loaded for the functions bitcode calls, and assembly calling a function defined in bitcode was reported undefined before LTO ran.

Bind a bitcode file's undefined functions to their mangled forms with an anti-dependency alias, as ARM64EC object files do, and let a mangled reference from an object file keep the bitcode function it names.
---
 lld/COFF/InputFiles.cpp  | 16 ++++++++++++++++
 lld/COFF/SymbolTable.cpp | 13 +++++++++++++
 2 files changed, 29 insertions(+)

diff --git a/lld/COFF/InputFiles.cpp b/lld/COFF/InputFiles.cpp
index fd4858581..a0ed17616 100644
--- a/lld/COFF/InputFiles.cpp
+++ b/lld/COFF/InputFiles.cpp
@@ -1419,6 +1419,22 @@ void BitcodeFile::parse() {
       sym = symtab.addUndefined(symName, this, false);
       if (objSym.isWeak())
         sym->deferUndefined = true;
+      // An ARM64EC bitcode file names the functions it calls demangled; the
+      // object file LTO makes from it calls their mangled (#) forms, which is
+      // all ARM64EC archives index. Bind the two with an anti-dependency
+      // alias, as ARM64EC object files do, so that archive members defining
+      // the mangled form are loaded before LTO runs.
+      else if (symtab.isEC() && objSym.isExecutable()) {
+        auto *u = dyn_cast<Undefined>(sym);
+        if (u && !u->weakAlias) {
+          if (std::optional<std::string> mangledName =
+                  getArm64ECMangledFunctionName(symName)) {
+            Symbol *m = symtab.addUndefined(saver.save(*mangledName), this,
+                                            /*overrideLazy=*/false);
+            u->setWeakAlias(m, /*antiDep=*/true);
+          }
+        }
+      }
       // If one LTO object file references (i.e. has an undefined reference to)
       // a symbol with an __imp_ prefix, the LTO compilation itself sees it
       // as unprefixed but with a dllimport attribute instead, and doesn't
diff --git a/lld/COFF/SymbolTable.cpp b/lld/COFF/SymbolTable.cpp
index ea5bdbc0b..422d988ae 100644
--- a/lld/COFF/SymbolTable.cpp
+++ b/lld/COFF/SymbolTable.cpp
@@ -442,6 +442,19 @@ void SymbolTable::reportUnresolvable() {
         continue;
       }
     }
+    // An ARM64EC function defined in bitcode is named demangled there; only
+    // the object file LTO makes from it defines the mangled (#) form object
+    // files (hand-written assembly) may call. Keep the function for them.
+    if (isEC()) {
+      if (std::optional<std::string> demangledName =
+              getArm64ECDemangledFunctionName(name)) {
+        Defined *def = dyn_cast_or_null<Defined>(find(*demangledName));
+        if (def && isa<BitcodeFile>(def->getFile())) {
+          def->isUsedInRegularObj = true;
+          continue;
+        }
+      }
+    }
     if (name.contains("_PchSym_"))
       continue;
     if (ctx.config.autoImport && impSymbol(name))
