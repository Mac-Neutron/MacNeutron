From 9c2a7b0f2df66b3d6773262219825a89b9602a50 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Wed, 14 Oct 2026 23:47:25 -0400
Subject: [PATCH] [Bitcode] Read the hybrid_patchable attribute back

The writer emits ATTR_KIND_HYBRID_PATCHABLE but the reader didn't know it, so LTO and llvm-nm failed on ARM64EC bitcode with hybrid-patchable functions (Wine's DECLSPEC_HOTPATCH): "Unknown attribute kind (95)".
---
 llvm/lib/Bitcode/Reader/BitcodeReader.cpp | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/llvm/lib/Bitcode/Reader/BitcodeReader.cpp b/llvm/lib/Bitcode/Reader/BitcodeReader.cpp
index c57323ed4..59544dca1 100644
--- a/llvm/lib/Bitcode/Reader/BitcodeReader.cpp
+++ b/llvm/lib/Bitcode/Reader/BitcodeReader.cpp
@@ -2306,6 +2306,8 @@ static Attribute::AttrKind getAttrFromCode(uint64_t Code) {
     return Attribute::MustProgress;
   case bitc::ATTR_KIND_HOT:
     return Attribute::Hot;
+  case bitc::ATTR_KIND_HYBRID_PATCHABLE:
+    return Attribute::HybridPatchable;
   case bitc::ATTR_KIND_PRESPLIT_COROUTINE:
     return Attribute::PresplitCoroutine;
   case bitc::ATTR_KIND_WRITABLE:
