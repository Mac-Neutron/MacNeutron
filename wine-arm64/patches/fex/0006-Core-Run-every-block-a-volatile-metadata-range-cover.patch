From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Fri, 9 Oct 2026 13:49:44 -0400
Subject: [PATCH] Core: Run every block a volatile-metadata range covers
 without TSO.

The block rule needed a listed volatile access inside the block before it
looked at the valid ranges at all, so a block the metadata marks safe kept
TSO, and EVMD's documented range and module forms (Config.json.in) did
nothing: they list no instruction (852e93a made that no-instruction case
deterministic). Now every block inside a valid range runs without TSO, except
for its listed accesses and the accesses MonoHacks flags with FLAG_FORCE_TSO,
which keep it; a block that straddles a range's edge keeps the default.
Listed GPR accesses keep TSO; vector accesses follow VectorTSOEnabled; x87
FIST/FISTP stores follow VectorTSOEnabled; REP MOVS/STOS follow
MemcpySetTSOEnabled.

A range now turns TSO off, so it must not reach past its image: the PE
tables' ranges and EVMD's are clamped to the mapping, empty ones dropped, and
PE-listed instructions outside the image are dropped, so the image's unmap
(RemoveForceTSOInformation over its whole view) removes everything it added
and the coverage line never counts more than SizeOfImage. Only a bare module
name disables TSO for the whole module: `mod;` and `mod;;<instructions>` now
list no range instead of falling back to the whole module (and the latter
keeps its instructions). APITests cover both.

The VolatileMetadata option is read again (47a8fc4b4 removed its last
reader): FEX_VOLATILEMETADATA=0 skips an image's PE tables, while EVMD, an
explicit setting, still applies. Each image with metadata or EVMD gets one
coverage line at INFO: its instructions, ranges and bytes.

Ours and local only: FEX refuses AI-written code (AGENTS.md:1), and this
patch is never sent upstream (Ruling R15).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 FEXCore/Source/Interface/Core/Core.cpp        | 21 ++++--------
 Source/Common/VolatileMetadata.cpp            |  9 ++---
 Source/Common/VolatileMetadata.h              | 10 ++++--
 Source/Windows/Common/ImageTracker.cpp        | 24 ++++++++++---
 Source/Windows/Common/ImageTracker.h          |  1 +
 .../APITests/ExtendedVolatileMetadata.cpp     | 34 +++++++++++++++++++
 6 files changed, 73 insertions(+), 26 deletions(-)

diff --git a/FEXCore/Source/Interface/Core/Core.cpp b/FEXCore/Source/Interface/Core/Core.cpp
index 63280a4..7670361 100644
--- a/FEXCore/Source/Interface/Core/Core.cpp
+++ b/FEXCore/Source/Interface/Core/Core.cpp
@@ -579,14 +579,9 @@ ContextImpl::GenerateIR(FEXCore::Core::InternalThreadState* Thread, uint64_t Gue
       }
 #endif
 
-      bool BlockInForceTSOValidRange = false;
-      auto InstForceTSOIt = ForceTSOInstructions.end();
-      if (ForceTSOValidRanges.Contains({Block.Entry, Block.Entry + Block.Size})) {
-        if (auto It = ForceTSOInstructions.lower_bound(Block.Entry); It != ForceTSOInstructions.end() && *It < Block.Entry + Block.Size) {
-          InstForceTSOIt = It;
-          BlockInForceTSOValidRange = true;
-        }
-      }
+      // A block inside a valid range runs without TSO except for its listed and MonoHacks-flagged accesses (batch Task 4).
+      const bool BlockInForceTSOValidRange = ForceTSOValidRanges.Contains({Block.Entry, Block.Entry + Block.Size});
+      auto InstForceTSOIt = BlockInForceTSOValidRange ? ForceTSOInstructions.lower_bound(Block.Entry) : ForceTSOInstructions.end();
 
       // Set the block entry point
       Thread->OpDispatcher->SetNewBlockIfChanged(Block.Entry);
@@ -678,13 +673,11 @@ ContextImpl::GenerateIR(FEXCore::Core::InternalThreadState* Thread, uint64_t Gue
           Thread->OpDispatcher->ResetHandledLock();
           Thread->OpDispatcher->ResetDecodeFailure();
           IR::ForceTSOMode ForceTSO = IR::ForceTSOMode::NoOverride;
+          const bool Flagged = DecodedInfo->Flags & X86Tables::DecodeFlags::FLAG_FORCE_TSO;
           if (BlockInForceTSOValidRange) {
-            if (InstForceTSOIt != ForceTSOInstructions.end() && *InstForceTSOIt == InstAddress) {
-              ForceTSO = IR::ForceTSOMode::ForceEnabled;
-            } else {
-              ForceTSO = IR::ForceTSOMode::ForceDisabled;
-            }
-          } else if (DecodedInfo->Flags & X86Tables::DecodeFlags::FLAG_FORCE_TSO) {
+            const bool Listed = InstForceTSOIt != ForceTSOInstructions.end() && *InstForceTSOIt == InstAddress;
+            ForceTSO = Listed || Flagged ? IR::ForceTSOMode::ForceEnabled : IR::ForceTSOMode::ForceDisabled;
+          } else if (Flagged) {
             ForceTSO = IR::ForceTSOMode::ForceEnabled;
           }
 
diff --git a/Source/Common/VolatileMetadata.cpp b/Source/Common/VolatileMetadata.cpp
index 52de3b9..f531f41 100644
--- a/Source/Common/VolatileMetadata.cpp
+++ b/Source/Common/VolatileMetadata.cpp
@@ -35,10 +35,12 @@ fextl::unordered_map<fextl::string, ExtendedVolatileMetadata> ParseExtendedVolat
       continue;
     }
 
+    // Only a bare module name disables TSO for the whole module: `mod;` and `mod;;<instructions>` list no range
+    // (batch Task 4).
     auto current_module = ExtendedMetaData
                             .insert_or_assign(fextl::string(section_str),
                                               ExtendedVolatileMetadata {
-                                                .ModuleTSODisabled = true,
+                                                .ModuleTSODisabled = module_config.find(';') == std::string_view::npos,
                                               })
                             .first;
     ++section;
@@ -46,11 +48,6 @@ fextl::unordered_map<fextl::string, ExtendedVolatileMetadata> ParseExtendedVolat
     // Address range handling
     if (section != sections_end) {
       std::string_view section_str = *section;
-      if (section_str.empty()) {
-        continue;
-      }
-
-      current_module->second.ModuleTSODisabled = false;
 
       // Walk all the address ranges provided.
       for (auto tso_region_view : ranges::views::split(section_str, ',') | ranges::views::transform(to_string_view)) {
diff --git a/Source/Common/VolatileMetadata.h b/Source/Common/VolatileMetadata.h
index a6141fe..a61d698 100644
--- a/Source/Common/VolatileMetadata.h
+++ b/Source/Common/VolatileMetadata.h
@@ -6,6 +6,7 @@
 #include <FEXCore/fextl/set.h>
 #include <FEXCore/fextl/string.h>
 
+#include <algorithm>
 #include <string_view>
 
 namespace FEX::VolatileMetadata {
@@ -34,10 +35,15 @@ inline void ApplyFEXExtendedVolatileMetadata(FEX::VolatileMetadata::ExtendedVola
     }
   }
 
-  // Walk the volatile list
+  // Walk the volatile list, each range clamped to [Address, EndAddress) so it can't outlive the mapping (batch Task 4).
+  const uint64_t Size = EndAddress - Address;
   for (const auto it_ranges : ExtendedMetaData.VolatileValidRanges) {
     if (it_ranges.Offset >= FileOffset && it_ranges.End < FileOffsetEnd) {
-      VolatileValidRanges.Insert({Address + it_ranges.Offset - FileOffset, Address + it_ranges.End - FileOffset});
+      const uint64_t Begin = std::min(it_ranges.Offset - FileOffset, Size);
+      const uint64_t End = std::min(it_ranges.End - FileOffset, Size);
+      if (Begin < End) {
+        VolatileValidRanges.Insert({Address + Begin, Address + End});
+      }
     }
   }
 
diff --git a/Source/Windows/Common/ImageTracker.cpp b/Source/Windows/Common/ImageTracker.cpp
index c459c44..8221954 100644
--- a/Source/Windows/Common/ImageTracker.cpp
+++ b/Source/Windows/Common/ImageTracker.cpp
@@ -63,15 +63,22 @@ static void LoadImageVolatileMetadata(fextl::set<uint64_t>& VolatileInstructions
   const auto* VolatileAccessTableBegin = reinterpret_cast<IMAGE_VOLATILE_RVA_METADATA*>(Address + VolatileMetadata->VolatileAccessTable);
   const auto* VolatileAccessTableEnd =
     VolatileAccessTableBegin + (VolatileMetadata->VolatileAccessTableSize / sizeof(IMAGE_VOLATILE_RVA_METADATA));
+  // Entries outside the image are dropped and ranges clamped to it, so nothing outlives the module (batch Task 4).
   for (auto It = VolatileAccessTableBegin; It != VolatileAccessTableEnd; It++) {
-    VolatileInstructions.emplace(Address + It->Rva);
+    if (Address + It->Rva < EndAddress) {
+      VolatileInstructions.emplace(Address + It->Rva);
+    }
   }
 
   const auto* VolatileInfoRangeTableBegin = reinterpret_cast<IMAGE_VOLATILE_RANGE_METADATA*>(Address + VolatileMetadata->VolatileInfoRangeTable);
   const auto* VolatileInfoRangeTableEnd =
     VolatileInfoRangeTableBegin + (VolatileMetadata->VolatileInfoRangeTableSize / sizeof(IMAGE_VOLATILE_RANGE_METADATA));
   for (auto It = VolatileInfoRangeTableBegin; It != VolatileInfoRangeTableEnd; It++) {
-    VolatileValidRanges.Insert({Address + It->Rva, Address + It->Rva + It->Size});
+    const uint64_t Begin = Address + It->Rva;
+    const uint64_t End = std::min(Begin + It->Size, EndAddress);
+    if (Begin < End) {
+      VolatileValidRanges.Insert({Begin, End});
+    }
   }
 }
 
@@ -185,7 +192,9 @@ FEXCore::ExecutableFileSectionInfo ImageTracker::HandleImageMap(std::string_view
   uint64_t EndAddress = Address + Nt->OptionalHeader.SizeOfImage;
   fextl::set<uint64_t> VolatileInstructions {};
   FEXCore::IntervalList<uint64_t> VolatileValidRanges {};
-  LoadImageVolatileMetadata(VolatileInstructions, VolatileValidRanges, Module, Nt, Address, EndAddress);
+  if (VolatileMetadataConfig()) {
+    LoadImageVolatileMetadata(VolatileInstructions, VolatileValidRanges, Module, Nt, Address, EndAddress);
+  }
   if (auto It = ExtendedMetaData.find(ID); It != ExtendedMetaData.end()) {
     FEX::VolatileMetadata::ApplyFEXExtendedVolatileMetadata(It->second, VolatileInstructions, VolatileValidRanges, Address, EndAddress);
   }
@@ -194,7 +203,14 @@ FEXCore::ExecutableFileSectionInfo ImageTracker::HandleImageMap(std::string_view
   }
 
   if (!VolatileInstructions.empty() || !VolatileValidRanges.Empty()) {
-    LogMan::Msg::DFmt("Loaded volatile metadata for {:X}: {} entries", Address, VolatileInstructions.size());
+    size_t Ranges = 0;
+    uint64_t Bytes = 0;
+    for (const auto& Range : VolatileValidRanges) {
+      ++Ranges;
+      Bytes += Range.End - Range.Offset;
+    }
+    LogMan::Msg::IFmt("volatile metadata: {} at {:X}: {} instructions, {} ranges, {} bytes", ModuleName, Address,
+                      VolatileInstructions.size(), Ranges, Bytes);
     CTX.AddForceTSOInformation(VolatileValidRanges, std::move(VolatileInstructions));
   }
 
diff --git a/Source/Windows/Common/ImageTracker.h b/Source/Windows/Common/ImageTracker.h
index 438bcbc..6f711ea 100644
--- a/Source/Windows/Common/ImageTracker.h
+++ b/Source/Windows/Common/ImageTracker.h
@@ -64,6 +64,7 @@ private:
   FEXCore::Context::Context& CTX;
 
   FEX_CONFIG_OPT(ExtendedVolatileMetadataConfig, EXTENDEDVOLATILEMETADATA);
+  FEX_CONFIG_OPT(VolatileMetadataConfig, VOLATILEMETADATA);
   fextl::unordered_map<fextl::string, FEX::VolatileMetadata::ExtendedVolatileMetadata> ExtendedMetaData;
 
   std::shared_mutex ImagesLock;
diff --git a/unittests/APITests/ExtendedVolatileMetadata.cpp b/unittests/APITests/ExtendedVolatileMetadata.cpp
index 4c06548..37984be 100644
--- a/unittests/APITests/ExtendedVolatileMetadata.cpp
+++ b/unittests/APITests/ExtendedVolatileMetadata.cpp
@@ -156,3 +156,37 @@ TEST_CASE("Basic - Double - offset") {
     }
   }
 }
+
+// Only a bare module name disables TSO for the whole module: an empty ranges section lists no range (batch Task 4).
+TEST_CASE("Basic - Single - empty ranges") {
+  const auto String = "hl2_linux;";
+  const auto Result = FEX::VolatileMetadata::ParseExtendedVolatileMetadata(String);
+  REQUIRE(Result.size() == 1);
+  REQUIRE(Result.contains("hl2_linux"));
+  CHECK(Result.at("hl2_linux").ModuleTSODisabled == false);
+  CHECK(Result.at("hl2_linux").VolatileInstructions.empty());
+  CHECK(Result.at("hl2_linux").VolatileValidRanges.Empty());
+}
+
+TEST_CASE("Basic - Single - empty ranges plus instruction") {
+  const auto String = "hl2_linux;;0x1,0x2";
+  const auto Result = FEX::VolatileMetadata::ParseExtendedVolatileMetadata(String);
+  REQUIRE(Result.size() == 1);
+  REQUIRE(Result.contains("hl2_linux"));
+  CHECK(Result.at("hl2_linux").ModuleTSODisabled == false);
+  CHECK(Result.at("hl2_linux").VolatileValidRanges.Empty());
+  CHECK(Result.at("hl2_linux").VolatileInstructions == fextl::set<uint64_t> {1, 2});
+}
+
+// Ranges are clamped to the mapping, so none outlives it (batch Task 4).
+TEST_CASE("Apply - ranges clamped to the module") {
+  auto Result = FEX::VolatileMetadata::ParseExtendedVolatileMetadata("hl2_linux;0x0-0x100000,0x200000-0x300000");
+  fextl::set<uint64_t> Instructions;
+  FEXCore::IntervalList<uint64_t> Ranges;
+  FEX::VolatileMetadata::ApplyFEXExtendedVolatileMetadata(Result.at("hl2_linux"), Instructions, Ranges, 0x10000, 0x28000);
+  std::vector<std::pair<uint64_t, uint64_t>> Got;
+  for (auto it : Ranges) {
+    Got.emplace_back(it.Offset, it.End);
+  }
+  CHECK(Got == std::vector<std::pair<uint64_t, uint64_t>> {{0x10000, 0x28000}});
+}
