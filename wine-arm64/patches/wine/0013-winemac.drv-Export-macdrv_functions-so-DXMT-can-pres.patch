From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Sat, 3 Oct 2026 16:17:22 -0400
Subject: [PATCH] winemac.drv: Export macdrv_functions so DXMT can present.

DXMT's winemetal.so finds the driver with dlsym(RTLD_DEFAULT,
"macdrv_functions") and falls back to get_win_data and three
macdrv_view_* symbols. Wine builds unix libraries with
-fvisibility=hidden, so winemac.so exports none of them and every
swapchain creation aborts.

Export a ten-slot table in DXMT's slot order. Its get_win_data makes a
client surface for the window and returns Wine 8's struct head with the
surface view at offset 24, where DXMT reads client_cocoa_view. Nothing
in win32u updates or presents such a surface, so the view's metal layer
reports each nextDrawable to the window's thread, which presents the
surface: that shows the view again after a GDI flush hid it and keeps
it on the client rect. The handler presents only a surface the window
still lists, since a nextDrawable during window close can post a
pointer to a freed surface. The layer reads the view tree on the main
thread, not on DXMT's, since DestroyWindow's macdrv_dispose_view frees
the content view there: read on DXMT's thread, a present_loop round
that destroyed the window mid-present sent isKindOfClass: to the freed
view (NSZombieEnabled, with nextDrawable slowed by 3 ms).

Sources (LGPL), adapted to Wine 11.19's client surfaces:
- CodeWeavers' dlls/winemac.drv/d3dmetal.c (Brendan Shanks,
  LGPL-2.1+), as published in athei/wine branch cx-26-patched: the
  table, get_win_data's client surface and the present handler; and
  its d3dmetal_objc.m: the present report (WineMetalLayer, CW HACK
  22435).
- dappermint/winecx 713015fa9f, 13e6a88a02 and 565f6386b7: the same
  code enabled on aarch64 and ported to Wine 11.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 dlls/winemac.drv/cocoa_window.m | 45 ++++++++++++++-
 dlls/winemac.drv/event.c        |  5 ++
 dlls/winemac.drv/macdrv.h       |  2 +
 dlls/winemac.drv/macdrv_cocoa.h |  5 ++
 dlls/winemac.drv/window.c       | 98 +++++++++++++++++++++++++++++++++
 5 files changed, 154 insertions(+), 1 deletion(-)

diff --git a/dlls/winemac.drv/cocoa_window.m b/dlls/winemac.drv/cocoa_window.m
index e15f7083..b883740f 100644
--- a/dlls/winemac.drv/cocoa_window.m
+++ b/dlls/winemac.drv/cocoa_window.m
@@ -243,6 +243,8 @@ @interface WineContentView : WineBaseView <NSTextInputClient, NSViewLayerContent
 
     WineMetalView *_metalView;
     NSMutableDictionary<NSNumber*, CALayerHost*>* _caLayerHosts;
+@public
+    void *client_surface;   /* set only on views handed out through macdrv_functions */
 }
 
 @property (readonly, nonatomic) BOOL everHadGLContext;
@@ -821,6 +823,42 @@ - (NSInteger) windowLevel
 @end
 
 
+/* DXMT presents straight to the layer, so nothing tells win32u about it. Report each
+ * nextDrawable on a macdrv_functions view to the window's thread, which runs
+ * client_surface_present(): that un-hides the view after a GDI flush hid it and
+ * re-applies the window's client rect, since win32u never updates this surface itself.
+ * nextDrawable runs on DXMT's thread, so the view tree is read on the main thread, the only
+ * one that changes it (macdrv_dispose_view frees the content view there, and AppKit
+ * deallocates windows there); the block holds the metal view, which DXMT keeps until
+ * macdrv_view_release_metal_view. */
+@interface WineMetalLayer : CAMetalLayer
+@end
+
+@implementation WineMetalLayer
+
+    - (id<CAMetalDrawable>) nextDrawable
+    {
+        NSView *view = (NSView*)self.delegate;
+
+        OnMainThreadAsync(^{
+            WineContentView *content = (WineContentView*)view.superview;
+
+            if ([content isKindOfClass:[WineContentView class]] && content->client_surface &&
+                [view.window isKindOfClass:[WineWindow class]])
+            {
+                WineWindow *window = (WineWindow*)view.window;
+                macdrv_event *event = macdrv_create_event(CLIENT_SURFACE_PRESENTED, window);
+                event->client_surface_presented.client_surface = content->client_surface;
+                [window.queue postEvent:event];
+                macdrv_release_event(event);
+            }
+        });
+        return [super nextDrawable];
+    }
+
+@end
+
+
 @implementation WineMetalView
 
     - (id) initWithFrame:(NSRect)frame device:(id<MTLDevice>)device
@@ -849,7 +887,7 @@ - (void) setRetinaMode:(BOOL)mode
 
     - (CALayer*) makeBackingLayer
     {
-        CAMetalLayer *layer = [CAMetalLayer layer];
+        CAMetalLayer *layer = [WineMetalLayer layer];
         layer.device = _device;
         layer.framebufferOnly = YES;
         layer.magnificationFilter = kCAFilterNearest;
@@ -3635,6 +3673,11 @@ void macdrv_release_metal_device(id<MTLDevice> device)
     return layer;
 }
 
+void macdrv_set_view_client_surface(WineContentView *view, void *client_surface)
+{
+    view->client_surface = client_surface;
+}
+
 void macdrv_view_release_metal_view(WineMetalView *view)
 {
     OnMainThread(^{
diff --git a/dlls/winemac.drv/event.c b/dlls/winemac.drv/event.c
index 18185a61..dbb9369c 100644
--- a/dlls/winemac.drv/event.c
+++ b/dlls/winemac.drv/event.c
@@ -67,6 +67,7 @@ static const char *dbgstr_event(int type)
         "WINDOW_MINIMIZE_REQUESTED",
         "WINDOW_RESIZE_ENDED",
         "WINDOW_RESTORE_REQUESTED",
+        "CLIENT_SURFACE_PRESENTED",
     };
     C_ASSERT(ARRAYSIZE(event_names) == NUM_EVENT_TYPES);
 
@@ -111,6 +112,7 @@ static macdrv_event_mask get_event_mask(DWORD mask)
         event_mask |= event_mask_for_type(APP_ACTIVATED);
         event_mask |= event_mask_for_type(APP_DEACTIVATED);
         event_mask |= event_mask_for_type(APP_QUIT_REQUESTED);
+        event_mask |= event_mask_for_type(CLIENT_SURFACE_PRESENTED);
         event_mask |= event_mask_for_type(DISPLAYS_CHANGED);
         event_mask |= event_mask_for_type(LOST_PASTEBOARD_OWNERSHIP);
         event_mask |= event_mask_for_type(STATUS_ITEM_MOUSE_BUTTON);
@@ -328,6 +330,9 @@ void macdrv_handle_event(const macdrv_event *event)
     case APP_QUIT_REQUESTED:
         macdrv_app_quit_requested(event);
         break;
+    case CLIENT_SURFACE_PRESENTED:
+        macdrv_client_surface_presented(hwnd, event);
+        break;
     case DISPLAYS_CHANGED:
         macdrv_displays_changed(event);
         break;
diff --git a/dlls/winemac.drv/macdrv.h b/dlls/winemac.drv/macdrv.h
index 89c498fe..daf19a25 100644
--- a/dlls/winemac.drv/macdrv.h
+++ b/dlls/winemac.drv/macdrv.h
@@ -242,6 +242,7 @@ extern void macdrv_ime_set_text(HWND hwnd, CFStringRef text, bool complete,
     unsigned int        per_pixel_alpha : 1;    /* is window using per-pixel alpha? */
     unsigned int        minimized : 1;          /* is window minimized? */
     unsigned int        fullscreen : 1;         /* is the window visible rect fullscreen? (unrelated to native AppKit/Cocoa fullscreen) */
+    CFMutableArrayRef   dxmt_surfaces;          /* client surfaces created through macdrv_functions */
 };
 
 struct macdrv_client_surface
@@ -262,6 +263,7 @@ extern void macdrv_ime_set_text(HWND hwnd, CFStringRef text, bool complete,
 extern void activate_on_following_focus(void);
 
 extern void macdrv_handle_event(const macdrv_event *event);
+extern void macdrv_client_surface_presented(HWND hwnd, const macdrv_event *event);
 
 extern void macdrv_window_close_requested(HWND hwnd);
 extern void macdrv_window_frame_changed(HWND hwnd, const macdrv_event *event);
diff --git a/dlls/winemac.drv/macdrv_cocoa.h b/dlls/winemac.drv/macdrv_cocoa.h
index 5157b38c..215ed7bf 100644
--- a/dlls/winemac.drv/macdrv_cocoa.h
+++ b/dlls/winemac.drv/macdrv_cocoa.h
@@ -285,6 +285,7 @@ static inline CGPoint cgpoint_win_from_mac(CGPoint point)
     WINDOW_MINIMIZE_REQUESTED,
     WINDOW_RESIZE_ENDED,
     WINDOW_RESTORE_REQUESTED,
+    CLIENT_SURFACE_PRESENTED,
     NUM_EVENT_TYPES
 };
 
@@ -306,6 +307,9 @@ static inline CGPoint cgpoint_win_from_mac(CGPoint point)
         struct {
             int reason;
         }                                           app_quit_requested;
+        struct {
+            void           *client_surface;
+        }                                           client_surface_presented;
         struct {
             bool activating;
         }                                           displays_changed;
@@ -503,6 +507,7 @@ extern void macdrv_order_cocoa_window(WineWindow *window, WineWindow *prev,
 extern WineMetalView *macdrv_view_create_metal_view(WineContentView *view, MTLDevice_id device);
 extern CAMetalLayer *macdrv_view_get_metal_layer(WineMetalView *view);
 extern void macdrv_view_release_metal_view(WineMetalView *view);
+extern void macdrv_set_view_client_surface(WineContentView *view, void *client_surface);
 extern WineMetalSwapChain_id macdrv_create_view_swapchain(WineContentView *view);
 extern WineMetalSwapChain_id macdrv_create_offscreen_swapchain(void* hwnd, CGRect bounds);
 extern CAMetalLayer *macdrv_swapchain_get_layer(WineMetalSwapChain_id swapchain);
diff --git a/dlls/winemac.drv/window.c b/dlls/winemac.drv/window.c
index 552971f5..97124882 100644
--- a/dlls/winemac.drv/window.c
+++ b/dlls/winemac.drv/window.c
@@ -1185,6 +1185,102 @@ bool macdrv_client_surface_acquire_metal_swapchain(struct macdrv_client_surface
     return surface->metal_swapchain != NULL;
 }
 
+/* What DXMT reads through macdrv_functions->get_win_data: Wine 8's macdrv_win_data head.
+ * Only client_cocoa_view (offset 24) is used; 11.x moved client_view to offset 16. */
+struct dxmt_win_data
+{
+    HWND                    hwnd;
+    WineWindow             *cocoa_window;
+    WineContentView        *cocoa_view;             /* gone since Wine 9, always NULL */
+    WineContentView        *client_cocoa_view;
+    struct macdrv_win_data *data;                   /* private: held until release */
+};
+C_ASSERT(offsetof(struct dxmt_win_data, client_cocoa_view) == 24);
+
+static void dxmt_surface_release(CFAllocatorRef allocator, const void *client)
+{
+    client_surface_release((struct client_surface *)client);
+}
+
+/* DXMT keeps the returned view's metal layer for the swapchain's life, so every call
+ * makes a client surface owned by the window, like CrossOver's d3dmetal.c does. */
+static struct dxmt_win_data *dxmt_get_win_data(HWND hwnd)
+{
+    static const CFArrayCallBacks callbacks = { .release = dxmt_surface_release };
+    struct dxmt_win_data *ret;
+    struct client_surface *client;
+
+    if (!(ret = calloc(1, sizeof(*ret)))) return NULL;
+    ret->hwnd = hwnd;
+    client = macdrv_CreateClientSurface(hwnd, 0, FALSE);  /* before get_win_data: it locks win data itself */
+    if (!(ret->data = get_win_data(hwnd)))
+    {
+        /* ponytail: other-process hwnd; client_cocoa_view stays NULL so DXMT aborts with its own message */
+        client_surface_release(client);
+        return ret;
+    }
+    if (!ret->data->dxmt_surfaces) ret->data->dxmt_surfaces = CFArrayCreateMutable(NULL, 0, &callbacks);
+    CFArrayAppendValue(ret->data->dxmt_surfaces, client);
+    ret->cocoa_window = ret->data->cocoa_window;
+    ret->client_cocoa_view = impl_from_client_surface(client)->cocoa_view;
+    macdrv_set_view_client_surface(ret->client_cocoa_view, client);
+    return ret;
+}
+
+static void dxmt_release_win_data(struct dxmt_win_data *data)
+{
+    if (!data) return;
+    release_win_data(data->data);
+    free(data);
+}
+
+/* A nextDrawable during window close can post a surface DestroyWindow has freed since, so present
+ * only a surface the window still lists. DestroyWindow frees them on this thread, so a listed one
+ * outlives client_surface_present. Events come for the toplevel's Cocoa window, so a child window's
+ * surface is never listed here: child-window swap chains aren't supported yet. */
+void macdrv_client_surface_presented(HWND hwnd, const macdrv_event *event)
+{
+    struct client_surface *client = event->client_surface_presented.client_surface;
+    struct macdrv_win_data *data;
+    BOOL listed;
+
+    if (!(data = get_win_data(hwnd))) return;
+    listed = data->dxmt_surfaces &&
+             CFArrayContainsValue(data->dxmt_surfaces, CFRangeMake(0, CFArrayGetCount(data->dxmt_surfaces)), client);
+    release_win_data(data);  /* before presenting: the surfaces lock ranks above win_data_mutex */
+    if (listed) client_surface_present(client);
+}
+
+/* Looked up by DXMT's winemetal.so with dlsym(RTLD_DEFAULT, "macdrv_functions"); the slot
+ * order is DXMT's struct macdrv_functions_t. DXMT calls slots 1, 2, 6, 7 and 8 only.
+ * ponytail: 10 slots, not D3DMetal's 24 (CrossOver d3dmetal.c); D3DMetal is x86_64 only. */
+DECLSPEC_EXPORT const struct
+{
+    void *init_display_devices;
+    struct dxmt_win_data *(*get_win_data)(HWND hwnd);
+    void (*release_win_data)(struct dxmt_win_data *data);
+    void *get_cocoa_window;
+    MTLDevice_id (*create_metal_device)(void);
+    void (*release_metal_device)(MTLDevice_id device);
+    WineMetalView *(*view_create_metal_view)(WineContentView *view, MTLDevice_id device);
+    CAMetalLayer *(*view_get_metal_layer)(WineMetalView *view);
+    void (*view_release_metal_view)(WineMetalView *view);
+    void *on_main_thread;
+} macdrv_functions =
+{
+    NULL,
+    dxmt_get_win_data,
+    dxmt_release_win_data,
+    NULL,
+    macdrv_create_metal_device,
+    macdrv_release_metal_device,
+    macdrv_view_create_metal_view,
+    macdrv_view_get_metal_layer,
+    macdrv_view_release_metal_view,
+    NULL,
+};
+
+
 /**********************************************************************
  *              SetDesktopWindow   (MACDRV.@)
  */
@@ -1269,6 +1365,8 @@ void macdrv_DestroyWindow(HWND hwnd)
 
     CFDictionaryRemoveValue(win_datas, hwnd);
     release_win_data(data);
+    /* after unlocking: releasing takes the win32u surfaces lock, which ranks above win_data_mutex */
+    if (data->dxmt_surfaces) CFRelease(data->dxmt_surfaces);
     free(data);
 }
 
