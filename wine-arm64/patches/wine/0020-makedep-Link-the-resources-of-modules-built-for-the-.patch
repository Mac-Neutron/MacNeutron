From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Mon, 5 Oct 2026 08:12:58 -0400
Subject: [PATCH] makedep: Link the resources of modules built for the hybrid
 arch only.

In an ARM64X build (arm64ec,aarch64), a module enabled for arm64ec but not
for aarch64 (vcruntime140_1.dll and dpnsvr.exe, enabled for x86_64,arm64ec
only) is still linked by output_module() for aarch64, with link_arch set to
arm64ec by get_link_arch(). output_source_ver(), output_source_rc() and
output_source_mc() add the .res only to the res_files of archs that aren't
disabled, here arm64ec's, but output_module() linked res_files[arch], the
disabled aarch64's, which is empty. The module shipped without its resources:
vcruntime140_1.dll had no version resource, and SMITE 2's bootstrap,
which reads vcruntime140_1.dll's file version, refused to start with
"Microsoft Visual C++ Runtime" required.

Link res_files[link_arch] when arch is disabled. A module enabled for both
archs still links res_files[arch] alone, so an ARM64X module gets its
resources once. Test modules have the same pattern but aren't built here;
fake modules are native-only and static libraries take no resources.

Local to MacNeutron; not proposed upstream.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tools/makedep.c | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/tools/makedep.c b/tools/makedep.c
index c955265b..cc98e7b4 100644
--- a/tools/makedep.c
+++ b/tools/makedep.c
@@ -3930,7 +3930,7 @@ static void output_module( struct makefile *make, unsigned int arch )
     struct strarray imports = make->imports;
     const char *p, *module_name;
     char *spec_file = NULL;
-    unsigned int link_arch;
+    unsigned int link_arch, res_arch;
 
     if (!make->is_exe)
     {
@@ -3979,12 +3979,15 @@ static void output_module( struct makefile *make, unsigned int arch )
                            strmake( "$(libdir)/wine/%s", arch_pe_dirs[arch] ), NULL );
     }
 
+    /* a module built for the hybrid arch only has its resources there */
+    res_arch = make->disabled[arch] ? link_arch : arch;
+
     strarray_add( &make->all_targets[link_arch], module_name );
     output( "%s:", obj_dir_path( make, module_name ));
     if (spec_file) output_filename( spec_file );
     output_filenames_obj_dir( make, make->object_files[arch] );
     if (link_arch != arch) output_filenames_obj_dir( make, make->object_files[link_arch] );
-    output_filenames_obj_dir( make, make->res_files[arch] );
+    output_filenames_obj_dir( make, make->res_files[res_arch] );
     output_filenames( dep_libs );
     output_filename( winebuild );
     output_filename( winegcc );
@@ -4004,7 +4007,7 @@ static void output_module( struct makefile *make, unsigned int arch )
     if (link_arch) output_filenames( get_expanded_arch_var_array( make, "EXTRADLLFLAGS", link_arch ));
     output_filenames_obj_dir( make, make->object_files[arch] );
     if (link_arch != arch) output_filenames_obj_dir( make, make->object_files[link_arch] );
-    output_filenames_obj_dir( make, make->res_files[arch] );
+    output_filenames_obj_dir( make, make->res_files[res_arch] );
     output_debug_files( make, module_name, link_arch );
     output_filenames( all_libs );
     output_filename( arch_make_variable( "LDFLAGS", link_arch ));
