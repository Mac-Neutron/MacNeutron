+#if defined(__aarch64__) || defined(__arm64ec__)
+    int r = aor_strcmp( str1, str2 );
+    return (r > 0) - (r < 0);
+#else
     while (*str1 && *str1 == *str2) { str1++; str2++; }
     if ((unsigned char)*str1 > (unsigned char)*str2) return 1;
     if ((unsigned char)*str1 < (unsigned char)*str2) return -1;
     return 0;
+#endif
