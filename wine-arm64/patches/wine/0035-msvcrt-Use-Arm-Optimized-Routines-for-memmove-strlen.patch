+static __attribute__((naked, aligned(64))) char *aor_strrchr( const char *str, int c )
+{
+    asm(
+        /* Assumptions:
+         *
+         * ARMv8-a, AArch64, Advanced SIMD.
+         * MTE compatible.
+         */
+
+        "srcin .req x0\n\t"
+        "chrin .req w1\n\t"
+        "result .req x0\n\t"
+
+        "src .req x2\n\t"
+        "tmp .req x3\n\t"
+        "synd .req x3\n\t"
+        "shift .req x4\n\t"
+        "src_match .req x4\n\t"
+        "nul_match .req x5\n\t"
+        "chr_match .req x6\n\t"
+
+        "vrepchr .req v0\n\t"
+        "vdata .req v1\n\t"
+        "vhas_nul .req v2\n\t"
+        "vhas_chr .req v3\n\t"
+        "vrepmask .req v4\n\t"
+        "vend .req v5\n\t"
+        "dend .req d5\n\t"
+
+        /* Core algorithm.
+
+           For each 16-byte chunk we calculate a 64-bit syndrome value, with
+           four bits per byte (LSB is always in bits 0 and 1, for both big
+           and little-endian systems).  For each tuple, bits 0-1 are set if
+           the relevant byte matched the requested character; bits 2-3 are set
+           if the relevant byte matched the NUL end of string.  */
+
+        "bic     src, srcin, 15\n\t"
+        "dup     vrepchr.16b, chrin\n\t"
+        "movi    vrepmask.16b, 0x33\n\t"
+        "ld1     {vdata.16b}, [src]\n\t"
+        "cmeq    vhas_nul.16b, vdata.16b, 0\n\t"
+        "cmeq    vhas_chr.16b, vdata.16b, vrepchr.16b\n\t"
+        "bit     vhas_nul.16b, vhas_chr.16b, vrepmask.16b\n\t"
+        "shrn    vend.8b, vhas_nul.8h, 4\n\t"
+        "lsl     shift, srcin, 2\n\t"
+        "fmov    synd, dend\n\t"
+        "lsr     synd, synd, shift\n\t"
+        "lsl     synd, synd, shift\n\t"
+        "ands    nul_match, synd, 0xcccccccccccccccc\n\t"
+        "bne     .Lstrrchr_tail\n\t"
+        "cbnz    synd, .Lstrrchr_loop2_start\n\t"
+
+        ".p2align 4\n\t"
+        ".Lstrrchr_loop1:\n\t"
+        "ldr     q1, [src, 16]\n\t"
+        "cmeq    vhas_chr.16b, vdata.16b, vrepchr.16b\n\t"
+        "cmhs    vhas_nul.16b, vhas_chr.16b, vdata.16b\n\t"
+        "umaxp   vend.16b, vhas_nul.16b, vhas_nul.16b\n\t"
+        "fmov    synd, dend\n\t"
+        "cbnz    synd, .Lstrrchr_loop1_end\n\t"
+        "ldr     q1, [src, 32]!\n\t"
+        "cmeq    vhas_chr.16b, vdata.16b, vrepchr.16b\n\t"
+        "cmhs    vhas_nul.16b, vhas_chr.16b, vdata.16b\n\t"
+        "umaxp   vend.16b, vhas_nul.16b, vhas_nul.16b\n\t"
+        "fmov    synd, dend\n\t"
+        "cbz     synd, .Lstrrchr_loop1\n\t"
+        "sub     src, src, 16\n\t"
+        ".Lstrrchr_loop1_end:\n\t"
+        "add     src, src, 16\n\t"
+        "cmeq    vhas_nul.16b, vdata.16b, 0\n\t"
+        "bit     vhas_nul.16b, vhas_chr.16b, vrepmask.16b\n\t"
+        "shrn    vend.8b, vhas_nul.8h, 4\n\t"
+        "fmov    synd, dend\n\t"
+        "ands    nul_match, synd, 0xcccccccccccccccc\n\t"
+        "beq     .Lstrrchr_loop2_start\n\t"
+        ".Lstrrchr_tail:\n\t"
+        "sub     nul_match, nul_match, 1\n\t"
+        "and     chr_match, synd, 0x3333333333333333\n\t"
+        "ands    chr_match, chr_match, nul_match\n\t"
+        "add     result, src, 15\n\t"
+        "clz     tmp, chr_match\n\t"
+        "sub     result, result, tmp, lsr 2\n\t"
+        "csel    result, result, xzr, ne\n\t"
+        "ret\n\t"
+
+        ".p2align 4\n\t"
+        "nop\n\t"
+        "nop\n\t"
+        ".Lstrrchr_loop2_start:\n\t"
+        "add     src, src, 16\n\t"
+        "bic     vrepmask.8h, 0xf0\n\t"
+
+        ".Lstrrchr_loop2:\n\t"
+        "cmp     synd, 0\n\t"
+        "csel    src_match, src, src_match, ne\n\t"
+        "csel    chr_match, synd, chr_match, ne\n\t"
+        "ld1     {vdata.16b}, [src], 16\n\t"
+        "cmeq    vhas_nul.16b, vdata.16b, 0\n\t"
+        "cmeq    vhas_chr.16b, vdata.16b, vrepchr.16b\n\t"
+        "bit     vhas_nul.16b, vhas_chr.16b, vrepmask.16b\n\t"
+        "umaxp   vend.16b, vhas_nul.16b, vhas_nul.16b\n\t"
+        "fmov    synd, dend\n\t"
+        "tst     synd, 0xcccccccccccccccc\n\t"
+        "beq     .Lstrrchr_loop2\n\t"
+
+        "bic     vhas_nul.8h, 0x0f, lsl 8\n\t"
+        "addp    vend.16b, vhas_nul.16b, vhas_nul.16b\n\t"
+        "fmov    synd, dend\n\t"
+        "and     nul_match, synd, 0xcccccccccccccccc\n\t"
+        "sub     nul_match, nul_match, 1\n\t"
+        "and     tmp, synd, 0x3333333333333333\n\t"
+        "ands    tmp, tmp, nul_match\n\t"
+        "csel    chr_match, tmp, chr_match, ne\n\t"
+        "csel    src_match, src, src_match, ne\n\t"
+        "sub     src_match, src_match, 1\n\t"
+        "clz     tmp, chr_match\n\t"
+        "sub     result, src_match, tmp, lsr 2\n\t"
+        "ret\n\t"
+
+        ".unreq srcin\n\t"
+        ".unreq chrin\n\t"
+        ".unreq result\n\t"
+        ".unreq src\n\t"
+        ".unreq tmp\n\t"
+        ".unreq synd\n\t"
+        ".unreq shift\n\t"
+        ".unreq src_match\n\t"
+        ".unreq nul_match\n\t"
+        ".unreq chr_match\n\t"
+        ".unreq vrepchr\n\t"
+        ".unreq vdata\n\t"
+        ".unreq vhas_nul\n\t"
+        ".unreq vhas_chr\n\t"
+        ".unreq vrepmask\n\t"
+        ".unreq vend\n\t"
+        ".unreq dend"
+    );
+}
