+static __attribute__((naked, aligned(64))) char *aor_strchr( const char *str, int c )
+{
+    asm(
+        /* Assumptions:
+         *
+         * ARMv8-a, AArch64, Advanced SIMD.
+         * MTE compatible.
+         */
+
+        "srcin .req x0\n\t"
+        "chrin .req w1\n\t"
+        "result .req x0\n\t"
+
+        "src .req x2\n\t"
+        "tmp1 .req x1\n\t"
+        "tmp2 .req x3\n\t"
+
+        "vrepchr .req v0\n\t"
+        "vdata .req v1\n\t"
+        "qdata .req q1\n\t"
+        "vhas_nul .req v2\n\t"
+        "vhas_chr .req v3\n\t"
+        "vrepmask .req v4\n\t"
+        "vend .req v5\n\t"
+        "dend .req d5\n\t"
+
+        /* Core algorithm.
+
+           For each 16-byte chunk we calculate a 64-bit syndrome value with four bits
+           per byte. Bits 0-1 are set if the relevant byte matched the requested
+           character, bits 2-3 are set if the byte is NUL or matched. Count trailing
+           zeroes gives the position of the matching byte if it is a multiple of 4.
+           If it is not a multiple of 4, there was no match.  */
+
+        "bic     src, srcin, 15\n\t"
+        "dup     vrepchr.16b, chrin\n\t"
+        "ld1     {vdata.16b}, [src]\n\t"
+        "movi    vrepmask.16b, 0x33\n\t"
+        "cmeq    vhas_nul.16b, vdata.16b, 0\n\t"
+        "cmeq    vhas_chr.16b, vdata.16b, vrepchr.16b\n\t"
+        "bit     vhas_nul.16b, vhas_chr.16b, vrepmask.16b\n\t"
+        "lsl     tmp2, srcin, 2\n\t"
+        "shrn    vend.8b, vhas_nul.8h, 4\n\t" /* 128->64 */
+        "fmov    tmp1, dend\n\t"
+        "lsr     tmp1, tmp1, tmp2\n\t"
+        "cbz     tmp1, .Lstrchr_loop\n\t"
+
+        "rbit    tmp1, tmp1\n\t"
+        "clz     tmp1, tmp1\n\t"
+        /* Tmp1 is an even multiple of 2 if the target character was
+           found first. Otherwise we've found the end of string.  */
+        "tst     tmp1, 2\n\t"
+        "add     result, srcin, tmp1, lsr 2\n\t"
+        "csel    result, result, xzr, eq\n\t"
+        "ret\n\t"
+
+        ".p2align 4\n\t"
+        ".Lstrchr_loop:\n\t"
+        "ldr     qdata, [src, 16]\n\t"
+        "cmeq    vhas_chr.16b, vdata.16b, vrepchr.16b\n\t"
+        "cmhs    vhas_nul.16b, vhas_chr.16b, vdata.16b\n\t"
+        "umaxp   vend.16b, vhas_nul.16b, vhas_nul.16b\n\t"
+        "fmov    tmp1, dend\n\t"
+        "cbnz    tmp1, .Lstrchr_end\n\t"
+        "ldr     qdata, [src, 32]!\n\t"
+        "cmeq    vhas_chr.16b, vdata.16b, vrepchr.16b\n\t"
+        "cmhs    vhas_nul.16b, vhas_chr.16b, vdata.16b\n\t"
+        "umaxp   vend.16b, vhas_nul.16b, vhas_nul.16b\n\t"
+        "fmov    tmp1, dend\n\t"
+        "cbz     tmp1, .Lstrchr_loop\n\t"
+        "sub     src, src, 16\n\t"
+        ".Lstrchr_end:\n\t"
+
+        "bit     vhas_nul.16b, vhas_chr.16b, vrepmask.16b\n\t"
+        "shrn    vend.8b, vhas_nul.8h, 4\n\t" /* 128->64 */
+        "fmov    tmp1, dend\n\t"
+        "rbit    tmp1, tmp1\n\t"
+        "add     src, src, 16\n\t"
+        "clz     tmp1, tmp1\n\t"
+        /* Tmp1 is a multiple of 4 if the target character was found.  */
+        "tst     tmp1, 2\n\t"
+        "add     result, src, tmp1, lsr 2\n\t"
+        "csel    result, result, xzr, eq\n\t"
+        "ret\n\t"
+
+        ".unreq srcin\n\t"
+        ".unreq chrin\n\t"
+        ".unreq result\n\t"
+        ".unreq src\n\t"
+        ".unreq tmp1\n\t"
+        ".unreq tmp2\n\t"
+        ".unreq vrepchr\n\t"
+        ".unreq vdata\n\t"
+        ".unreq qdata\n\t"
+        ".unreq vhas_nul\n\t"
+        ".unreq vhas_chr\n\t"
+        ".unreq vrepmask\n\t"
+        ".unreq vend\n\t"
+        ".unreq dend"
+    );
+}
