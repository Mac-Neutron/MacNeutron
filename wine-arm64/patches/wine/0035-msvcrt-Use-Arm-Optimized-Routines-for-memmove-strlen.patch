+static __attribute__((naked, aligned(64))) size_t aor_strnlen( const char *str, size_t maxlen )
+{
+    asm(
+        /* Assumptions:
+         *
+         * ARMv8-a, AArch64, Advanced SIMD.
+         * MTE compatible.
+         */
+
+        "srcin .req x0\n\t"
+        "cntin .req x1\n\t"
+        "result .req x0\n\t"
+
+        "src .req x2\n\t"
+        "synd .req x3\n\t"
+        "shift .req x4\n\t"
+        "tmp .req x4\n\t"
+        "cntrem .req x5\n\t"
+
+        "qdata .req q0\n\t"
+        "vdata .req v0\n\t"
+        "vhas_chr .req v1\n\t"
+        "vend .req v2\n\t"
+        "dend .req d2\n\t"
+
+        /*
+           Core algorithm:
+           Process the string in 16-byte aligned chunks. Compute a 64-bit mask with
+           four bits per byte using the shrn instruction. A count trailing zeros then
+           identifies the first zero byte.  */
+
+        "bic     src, srcin, 15\n\t"
+        "cbz     cntin, .Lstrnlen_nomatch\n\t"
+        "ld1     {vdata.16b}, [src]\n\t"
+        "cmeq    vhas_chr.16b, vdata.16b, 0\n\t"
+        "lsl     shift, srcin, 2\n\t"
+        "shrn    vend.8b, vhas_chr.8h, 4\n\t" /* 128->64 */
+        "fmov    synd, dend\n\t"
+        "lsr     synd, synd, shift\n\t"
+        "cbz     synd, .Lstrnlen_start_loop\n\t"
+        ".Lstrnlen_finish:\n\t"
+        "rbit    synd, synd\n\t"
+        "clz     synd, synd\n\t"
+        "lsr     result, synd, 2\n\t"
+        "cmp     cntin, result\n\t"
+        "csel    result, cntin, result, ls\n\t"
+        "ret\n\t"
+
+        ".Lstrnlen_nomatch:\n\t"
+        "mov     result, cntin\n\t"
+        "ret\n\t"
+
+        ".Lstrnlen_start_loop:\n\t"
+        "sub     tmp, src, srcin\n\t"
+        "add     tmp, tmp, 17\n\t"
+        "subs    cntrem, cntin, tmp\n\t"
+        "b.lo    .Lstrnlen_nomatch\n\t"
+
+        /* Make sure that it won't overread by a 16-byte chunk */
+        "tbz     cntrem, 4, .Lstrnlen_loop32_2\n\t"
+        "sub     src, src, 16\n\t"
+        ".p2align 5\n\t"
+        ".Lstrnlen_loop32:\n\t"
+        "ldr     qdata, [src, 32]!\n\t"
+        "cmeq    vhas_chr.16b, vdata.16b, 0\n\t"
+        "umaxp   vend.16b, vhas_chr.16b, vhas_chr.16b\n\t" /* 128->64 */
+        "fmov    synd, dend\n\t"
+        "cbnz    synd, .Lstrnlen_end\n\t"
+        ".Lstrnlen_loop32_2:\n\t"
+        "ldr     qdata, [src, 16]\n\t"
+        "subs    cntrem, cntrem, 32\n\t"
+        "cmeq    vhas_chr.16b, vdata.16b, 0\n\t"
+        "b.lo    .Lstrnlen_end_2\n\t"
+        "umaxp   vend.16b, vhas_chr.16b, vhas_chr.16b\n\t" /* 128->64 */
+        "fmov    synd, dend\n\t"
+        "cbz     synd, .Lstrnlen_loop32\n\t"
+        ".Lstrnlen_end_2:\n\t"
+        "add     src, src, 16\n\t"
+        ".Lstrnlen_end:\n\t"
+        "shrn    vend.8b, vhas_chr.8h, 4\n\t" /* 128->64 */
+        "sub     result, src, srcin\n\t"
+        "fmov    synd, dend\n\t"
+        "rbit    synd, synd\n\t"
+        "clz     synd, synd\n\t"
+        "add     result, result, synd, lsr 2\n\t"
+        "cmp     cntin, result\n\t"
+        "csel    result, cntin, result, ls\n\t"
+        "ret\n\t"
+
+        ".unreq srcin\n\t"
+        ".unreq cntin\n\t"
+        ".unreq result\n\t"
+        ".unreq src\n\t"
+        ".unreq synd\n\t"
+        ".unreq shift\n\t"
+        ".unreq tmp\n\t"
+        ".unreq cntrem\n\t"
+        ".unreq qdata\n\t"
+        ".unreq vdata\n\t"
+        ".unreq vhas_chr\n\t"
+        ".unreq vend\n\t"
+        ".unreq dend"
+    );
+}
