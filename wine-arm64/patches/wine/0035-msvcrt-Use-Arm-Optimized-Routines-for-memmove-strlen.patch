+static __attribute__((naked, aligned(64))) int aor_strcmp( const char *str1, const char *str2 )
+{
+    asm(
+        /* Assumptions:
+         *
+         * ARMv8-a, AArch64.
+         * MTE compatible.
+         */
+
+        ".set REP8_01, 0x0101010101010101\n\t"
+        ".set REP8_7f, 0x7f7f7f7f7f7f7f7f\n\t"
+
+        "src1 .req x0\n\t"
+        "src2 .req x1\n\t"
+        "result .req x0\n\t"
+
+        "data1 .req x2\n\t"
+        "data1w .req w2\n\t"
+        "data2 .req x3\n\t"
+        "data2w .req w3\n\t"
+        "has_nul .req x4\n\t"
+        "diff .req x5\n\t"
+        "off1 .req x5\n\t"
+        "syndrome .req x6\n\t"
+        "tmp .req x6\n\t"
+        "data3 .req x7\n\t"
+        "zeroones .req x8\n\t"
+        "shift .req x9\n\t"
+        "off2 .req x10\n\t"
+
+        /* On big-endian early bytes are at MSB and on little-endian LSB.
+           LS_FW means shifting towards early bytes.  */
+
+        /* NUL detection works on the principle that (X - 1) & (~X) & 0x80
+           (=> (X - 1) & ~(X | 0x7f)) is non-zero iff a byte is zero, and
+           can be done in parallel across the entire word.
+           Since carry propagation makes 0x1 bytes before a NUL byte appear
+           NUL too in big-endian, byte-reverse the data before the NUL check.  */
+
+        "sub     off2, src2, src1\n\t"
+        "mov     zeroones, REP8_01\n\t"
+        "and     tmp, src1, 7\n\t"
+        "tst     off2, 7\n\t"
+        "b.ne    .Lstrcmp_misaligned8\n\t"
+        "cbnz    tmp, .Lstrcmp_mutual_align\n\t"
+
+        ".p2align 4\n\t"
+
+        ".Lstrcmp_loop_aligned:\n\t"
+        "ldr     data2, [src1, off2]\n\t"
+        "ldr     data1, [src1], 8\n\t"
+        ".Lstrcmp_start_realigned:\n\t"
+        "sub     has_nul, data1, zeroones\n\t"
+        "orr     tmp, data1, REP8_7f\n\t"
+        "bics    has_nul, has_nul, tmp\n\t" /* Non-zero if NUL terminator.  */
+        "ccmp    data1, data2, 0, eq\n\t"
+        "b.eq    .Lstrcmp_loop_aligned\n\t"
+        "eor     diff, data1, data2\n\t"
+        "orr     syndrome, diff, has_nul\n\t"
+        ".Lstrcmp_end:\n\t"
+        "rev     syndrome, syndrome\n\t"
+        "rev     data1, data1\n\t"
+        "rev     data2, data2\n\t"
+        "clz     shift, syndrome\n\t"
+        /* The most-significant-non-zero bit of the syndrome marks either the
+           first bit that is different, or the top bit of the first zero byte.
+           Shifting left now will bring the critical information into the
+           top bits.  */
+        "lsl     data1, data1, shift\n\t"
+        "lsl     data2, data2, shift\n\t"
+        /* But we need to zero-extend (char is unsigned) the value and then
+           perform a signed 32-bit subtraction.  */
+        "lsr     data1, data1, 56\n\t"
+        "sub     result, data1, data2, lsr 56\n\t"
+        "ret\n\t"
+
+        ".p2align 4\n\t"
+
+        ".Lstrcmp_mutual_align:\n\t"
+        /* Sources are mutually aligned, but are not currently at an
+           alignment boundary.  Round down the addresses and then mask off
+           the bytes that precede the start point.  */
+        "bic     src1, src1, 7\n\t"
+        "ldr     data2, [src1, off2]\n\t"
+        "ldr     data1, [src1], 8\n\t"
+        "neg     shift, src2, lsl 3\n\t" /* Bits to alignment -64.  */
+        "mov     tmp, -1\n\t"
+        "lsr     tmp, tmp, shift\n\t"
+        "orr     data1, data1, tmp\n\t"
+        "orr     data2, data2, tmp\n\t"
+        "b       .Lstrcmp_start_realigned\n\t"
+
+        ".Lstrcmp_misaligned8:\n\t"
+        /* Align SRC1 to 8 bytes and then compare 8 bytes at a time, always
+           checking to make sure that we don't access beyond the end of SRC2.  */
+        "cbz     tmp, .Lstrcmp_src1_aligned\n\t"
+        ".Lstrcmp_do_misaligned:\n\t"
+        "ldrb    data1w, [src1], 1\n\t"
+        "ldrb    data2w, [src2], 1\n\t"
+        "cmp     data1w, 0\n\t"
+        "ccmp    data1w, data2w, 0, ne\n\t" /* NZCV = 0b0000.  */
+        "b.ne    .Lstrcmp_done\n\t"
+        "tst     src1, 7\n\t"
+        "b.ne    .Lstrcmp_do_misaligned\n\t"
+
+        ".Lstrcmp_src1_aligned:\n\t"
+        "neg     shift, src2, lsl 3\n\t"
+        "bic     src2, src2, 7\n\t"
+        "ldr     data3, [src2], 8\n\t"
+        "lsr     tmp, zeroones, shift\n\t"
+        "orr     data3, data3, tmp\n\t"
+        "sub     has_nul, data3, zeroones\n\t"
+        "orr     tmp, data3, REP8_7f\n\t"
+        "bics    has_nul, has_nul, tmp\n\t"
+        "b.ne    .Lstrcmp_tail\n\t"
+
+        "sub     off1, src2, src1\n\t"
+
+        ".p2align 4\n\t"
+
+        ".Lstrcmp_loop_unaligned:\n\t"
+        "ldr     data3, [src1, off1]\n\t"
+        "ldr     data2, [src1, off2]\n\t"
+        "sub     has_nul, data3, zeroones\n\t"
+        "orr     tmp, data3, REP8_7f\n\t"
+        "ldr     data1, [src1], 8\n\t"
+        "bics    has_nul, has_nul, tmp\n\t"
+        "ccmp    data1, data2, 0, eq\n\t"
+        "b.eq    .Lstrcmp_loop_unaligned\n\t"
+
+        "lsl     tmp, has_nul, shift\n\t"
+        "eor     diff, data1, data2\n\t"
+        "orr     syndrome, diff, tmp\n\t"
+        "cbnz    syndrome, .Lstrcmp_end\n\t"
+        ".Lstrcmp_tail:\n\t"
+        "ldr     data1, [src1]\n\t"
+        "neg     shift, shift\n\t"
+        "lsr     data2, data3, shift\n\t"
+        "lsr     has_nul, has_nul, shift\n\t"
+        "eor     diff, data1, data2\n\t"
+        "orr     syndrome, diff, has_nul\n\t"
+        "b       .Lstrcmp_end\n\t"
+
+        ".Lstrcmp_done:\n\t"
+        "sub     result, data1, data2\n\t"
+        "ret\n\t"
+
+        ".unreq src1\n\t"
+        ".unreq src2\n\t"
+        ".unreq result\n\t"
+        ".unreq data1\n\t"
+        ".unreq data1w\n\t"
+        ".unreq data2\n\t"
+        ".unreq data2w\n\t"
+        ".unreq has_nul\n\t"
+        ".unreq diff\n\t"
+        ".unreq off1\n\t"
+        ".unreq syndrome\n\t"
+        ".unreq tmp\n\t"
+        ".unreq data3\n\t"
+        ".unreq zeroones\n\t"
+        ".unreq shift\n\t"
+        ".unreq off2"
+    );
+}
+
+static __attribute__((naked, aligned(64))) void *aor_memchr( const void *ptr, int c, size_t n )
+{
+    asm(
+        /* Assumptions:
+         *
+         * ARMv8-a, AArch64
+         * Neon Available.
+         */
+
+        /* Arguments and results.  */
+        "srcin .req x0\n\t"
+        "chrin .req w1\n\t"
+        "cntin .req x2\n\t"
+
+        "result .req x0\n\t"
+
+        "src .req x3\n\t"
+        "tmp .req x4\n\t"
+        "wtmp2 .req w5\n\t"
+        "synd .req x6\n\t"
+        "soff .req x9\n\t"
+        "cntrem .req x10\n\t"
+
+        "vrepchr .req v0\n\t"
+        "vdata1 .req v1\n\t"
+        "vdata2 .req v2\n\t"
+        "vhas_chr1 .req v3\n\t"
+        "vhas_chr2 .req v4\n\t"
+        "vrepmask .req v5\n\t"
+        "vend .req v6\n\t"
+
+        /*
+         * Core algorithm:
+         *
+         * For each 32-byte chunk we calculate a 64-bit syndrome value, with two bits
+         * per byte. For each tuple, bit 0 is set if the relevant byte matched the
+         * requested character and bit 1 is not used (faster than using a 32bit
+         * syndrome). Since the bits in the syndrome reflect exactly the order in which
+         * things occur in the original string, counting trailing zeros allows to
+         * identify exactly which byte has matched.
+         */
+
+        /* Do not dereference srcin if no bytes to compare.  */
+        "cbz     cntin, .Lmemchr_zero_length\n\t"
+        /*
+         * Magic constant 0x40100401 allows us to identify which lane matches
+         * the requested byte.
+         */
+        "mov     wtmp2, #0x0401\n\t"
+        "movk    wtmp2, #0x4010, lsl #16\n\t"
+        "dup     vrepchr.16b, chrin\n\t"
+        /* Work with aligned 32-byte chunks */
+        "bic     src, srcin, #31\n\t"
+        "dup     vrepmask.4s, wtmp2\n\t"
+        "ands    soff, srcin, #31\n\t"
+        "and     cntrem, cntin, #31\n\t"
+        "b.eq    .Lmemchr_loop\n\t"
+
+        /*
+         * Input string is not 32-byte aligned. We calculate the syndrome
+         * value for the aligned 32 bytes block containing the first bytes
+         * and mask the irrelevant part.
+         */
+
+        "ld1     {vdata1.16b, vdata2.16b}, [src], #32\n\t"
+        "sub     tmp, soff, #32\n\t"
+        "adds    cntin, cntin, tmp\n\t"
+        "cmeq    vhas_chr1.16b, vdata1.16b, vrepchr.16b\n\t"
+        "cmeq    vhas_chr2.16b, vdata2.16b, vrepchr.16b\n\t"
+        "and     vhas_chr1.16b, vhas_chr1.16b, vrepmask.16b\n\t"
+        "and     vhas_chr2.16b, vhas_chr2.16b, vrepmask.16b\n\t"
+        "addp    vend.16b, vhas_chr1.16b, vhas_chr2.16b\n\t" /* 256->128 */
+        "addp    vend.16b, vend.16b, vend.16b\n\t" /* 128->64 */
+        "mov     synd, vend.d[0]\n\t"
+        /* Clear the soff*2 lower bits */
+        "lsl     tmp, soff, #1\n\t"
+        "lsr     synd, synd, tmp\n\t"
+        "lsl     synd, synd, tmp\n\t"
+        /* The first block can also be the last */
+        "b.ls    .Lmemchr_masklast\n\t"
+        /* Have we found something already? */
+        "cbnz    synd, .Lmemchr_tail\n\t"
+
+        ".Lmemchr_loop:\n\t"
+        "ld1     {vdata1.16b, vdata2.16b}, [src], #32\n\t"
+        "subs    cntin, cntin, #32\n\t"
+        "cmeq    vhas_chr1.16b, vdata1.16b, vrepchr.16b\n\t"
+        "cmeq    vhas_chr2.16b, vdata2.16b, vrepchr.16b\n\t"
+        /* If we're out of data we finish regardless of the result */
+        "b.ls    .Lmemchr_end\n\t"
+        /* Use a fast check for the termination condition */
+        "orr     vend.16b, vhas_chr1.16b, vhas_chr2.16b\n\t"
+        "addp    vend.2d, vend.2d, vend.2d\n\t"
+        "mov     synd, vend.d[0]\n\t"
+        /* We're not out of data, loop if we haven't found the character */
+        "cbz     synd, .Lmemchr_loop\n\t"
+
+        ".Lmemchr_end:\n\t"
+        /* Termination condition found, let's calculate the syndrome value */
+        "and     vhas_chr1.16b, vhas_chr1.16b, vrepmask.16b\n\t"
+        "and     vhas_chr2.16b, vhas_chr2.16b, vrepmask.16b\n\t"
+        "addp    vend.16b, vhas_chr1.16b, vhas_chr2.16b\n\t" /* 256->128 */
+        "addp    vend.16b, vend.16b, vend.16b\n\t" /* 128->64 */
+        "mov     synd, vend.d[0]\n\t"
+        /* Only do the clear for the last possible block */
+        "b.hs    .Lmemchr_tail\n\t"
+
+        ".Lmemchr_masklast:\n\t"
+        /* Clear the (32 - ((cntrem + soff) % 32)) * 2 upper bits */
+        "add     tmp, cntrem, soff\n\t"
+        "and     tmp, tmp, #31\n\t"
+        "sub     tmp, tmp, #32\n\t"
+        "neg     tmp, tmp, lsl #1\n\t"
+        "lsl     synd, synd, tmp\n\t"
+        "lsr     synd, synd, tmp\n\t"
+
+        ".Lmemchr_tail:\n\t"
+        /* Count the trailing zeros using bit reversing */
+        "rbit    synd, synd\n\t"
+        /* Compensate the last post-increment */
+        "sub     src, src, #32\n\t"
+        /* Check that we have found a character */
+        "cmp     synd, #0\n\t"
+        /* And count the leading zeros */
+        "clz     synd, synd\n\t"
+        /* Compute the potential result */
+        "add     result, src, synd, lsr #1\n\t"
+        /* Select result or NULL */
+        "csel    result, xzr, result, eq\n\t"
+        "ret\n\t"
+
+        ".Lmemchr_zero_length:\n\t"
+        "mov     result, #0\n\t"
+        "ret\n\t"
+
+        ".unreq srcin\n\t"
+        ".unreq chrin\n\t"
+        ".unreq cntin\n\t"
+        ".unreq result\n\t"
+        ".unreq src\n\t"
+        ".unreq tmp\n\t"
+        ".unreq wtmp2\n\t"
+        ".unreq synd\n\t"
+        ".unreq soff\n\t"
+        ".unreq cntrem\n\t"
+        ".unreq vrepchr\n\t"
+        ".unreq vdata1\n\t"
+        ".unreq vdata2\n\t"
+        ".unreq vhas_chr1\n\t"
+        ".unreq vhas_chr2\n\t"
+        ".unreq vrepmask\n\t"
+        ".unreq vend"
+    );
+}
+
+#endif /* __aarch64__ || __arm64ec__ */
