From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Sat, 10 Oct 2026 10:35:24 -0400
Subject: [PATCH] msvcrt: Use Arm Optimized Routines for memmove, strlen,
 strnlen, strchr, strrchr, strcmp and memchr on ARM64.

On ARM64 and ARM64EC these were byte loops, and memmove a scalar shift-merge for mutually misaligned copies with
scalar heads and tails. They become Arm's AdvSIMD routines, 16-32 bytes a step: memcpy-advsimd.S (memmove, which
memcpy calls), strlen.S, strnlen.S, strchr-mte.S, strrchr-mte.S, strcmp.S and memchr.S from Arm Optimized Routines
v26.07 (commit 4be260a5117480382690c6d8c300bc784e927d76), taken under MIT out of upstream's MIT OR Apache-2.0 WITH
LLVM-exception; the notice and the list of changes are in dlls/msvcrt/aor_string.h. msvcrt, ucrtbase and msvcr80-120
build string.c, so all of them get the routines.

Each routine is the body of a static naked helper, transcribed mechanically (register #defines as .req aliases,
L(x) as per-routine local labels, the little-endian production branches, ENTRY's 64-byte alignment as aligned(64)).
The exported C functions call the helpers, so ARM64EC keeps the entry thunks the compiler makes for the exports and x64
callers enter through them. For ARM64EC, which can't use x13, x14, x23, x24, x28 or v16-v31 (an x64 context can't
hold them): memcpy-advsimd.S's tmp1 is x11 instead of x14, and strchr and strrchr are the -mte versions, which use
v0-v5 only. No SEH directives: a .p2align inside .seh_proc breaks llvm-mingw's unwind emitter, and these leaf
routines touch neither sp nor lr. strcmp still answers -1/0/1 (AOR's strcmp returns the byte difference).

Ours and stays local.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 dlls/msvcrt/aor_string.h | 1138 ++++++++++++++++++++++++++++++++++++++
 dlls/msvcrt/string.c     |   28 +
 2 files changed, 1166 insertions(+)
 create mode 100644 dlls/msvcrt/aor_string.h

diff --git a/dlls/msvcrt/aor_string.h b/dlls/msvcrt/aor_string.h
new file mode 100644
index 00000000..a2528845
--- /dev/null
+++ b/dlls/msvcrt/aor_string.h
@@ -0,0 +1,1138 @@
+/*
+ * ARM64 and ARM64EC string routines for msvcrt from Arm Optimized Routines
+ *
+ * SPDX-License-Identifier: MIT
+ *
+ * From https://github.com/ARM-software/optimized-routines, tag v26.07, commit
+ * 4be260a5117480382690c6d8c300bc784e927d76: string/aarch64/memcpy-advsimd.S, strlen.S, strnlen.S,
+ * strchr-mte.S, strrchr-mte.S, strcmp.S and memchr.S. Upstream offers MIT OR Apache-2.0 WITH
+ * LLVM-exception; taken under MIT. The files carry:
+ *
+ * Copyright (c) 2019-2023, Arm Limited.    (memcpy-advsimd.S)
+ * Copyright (c) 2020-2022, Arm Limited.    (strlen.S, strnlen.S, strchr-mte.S)
+ * Copyright (c) 2020-2023, Arm Limited.    (strrchr-mte.S)
+ * Copyright (c) 2012-2022, Arm Limited.    (strcmp.S)
+ * Copyright (c) 2014-2022, Arm Limited.    (memchr.S)
+ *
+ * Permission is hereby granted, free of charge, to any person obtaining a copy
+ * of this software and associated documentation files (the "Software"), to deal
+ * in the Software without restriction, including without limitation the rights
+ * to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
+ * copies of the Software, and to permit persons to whom the Software is
+ * furnished to do so, subject to the following conditions:
+ *
+ * The above copyright notice and this permission notice shall be included in all
+ * copies or substantial portions of the Software.
+ *
+ * THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
+ * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+ * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
+ * AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+ * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
+ * OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
+ * SOFTWARE.
+ *
+ * Changes, made mechanically:
+ * - Each routine is the body of one static naked C helper, a single asm statement; string.c's
+ *   exported C functions call the helpers, so ARM64EC keeps the entry thunks the compiler makes
+ *   for those exports. memcpy-advsimd.S's entry is the helper for memmove (memcpy calls memmove).
+ * - Register #defines are .req aliases, dropped with .unreq at the helper's end; constant #defines
+ *   are .set; L(x) is .L<routine>_x, as the helpers share one assembly file.
+ * - The little-endian, production branches only: no __AARCH64EB__ code, LS_FW is lsr, and
+ *   MIN_PAGE_SIZE is 4096 (no TEST_PAGE_CROSS).
+ * - ENTRY, ENTRY_ALIAS, END, the .cfi directives, BTI and asmdefs.h are gone; ENTRY's 64-byte
+ *   alignment, which the padding nops assume, is the helpers' aligned(64). Every instruction and
+ *   .p2align is kept.
+ * - memcpy-advsimd.S's tmp1 is x11, not x14: ARM64EC code can't use x13, x14, x23, x24, x28 or
+ *   v16-v31, which an x64 context can't hold. strchr and strrchr are the -mte versions, which use
+ *   v0-v5 only.
+ * - No SEH unwind directives: these are leaf routines that touch neither sp nor lr.
+ */
+
+#if defined(__aarch64__) || defined(__arm64ec__)
+
+static __attribute__((naked, aligned(64))) void *aor_memmove( void *dst, const void *src, size_t n )
+{
+    asm(
+        /* Assumptions:
+         *
+         * ARMv8-a, AArch64, Advanced SIMD, unaligned accesses.
+         *
+         */
+
+        "dstin .req x0\n\t"
+        "src .req x1\n\t"
+        "count .req x2\n\t"
+        "dst .req x3\n\t"
+        "srcend .req x4\n\t"
+        "dstend .req x5\n\t"
+        "A_l .req x6\n\t"
+        "A_lw .req w6\n\t"
+        "A_h .req x7\n\t"
+        "B_l .req x8\n\t"
+        "B_lw .req w8\n\t"
+        "B_h .req x9\n\t"
+        "C_lw .req w10\n\t"
+        "tmp1 .req x11\n\t"
+
+        "A_q .req q0\n\t"
+        "B_q .req q1\n\t"
+        "C_q .req q2\n\t"
+        "D_q .req q3\n\t"
+        "E_q .req q4\n\t"
+        "F_q .req q5\n\t"
+        "G_q .req q6\n\t"
+        "H_q .req q7\n\t"
+
+        /* This implementation handles overlaps and supports both memcpy and memmove
+           from a single entry point.  It uses unaligned accesses and branchless
+           sequences to keep the code small, simple and improve performance.
+
+           Copies are split into 3 main cases: small copies of up to 32 bytes, medium
+           copies of up to 128 bytes, and large copies.  The overhead of the overlap
+           check is negligible since it is only required for large copies.
+
+           Large copies use a software pipelined loop processing 64 bytes per iteration.
+           The source pointer is 16-byte aligned to minimize unaligned accesses.
+           The loop tail is handled by always copying 64 bytes from the end.
+        */
+
+        "add     srcend, src, count\n\t"
+        "cmp     count, 128\n\t"
+        "b.hi    .Lmemmove_copy_long\n\t"
+        "add     dstend, dstin, count\n\t"
+        "cmp     count, 32\n\t"
+        "b.hi    .Lmemmove_copy32_128\n\t"
+        "nop\n\t"
+
+        /* Small copies: 0..32 bytes.  */
+        "cmp     count, 16\n\t"
+        "b.lo    .Lmemmove_copy16\n\t"
+        "ldr     A_q, [src]\n\t"
+        "ldr     B_q, [srcend, -16]\n\t"
+        "str     A_q, [dstin]\n\t"
+        "str     B_q, [dstend, -16]\n\t"
+        "ret\n\t"
+
+        ".p2align 4\n\t"
+        /* Medium copies: 33..128 bytes.  */
+        ".Lmemmove_copy32_128:\n\t"
+        "ldp     A_q, B_q, [src]\n\t"
+        "ldp     C_q, D_q, [srcend, -32]\n\t"
+        "cmp     count, 64\n\t"
+        "b.hi    .Lmemmove_copy128\n\t"
+        "stp     A_q, B_q, [dstin]\n\t"
+        "stp     C_q, D_q, [dstend, -32]\n\t"
+        "ret\n\t"
+
+        ".p2align 4\n\t"
+        /* Copy 8-15 bytes.  */
+        ".Lmemmove_copy16:\n\t"
+        "tbz     count, 3, .Lmemmove_copy8\n\t"
+        "ldr     A_l, [src]\n\t"
+        "ldr     A_h, [srcend, -8]\n\t"
+        "str     A_l, [dstin]\n\t"
+        "str     A_h, [dstend, -8]\n\t"
+        "ret\n\t"
+
+        /* Copy 4-7 bytes.  */
+        ".Lmemmove_copy8:\n\t"
+        "tbz     count, 2, .Lmemmove_copy4\n\t"
+        "ldr     A_lw, [src]\n\t"
+        "ldr     B_lw, [srcend, -4]\n\t"
+        "str     A_lw, [dstin]\n\t"
+        "str     B_lw, [dstend, -4]\n\t"
+        "ret\n\t"
+
+        /* Copy 65..128 bytes.  */
+        ".Lmemmove_copy128:\n\t"
+        "ldp     E_q, F_q, [src, 32]\n\t"
+        "cmp     count, 96\n\t"
+        "b.ls    .Lmemmove_copy96\n\t"
+        "ldp     G_q, H_q, [srcend, -64]\n\t"
+        "stp     G_q, H_q, [dstend, -64]\n\t"
+        ".Lmemmove_copy96:\n\t"
+        "stp     A_q, B_q, [dstin]\n\t"
+        "stp     E_q, F_q, [dstin, 32]\n\t"
+        "stp     C_q, D_q, [dstend, -32]\n\t"
+        "ret\n\t"
+
+        /* Copy 0..3 bytes using a branchless sequence.  */
+        ".Lmemmove_copy4:\n\t"
+        "cbz     count, .Lmemmove_copy0\n\t"
+        "lsr     tmp1, count, 1\n\t"
+        "ldrb    A_lw, [src]\n\t"
+        "ldrb    C_lw, [srcend, -1]\n\t"
+        "ldrb    B_lw, [src, tmp1]\n\t"
+        "strb    A_lw, [dstin]\n\t"
+        "strb    B_lw, [dstin, tmp1]\n\t"
+        "strb    C_lw, [dstend, -1]\n\t"
+        ".Lmemmove_copy0:\n\t"
+        "ret\n\t"
+
+        ".p2align 3\n\t"
+        /* Copy more than 128 bytes.  */
+        ".Lmemmove_copy_long:\n\t"
+        "add     dstend, dstin, count\n\t"
+
+        /* Use backwards copy if there is an overlap.  */
+        "sub     tmp1, dstin, src\n\t"
+        "cmp     tmp1, count\n\t"
+        "b.lo    .Lmemmove_copy_long_backwards\n\t"
+
+        /* Copy 16 bytes and then align src to 16-byte alignment.  */
+        "ldr     D_q, [src]\n\t"
+        "and     tmp1, src, 15\n\t"
+        "bic     src, src, 15\n\t"
+        "sub     dst, dstin, tmp1\n\t"
+        "add     count, count, tmp1\n\t" /* Count is now 16 too large.  */
+        "ldp     A_q, B_q, [src, 16]\n\t"
+        "str     D_q, [dstin]\n\t"
+        "ldp     C_q, D_q, [src, 48]\n\t"
+        "subs    count, count, 128 + 16\n\t" /* Test and readjust count.  */
+        "b.ls    .Lmemmove_copy64_from_end\n\t"
+        ".Lmemmove_loop64:\n\t"
+        "stp     A_q, B_q, [dst, 16]\n\t"
+        "ldp     A_q, B_q, [src, 80]\n\t"
+        "stp     C_q, D_q, [dst, 48]\n\t"
+        "ldp     C_q, D_q, [src, 112]\n\t"
+        "add     src, src, 64\n\t"
+        "add     dst, dst, 64\n\t"
+        "subs    count, count, 64\n\t"
+        "b.hi    .Lmemmove_loop64\n\t"
+
+        /* Write the last iteration and copy 64 bytes from the end.  */
+        ".Lmemmove_copy64_from_end:\n\t"
+        "ldp     E_q, F_q, [srcend, -64]\n\t"
+        "stp     A_q, B_q, [dst, 16]\n\t"
+        "ldp     A_q, B_q, [srcend, -32]\n\t"
+        "stp     C_q, D_q, [dst, 48]\n\t"
+        "stp     E_q, F_q, [dstend, -64]\n\t"
+        "stp     A_q, B_q, [dstend, -32]\n\t"
+        "ret\n\t"
+
+        ".p2align 4\n\t"
+        "nop\n\t"
+
+        /* Large backwards copy for overlapping copies.
+           Copy 16 bytes and then align srcend to 16-byte alignment.  */
+        ".Lmemmove_copy_long_backwards:\n\t"
+        "cbz     tmp1, .Lmemmove_copy0\n\t"
+        "ldr     D_q, [srcend, -16]\n\t"
+        "and     tmp1, srcend, 15\n\t"
+        "bic     srcend, srcend, 15\n\t"
+        "sub     count, count, tmp1\n\t"
+        "ldp     A_q, B_q, [srcend, -32]\n\t"
+        "str     D_q, [dstend, -16]\n\t"
+        "ldp     C_q, D_q, [srcend, -64]\n\t"
+        "sub     dstend, dstend, tmp1\n\t"
+        "subs    count, count, 128\n\t"
+        "b.ls    .Lmemmove_copy64_from_start\n\t"
+
+        ".Lmemmove_loop64_backwards:\n\t"
+        "str     B_q, [dstend, -16]\n\t"
+        "str     A_q, [dstend, -32]\n\t"
+        "ldp     A_q, B_q, [srcend, -96]\n\t"
+        "str     D_q, [dstend, -48]\n\t"
+        "str     C_q, [dstend, -64]!\n\t"
+        "ldp     C_q, D_q, [srcend, -128]\n\t"
+        "sub     srcend, srcend, 64\n\t"
+        "subs    count, count, 64\n\t"
+        "b.hi    .Lmemmove_loop64_backwards\n\t"
+
+        /* Write the last iteration and copy 64 bytes from the start.  */
+        ".Lmemmove_copy64_from_start:\n\t"
+        "ldp     E_q, F_q, [src, 32]\n\t"
+        "stp     A_q, B_q, [dstend, -32]\n\t"
+        "ldp     A_q, B_q, [src]\n\t"
+        "stp     C_q, D_q, [dstend, -64]\n\t"
+        "stp     E_q, F_q, [dstin, 32]\n\t"
+        "stp     A_q, B_q, [dstin]\n\t"
+        "ret\n\t"
+
+        ".unreq dstin\n\t"
+        ".unreq src\n\t"
+        ".unreq count\n\t"
+        ".unreq dst\n\t"
+        ".unreq srcend\n\t"
+        ".unreq dstend\n\t"
+        ".unreq A_l\n\t"
+        ".unreq A_lw\n\t"
+        ".unreq A_h\n\t"
+        ".unreq B_l\n\t"
+        ".unreq B_lw\n\t"
+        ".unreq B_h\n\t"
+        ".unreq C_lw\n\t"
+        ".unreq tmp1\n\t"
+        ".unreq A_q\n\t"
+        ".unreq B_q\n\t"
+        ".unreq C_q\n\t"
+        ".unreq D_q\n\t"
+        ".unreq E_q\n\t"
+        ".unreq F_q\n\t"
+        ".unreq G_q\n\t"
+        ".unreq H_q"
+    );
+}
+
+static __attribute__((naked, aligned(64))) size_t aor_strlen( const char *str )
+{
+    asm(
+        /* Assumptions:
+         *
+         * ARMv8-a, AArch64, Advanced SIMD, unaligned accesses.
+         * Not MTE compatible.
+         */
+
+        "srcin .req x0\n\t"
+        "len .req x0\n\t"
+
+        "src .req x1\n\t"
+        "data1 .req x2\n\t"
+        "data2 .req x3\n\t"
+        "has_nul1 .req x4\n\t"
+        "has_nul2 .req x5\n\t"
+        "tmp1 .req x4\n\t"
+        "tmp2 .req x5\n\t"
+        "tmp3 .req x6\n\t"
+        "tmp4 .req x7\n\t"
+        "zeroones .req x8\n\t"
+
+        "maskv .req v0\n\t"
+        "maskd .req d0\n\t"
+        "dataq1 .req q1\n\t"
+        "dataq2 .req q2\n\t"
+        "datav1 .req v1\n\t"
+        "datav2 .req v2\n\t"
+        "tmp .req x2\n\t"
+        "tmpw .req w2\n\t"
+        "synd .req x3\n\t"
+        "syndw .req w3\n\t"
+        "shift .req x4\n\t"
+
+        /* For the first 32 bytes, NUL detection works on the principle that
+           (X - 1) & (~X) & 0x80 (=> (X - 1) & ~(X | 0x7f)) is non-zero if a
+           byte is zero, and can be done in parallel across the entire word.  */
+
+        ".set REP8_01, 0x0101010101010101\n\t"
+        ".set REP8_7f, 0x7f7f7f7f7f7f7f7f\n\t"
+
+        /* To test the page crossing code path more thoroughly, compile with
+           -DTEST_PAGE_CROSS - this will force all calls through the slower
+           entry path.  This option is not intended for production use.  */
+
+        ".set MIN_PAGE_SIZE, 4096\n\t"
+
+        /* Core algorithm:
+
+           Since strings are short on average, we check the first 32 bytes of the
+           string for a NUL character without aligning the string.  In order to use
+           unaligned loads safely we must do a page cross check first.
+
+           If there is a NUL byte we calculate the length from the 2 8-byte words
+           using conditional select to reduce branch mispredictions (it is unlikely
+           strlen will be repeatedly called on strings with the same length).
+
+           If the string is longer than 32 bytes, align src so we don't need further
+           page cross checks, and process 32 bytes per iteration using a fast SIMD
+           loop.
+
+           If the page cross check fails, we read 32 bytes from an aligned address,
+           and ignore any characters before the string.  If it contains a NUL
+           character, return the length, if not, continue in the main loop.  */
+
+        "and     tmp1, srcin, MIN_PAGE_SIZE - 1\n\t"
+        "cmp     tmp1, MIN_PAGE_SIZE - 32\n\t"
+        "b.hi    .Lstrlen_page_cross\n\t"
+
+        /* Look for a NUL byte in the first 16 bytes.  */
+        "ldp     data1, data2, [srcin]\n\t"
+        "mov     zeroones, REP8_01\n\t"
+
+        "sub     tmp1, data1, zeroones\n\t"
+        "orr     tmp2, data1, REP8_7f\n\t"
+        "sub     tmp3, data2, zeroones\n\t"
+        "orr     tmp4, data2, REP8_7f\n\t"
+        "bics    has_nul1, tmp1, tmp2\n\t"
+        "bic     has_nul2, tmp3, tmp4\n\t"
+        "ccmp    has_nul2, 0, 0, eq\n\t"
+        "b.eq    .Lstrlen_bytes16_31\n\t"
+
+        /* Find the exact offset of the first NUL byte in the first 16 bytes
+           from the string start.  Enter with C = has_nul1 == 0.  */
+        "csel    has_nul1, has_nul1, has_nul2, cc\n\t"
+        "mov     len, 8\n\t"
+        "rev     has_nul1, has_nul1\n\t"
+        "csel    len, xzr, len, cc\n\t"
+        "clz     tmp1, has_nul1\n\t"
+        "add     len, len, tmp1, lsr 3\n\t"
+        "ret\n\t"
+
+        /* Look for a NUL byte at offset 16..31 in the string.  */
+        ".Lstrlen_bytes16_31:\n\t"
+        "ldp     data1, data2, [srcin, 16]\n\t"
+        "sub     tmp1, data1, zeroones\n\t"
+        "orr     tmp2, data1, REP8_7f\n\t"
+        "sub     tmp3, data2, zeroones\n\t"
+        "orr     tmp4, data2, REP8_7f\n\t"
+        "bics    has_nul1, tmp1, tmp2\n\t"
+        "bic     has_nul2, tmp3, tmp4\n\t"
+        "ccmp    has_nul2, 0, 0, eq\n\t"
+        "b.eq    .Lstrlen_loop_entry\n\t"
+
+        /* Find the exact offset of the first NUL byte at offset 16..31 from
+           the string start.  Enter with C = has_nul1 == 0.  */
+        "csel    has_nul1, has_nul1, has_nul2, cc\n\t"
+        "mov     len, 24\n\t"
+        "rev     has_nul1, has_nul1\n\t"
+        "mov     tmp3, 16\n\t"
+        "clz     tmp1, has_nul1\n\t"
+        "csel    len, tmp3, len, cc\n\t"
+        "add     len, len, tmp1, lsr 3\n\t"
+        "ret\n\t"
+
+        "nop\n\t"
+        ".Lstrlen_loop_entry:\n\t"
+        "bic     src, srcin, 31\n\t"
+
+        ".p2align 5\n\t"
+        ".Lstrlen_loop:\n\t"
+        "ldp     dataq1, dataq2, [src, 32]!\n\t"
+        "uminp   maskv.16b, datav1.16b, datav2.16b\n\t"
+        "uminp   maskv.16b, maskv.16b, maskv.16b\n\t"
+        "cmeq    maskv.8b, maskv.8b, 0\n\t"
+        "fmov    synd, maskd\n\t"
+        "cbz     synd, .Lstrlen_loop\n\t"
+
+        /* Low 32 bits of synd are non-zero if a NUL was found in datav1.  */
+        "cmeq    maskv.16b, datav1.16b, 0\n\t"
+        "sub     len, src, srcin\n\t"
+        "cbnz    syndw, 1f\n\t"
+        "cmeq    maskv.16b, datav2.16b, 0\n\t"
+        "add     len, len, 16\n\t"
+        "1:\n\t"
+        /* Generate a bitmask and compute correct byte offset.  */
+        "shrn    maskv.8b, maskv.8h, 4\n\t"
+        "fmov    synd, maskd\n\t"
+        "rbit    synd, synd\n\t"
+        "clz     tmp, synd\n\t"
+        "add     len, len, tmp, lsr 2\n\t"
+        "ret\n\t"
+
+        ".Lstrlen_page_cross:\n\t"
+        "bic     src, srcin, 31\n\t"
+        "mov     tmpw, 0x0c03\n\t"
+        "movk    tmpw, 0xc030, lsl 16\n\t"
+        "ld1     {datav1.16b, datav2.16b}, [src]\n\t"
+        "dup     maskv.4s, tmpw\n\t"
+        "cmeq    datav1.16b, datav1.16b, 0\n\t"
+        "cmeq    datav2.16b, datav2.16b, 0\n\t"
+        "and     datav1.16b, datav1.16b, maskv.16b\n\t"
+        "and     datav2.16b, datav2.16b, maskv.16b\n\t"
+        "addp    maskv.16b, datav1.16b, datav2.16b\n\t"
+        "addp    maskv.16b, maskv.16b, maskv.16b\n\t"
+        "fmov    synd, maskd\n\t"
+        "lsl     shift, srcin, 1\n\t"
+        "lsr     synd, synd, shift\n\t"
+        "cbz     synd, .Lstrlen_loop\n\t"
+
+        "rbit    synd, synd\n\t"
+        "clz     len, synd\n\t"
+        "lsr     len, len, 1\n\t"
+        "ret\n\t"
+
+        ".unreq srcin\n\t"
+        ".unreq len\n\t"
+        ".unreq src\n\t"
+        ".unreq data1\n\t"
+        ".unreq data2\n\t"
+        ".unreq has_nul1\n\t"
+        ".unreq has_nul2\n\t"
+        ".unreq tmp1\n\t"
+        ".unreq tmp2\n\t"
+        ".unreq tmp3\n\t"
+        ".unreq tmp4\n\t"
+        ".unreq zeroones\n\t"
+        ".unreq maskv\n\t"
+        ".unreq maskd\n\t"
+        ".unreq dataq1\n\t"
+        ".unreq dataq2\n\t"
+        ".unreq datav1\n\t"
+        ".unreq datav2\n\t"
+        ".unreq tmp\n\t"
+        ".unreq tmpw\n\t"
+        ".unreq synd\n\t"
+        ".unreq syndw\n\t"
+        ".unreq shift"
+    );
+}
