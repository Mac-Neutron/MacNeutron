From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Tue, 6 Oct 2026 13:59:16 -0400
Subject: [PATCH] libxess: Make the MetalFX upscaler at the first Execute.

Init has no texture formats, so the upscaler it made was a guess
(RGBA16F colour and output) that Unreal's R11G11B10 never matched: the
first Execute made another, and on a MetalFX that never frees one the
guess cost ~13 ms and ~230 MB per process. Init now only checks the
call and releases a live context's old upscaler; the first Execute
makes one from the game's textures.

An Execute the bridge refuses records nothing: the missing depth is
sized from the colour texture for the checks, and the far-plane depth
is made and cleared only after them, once the command list is known to
be DXMT's. DXMT's own refusal of the upscale comes after it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 dlls/libxess/d3d12.c | 66 +++++++++++++++++++-------------------------
 1 file changed, 28 insertions(+), 38 deletions(-)

diff --git a/dlls/libxess/d3d12.c b/dlls/libxess/d3d12.c
index 45314fbb..a21938bf 100644
--- a/dlls/libxess/d3d12.c
+++ b/dlls/libxess/d3d12.c
@@ -126,6 +126,7 @@ static void release_scaler(struct xess_d3d12 *ctx)
 {
     if (ctx->scaler) IMTLD3D12TemporalScaler_Release(ctx->scaler);
     ctx->scaler = NULL;
+    memset(&ctx->scaler_desc, 0, sizeof(ctx->scaler_desc));
 }
 
 static void release_depth(struct xess_d3d12 *ctx)
@@ -266,16 +267,14 @@ xess_result_t CDECL d3d12_get_pipeline_build_status(xess_context_handle_t handle
     return unlock_context(ctx, ctx->built ? XESS_RESULT_SUCCESS : XESS_RESULT_ERROR_WRONG_CALL_ORDER, "");
 }
 
-/* XeSS's Init has no texture formats: the upscaler is made for the usual ones (the mode's optimal
- * input, RGBA16F colour and output, D32 depth, RG16F motion vectors), and Execute makes another
- * if the game's textures differ. One that can't be made fails Init; Unreal then uses its own AA. */
+/* XeSS's Init has no texture formats: it checks the call, and the first Execute makes the upscaler
+ * from the game's textures (Ruling 17: a guess here missed Unreal's R11G11B10 and cost ~13 ms and,
+ * on a MetalFX that never frees one, ~230 MB). A re-Init releases the one it replaces. */
 static xess_result_t init(struct xess_d3d12 *ctx, const xess_d3d12_init_params_t *params, char *msg)
 {
-    static LONG logged, bad_flags, bad_size, failed;
-    MTL_TEMPORAL_SCALER_D3D12_DESC desc = {0};
+    static LONG logged, bad_flags, bad_size;
     uint32_t flags;
     xess_2d_t in;
-    HRESULT hr;
 
     if (!params) return XESS_RESULT_ERROR_INVALID_ARGUMENT;
     flags = params->initFlags;
@@ -297,27 +296,7 @@ static xess_result_t init(struct xess_d3d12 *ctx, const xess_d3d12_init_params_t
     /* re-initialised (a resolution or quality change): the old upscaler goes now */
     release_scaler(ctx);
     release_depth(ctx);
-    ctx->initialized = FALSE;
     ctx->init = *params;
-    desc.InputWidth = in.x;
-    desc.InputHeight = in.y;
-    desc.OutputWidth = params->outputResolution.x;
-    desc.OutputHeight = params->outputResolution.y;
-    desc.ColorFormat = desc.OutputFormat = DXGI_FORMAT_R16G16B16A16_FLOAT;
-    desc.DepthFormat = DXGI_FORMAT_D32_FLOAT;
-    desc.MotionFormat = DXGI_FORMAT_R16G16_FLOAT;
-    desc.ReactiveMaskFormat = DXGI_FORMAT_UNKNOWN;
-    desc.AutoExposure = !!(flags & XESS_INIT_FLAG_ENABLE_AUTOEXPOSURE);
-    desc.OutputResolutionMotionVectors = !!(flags & XESS_INIT_FLAG_HIGH_RES_MV);
-    desc.JitteredMotionVectors = !!(flags & XESS_INIT_FLAG_JITTERED_MV);
-    if (FAILED(hr = IMTLD3D12DeviceExt_CreateTemporalScaler(ctx->ext, &desc, &ctx->scaler)))
-    {
-        ctx->scaler = NULL;
-        once(&failed, msg, "xessD3D12Init: no MetalFX upscaler for %ux%u to %ux%u: %#lx", in.x, in.y,
-             desc.OutputWidth, desc.OutputHeight, hr);
-        return XESS_RESULT_ERROR_DEVICE_OUT_OF_MEMORY;
-    }
-    ctx->scaler_desc = desc;
     ctx->initialized = TRUE;
     return XESS_RESULT_SUCCESS;
 }
@@ -433,15 +412,20 @@ static xess_result_t execute(struct xess_d3d12 *ctx, ID3D12GraphicsCommandList *
     }
     reactive = flags & XESS_INIT_FLAG_RESPONSIVE_PIXEL_MASK ? p->pResponsivePixelMaskTexture : NULL;
     extent(p->pColorTexture, &color, p->inputColorBase.x, p->inputColorBase.y, &cw, &ch);
-    if ((depth_texture = p->pDepthTexture)) depth_base = p->inputDepthBase;
-    else if ((depth_texture = far_depth(ctx, list, &color, &hr))) depth_base = p->inputColorBase;
+    if ((depth_texture = p->pDepthTexture))
+    {
+        depth_base = p->inputDepthBase;
+        extent(depth_texture, &depth, depth_base.x, depth_base.y, &dw, &dh);
+    }
     else
     {
-        once(&no_depth, msg, "xessD3D12Execute: no depth texture like the colour's (%ux%u): %#lx", (UINT)color.Width,
-             color.Height, hr);
-        return result_of(hr);
+        /* far_depth's, made once nothing can refuse the call: as large as the colour, read at its base */
+        depth_base = p->inputColorBase;
+        depth = color;
+        depth.Format = DXGI_FORMAT_D32_FLOAT;
+        dw = cw;
+        dh = ch;
     }
-    extent(depth_texture, &depth, depth_base.x, depth_base.y, &dw, &dh);
     extent(p->pVelocityTexture, &motion, p->inputMotionVectorBase.x, p->inputMotionVectorBase.y, &mw, &mh);
     output = ID3D12Resource_GetDesc(p->pOutputTexture);
     if (reactive)
@@ -505,6 +489,18 @@ static xess_result_t execute(struct xess_d3d12 *ctx, ID3D12GraphicsCommandList *
         }
         ctx->scaler_desc = want;
     }
+    if (FAILED(hr = ID3D12GraphicsCommandList_QueryInterface(list, &IID_IMTLD3D12CommandListExt, (void **)&ext)))
+    {
+        once(&foreign, msg, "xessD3D12Execute: command list %p isn't DXMT's: %#lx", list, hr);
+        return result_of(hr);
+    }
+    if (!depth_texture && !(depth_texture = far_depth(ctx, list, &color, &hr)))
+    {
+        IMTLD3D12CommandListExt_Release(ext);
+        once(&no_depth, msg, "xessD3D12Execute: no depth texture like the colour's (%ux%u): %#lx", (UINT)color.Width,
+             color.Height, hr);
+        return result_of(hr);
+    }
 
     d.Color = p->pColorTexture;
     d.Depth = depth_texture;
@@ -543,12 +539,6 @@ static xess_result_t execute(struct xess_d3d12 *ctx, ID3D12GraphicsCommandList *
     d.PreExposure = flags & XESS_INIT_FLAG_EXPOSURE_SCALE_TEXTURE ? 0.0f : p->exposureScale;
     d.Reset = !!p->resetHistory;
     d.DepthReversed = !!(flags & XESS_INIT_FLAG_INVERTED_DEPTH);
-
-    if (FAILED(hr = ID3D12GraphicsCommandList_QueryInterface(list, &IID_IMTLD3D12CommandListExt, (void **)&ext)))
-    {
-        once(&foreign, msg, "xessD3D12Execute: command list %p isn't DXMT's: %#lx", list, hr);
-        return result_of(hr);
-    }
     hr = IMTLD3D12CommandListExt_TemporalUpscale(ext, ctx->scaler, &d);
     IMTLD3D12CommandListExt_Release(ext);
     if ((ret = result_of(hr)))
-- 
2.54.0 (Apple Git-157)

