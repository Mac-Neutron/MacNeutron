From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Mon, 19 Oct 2026 16:24:35 -0400
Subject: [PATCH] ntdll: Read WINEDEBUG before init_startup_info drops argv[0].

start_main_thread called init_startup_info, whose rebuild_argv leaves a
child process's main_argv[1] NULL, before dbg_init, whose init_options
takes the process name from main_argv[1]. A trace on the way there read
the options lazily first; built with WINE_NO_TRACE_MSGS, a child started
with WINEDEBUG set (services.exe under wineboot) crashed in strpbrk.

Assisted-by: Claude Code: claude-opus-5-5
---
 dlls/ntdll/unix/debug.c        | 12 ++++++++++++
 dlls/ntdll/unix/loader.c       |  1 +
 dlls/ntdll/unix/unix_private.h |  1 +
 3 files changed, 14 insertions(+)

diff --git a/dlls/ntdll/unix/debug.c b/dlls/ntdll/unix/debug.c
index 53516b9..165f1a1 100644
--- a/dlls/ntdll/unix/debug.c
+++ b/dlls/ntdll/unix/debug.c
@@ -354,6 +354,18 @@ int __cdecl __wine_dbg_header( enum __wine_debug_class cls, struct __wine_debug_
 /***********************************************************************
  *		dbg_init
  */
+/***********************************************************************
+ *		dbg_init_options
+ *
+ * Read WINEDEBUG while main_argv[1] is still the program: init_startup_info's rebuild_argv drops argv[0], and
+ * init_options takes the process name from main_argv[1]. A trace before then used to read them lazily; with the
+ * traces compiled out (WINE_NO_TRACE_MSGS) the first read came after, from a NULL main_argv[1] in a child process.
+ */
+void dbg_init_options(void)
+{
+    if (nb_debug_options == -1) init_options();
+}
+
 void dbg_init(void)
 {
     struct __wine_debug_channel *options, default_option = { default_flags };
diff --git a/dlls/ntdll/unix/loader.c b/dlls/ntdll/unix/loader.c
index 45b0d6d..499adb1 100644
--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -1921,6 +1921,7 @@ static void start_main_thread(void)
     virtual_map_user_shared_data();
     init_cpu_info();
     init_files();
+    dbg_init_options();
     init_startup_info();
     dbg_init();
     *(ULONG_PTR *)&peb->CloudFileFlags = get_image_address();
diff --git a/dlls/ntdll/unix/unix_private.h b/dlls/ntdll/unix/unix_private.h
index 7346ed1..c74c8b2 100644
--- a/dlls/ntdll/unix/unix_private.h
+++ b/dlls/ntdll/unix/unix_private.h
@@ -414,6 +414,7 @@ extern NTSTATUS wow64_wine_server_handle_to_fd( void *args );
 extern NTSTATUS wow64_wine_spawnvp( void *args );
 #endif
 
+extern void dbg_init_options(void);
 extern void dbg_init(void);
 
 extern void close_inproc_sync( HANDLE handle );
