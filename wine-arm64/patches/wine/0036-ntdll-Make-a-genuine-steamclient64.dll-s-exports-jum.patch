From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Sun, 11 Oct 2026 20:30:56 -0400
Subject: [PATCH] ntdll: Make a genuine steamclient64.dll's exports jump to
 lsteamclient.dll.

SteamStub DRM (Palworld) checks the signature of the prefix's steamclient64.dll and stops with "Application load
error 3:0000065432" when it is our lsteamclient.dll. Proton keeps Valve's signed file there and redirects it in
memory (ValveSoftware/wine proton_11.0: dlls/ntdll/loader.c build_module, import_dll, MODULE_InitDLL;
dlls/ntdll/unix/loader.c steamclient_setup_trampolines). This does the same, PE-side:
- each export lsteamclient.dll also has becomes mov rax, <its x64-view export>; jmp rax, written under
  NtProtectVirtualMemory (RW, then the old protection back), so Wine keeps W^X and FEX sees the change; Proton's
  unix-side mprotect(RWX) is refused on Apple Silicon;
- lsteamclient.dll is loaded from system32 only;
- its DllMain and TLS callbacks are skipped (LDR_DONT_CALL_DLLMAIN, Proton's bit), unless no export was redirected;
- its tier0_s64.dll and vstdlib_s64.dll imports get ntdll's stubs, under their own names.
Only a native x64 module named steamclient64.dll: our builtin under that name is left alone.
PROTON_DISABLE_LSTEAMCLIENT=1 turns it off.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 dlls/ntdll/loader.c | 111 +++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 109 insertions(+), 2 deletions(-)

diff --git a/dlls/ntdll/loader.c b/dlls/ntdll/loader.c
index f529f73e..cb5cf5c0 100644
--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -49,6 +49,11 @@ WINE_DECLARE_DEBUG_CHANNEL(imports);
 #define DEFAULT_SECURITY_COOKIE_32  0xbb40e64e
 #define DEFAULT_SECURITY_COOKIE_16  (DEFAULT_SECURITY_COOKIE_32 >> 16)
 
+/* Proton's LDR_DATA_TABLE_ENTRY.Flags bit (include/winternl.h on proton_11.0): a genuine steamclient64.dll whose
+ * exports jump to lsteamclient.dll. Its DllMain and TLS callbacks never run: they would call the ntdll stubs that
+ * stand in for its tier0_s64.dll and vstdlib_s64.dll imports. */
+#define LDR_DONT_CALL_DLLMAIN 0x20000000
+
 #ifdef __i386__
 static const WCHAR pe_dir[] = L"\\i386-windows";
 #elif defined __x86_64__
@@ -1170,7 +1175,15 @@ static BOOL import_dll( WINE_MODREF *wm, const IMAGE_IMPORT_DESCRIPTOR *descr, L
         return TRUE;
     }
 
-    status = build_import_name( wm, buffer, name, len );
+    /* Valve's tier0_s64.dll and vstdlib_s64.dll aren't in the prefix: ntdll's stubs stand in, never called. The
+     * stubs and their warnings keep the real names. */
+    if ((wm->ldr.Flags & LDR_DONT_CALL_DLLMAIN) &&
+        (!_stricmp( name, "tier0_s64.dll" ) || !_stricmp( name, "vstdlib_s64.dll" )))
+    {
+        TRACE( "%s -> ntdll.dll\n", name );
+        status = build_import_name( wm, buffer, "ntdll.dll", strlen( "ntdll.dll" ) );
+    }
+    else status = build_import_name( wm, buffer, name, len );
     if (!status) status = load_dll( load_path, buffer, 0, &wmImp, system );
 
     if (status)
@@ -1690,7 +1703,7 @@ static NTSTATUS MODULE_InitDLL( WINE_MODREF *wm, UINT reason, LPVOID lpReserved
 
     /* Skip calls for modules loaded with special load flags */
 
-    if (wm->ldr.Flags & LDR_DONT_RESOLVE_REFS) return STATUS_SUCCESS;
+    if (wm->ldr.Flags & (LDR_DONT_RESOLVE_REFS | LDR_DONT_CALL_DLLMAIN)) return STATUS_SUCCESS;
     if (wm->ldr.TlsIndex == -1) call_tls_callbacks( wm->ldr.DllBase, reason );
     if (!entry) return STATUS_SUCCESS;
 
@@ -2262,6 +2275,76 @@ done:
 }
 
 
+/***********************************************************************
+ *           use_lsteamclient
+ *
+ * Proton's switch: PROTON_DISABLE_LSTEAMCLIENT=1 leaves a genuine steamclient64.dll as it is (a Windows Steam
+ * installed in the prefix, with its tier0_s64.dll beside it).
+ */
+static BOOL use_lsteamclient(void)
+{
+    static const WCHAR name[] = L"PROTON_DISABLE_LSTEAMCLIENT";
+    static int use = -1;
+    WCHAR value[32];
+    SIZE_T len;
+
+    if (use == -1)
+    {
+        use = RtlQueryEnvironmentVariable( NULL, name, ARRAY_SIZE(name) - 1, value, ARRAY_SIZE(value), &len ) ||
+              value[0] == '0';
+        if (!use) ERR( "lsteamclient disabled\n" );
+    }
+    return use;
+}
+
+
+/***********************************************************************
+ *           setup_steamclient_trampolines
+ *
+ * Proton's handling of Valve's signed steamclient64.dll, which SteamStub DRM checks on disk: in memory, each export
+ * that lsteamclient.dll also has becomes an x64 jump to lsteamclient.dll's. Those are its x64 view's addresses, the
+ * ones an x64 importer gets (export thunks into the ARM64EC code). Returns how many, and in *matched how many
+ * exports both DLLs have. The exports of Valve's 2026 DLL are 16 bytes apart at least, so a 12-byte jump never reaches
+ * the next one (ponytail: unchecked; check the spacing before shipping this for any Valve DLL).
+ */
+static ULONG setup_steamclient_trampolines( HMODULE module, HMODULE lsteamclient, ULONG *matched )
+{
+    const IMAGE_EXPORT_DIRECTORY *exports;
+    const DWORD *names;
+    ULONG i, size, count = 0;
+
+    *matched = 0;
+    if (!(exports = RtlImageDirectoryEntryToData( module, TRUE, IMAGE_DIRECTORY_ENTRY_EXPORT, &size ))) return 0;
+    names = get_rva( module, exports->AddressOfNames );
+    for (i = 0; i < exports->NumberOfNames; i++)
+    {
+        const char *name = get_rva( module, names[i] );
+        BYTE *src = RtlFindExportedRoutineByName( module, name );
+        void *tgt = RtlFindExportedRoutineByName( lsteamclient, name ), *addr = src;
+        SIZE_T len = 12;
+        ULONG old;
+
+        if (!src || !tgt) continue;  /* Breakpad_SteamSendMiniDump: lsteamclient.dll has none, as on Proton */
+        (*matched)++;
+        /* not PAGE_EXECUTE_READWRITE: FEX would keep the range as self-modifying code */
+        if (NtProtectVirtualMemory( NtCurrentProcess(), &addr, &len, PAGE_READWRITE, &old ))
+        {
+            ERR( "can't make %s writable\n", debugstr_a(name) );
+            continue;
+        }
+        src[0] = 0x48; src[1] = 0xb8;  /* mov rax, tgt */
+        memcpy( src + 2, &tgt, sizeof(tgt) );
+        src[10] = 0xff; src[11] = 0xe0;  /* jmp rax */
+        /* back to execute: FEX runs only what is executable */
+        if (NtProtectVirtualMemory( NtCurrentProcess(), &addr, &len, old, &old ))
+            ERR( "can't restore the protection of %s\n", debugstr_a(name) );
+        NtFlushInstructionCache( NtCurrentProcess(), src, 12 );
+        count++;
+    }
+    return count;
+}
+
+
 /*************************************************************************
  *		build_module
  *
@@ -2299,6 +2382,30 @@ static NTSTATUS build_module( LPCWSTR load_path, const UNICODE_STRING *nt_name,
 
     update_load_config( *module );
 
+    /* Valve's signed steamclient64.dll (not our builtin under that name): made lsteamclient.dll's before any of its
+     * code can run, and before its imports, which this flag redirects */
+    if (!is_builtin && nt->FileHeader.Machine == IMAGE_FILE_MACHINE_AMD64 &&
+        !wcsicmp( wm->ldr.BaseDllName.Buffer, L"steamclient64.dll" ) && use_lsteamclient())
+    {
+        static HMODULE lsteamclient;
+        UNICODE_STRING name = RTL_CONSTANT_STRING( L"lsteamclient.dll" );
+        /* from system32 only: a game folder's lsteamclient.dll must not win */
+        NTSTATUS ret = lsteamclient ? STATUS_SUCCESS : LdrLoadDll( system_dir, NULL, &name, &lsteamclient );
+        ULONG count, matched;
+
+        if (ret) ERR( "%s left as it is: lsteamclient.dll didn't load (%lx)\n", debugstr_us(nt_name), ret );
+        else if (!(count = setup_steamclient_trampolines( *module, lsteamclient, &matched )))
+            ERR( "%s left as it is: no export jumps to lsteamclient.dll\n", debugstr_us(nt_name) );
+        else
+        {
+            if (count != matched) ERR( "%s: only %lu of %lu exports jump to lsteamclient.dll\n",
+                                       debugstr_us(nt_name), count, matched );
+            TRACE_(loaddll)( "%s: %lu exports jump to lsteamclient.dll, DllMain skipped\n",
+                             debugstr_us(nt_name), count );
+            wm->ldr.Flags |= LDR_DONT_CALL_DLLMAIN;
+        }
+    }
+
     /* fixup imports */
 
     if (!(flags & LDR_DONT_RESOLVE_REFS) &&
-- 
