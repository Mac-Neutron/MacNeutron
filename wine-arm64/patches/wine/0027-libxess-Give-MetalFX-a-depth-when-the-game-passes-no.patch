From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Tue, 6 Oct 2026 12:24:12 -0400
Subject: [PATCH] libxess: Give MetalFX a depth when the game passes none.

XeSS's header makes the depth texture optional with motion vectors at
the output size (XESS_INIT_FLAG_HIGH_RES_MV), and Unreal's XeSS plugin
passes none: SMITE 2 initialises with flags 0x101 and every Execute
returned XESS_RESULT_ERROR_INVALID_ARGUMENT. MetalFX needs a depth as
large as the colour texture, so the bridge makes one at the far plane
(D32_FLOAT, cleared once on the game's list, read at the colour's
base), keeps it while the colour texture's size holds and drops it on a
re-Init or the context's end. Without high-res motion vectors a missing
depth is still refused. The first Execute's dump names the game's depth
texture.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 dlls/libxess/Makefile.in |  1 +
 dlls/libxess/d3d12.c     | 98 ++++++++++++++++++++++++++++++++++------
 2 files changed, 86 insertions(+), 13 deletions(-)

diff --git a/dlls/libxess/Makefile.in b/dlls/libxess/Makefile.in
index 7c354ada..e36bcd05 100644
--- a/dlls/libxess/Makefile.in
+++ b/dlls/libxess/Makefile.in
@@ -2,6 +2,7 @@ MODULE = libxess.dll
 
 VER_FILEDESCRIPTION_STR = "Wine XeSS on MetalFX"
 VER_PRODUCTVERSION      = 2,0,1,0
+IMPORTS   = dxguid
 
 SOURCES = \
 	d3d12.c \
diff --git a/dlls/libxess/d3d12.c b/dlls/libxess/d3d12.c
index 3c5d3de9..45314fbb 100644
--- a/dlls/libxess/d3d12.c
+++ b/dlls/libxess/d3d12.c
@@ -67,6 +67,8 @@ struct xess_d3d12
     float jitter_x, jitter_y, velocity_x, velocity_y;
     IMTLD3D12TemporalScaler *scaler;
     MTL_TEMPORAL_SCALER_D3D12_DESC scaler_desc;
+    ID3D12Resource *depth;      /* far_depth's, for a game that passes none */
+    ID3D12DescriptorHeap *dsv;
     xess_app_log_callback_t log;
     xess_logging_level_t log_level;
 };
@@ -126,6 +128,14 @@ static void release_scaler(struct xess_d3d12 *ctx)
     ctx->scaler = NULL;
 }
 
+static void release_depth(struct xess_d3d12 *ctx)
+{
+    if (ctx->depth) ID3D12Resource_Release(ctx->depth);
+    if (ctx->dsv) ID3D12DescriptorHeap_Release(ctx->dsv);
+    ctx->depth = NULL;
+    ctx->dsv = NULL;
+}
+
 static xess_result_t result_of(HRESULT hr)
 {
     if (SUCCEEDED(hr)) return XESS_RESULT_SUCCESS;
@@ -230,6 +240,7 @@ xess_result_t CDECL d3d12_destroy_context(xess_context_handle_t handle)
     AcquireSRWLockExclusive(&found->lock);
     ReleaseSRWLockExclusive(&found->lock);
     release_scaler(found);
+    release_depth(found);
     IMTLD3D12DeviceExt_Release(found->ext);
     free(found);
     return XESS_RESULT_SUCCESS;
@@ -285,6 +296,7 @@ static xess_result_t init(struct xess_d3d12 *ctx, const xess_d3d12_init_params_t
     }
     /* re-initialised (a resolution or quality change): the old upscaler goes now */
     release_scaler(ctx);
+    release_depth(ctx);
     ctx->initialized = FALSE;
     ctx->init = *params;
     desc.InputWidth = in.x;
@@ -340,22 +352,74 @@ static void extent(ID3D12Resource *resource, D3D12_RESOURCE_DESC *desc, uint32_t
     *h = desc->Dimension == D3D12_RESOURCE_DIMENSION_TEXTURE2D && desc->Height > y ? desc->Height - y : 0;
 }
 
+/* Intel's header makes depth optional with motion vectors at the output size (bit 0), and Unreal's XeSS plugin passes
+ * none (SMITE 2: flags 0x101); MetalFX needs one, as large as the colour texture (its validation says so). This is
+ * one at the far plane, made and cleared on the first list that needs it, kept until the colour texture's size
+ * changes, a re-Init or the context's end (the lists that read it keep it too), and read at the colour's base.
+ * ponytail: a constant depth gives MetalFX no depth edges: its velocity dilation and disocclusion lean on colour alone;
+ * the maintainer's captures judge it. Cleared once, so a list recorded but never submitted leaves it undefined. */
+static ID3D12Resource *far_depth(struct xess_d3d12 *ctx, ID3D12GraphicsCommandList *list,
+                                 const D3D12_RESOURCE_DESC *color, HRESULT *hr)
+{
+    D3D12_HEAP_PROPERTIES heap = {D3D12_HEAP_TYPE_DEFAULT};
+    D3D12_RESOURCE_DESC desc = {D3D12_RESOURCE_DIMENSION_TEXTURE2D, 0, color->Width, color->Height, 1, 1,
+                                DXGI_FORMAT_D32_FLOAT, {1, 0}, D3D12_TEXTURE_LAYOUT_UNKNOWN,
+                                D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL};
+    D3D12_DESCRIPTOR_HEAP_DESC dsv = {D3D12_DESCRIPTOR_HEAP_TYPE_DSV, 1};
+    float far_plane = ctx->init.initFlags & XESS_INIT_FLAG_INVERTED_DEPTH ? 0.0f : 1.0f;
+    D3D12_CLEAR_VALUE clear = {DXGI_FORMAT_D32_FLOAT};
+    D3D12_RESOURCE_BARRIER barrier = {D3D12_RESOURCE_BARRIER_TYPE_TRANSITION};
+    D3D12_CPU_DESCRIPTOR_HANDLE handle;
+    ID3D12Device *device;
+
+    if (ctx->depth)
+    {
+        D3D12_RESOURCE_DESC had = ID3D12Resource_GetDesc(ctx->depth);
+        if (had.Width == color->Width && had.Height == color->Height) return ctx->depth;
+        release_depth(ctx);
+    }
+    if (FAILED(*hr = ID3D12GraphicsCommandList_GetDevice(list, &IID_ID3D12Device, (void **)&device))) return NULL;
+    clear.DepthStencil.Depth = far_plane;
+    if (SUCCEEDED(*hr = ID3D12Device_CreateCommittedResource(device, &heap, D3D12_HEAP_FLAG_NONE, &desc,
+                                                             D3D12_RESOURCE_STATE_DEPTH_WRITE, &clear,
+                                                             &IID_ID3D12Resource, (void **)&ctx->depth)))
+        *hr = ID3D12Device_CreateDescriptorHeap(device, &dsv, &IID_ID3D12DescriptorHeap, (void **)&ctx->dsv);
+    if (FAILED(*hr))
+    {
+        ID3D12Device_Release(device);
+        release_depth(ctx);
+        return NULL;
+    }
+    handle = ID3D12DescriptorHeap_GetCPUDescriptorHandleForHeapStart(ctx->dsv);
+    ID3D12Device_CreateDepthStencilView(device, ctx->depth, NULL, handle);
+    ID3D12Device_Release(device);
+    ID3D12GraphicsCommandList_ClearDepthStencilView(list, handle, D3D12_CLEAR_FLAG_DEPTH, far_plane, 0, 0, NULL);
+    barrier.Transition.pResource = ctx->depth;
+    barrier.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    barrier.Transition.StateBefore = D3D12_RESOURCE_STATE_DEPTH_WRITE;
+    barrier.Transition.StateAfter = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+    ID3D12GraphicsCommandList_ResourceBarrier(list, 1, &barrier);
+    return ctx->depth;
+}
+
 static xess_result_t execute(struct xess_d3d12 *ctx, ID3D12GraphicsCommandList *list,
                              const xess_d3d12_execute_params_t *p, char *msg)
 {
-    static LONG logged, bad, too_small, failed, foreign, refused;
+    static LONG logged, bad, too_small, failed, foreign, refused, no_depth;
     D3D12_RESOURCE_DESC color, depth, motion, output, mask = {0};
     MTL_TEMPORAL_SCALER_D3D12_DESC want = {0};
     MTL_TEMPORAL_UPSCALE_D3D12_DESC d = {0};
     IMTLD3D12CommandListExt *ext;
     UINT cw, ch, dw, dh, mw, mh, kw = ~0u, kh = ~0u, iw, ih;
     uint32_t flags = ctx->init.initFlags;
-    ID3D12Resource *reactive;
+    ID3D12Resource *reactive, *depth_texture;
+    xess_coord_t depth_base = {0};
     xess_result_t ret;
     HRESULT hr;
 
     if (!ctx->initialized) return XESS_RESULT_ERROR_UNINITIALIZED;
-    if (!list || !p || !p->pColorTexture || !p->pVelocityTexture || !p->pDepthTexture || !p->pOutputTexture ||
+    if (!list || !p || !p->pColorTexture || !p->pVelocityTexture || !p->pOutputTexture ||
+        (!p->pDepthTexture && !(flags & XESS_INIT_FLAG_HIGH_RES_MV)) ||
         !p->inputWidth || !p->inputHeight ||
         ctx->init.outputResolution.x > p->inputWidth * ctx->max_scale ||
         ctx->init.outputResolution.y > p->inputHeight * ctx->max_scale ||
@@ -369,7 +433,15 @@ static xess_result_t execute(struct xess_d3d12 *ctx, ID3D12GraphicsCommandList *
     }
     reactive = flags & XESS_INIT_FLAG_RESPONSIVE_PIXEL_MASK ? p->pResponsivePixelMaskTexture : NULL;
     extent(p->pColorTexture, &color, p->inputColorBase.x, p->inputColorBase.y, &cw, &ch);
-    extent(p->pDepthTexture, &depth, p->inputDepthBase.x, p->inputDepthBase.y, &dw, &dh);
+    if ((depth_texture = p->pDepthTexture)) depth_base = p->inputDepthBase;
+    else if ((depth_texture = far_depth(ctx, list, &color, &hr))) depth_base = p->inputColorBase;
+    else
+    {
+        once(&no_depth, msg, "xessD3D12Execute: no depth texture like the colour's (%ux%u): %#lx", (UINT)color.Width,
+             color.Height, hr);
+        return result_of(hr);
+    }
+    extent(depth_texture, &depth, depth_base.x, depth_base.y, &dw, &dh);
     extent(p->pVelocityTexture, &motion, p->inputMotionVectorBase.x, p->inputMotionVectorBase.y, &mw, &mh);
     output = ID3D12Resource_GetDesc(p->pOutputTexture);
     if (reactive)
@@ -377,15 +449,15 @@ static xess_result_t execute(struct xess_d3d12 *ctx, ID3D12GraphicsCommandList *
     if (!InterlockedExchange(&logged, 1))
         WARN("flags %#x, input %ux%u, output %ux%u; formats colour %u depth %u motion %u output %u mask %u; "
              "sizes colour %ux%u depth %ux%u motion %ux%u output %ux%u; bases colour %u,%u depth %u,%u "
-             "motion %u,%u mask %u,%u output %u,%u; exposure texture %p, mask %p; jitter %f,%f scale %f,%f; "
-             "velocity scale %f,%f; exposure %f; reset %u\n", flags, p->inputWidth, p->inputHeight,
+             "motion %u,%u mask %u,%u output %u,%u; depth texture %p, exposure texture %p, mask %p; "
+             "jitter %f,%f scale %f,%f; velocity scale %f,%f; exposure %f; reset %u\n", flags, p->inputWidth, p->inputHeight,
              ctx->init.outputResolution.x, ctx->init.outputResolution.y, color.Format, depth.Format,
              motion.Format, output.Format, mask.Format, (UINT)color.Width, color.Height, (UINT)depth.Width, depth.Height,
              (UINT)motion.Width, motion.Height, (UINT)output.Width, output.Height, p->inputColorBase.x, p->inputColorBase.y,
              p->inputDepthBase.x, p->inputDepthBase.y, p->inputMotionVectorBase.x, p->inputMotionVectorBase.y,
              p->inputResponsiveMaskBase.x, p->inputResponsiveMaskBase.y, p->outputColorBase.x,
-             p->outputColorBase.y, p->pExposureScaleTexture, p->pResponsivePixelMaskTexture, p->jitterOffsetX,
-             p->jitterOffsetY, ctx->jitter_x, ctx->jitter_y, ctx->velocity_x, ctx->velocity_y, p->exposureScale,
+             p->outputColorBase.y, p->pDepthTexture, p->pExposureScaleTexture, p->pResponsivePixelMaskTexture,
+             p->jitterOffsetX, p->jitterOffsetY, ctx->jitter_x, ctx->jitter_y, ctx->velocity_x, ctx->velocity_y, p->exposureScale,
              p->resetHistory);
 
     /* The upscaler for these textures: the one there is if they hold the region it reads, else one
@@ -410,8 +482,8 @@ static xess_result_t execute(struct xess_d3d12 *ctx, ID3D12GraphicsCommandList *
     if (iw < p->inputWidth || ih < p->inputHeight)
     {
         once(&too_small, msg, "xessD3D12Execute: input %ux%u at bases (%u,%u) (%u,%u) (%u,%u) isn't in its textures",
-             p->inputWidth, p->inputHeight, p->inputColorBase.x, p->inputColorBase.y, p->inputDepthBase.x,
-             p->inputDepthBase.y, p->inputMotionVectorBase.x, p->inputMotionVectorBase.y);
+             p->inputWidth, p->inputHeight, p->inputColorBase.x, p->inputColorBase.y, depth_base.x, depth_base.y,
+             p->inputMotionVectorBase.x, p->inputMotionVectorBase.y);
         return XESS_RESULT_ERROR_INVALID_ARGUMENT;
     }
     want.InputWidth = ctx->scaler_desc.InputWidth;
@@ -435,7 +507,7 @@ static xess_result_t execute(struct xess_d3d12 *ctx, ID3D12GraphicsCommandList *
     }
 
     d.Color = p->pColorTexture;
-    d.Depth = p->pDepthTexture;
+    d.Depth = depth_texture;
     d.MotionVector = p->pVelocityTexture;
     d.Exposure = flags & XESS_INIT_FLAG_EXPOSURE_SCALE_TEXTURE ? p->pExposureScaleTexture : NULL;
     d.ReactiveMask = reactive;
@@ -444,8 +516,8 @@ static xess_result_t execute(struct xess_d3d12 *ctx, ID3D12GraphicsCommandList *
     d.InputContentHeight = p->inputHeight;
     d.ColorOffsetX = p->inputColorBase.x;
     d.ColorOffsetY = p->inputColorBase.y;
-    d.DepthOffsetX = p->inputDepthBase.x;
-    d.DepthOffsetY = p->inputDepthBase.y;
+    d.DepthOffsetX = depth_base.x;
+    d.DepthOffsetY = depth_base.y;
     d.MotionOffsetX = p->inputMotionVectorBase.x;
     d.MotionOffsetY = p->inputMotionVectorBase.y;
     d.ReactiveOffsetX = p->inputResponsiveMaskBase.x;
-- 
