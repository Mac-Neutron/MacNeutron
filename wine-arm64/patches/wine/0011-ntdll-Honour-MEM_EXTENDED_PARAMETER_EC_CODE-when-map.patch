From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Sat, 3 Oct 2026 11:52:28 -0400
Subject: [PATCH] ntdll: Honour MEM_EXTENDED_PARAMETER_EC_CODE when mapping a
 section view.

NtMapViewOfSectionEx parsed the attribute flags and dropped them, so a view
mapped with MEM_EXTENDED_PARAMETER_EC_CODE was never entered in the ARM64EC
code bitmap. A JIT in an ARM64EC process gets code it can rewrite and run
from one section mapped twice (a RW view to write, an RX view to run); the
RX view has to be EC code, or RtlIsEcCode says no and the call goes to the
x64 emulator instead of running the ARM64 instructions.

Pass the flags on to virtual_map_section and mark the view the way
allocate_virtual_memory does (commit_arm64ec_map, set_arm64ec_range), once
the view is mapped. A process without an ARM64EC code map gets
STATUS_INVALID_PARAMETER, as it does from NtAllocateVirtualMemoryEx.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 dlls/ntdll/unix/virtual.c | 14 +++++++++++---
 1 file changed, 11 insertions(+), 3 deletions(-)

diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
index 448156e1..b0607691 100644
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -3112,7 +3112,7 @@ done:
 static unsigned int virtual_map_section( HANDLE handle, PVOID *addr_ptr, ULONG_PTR limit_low,
                                          ULONG_PTR limit_high, SIZE_T commit_size,
                                          const LARGE_INTEGER *offset_ptr, SIZE_T *size_ptr,
-                                         ULONG alloc_type, ULONG protect, USHORT machine )
+                                         ULONG alloc_type, ULONG protect, USHORT machine, ULONG attributes )
 {
     unsigned int res;
     mem_size_t full_size;
@@ -3195,6 +3195,8 @@ static unsigned int virtual_map_section( HANDLE handle, PVOID *addr_ptr, ULONG_P
     }
     if (!(size = ROUND_SIZE( 0, size, page_mask ))) return STATUS_INVALID_PARAMETER;  /* wrap-around */
 
+    if (!arm64ec_view && (attributes & MEM_EXTENDED_PARAMETER_EC_CODE)) return STATUS_INVALID_PARAMETER;
+
     get_vprot_flags( protect, &vprot, FALSE );
     vprot |= sec_flags;
     if (!(sec_flags & SEC_RESERVE)) vprot |= VPROT_COMMITTED;
@@ -3230,6 +3232,12 @@ static unsigned int virtual_map_section( HANDLE handle, PVOID *addr_ptr, ULONG_P
     {
         *addr_ptr = view->base;
         *size_ptr = size;
+        /* a view of ARM64EC code, marked as allocate_virtual_memory marks it */
+        if (attributes & MEM_EXTENDED_PARAMETER_EC_CODE)
+        {
+            commit_arm64ec_map( view );
+            set_arm64ec_range( view->base, size );
+        }
         VIRTUAL_DEBUG_DUMP_VIEW( view );
     }
     else delete_view( view );
@@ -6023,7 +6031,7 @@ NTSTATUS WINAPI NtMapViewOfSection( HANDLE handle, HANDLE process, PVOID *addr_p
     }
 
     return virtual_map_section( handle, addr_ptr, 0, get_zero_bits_limit( zero_bits ), commit_size,
-                                offset_ptr, size_ptr, alloc_type, protect, 0 );
+                                offset_ptr, size_ptr, alloc_type, protect, 0, 0 );
 }
 
 /***********************************************************************
@@ -6101,7 +6109,7 @@ NTSTATUS WINAPI NtMapViewOfSectionEx( HANDLE handle, HANDLE process, PVOID *addr
     }
 
     return virtual_map_section( handle, addr_ptr, limit_low, limit_high, 0,
-                                offset_ptr, size_ptr, alloc_type, protect, machine );
+                                offset_ptr, size_ptr, alloc_type, protect, machine, attributes );
 }
 
 
