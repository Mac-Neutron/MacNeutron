From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Fri, 9 Oct 2026 07:59:01 -0400
Subject: [PATCH] msync: Fix wait-all wakeups, rollback and duplicate objects.

- B1: every object type wakes all its waiters on both sides, as CrossOver
  26.3 does; before, an auto-reset event, its server twin and a mutex woke
  one, and a non-alertable wait-all leg parked on the object word, which
  only observes, could take that wake, so a single waiter slept with the
  object signalled. Parking those legs on the pump instead kept wake-one
  but made a wait-all's wake slower than the plain wineserver's (10.6-11.3
  against 9.1-9.2 us, three runs), so wake-all it is. A spent timeout
  returns before a leg parks.
- B2: the rollback wakes the waiters of what it puts back. B3: it puts back
  only what it took, so an owned mutex stays owned. B6: a mutex taken from
  abandoned goes back abandoned.
- B4: a repeated object returns STATUS_INVALID_PARAMETER, as on Windows;
  before, it spun or wrongly succeeded.
- B7: an abandoned mutex no longer spins the first step.
- R5: the shm reply port's receive right is released. R9: the abandon store
  is SEQ_CST.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 dlls/ntdll/unix/msync.c | 79 +++++++++++++++++++++--------------------
 server/msync.c          | 20 ++++-------
 2 files changed, 47 insertions(+), 52 deletions(-)

diff --git a/dlls/ntdll/unix/msync.c b/dlls/ntdll/unix/msync.c
index d8425746..dc8a37eb 100644
--- a/dlls/ntdll/unix/msync.c
+++ b/dlls/ntdll/unix/msync.c
@@ -566,6 +566,7 @@ static void *request_shm_from_server( int entry, int tid )
     }
 
     mach_port_deallocate( mach_task_self(), reply_port );
+    mach_port_mod_refs( mach_task_self(), reply_port, MACH_PORT_RIGHT_RECEIVE, -1 );
     mach_port_deallocate( mach_task_self(), receive_message.descriptor.name );
     return (void *)map_address;
 }
@@ -716,20 +717,14 @@ void msync_init(void)
 }
 
 
-/* An auto-reset event, its server-side twin and a mutex release exactly one
- * waiter. Waking the rest buys them a trip through the scheduler to find the
- * object already taken, so wake one and leave them asleep. */
+/* Every type wakes all, as CrossOver 26.3 does. A wait-all leg parks on the
+ * object's word only to look at it, so a wake-one could pick that leg and
+ * leave a single waiter asleep with the object signalled. Parking those legs
+ * on the pump instead kept wake-one but measured slower than the plain
+ * wineserver: a wait-all's wake took 10.6-11.3 us against its 9.1-9.2 us. */
 static inline uint32_t wake_flags( unsigned short msync_type )
 {
-    switch (msync_type)
-    {
-    case MSYNC_AUTO_EVENT:
-    case MSYNC_AUTO_SERVER:
-    case MSYNC_MUTEX:
-        return 0;
-    default:
-        return ULF_WAKE_ALL;
-    }
+    return ULF_WAKE_ALL;
 }
 
 static inline void signal_all( void *shm, unsigned int shm_idx )
@@ -881,20 +876,11 @@ static NTSTATUS do_single_wait( int obj, void *obj_shm, int alert_obj, void *ale
 {
     NTSTATUS status;
 
-    if (alert_obj)
-    {
-        if (__atomic_load_n( (int *)alert_obj_shm, __ATOMIC_SEQ_CST ))
-            return STATUS_USER_APC;
-
-        status = msync_wait_multiple( &obj, &obj_shm, alert_obj, alert_obj_shm, 1, end, tid );
-
-        if (__atomic_load_n( (int *)alert_obj_shm, __ATOMIC_SEQ_CST ))
-            return STATUS_USER_APC;
-    }
-    else
-    {
-        status = msync_wait_single( obj, obj_shm, end, tid );
-    }
+    if (alert_obj && __atomic_load_n( (int *)alert_obj_shm, __ATOMIC_SEQ_CST )) return STATUS_USER_APC;
+    if (end && !update_timeout( *end )) return STATUS_TIMEOUT;
+    if (!alert_obj) return msync_wait_single( obj, obj_shm, end, tid );
+    status = msync_wait_multiple( &obj, &obj_shm, alert_obj, alert_obj_shm, 1, end, tid );
+    if (__atomic_load_n( (int *)alert_obj_shm, __ATOMIC_SEQ_CST )) return STATUS_USER_APC;
     return status;
 }
 
@@ -1063,13 +1049,22 @@ NTSTATUS msync_wait_objs( const DWORD count, const int *objs, BOOLEAN wait_any,
          * waiting for an instant while we put things back. */
 
         NTSTATUS status = STATUS_SUCCESS;
+        int j;
+
+        /* An object listed twice can't be taken twice at once; Windows (and
+         * ntsync) refuse the wait. Two handles to one object share its index. */
+        for (i = 0; i < count; i++)
+            for (j = i + 1; j < count; j++)
+                if (objs[i] == objs[j]) return STATUS_INVALID_PARAMETER;
 
         while (1)
         {
-            BOOL abandoned;
+            /* What this pass's grab changed, so a rollback puts back exactly
+             * that: bit i is objs[i]. count <= MAXIMUM_WAIT_OBJECTS (64). */
+            ULONG64 taken, from_abandoned;
 
 tryagain:
-            abandoned = FALSE;
+            taken = from_abandoned = 0;
 
             /* First step: try to wait on each object in sequence. */
 
@@ -1078,11 +1073,14 @@ tryagain:
                 if (((struct mutex *)objs_shm[i])->msync_type == MSYNC_MUTEX)
                 {
                     struct mutex *mutex = (struct mutex *)objs_shm[i];
+                    int tid;
 
                     if (mutex->tid == current_tid)
                         continue;
 
-                    while (__atomic_load_n( &mutex->tid, __ATOMIC_SEQ_CST ))
+                    /* Wait only while another live thread owns it: an
+                     * abandoned mutex (~0) is free to take. */
+                    while ((tid = __atomic_load_n( &mutex->tid, __ATOMIC_SEQ_CST )) && tid != ~0)
                     {
                         status = do_single_wait( objs[i], objs_shm[i], alert_obj, alert_obj_shm, timeout ? &end : NULL, current_tid );
                         if (status != STATUS_PENDING)
@@ -1143,8 +1141,9 @@ tryagain:
                         goto tooslow;
                     if (__sync_val_compare_and_swap( &mutex->tid, tid, current_tid ) != tid)
                         goto tooslow;
+                    taken |= (ULONG64)1 << i;
                     if (tid == ~0)
-                        abandoned = TRUE;
+                        from_abandoned |= (ULONG64)1 << i;
                     break;
                 }
                 case MSYNC_SEMAPHORE:
@@ -1160,6 +1159,7 @@ tryagain:
                     }
                     if (!current)
                         goto tooslow;
+                    taken |= (ULONG64)1 << i;
                     break;
                 }
                 case MSYNC_AUTO_EVENT:
@@ -1168,6 +1168,7 @@ tryagain:
                     struct event *event = (struct event *)objs_shm[i];
                     if (!__sync_val_compare_and_swap( &event->signaled, 1, 0 ))
                         goto tooslow;
+                    taken |= (ULONG64)1 << i;
                     break;
                 }
                 default:
@@ -1188,22 +1189,24 @@ tryagain:
                 }
             }
 
-            if (abandoned) return STATUS_ABANDONED;
+            if (from_abandoned) return STATUS_ABANDONED;
 
             return STATUS_SUCCESS;
 
 tooslow:
-            for (--i; i >= 0; i--)
+            /* Put back only what this pass took (a mutex the caller already
+             * owned stays owned; one taken abandoned goes back abandoned), and
+             * wake whoever parked on it meanwhile. */
+            for (i = 0; i < count; i++)
             {
+                if (!(taken >> i & 1)) continue;
+
                 switch (((struct event *)objs_shm[i])->msync_type)
                 {
                 case MSYNC_MUTEX:
                 {
                     struct mutex *mutex = (struct mutex *)objs_shm[i];
-                    /* HACK: This won't do the right thing with abandoned
-                     * mutexes, but fixing it is probably more trouble than
-                     * it's worth. */
-                    __atomic_store_n( &mutex->tid, 0, __ATOMIC_SEQ_CST );
+                    __atomic_store_n( &mutex->tid, from_abandoned >> i & 1 ? ~0 : 0, __ATOMIC_SEQ_CST );
                     break;
                 }
                 case MSYNC_SEMAPHORE:
@@ -1219,10 +1222,8 @@ tooslow:
                     __atomic_store_n( &event->signaled, 1, __ATOMIC_SEQ_CST );
                     break;
                 }
-                default:
-                    /* doesn't need to be put back */
-                    break;
                 }
+                signal_all( objs_shm[i], objs[i] );
             }
         } /* while (1) */
     } /* else (wait-all) */
diff --git a/server/msync.c b/server/msync.c
index bf5ce7e4..acf0d62d 100644
--- a/server/msync.c
+++ b/server/msync.c
@@ -416,20 +416,14 @@ static inline mach_msg_return_t destroy_all( unsigned int shm_idx )
 }
 
 
-/* An auto-reset event, its server-side twin and a mutex release exactly one
- * waiter. Waking the rest buys them a trip through the scheduler to find the
- * object already taken, so wake one and leave them asleep. */
+/* Every type wakes all, as CrossOver 26.3 does. A wait-all leg parks on the
+ * object's word only to look at it, so a wake-one could pick that leg and
+ * leave a single waiter asleep with the object signalled. Parking those legs
+ * on the pump instead kept wake-one but measured slower than the plain
+ * wineserver: a wait-all's wake took 10.6-11.3 us against its 9.1-9.2 us. */
 static inline uint32_t wake_flags( unsigned short msync_type )
 {
-    switch (msync_type)
-    {
-    case MSYNC_AUTO_EVENT:
-    case MSYNC_AUTO_SERVER:
-    case MSYNC_MUTEX:
-        return 0;
-    default:
-        return ULF_WAKE_ALL;
-    }
+    return ULF_WAKE_ALL;
 }
 
 static inline mach_msg_return_t signal_all( unsigned int shm_idx, int *shm )
@@ -823,8 +817,8 @@ void msync_abandon_mutexes( thread_id_t tid )
         {
             if (debug_level)
                 fprintf( stderr, "msync_abandon_mutexes() idx=%d\n", msync->shm_idx );
-            mutex->tid = ~0;
             mutex->count = 0;
+            __atomic_store_n( &mutex->tid, ~0, __ATOMIC_SEQ_CST );
             signal_all ( msync->shm_idx, (int *)mutex );
         }
     }
-- 
