From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Sun, 4 Oct 2026 16:40:09 -0400
Subject: [PATCH] ntdll: Toggle x18 on above the new callback frame, and check
 the toggle's layout.

call_user_mode_callback (patch 0004) moved sp to the new syscall frame before
the ON toggle, on every callback. From that "mov sp, x1" to "mov sp, x20" the
thread published thread_data->syscall_frame while the frame held only
prev_frame and syscall_cfa, and sp sat at it, so is_inside_syscall() was true:
a suspend there (usr1_handler) ran NtGetContextThread/NtSetContextThread on
that frame. The suspender read stale pc, sp and x[] left on the kernel stack
by earlier calls, and a SetThreadContext made in the window was lost, since the
next syscall entry overwrites the frame and clears restore_flags. Stop-the-world
GCs (Mono, Boehm, .NET) suspend threads and read SP to scan stacks.

Restore upstream's ordering: sp moves to the frame only in the trace branch
(for trace_usercall, as upstream does) and comes back to the old sp after it;
the ON toggle runs on the old sp, above the frame, as upstream's own
three-instruction window does. The toggle routine uses at most 0x10 bytes of
stack (stp/ldp x20,x21 on its trap paths), at old sp - 0x10, which is the top
of the unwritten frame (v[31]), on a path that is fatal anyway; prev_frame is
0x220 below the old sp. With sp on the kernel stack above the frame,
is_inside_syscall() is false there: usr1_handler saves the signal context,
usr2_handler returns early, quit_handler's user_mode_abort_thread reads only
frame->syscall_cfa (written before the toggle), and x18_call's OFF check fires
only for an sp inside the TEB stack. Every register and toggle invariant of
0004 is kept: x19-x21 hold teb, user_sp and func across the toggle, x18 is set
after it, and the user-stack label still resumes at x21.

signal_init_process also checks, outside signal context, that the words at
os_set_custom_x18_abi_enabled + 0x58 and + 0x78 are brk #1 (0xd4200020), the
layout x18_toggle_trap's 0x80-byte window assumes (macOS 27), and prints one
ERR line naming the offsets when they are not.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 dlls/ntdll/unix/signal_arm64.c | 23 ++++++++++++++++-------
 1 file changed, 16 insertions(+), 7 deletions(-)

diff --git a/dlls/ntdll/unix/signal_arm64.c b/dlls/ntdll/unix/signal_arm64.c
index b08f431c..d16e201d 100644
--- a/dlls/ntdll/unix/signal_arm64.c
+++ b/dlls/ntdll/unix/signal_arm64.c
@@ -938,19 +938,23 @@ __ASM_GLOBAL_FUNC( call_user_mode_callback,
                    "mov x19, x4\n\t"              /* teb */
                    "mov x20, x0\n\t"              /* user_sp */
                    "mov x21, x3\n\t"              /* func */
-                   "mov sp, x1\n\t"               /* below the new frame for the calls */
                    "ldr w11, [x19, #0x380]\n\t"   /* thread_data->syscall_trace */
-                   "cbz x11, 1f\n\t"
-                   "ldr x1, [x20]\n\t"            /* args */
-                   "ldp w2, w0, [x20, #8]\n\t"    /* len, id */
-                   "str x0, [x29, #0xc0]\n\t"     /* id */
-                   "bl " __ASM_NAME("trace_usercall") "\n"
+                   "cbnz x11, 2f\n"
+                   /* the toggle on the old sp: sp never sits at or below the new frame, which holds only prev_frame
+                    * and syscall_cfa, so a suspend here (not inside a syscall) saves the signal context instead */
                    "1:\t" X18_TOGGLE(1)
                    "mov x18, x19\n\t"             /* teb */
                    /* switch to user stack */
                    "mov sp, x20\n\t"              /* user_sp */
                    __ASM_LOCAL_LABEL("call_user_mode_callback_user_stack") ":\n\t"
-                   "br x21" )
+                   "br x21\n"
+                   "2:\tmov sp, x1\n\t"
+                   "ldr x1, [x20]\n\t"            /* args */
+                   "ldp w2, w0, [x20, #8]\n\t"    /* len, id */
+                   "str x0, [x29, #0xc0]\n\t"     /* id */
+                   "bl " __ASM_NAME("trace_usercall") "\n\t"
+                   "mov sp, x29\n\t"              /* back to the old sp for the toggle */
+                   "b 1b" )
 
 
 /***********************************************************************
@@ -1681,6 +1685,11 @@ void signal_init_process( TEB *teb )
         const char *selftest = getenv( "WINE_X18_SELFTEST" );
         x18_selftest = selftest && !strcmp( selftest, "double_on" );  /* before SIGTRAP is handled */
     }
+    /* x18_toggle_trap's 0x80 window assumes the toggle's brk #1 at +0x58 and +0x78 */
+    if (*(const UINT *)((ULONG_PTR)os_set_custom_x18_abi_enabled + 0x58) != 0xd4200020 ||
+        *(const UINT *)((ULONG_PTR)os_set_custom_x18_abi_enabled + 0x78) != 0xd4200020)
+        ERR( "os_set_custom_x18_abi_enabled has no brk #1 at +0x58 and +0x78: an unbalanced x18 toggle may not be "
+             "recognised\n" );
 #endif
     sig_act.sa_sigaction = X18_HANDLER( int_handler );
     if (sigaction( SIGINT, &sig_act, NULL ) == -1) goto error;
