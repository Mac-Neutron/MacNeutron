     ok(cs.OwningThread == ULongToHandle(GetCurrentThreadId()), "unexpected OwningThread\n");
@@ -3107,7 +3106,6 @@ static void test_RtlLeaveCriticalSection(void)
     /* entering section fixes RecursionCount */
