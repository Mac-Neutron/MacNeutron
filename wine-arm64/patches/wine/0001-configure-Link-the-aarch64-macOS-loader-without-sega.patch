From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Fri, 2 Oct 2026 22:36:30 -0400
Subject: [PATCH] configure: Link the aarch64 macOS loader without
 -segalign/-pagezero_size.

The arm64 kernel SIGKILLs a binary linked with a custom pagezero or segalign.
Keep the default 4GB __PAGEZERO; an entitled loader releases it at runtime.
---
 configure    | 4 ++++
 configure.ac | 5 +++++
 2 files changed, 9 insertions(+)

diff --git a/configure b/configure
index e2065aef..6b9a7809 100755
--- a/configure
+++ b/configure
@@ -12444,6 +12444,10 @@ else case e in #(
 esac
 fi
         ;;
+      aarch64)
+                WINELOADER_LDFLAGS="-Wl,-sectcreate,__TEXT,__info_plist,loader/wine_info.plist"
+        wine_use_preloader=no
+        ;;
       *)    wine_use_preloader=no ;;
     esac
 
diff --git a/configure.ac b/configure.ac
index f1fccbd2..0a888ce1 100644
--- a/configure.ac
+++ b/configure.ac
@@ -998,6 +998,11 @@ case $host_os in
             WINELOADER_LDFLAGS="$WINELOADER_LDFLAGS -Wl,-no_pie,-image_base,0x200000000,-no_huge,-no_fixup_chains,-segalign,0x1000,-segaddr,WINE_RESERVE,0x1000"],
            [wine_use_preloader=yes])
         ;;
+      aarch64)
+        dnl arm64 kills a binary with a custom pagezero or segalign: keep only the info plist
+        WINELOADER_LDFLAGS="-Wl,-sectcreate,__TEXT,__info_plist,loader/wine_info.plist"
+        wine_use_preloader=no
+        ;;
       *)    wine_use_preloader=no ;;
     esac
 
