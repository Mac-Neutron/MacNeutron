From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Fri, 2 Oct 2026 22:44:27 -0400
Subject: [PATCH] ntdll: Exec the macOS arm64 loader with 4K pages.

All loader execs (initial re-exec, new Windows processes) go through
preloader_exec; use posix_spawn(POSIX_SPAWN_SETEXEC) with
posix_spawnattr_set_4k_page_size_np. A failed spawn still falls through
to execv here; patch 7 refuses an unentitled loader before the spawn and
removes that 16K fallback.
---
 dlls/ntdll/unix/loader.c | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/dlls/ntdll/unix/loader.c b/dlls/ntdll/unix/loader.c
index ebfb6af5..a6dc64c1 100644
--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -451,6 +451,18 @@ static void preloader_exec( char **argv )
 #endif
     execv( argv[0], argv );
     free( argv[0] );
+#endif
+#if defined(__APPLE__) && defined(__aarch64__)
+    {
+        /* exec with 4K pages; the kernel only honors this for a loader signed with
+         * com.apple.developer.cross-architecture-support, an unentitled target is SIGKILLed; patch 7 checks first */
+        posix_spawnattr_t attr;
+        posix_spawnattr_init( &attr );
+        posix_spawnattr_setflags( &attr, POSIX_SPAWN_SETEXEC );
+        posix_spawnattr_set_4k_page_size_np( &attr );
+        posix_spawn( NULL, argv[1], NULL, &attr, argv + 1, *_NSGetEnviron() );
+        posix_spawnattr_destroy( &attr );
+    }
 #endif
     execv( argv[1], argv + 1 );
 }
