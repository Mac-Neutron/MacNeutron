From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Fri, 2 Oct 2026 22:45:08 -0400
Subject: [PATCH] ntdll: Toggle the custom x18 ABI at every PE/unix boundary on
 macOS arm64.

Apple's contract (os/arch/arm64.h, macOS 26.4) is that only code that
needs x18 runs with the custom x18 ABI on, and no macOS library code runs
with it on. Following MacNeutron's design in
docs/research/2026-10-02-native-arm64/x18-boundaries.md (design (b)) and
the ship-base spec's section 9, PE code runs with the mode on, so the
kernel keeps the TEB in x18, and unix code runs with it off:

- __wine_syscall_dispatcher and __wine_unix_call_dispatcher turn it off
  at their kernel-stack labels, and on again on the way back to PE code,
  before x18 is reloaded; call_user_mode_callback turns it on before it
  enters the callback. The registers still live across a toggle are
  parked in callee-saved registers or below the syscall frame (not in
  frame->x[], which a suspend may rewrite). The x18 reads that would run
  with the mode off moved before the toggle; __wine_syscall_dispatcher_return,
  where a fault in a syscall resumes, reads the TEB from the frame.
- The nine signal handlers run through a wrapper that turns the mode off
  on entry and on at exit when the handler sends the thread into PE code
  (SIGUSR1 and SIGINT keep the mode they found).
- A toggle to the mode already set traps (brk #1) in
  os_set_custom_x18_abi_enabled; that SIGTRAP is passed to the default
  action instead of becoming a Windows exception, so an imbalance kills
  the process (status 133).
- A signal that finds the thread on its PE stack with the mode off writes
  "x18: PE stack running OFF" and aborts.
- WINE_X18_SELFTEST=double_on enables the mode twice at process start,
  to test the trap pass-through.

This replaces turning the mode on once per thread in init_syscall_frame.
---
 dlls/ntdll/unix/signal_arm64.c | 198 +++++++++++++++++++++++++++------
 1 file changed, 163 insertions(+), 35 deletions(-)

diff --git a/dlls/ntdll/unix/signal_arm64.c b/dlls/ntdll/unix/signal_arm64.c
index aa77d8a0..ce05b134 100644
--- a/dlls/ntdll/unix/signal_arm64.c
+++ b/dlls/ntdll/unix/signal_arm64.c
@@ -57,6 +57,10 @@
 #include "winternl.h"
 #include "wine/asm.h"
 #include "unix_private.h"
+#ifdef __APPLE__
+# include <dlfcn.h>
+# include <os/arch/arm64.h>
+#endif
 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(seh);
@@ -877,6 +881,18 @@ NTSTATUS call_user_exception_dispatcher( struct thread_data *data, EXCEPTION_REC
 }
 
 
+#ifdef __APPLE__
+/* Strict x18 (docs/research/2026-10-02-native-arm64/x18-boundaries.md): PE code runs with the custom x18 ABI on, so
+ * the kernel keeps the TEB in x18; unix code, which calls macOS libraries, runs with it off, as Apple's contract asks.
+ * The dispatchers turn it off on the way in and on on the way out, with the registers they still need parked in
+ * callee-saved ones or on the kernel stack; the signal handlers' wrapper (x18_call) does the same around them. An
+ * unbalanced toggle traps in os_set_custom_x18_abi_enabled, and the trap kills the process. While the mode is off,
+ * the kernel zeroes x18 at every exception return, so nothing there reads it. */
+# define X18_TOGGLE(on) "mov w0, #" #on "\n\t" "bl " __ASM_NAME("os_set_custom_x18_abi_enabled") "\n\t"
+#else
+# define X18_TOGGLE(on) ""
+#endif
+
 /***********************************************************************
  *           call_user_mode_callback
  */
@@ -909,36 +925,33 @@ __ASM_GLOBAL_FUNC( call_user_mode_callback,
                    "stp d12, d13, [x29, #0x80]\n\t"
                    "stp d14, d15, [x29, #0x90]\n\t"
                    "stp x1, x2, [x29, #0xa0]\n\t" /* ret_ptr, ret_len */
-                   "mov x18, x4\n\t"              /* teb */
                    "mrs x1, fpcr\n\t"
                    "mrs x2, fpsr\n\t"
                    "bfi x1, x2, #0, #32\n\t"
-                   "ldr x2, [x18]\n\t"            /* teb->Tib.ExceptionList */
+                   "ldr x2, [x4]\n\t"             /* teb->Tib.ExceptionList */
                    "stp x1, x2, [x29, #0xb0]\n\t"
 
-                   "ldr x7, [x18, #0x378]\n\t"    /* thread_data->syscall_frame */
+                   "ldr x7, [x4, #0x378]\n\t"     /* thread_data->syscall_frame */
                    "sub x1, sp, #0x330\n\t"       /* sizeof(struct syscall_frame) */
-                   "str x1, [x18, #0x378]\n\t"    /* thread_data->syscall_frame */
+                   "str x1, [x4, #0x378]\n\t"     /* thread_data->syscall_frame */
                    "add x8, x29, #0xd0\n\t"
                    "stp x7, x8, [x1, #0x110]\n\t" /* frame->prev_frame,syscall_cfa */
-                   "ldr w11, [x18, #0x380]\n\t"   /* thread_data->syscall_trace */
-                   "cbnz x11, 2f\n\t"
-                   /* switch to user stack */
-                   "1:mov sp, x0\n\t"             /* user_sp */
-                   __ASM_LOCAL_LABEL("call_user_mode_callback_user_stack") ":\n\t"
-                   "br x3\n"
-                   "2:\tmov x19, x18\n\t"         /* teb */
+                   "mov x19, x4\n\t"              /* teb */
                    "mov x20, x0\n\t"              /* user_sp */
                    "mov x21, x3\n\t"              /* func */
-                   "mov sp, x1\n\t"
+                   "mov sp, x1\n\t"               /* below the new frame for the calls */
+                   "ldr w11, [x19, #0x380]\n\t"   /* thread_data->syscall_trace */
+                   "cbz x11, 1f\n\t"
                    "ldr x1, [x20]\n\t"            /* args */
                    "ldp w2, w0, [x20, #8]\n\t"    /* len, id */
                    "str x0, [x29, #0xc0]\n\t"     /* id */
-                   "bl " __ASM_NAME("trace_usercall") "\n\t"
+                   "bl " __ASM_NAME("trace_usercall") "\n"
+                   "1:\t" X18_TOGGLE(1)
                    "mov x18, x19\n\t"             /* teb */
-                   "mov x0, x20\n\t"              /* user_sp */
-                   "mov x3, x21\n\t"
-                   "b 1b" )
+                   /* switch to user stack */
+                   "mov sp, x20\n\t"              /* user_sp */
+                   __ASM_LOCAL_LABEL("call_user_mode_callback_user_stack") ":\n\t"
+                   "br x21" )
 
 
 /***********************************************************************
@@ -1453,7 +1466,7 @@ static void usr1_handler( int signal, siginfo_t *siginfo, void *_sigcontext )
     }
     else if (PC_sig(sigcontext) == call_user_mode_callback_user_stack_ptr)
     {
-        PC_sig(sigcontext) = REGn_sig(3, sigcontext);
+        PC_sig(sigcontext) = REGn_sig(21, sigcontext);
     }
 
     if (!data->teb)
@@ -1541,6 +1554,82 @@ static void usr2_handler( int signal, siginfo_t *siginfo, void *_sigcontext )
 }
 
 
+#ifdef __APPLE__
+/**********************************************************************
+ *           x18_toggle_trap
+ *
+ * Whether a SIGTRAP is os_set_custom_x18_abi_enabled's brk #1: a toggle to the mode already set.
+ */
+static BOOL x18_toggle_trap( ucontext_t *sigcontext )
+{
+    DWORD64 esr = get_fault_esr( sigcontext );
+    Dl_info info;
+
+    return ESR_ELx_EC(esr) == ESR_ELx_EC_BRK64 && ESR_ELx_ISS_BRK_COMMENT(esr) == 1 &&
+           dladdr( (void *)PC_sig(sigcontext), &info ) &&
+           info.dli_saddr == (void *)os_set_custom_x18_abi_enabled;
+}
+
+
+/**********************************************************************
+ *           x18_call
+ *
+ * Runs a signal handler with the custom x18 ABI off, as unix code runs, and leaves it on when the handler sends the
+ * thread into PE code (keep: the handler's resumes go back to where the mode was already right). A toggle trap kills
+ * the process, and PE code found running with the mode off aborts it: both are bugs in the toggling, which no
+ * Windows exception handler should see.
+ */
+static void x18_call( void (*handler)( int, siginfo_t *, void * ), BOOL keep, int sig, siginfo_t *siginfo,
+                      void *_sigcontext )
+{
+    static const char off_msg[] = "x18: PE stack running OFF\n";
+    ucontext_t *sigcontext = _sigcontext;
+    ULONG_PTR pc = PC_sig(sigcontext), sp = SP_sig(sigcontext);
+    BOOL was_on = os_custom_x18_abi_enabled(), on;
+    struct thread_data *data;
+
+    if (was_on) os_set_custom_x18_abi_enabled( false );  /* before any libc call */
+    if (sig == SIGTRAP && x18_toggle_trap( sigcontext ))
+    {
+        signal( SIGTRAP, SIG_DFL );  /* the brk runs again on return, and kills the process */
+        return;
+    }
+    data = get_thread_data();
+    if (!was_on && data && data->teb && !is_inside_syscall( data, sp ) &&
+        sp >= (ULONG_PTR)data->teb->DeallocationStack && sp < (ULONG_PTR)data->teb->Tib.StackBase)
+    {
+        write( 2, off_msg, sizeof(off_msg) - 1 );
+        signal( SIGABRT, SIG_DFL );  /* abort, not a Windows exception */
+        abort();
+    }
+
+    handler( sig, siginfo, _sigcontext );
+
+    if (keep || (PC_sig(sigcontext) == pc && SP_sig(sigcontext) == sp) || !data || !data->teb) on = was_on;
+    else on = PC_sig(sigcontext) == (ULONG_PTR)pKiUserExceptionDispatcher ||
+              PC_sig(sigcontext) == (ULONG_PTR)pKiUserEmulationDispatcher ||
+              !is_inside_syscall( data, SP_sig(sigcontext) );
+    if (on) os_set_custom_x18_abi_enabled( true );  /* the kernel restores the saved x18 only when on */
+}
+
+#define X18_WRAP(name, keep) \
+    static void name##_x18( int sig, siginfo_t *siginfo, void *sigcontext ) \
+    { x18_call( name, keep, sig, siginfo, sigcontext ); }
+X18_WRAP( int_handler, TRUE )
+X18_WRAP( fpe_handler, FALSE )
+X18_WRAP( abrt_handler, FALSE )
+X18_WRAP( quit_handler, FALSE )
+X18_WRAP( usr1_handler, TRUE )
+X18_WRAP( usr2_handler, FALSE )
+X18_WRAP( trap_handler, FALSE )
+X18_WRAP( segv_handler, FALSE )
+X18_WRAP( ill_handler, FALSE )
+#define X18_HANDLER(name) name##_x18
+#else
+#define X18_HANDLER(name) name
+#endif
+
+
 /**********************************************************************
  *           get_thread_ldt_entry
  */
@@ -1580,25 +1669,33 @@ void signal_init_process( TEB *teb )
     sig_act.sa_mask = server_block_set;
     sig_act.sa_flags = SA_SIGINFO | SA_RESTART | SA_ONSTACK;
 
-    sig_act.sa_sigaction = int_handler;
+    sig_act.sa_sigaction = X18_HANDLER( int_handler );
     if (sigaction( SIGINT, &sig_act, NULL ) == -1) goto error;
-    sig_act.sa_sigaction = fpe_handler;
+    sig_act.sa_sigaction = X18_HANDLER( fpe_handler );
     if (sigaction( SIGFPE, &sig_act, NULL ) == -1) goto error;
-    sig_act.sa_sigaction = abrt_handler;
+    sig_act.sa_sigaction = X18_HANDLER( abrt_handler );
     if (sigaction( SIGABRT, &sig_act, NULL ) == -1) goto error;
-    sig_act.sa_sigaction = quit_handler;
+    sig_act.sa_sigaction = X18_HANDLER( quit_handler );
     if (sigaction( SIGQUIT, &sig_act, NULL ) == -1) goto error;
-    sig_act.sa_sigaction = usr1_handler;
+    sig_act.sa_sigaction = X18_HANDLER( usr1_handler );
     if (sigaction( SIGUSR1, &sig_act, NULL ) == -1) goto error;
-    sig_act.sa_sigaction = usr2_handler;
+    sig_act.sa_sigaction = X18_HANDLER( usr2_handler );
     if (sigaction( SIGUSR2, &sig_act, NULL ) == -1) goto error;
-    sig_act.sa_sigaction = trap_handler;
+    sig_act.sa_sigaction = X18_HANDLER( trap_handler );
     if (sigaction( SIGTRAP, &sig_act, NULL ) == -1) goto error;
-    sig_act.sa_sigaction = segv_handler;
+    sig_act.sa_sigaction = X18_HANDLER( segv_handler );
     if (sigaction( SIGBUS, &sig_act, NULL ) == -1) goto error;
     if (sigaction( SIGSEGV, &sig_act, NULL ) == -1) goto error;
-    sig_act.sa_sigaction = ill_handler;
+    sig_act.sa_sigaction = X18_HANDLER( ill_handler );
     if (sigaction( SIGILL, &sig_act, NULL ) == -1) goto error;
+#ifdef __APPLE__
+    /* T3 of the x18 check: an unbalanced toggle has to kill the process by SIGTRAP */
+    if (getenv( "WINE_X18_SELFTEST" ) && !strcmp( getenv( "WINE_X18_SELFTEST" ), "double_on" ))
+    {
+        os_set_custom_x18_abi_enabled( true );
+        os_set_custom_x18_abi_enabled( true );
+    }
+#endif
     return;
 
  error:
@@ -1777,10 +1874,23 @@ __ASM_GLOBAL_FUNC( __wine_syscall_dispatcher,
                    __ASM_LOCAL_LABEL("__wine_syscall_dispatcher_kernel_stack") ":\n\t"
                    "mov x22, sp\n\t"
                    __ASM_CFI_CFA_IS_AT2(x22, 0x98, 0x02) /* frame->syscall_cfa */
+                   "ldr x24, [x18, #0x370]\n\t" /* thread_data->syscall_table */
+                   "ldr w25, [x18, #0x380]\n\t" /* thread_data->syscall_trace */
+                   /* x18 off; the live arguments wait below the frame, whose x[] a suspend may rewrite */
+                   "stp x0, x1, [sp, #-0x50]!\n\t"
+                   "stp x2, x3, [sp, #0x10]\n\t"
+                   "stp x4, x5, [sp, #0x20]\n\t"
+                   "stp x6, x7, [sp, #0x30]\n\t"
+                   "stp x8, x11, [sp, #0x40]\n\t"
+                   X18_TOGGLE(0)
+                   "ldp x2, x3, [sp, #0x10]\n\t"
+                   "ldp x4, x5, [sp, #0x20]\n\t"
+                   "ldp x6, x7, [sp, #0x30]\n\t"
+                   "ldp x8, x11, [sp, #0x40]\n\t"
+                   "ldp x0, x1, [sp], #0x50\n\t"
                    "and x20, x8, #0xfff\n\t"    /* syscall number */
                    "ubfx x21, x8, #12, #2\n\t"  /* syscall table number */
-                   "ldr x16, [x18, #0x370]\n\t" /* thread_data->syscall_table */
-                   "add x21, x16, x21, lsl #5\n\t"
+                   "add x21, x24, x21, lsl #5\n\t"
                    "ldr x16, [x21, #16]\n\t"    /* table->ServiceLimit */
                    "cmp x20, x16\n\t"
                    "bcs " __ASM_LOCAL_LABEL("bad_syscall") "\n\t"
@@ -1797,8 +1907,7 @@ __ASM_GLOBAL_FUNC( __wine_syscall_dispatcher,
                    "cbnz x9, 1b\n"
                    "2:\tldr x16, [x21]\n\t"     /* table->ServiceTable */
                    "ldr x23, [x16, x20, lsl 3]\n\t"
-                   "ldr w11, [x18, #0x380]\n\t" /* thread_data->syscall_trace */
-                   "cbnz x11, " __ASM_LOCAL_LABEL("trace_syscall") "\n\t"
+                   "cbnz w25, " __ASM_LOCAL_LABEL("trace_syscall") "\n\t"
                    "blr x23\n\t"
                    "mov sp, x22\n"
                    __ASM_CFI_CFA_IS_AT2(sp, 0x98, 0x02) /* frame->syscall_cfa */
@@ -1806,14 +1915,21 @@ __ASM_GLOBAL_FUNC( __wine_syscall_dispatcher,
                    "ldr w16, [sp, #0x10c]\n\t"  /* frame->restore_flags */
                    "tbz x16, #16, 1f\n\t"       /* RESTORE_FLAGS_EMULATION */
                    "bl " __ASM_NAME("syscall_dispatcher_return_slowpath") "\n"
-                   "1:\ttbz x16, #1, 2f\n"      /* CONTEXT_INTEGER */
+                   "1:\ttbz x16, #1, 1f\n"      /* CONTEXT_INTEGER */
                    "ldp x12, x13, [sp, #0x80]\n\t" /* frame->x[16..17] */
                    "ldp x14, x15, [sp, #0xf8]\n\t" /* frame->sp, frame->pc */
                    "cmp x12, x15\n\t"              /* frame->x16 == frame->pc? */
                    "ccmp x13, x14, #0, eq\n\t"     /* frame->x17 == frame->sp? */
                    "beq 1f\n\t"                    /* take slowpath if unequal */
                    "bl " __ASM_NAME("syscall_dispatcher_return_slowpath") "\n"
-                   "1:\tldp x0, x1, [sp, #0x00]\n\t"
+                   /* x18 on; x0 and x16 wait in x19 and x20, which are reloaded below */
+                   "1:\tmov x19, x0\n\t"
+                   "mov x20, x16\n\t"
+                   X18_TOGGLE(1)
+                   "mov x0, x19\n\t"
+                   "mov x16, x20\n\t"
+                   "tbz x16, #1, 2f\n\t"        /* CONTEXT_INTEGER */
+                   "ldp x0, x1, [sp, #0x00]\n\t"
                    "ldp x2, x3, [sp, #0x10]\n\t"
                    "ldp x4, x5, [sp, #0x20]\n\t"
                    "ldp x6, x7, [sp, #0x30]\n\t"
@@ -1887,7 +2003,8 @@ __ASM_GLOBAL_FUNC( __wine_syscall_dispatcher,
                    "b " __ASM_LOCAL_LABEL("__wine_syscall_dispatcher_return") )
 
 __ASM_GLOBAL_FUNC( __wine_syscall_dispatcher_return,
-                   "ldr w11, [x18, #0x380]\n\t" /* thread_data->syscall_trace */
+                   "ldr x11, [sp, #0x90]\n\t"   /* frame->x[18]: the TEB, as x18 is off */
+                   "ldr w11, [x11, #0x380]\n\t" /* thread_data->syscall_trace */
                    "cbnz x11, " __ASM_LOCAL_LABEL("trace_syscall_ret") "\n\t"
                    "b " __ASM_LOCAL_LABEL("__wine_syscall_dispatcher_return") )
 
@@ -1931,12 +2048,23 @@ __ASM_GLOBAL_FUNC( __wine_unix_call_dispatcher,
                    __ASM_LOCAL_LABEL("__wine_unix_call_dispatcher_kernel_stack") ":\n\t"
                    "mov x19, sp\n\t"
                    __ASM_CFI_CFA_IS_AT2(x19, 0x98, 0x02) /* frame->syscall_cfa */
-                   "ldr x16, [x0, x1, lsl 3]\n\t"
-                   "mov x0, x2\n\t"             /* args */
+                   /* x18 off; x0-x2 wait in x20-x22 */
+                   "mov x20, x0\n\t"
+                   "mov x21, x1\n\t"
+                   "mov x22, x2\n\t"
+                   X18_TOGGLE(0)
+                   "ldr x16, [x20, x21, lsl 3]\n\t"
+                   "mov x0, x22\n\t"            /* args */
                    "blr x16\n\t"
                    "ldr w16, [sp, #0x10c]\n\t"  /* frame->restore_flags */
                    "cbnz w16, " __ASM_LOCAL_LABEL("__wine_syscall_dispatcher_return") "\n\t"
                    __ASM_CFI_CFA_IS_AT2(sp, 0x98, 0x02) /* frame->syscall_cfa */
+                   /* x18 on; x0 waits in x20 */
+                   "mov x20, x0\n\t"
+                   X18_TOGGLE(1)
+                   "mov x0, x20\n\t"
+                   "ldp x20, x21, [sp, #0xa0]\n\t"
+                   "ldp x22, x23, [sp, #0xb0]\n\t"
                    "ldp x18, x19, [sp, #0x90]\n\t"
                    "ldp x16, x17, [sp, #0xf8]\n\t"
                    /* switch to user stack */
