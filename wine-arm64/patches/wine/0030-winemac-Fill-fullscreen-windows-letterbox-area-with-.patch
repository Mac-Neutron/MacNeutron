From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Wed, 7 Oct 2026 20:06:32 -0400
Subject: [PATCH] winemac: Fill fullscreen windows' letterbox area with black.

With EmulateModeset, a fullscreen window whose mode has another aspect
than the screen covers the whole monitor and its window rect is
letterboxed inside it. setMask: is meant to cover the rest with black,
but the bars showed white (the window surface starts 0xff and its
unpainted pixels sit under the bars). Make the black hold:

- Pass the mask rect relative to the visible rect, as setMask: expects
  content view coordinates, and convert it with cgrect_mac_from_win.
- Size the bars layer from the view's bounds, not its layer's, which can
  still have the size from before the frame change.
- Re-add the bars layer in updateLayer if AppKit dropped it.
- Use a black window background while the mask is set, so transparent
  (shaped) or not yet drawn parts of the bars are black too.

Only windows that get WINE_SWP_FULLSCREEN with window != visible rect
are affected; other windows keep windowBackgroundColor.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 dlls/winemac.drv/cocoa_window.m | 20 +++++++++++++++-----
 dlls/winemac.drv/window.c       |  6 +++++-
 2 files changed, 20 insertions(+), 6 deletions(-)

diff --git a/dlls/winemac.drv/cocoa_window.m b/dlls/winemac.drv/cocoa_window.m
index b883740f..4aec4dbc 100644
--- a/dlls/winemac.drv/cocoa_window.m
+++ b/dlls/winemac.drv/cocoa_window.m
@@ -409,6 +409,10 @@ - (void) updateLayer
         image = CGImageCreateWithImageInRect(maskedImage, imageRect);
         CGImageRelease(maskedImage);
 
+        /* AppKit owns this layer's sublayers; put the letterbox bars back if it dropped them */
+        if (window.contentViewMaskLayer && window.contentViewMaskLayer.superlayer != layer)
+            [layer addSublayer:window.contentViewMaskLayer];
+
         if (image)
         {
             layer.position = surfaceRect.origin;
@@ -1962,14 +1966,14 @@ - (void) checkTransparency
         {
             self.shapeChangedSinceLastDraw = TRUE;
             [[self contentView] setNeedsDisplay:YES];
-            [self setBackgroundColor:[NSColor windowBackgroundColor]];
+            [self setBackgroundColor:self.contentViewMaskLayer ? [NSColor blackColor] : [NSColor windowBackgroundColor]];
             [self setOpaque:YES];
         }
         else if ([self isOpaque] && self.needsTransparency)
         {
             self.shapeChangedSinceLastDraw = TRUE;
             [[self contentView] setNeedsDisplay:YES];
-            [self setBackgroundColor:[NSColor clearColor]];
+            [self setBackgroundColor:self.contentViewMaskLayer ? [NSColor blackColor] : [NSColor clearColor]];
             [self setOpaque:NO];
         }
     }
@@ -2556,16 +2560,22 @@ - (void) setMask:(CGRect)rect
         {
             [self.contentViewMaskLayer removeFromSuperlayer];
             self.contentViewMaskLayer = nil;
+            [self setBackgroundColor:[self isOpaque] ? [NSColor windowBackgroundColor] : [NSColor clearColor]];
         }
 
         if (CGRectIsEmpty(rect))
             return;
 
+        /* Whatever shows through the bars (the window's own unpainted surface
+         * or the window background) must be black too. */
+        [self setBackgroundColor:[NSColor blackColor]];
+        rect = cgrect_mac_from_win(rect);
+
         CAShapeLayer *shapeLayer = [CAShapeLayer layer];
-        shapeLayer.bounds = self.contentView.layer.bounds;
-        shapeLayer.position = self.contentView.layer.position;
+        /* The view's bounds, not its layer's: the layer can still have the
+         * size from before the frame change that made the window fullscreen. */
+        shapeLayer.frame = NSRectToCGRect(self.contentView.bounds);
         shapeLayer.geometryFlipped = self.contentView.layer.geometryFlipped;
-        shapeLayer.anchorPoint = self.contentView.layer.anchorPoint;
         shapeLayer.fillColor = CGColorGetConstantColor(kCGColorBlack);
 
         CGMutablePathRef path = CGPathCreateMutable();
diff --git a/dlls/winemac.drv/window.c b/dlls/winemac.drv/window.c
index 97124882..829edac8 100644
--- a/dlls/winemac.drv/window.c
+++ b/dlls/winemac.drv/window.c
@@ -1781,7 +1781,11 @@ void macdrv_WindowPosChanged(HWND hwnd, HWND insert_after, HWND owner_hint, UINT
 
     if (fullscreen || fullscreen != data->fullscreen)
     {
-        CGRect rect = (fullscreen && !EqualRect(&data->rects.window, &data->rects.visible)) ? cgrect_from_rect(data->rects.window) : CGRectZero;
+        CGRect rect = CGRectZero;
+
+        /* the mask is in content view coordinates, which start at the visible rect */
+        if (fullscreen && !EqualRect(&data->rects.window, &data->rects.visible))
+            rect = CGRectOffset(cgrect_from_rect(data->rects.window), -data->rects.visible.left, -data->rects.visible.top);
         macdrv_set_window_mask(data->cocoa_window, rect);
         data->fullscreen = fullscreen;
     }
