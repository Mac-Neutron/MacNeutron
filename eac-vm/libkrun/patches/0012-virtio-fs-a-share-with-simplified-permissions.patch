+ */
+KrunFsDevice krun_fs_device_new_simplified(KrunStr tag, KrunStr host_path, KrunError* err_out);
+typedef KrunFsDevice (*krun_fs_device_new_simplified_fn)(KrunStr tag, KrunStr host_path, KrunError* err_out);
