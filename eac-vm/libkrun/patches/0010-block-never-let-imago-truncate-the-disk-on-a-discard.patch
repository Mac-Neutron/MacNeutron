From 3f6c1671089c428e036c9897460d21b5e980b83e Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Wed, 21 Oct 2026 17:42:04 -0400
Subject: [PATCH] block: never let imago truncate the disk on a discard or
 write-zeroes at its end

imago's file storage handles a discard or write-zeroes reaching the
file's end by truncating the file to the range's start. The disk keeps
its size for the run, but the next boot finds the image shorter than
its filesystem: ext4's fsck fails and the guest doesn't mount it. The
disk's last 4 KiB is kept out of such a request: a discard skips it,
a write-zeroes writes it as zeroes.

Assisted-by: Claude Code: claude-opus-5-5
---
 src/devices/src/virtio/block/worker.rs | 141 ++++++++++++++++++++-----
 1 file changed, 112 insertions(+), 29 deletions(-)

diff --git a/src/devices/src/virtio/block/worker.rs b/src/devices/src/virtio/block/worker.rs
index 9aec9fc2..f304d937 100644
--- a/src/devices/src/virtio/block/worker.rs
+++ b/src/devices/src/virtio/block/worker.rs
@@ -13,9 +13,61 @@ use utils::epoll::{ControlOperation, Epoll, EpollEvent, EventSet};
 use utils::eventfd::EventFd;
 #[cfg(target_os = "windows")]
 use utils::windows::AsRawFd;
+use imago::{DynStorage, FormatAccess};
 use virtio_bindings::virtio_blk::*;
 use vm_memory::{ByteValued, GuestMemoryMmap};
 
+/// The disk's last bytes a discard or write-zeroes never hands imago (MacNeutron).
+///
+/// imago's file storage "discards" a range that reaches the file's end by truncating the file to the
+/// range's start: the disk keeps its size for the rest of the run, and the next boot finds it shorter
+/// than its filesystem (ext4's fsck fails and the guest's /home, a game's state disk, isn't mounted).
+const KEPT_TAIL: u64 = 4096;
+
+/// `[offset, offset + length)` within a disk of `size` bytes, split where its kept tail begins:
+/// the part imago may have, and the part in the tail, each as (offset, length).
+fn split_tail(offset: u64, length: u64, size: u64) -> ((u64, u64), (u64, u64)) {
+    let start = offset.min(size);
+    let end = offset.saturating_add(length).min(size);
+    let cut = size.saturating_sub(KEPT_TAIL).clamp(start, end);
+    ((start, cut - start), (cut, end - cut))
+}
+
+/// A discard of `[offset, offset + length)` on `disk`, but for its kept tail (a discard is advisory).
+fn discard_keeping_tail(
+    disk: &mut FormatAccess<Box<dyn DynStorage>>,
+    offset: u64,
+    length: u64,
+) -> io::Result<()> {
+    let ((offset, length), _) = split_tail(offset, length, disk.size());
+    if length > 0 {
+        disk.discard_to_any(offset, length)?;
+    }
+    Ok(())
+}
+
+/// A write-zeroes of `[offset, offset + length)` on `disk`, discarding to zero if `unmap`; the kept
+/// tail's part is written as zeroes.
+fn zero_keeping_tail(
+    disk: &mut FormatAccess<Box<dyn DynStorage>>,
+    offset: u64,
+    length: u64,
+    unmap: bool,
+) -> io::Result<()> {
+    let ((offset, length), (tail, tail_length)) = split_tail(offset, length, disk.size());
+    if length > 0 {
+        if unmap {
+            disk.discard_to_zero(offset, length)?;
+        } else {
+            disk.write_zeroes(offset, length)?;
+        }
+    }
+    if tail_length > 0 {
+        disk.write(&vec![0u8; tail_length as usize], tail)?;
+    }
+    Ok(())
+}
+
 #[allow(dead_code)]
 #[derive(Debug)]
 pub enum RequestError {
@@ -266,15 +318,12 @@ impl BlockWorker {
                 let discard_write_data: DiscardWriteData = reader
                     .read_obj()
                     .map_err(RequestError::ReadingFromDescriptor)?;
-                self.disk
-                    .file
-                    .lock()
-                    .unwrap()
-                    .discard_to_any(
-                        discard_write_data.sector * 512,
-                        discard_write_data.num_sectors as u64 * 512,
-                    )
-                    .map_err(RequestError::Discarding)?;
+                discard_keeping_tail(
+                    &mut self.disk.file.lock().unwrap(),
+                    discard_write_data.sector * 512,
+                    discard_write_data.num_sectors as u64 * 512,
+                )
+                .map_err(RequestError::Discarding)?;
                 Ok(0)
             }
             VIRTIO_BLK_T_WRITE_ZEROES => {
@@ -282,30 +331,64 @@ impl BlockWorker {
                     .read_obj()
                     .map_err(RequestError::ReadingFromDescriptor)?;
                 let unmap = (discard_write_data.flags & VIRTIO_BLK_WRITE_ZEROES_FLAG_UNMAP) != 0;
-                if unmap {
-                    self.disk
-                        .file
-                        .lock()
-                        .unwrap()
-                        .discard_to_zero(
-                            discard_write_data.sector * 512,
-                            discard_write_data.num_sectors as u64 * 512,
-                        )
-                        .map_err(RequestError::DiscardingToZero)?;
+                zero_keeping_tail(
+                    &mut self.disk.file.lock().unwrap(),
+                    discard_write_data.sector * 512,
+                    discard_write_data.num_sectors as u64 * 512,
+                    unmap,
+                )
+                .map_err(if unmap {
+                    RequestError::DiscardingToZero
                 } else {
-                    self.disk
-                        .file
-                        .lock()
-                        .unwrap()
-                        .write_zeroes(
-                            discard_write_data.sector * 512,
-                            discard_write_data.num_sectors as u64 * 512,
-                        )
-                        .map_err(RequestError::WritingZeroes)?;
-                }
+                    RequestError::WritingZeroes
+                })?;
                 Ok(0)
             }
             _ => Err(RequestError::UnknownRequest),
         }
     }
 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use imago::{Storage, StorageOpenOptions, file::File as ImagoFile, raw::Raw};
+
+    const LEN: u64 = 1 << 20;
+
+    /// A raw image of `LEN` bytes, opened as the device opens one.
+    fn raw_disk(name: &str) -> (std::path::PathBuf, FormatAccess<Box<dyn DynStorage>>) {
+        let path =
+            std::env::temp_dir().join(format!("libkrun-block-{name}-{}", std::process::id()));
+        std::fs::File::create(&path).unwrap().set_len(LEN).unwrap();
+        let opts = StorageOpenOptions::new()
+            .write(true)
+            .filename(path.to_str().unwrap().to_owned());
+        let file = ImagoFile::open(opts).unwrap();
+        let raw = Raw::<Box<dyn DynStorage>>::open_image(Box::new(file), true).unwrap();
+        (path, FormatAccess::new(raw))
+    }
+
+    #[test]
+    fn a_discard_reaching_the_end_keeps_the_image_length() {
+        let (path, mut disk) = raw_disk("discard");
+        discard_keeping_tail(&mut disk, LEN / 2, LEN / 2).unwrap();
+        let len = std::fs::metadata(&path).unwrap().len();
+        std::fs::remove_file(&path).unwrap();
+        assert_eq!(len, LEN);
+    }
+
+    #[test]
+    fn write_zeroes_reaching_the_end_keeps_the_length_and_zeroes_it() {
+        let (path, mut disk) = raw_disk("zeroes");
+        for unmap in [false, true] {
+            disk.write(&vec![0xa5u8; 8192], LEN - 8192).unwrap();
+            zero_keeping_tail(&mut disk, LEN - 8192, 8192, unmap).unwrap();
+            let mut back = vec![1u8; 8192];
+            disk.read(&mut back, LEN - 8192).unwrap();
+            assert!(back.iter().all(|b| *b == 0), "unmap {unmap}: not zeroed");
+            assert_eq!(std::fs::metadata(&path).unwrap().len(), LEN, "unmap {unmap}");
+        }
+        std::fs::remove_file(&path).unwrap();
+    }
+}
