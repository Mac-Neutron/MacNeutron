From d76f975d486ee02b501da15e14442bea2d409e9c Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Thu, 15 Oct 2026 21:05:16 -0400
Subject: [PATCH 3/4] hvf: run every vCPU with Apple's TSO memory ordering
 (ACTLR_EL1.EnTSO)

Hypervisor.framework lets the host set EnTSO (ACTLR_EL1 bit 1) on a vCPU; a stock guest kernel never writes the
register, so the whole guest then orders memory like x86. MacNeutron's EAC guest runs x86 code under FEX on a signed
distribution kernel that has no PR_SET_MEM_MODEL: with EnTSO on every vCPU, FEX can drop its ordering barriers.
vCPU creation fails if the bit does not read back as set.
---
 src/hvf/src/lib.rs | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/src/hvf/src/lib.rs b/src/hvf/src/lib.rs
index 83b39d2f..66976766 100644
--- a/src/hvf/src/lib.rs
+++ b/src/hvf/src/lib.rs
@@ -412,6 +412,20 @@ impl HvfVcpu<'_> {
             return Err(Error::VcpuCreate);
         }
 
+        // Apple's EnTSO, bit 1 of ACTLR_EL1: the vCPU orders memory like x86 (TSO). A stock guest kernel never writes
+        // ACTLR_EL1, so every guest thread runs with TSO and an x86 translator such as FEX needs no ordering barriers.
+        const ACTLR_EL1_ENTSO: u64 = 1 << 1;
+        let reg = hv_sys_reg_t_HV_SYS_REG_ACTLR_EL1;
+        let mut actlr: u64 = 0;
+        if unsafe { hv_vcpu_get_sys_reg(vcpuid, reg, &mut actlr) } != HV_SUCCESS
+            || unsafe { hv_vcpu_set_sys_reg(vcpuid, reg, actlr | ACTLR_EL1_ENTSO) } != HV_SUCCESS
+            || unsafe { hv_vcpu_get_sys_reg(vcpuid, reg, &mut actlr) } != HV_SUCCESS
+            || actlr & ACTLR_EL1_ENTSO == 0
+        {
+            return Err(Error::VcpuSetSystemRegister(reg, actlr | ACTLR_EL1_ENTSO));
+        }
+        debug!("vCPU {vcpuid}: ACTLR_EL1 = 0x{actlr:x} (TSO)");
+
         let vcpu_exit: &hv_vcpu_exit_t = unsafe { vcpu_exit_ptr.as_mut().unwrap() };
 
         Ok(Self {
