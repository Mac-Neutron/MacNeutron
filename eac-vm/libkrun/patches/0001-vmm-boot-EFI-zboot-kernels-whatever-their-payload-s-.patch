From 59a5c0ea73e5ea4a0986247f03d8bbbe42ad9714 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Thu, 15 Oct 2026 20:37:41 -0400
Subject: [PATCH 1/4] vmm: boot EFI zboot kernels whatever their payload's
 compressor

arm64 distribution kernels (Fedora's vmlinuz among them) are EFI zboot images whose header names the payload's
offset, size and compressor; Fedora's is zstd, which the PeGz loader's gzip scan cannot find (PeGzInvalid). Read the
header and decode gzip or zstd; images without it keep the old scan. zstd becomes a dependency on every arch.
---
 src/libkrun/Cargo.toml         |  2 +-
 src/libkrun/src/vmm/builder.rs | 25 ++++++++++++++++++++++++-
 2 files changed, 25 insertions(+), 2 deletions(-)

diff --git a/src/libkrun/Cargo.toml b/src/libkrun/Cargo.toml
index 7d523624..3e05b3e6 100644
--- a/src/libkrun/Cargo.toml
+++ b/src/libkrun/Cargo.toml
@@ -28,6 +28,7 @@ bitflags = "2.10.0"
 crossbeam-channel = ">=0.5.15"
 env_logger = "0.11"
 flate2 = "1.0.35"
+zstd = "0.13"
 ffier = { git = "https://github.com/mtjhrc/ffier.git", tag = "v0.2.0-rc2", optional = true }
 ffier-builtins = { git = "https://github.com/mtjhrc/ffier.git", tag = "v0.2.0-rc2", optional = true }
 iocuddle = { version = "0.1.1", optional = true }
@@ -55,7 +56,6 @@ utils = { package = "krun-utils", version = "=0.1.0-2.0.0-dev", path = "../utils
 [target.'cfg(target_arch = "x86_64")'.dependencies]
 bzip2 = "0.5"
 cpuid = { package = "krun-cpuid", version = "=0.1.0-2.0.0-dev", path = "../cpuid" }
-zstd = "0.13"
 
 [target.'cfg(unix)'.dependencies]
 linux-loader = { version = "0.14.0", features = ["bzimage", "elf", "pe"] }
diff --git a/src/libkrun/src/vmm/builder.rs b/src/libkrun/src/vmm/builder.rs
index df64ef2d..dc7a841d 100644
--- a/src/libkrun/src/vmm/builder.rs
+++ b/src/libkrun/src/vmm/builder.rs
@@ -1429,7 +1429,30 @@ fn load_external_kernel(
         KernelFormat::PeGz => {
             let data: Vec<u8> = std::fs::read(external_kernel.path.clone())
                 .map_err(StartMicrovmError::PeGzOpenKernel)?;
-            if let Some(magic) = data
+            // An EFI zboot image (arm64 distribution kernels, Fedora's among them) describes its payload: "zimg" at 4,
+            // the payload's offset and size at 8 and 12, its compressor's name at 0x18.
+            if data.len() >= 0x20 && &data[4..8] == b"zimg" {
+                let field = |at: usize| u32::from_le_bytes(data[at..at + 4].try_into().unwrap()) as usize;
+                let (offset, size) = (field(8), field(12));
+                let payload = data
+                    .get(offset..offset + size)
+                    .ok_or(StartMicrovmError::PeGzInvalid)?;
+                let mut kernel_data: Vec<u8> = Vec::new();
+                match &data[0x18..0x1c] {
+                    b"gzip" => GzDecoder::new(payload)
+                        .read_to_end(&mut kernel_data)
+                        .map(|_| ())
+                        .map_err(StartMicrovmError::PeGzDecoder)?,
+                    b"zstd" => zstd::stream::copy_decode(payload, &mut kernel_data)
+                        .map_err(StartMicrovmError::PeGzDecoder)?,
+                    _ => return Err(StartMicrovmError::PeGzInvalid),
+                }
+                debug!("EFI zboot payload: {size} bytes at 0x{offset:x}, {} decompressed", kernel_data.len());
+                guest_mem
+                    .write(&kernel_data, GuestAddress(0x8000_0000))
+                    .unwrap();
+                GuestAddress(0x8000_0000)
+            } else if let Some(magic) = data
                 .windows(3)
                 .position(|window| window == [0x1f, 0x8b, 0x8])
             {
