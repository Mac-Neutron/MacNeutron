From 416f63c56339dbb8183818345f3c838bff79188f Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Thu, 15 Oct 2026 20:58:17 -0400
Subject: [PATCH 2/3] balloon: on macOS, take reported pages out of the VM
 before freeing them

While Hypervisor.framework maps a page a vCPU has written, madvise frees nothing (MADV_FREE and MADV_FREE_REUSABLE
alike): a guest that touched and freed 4 GiB left the host's physical footprint at 5.2 GB, although every 4 MB report
reached the device. The guest holds reported pages back until the descriptor is returned, so unmap the range from the
VM, MADV_FREE it and map it back: the footprint drops at once, and the guest's next write faults in a zero page that is
charged again. About 30 us per 4 MB report on an M5 Pro.
---
 src/devices/src/virtio/balloon/device.rs | 28 ++++++++++++++++++++----
 1 file changed, 24 insertions(+), 4 deletions(-)

diff --git a/src/devices/src/virtio/balloon/device.rs b/src/devices/src/virtio/balloon/device.rs
index 85b2812c..f2a5622b 100644
--- a/src/devices/src/virtio/balloon/device.rs
+++ b/src/devices/src/virtio/balloon/device.rs
@@ -94,16 +94,36 @@ impl Balloon {
                     desc.addr, host_addr, desc.len
                 );
                 #[cfg(target_os = "linux")]
-                let advice = libc::MADV_DONTNEED;
-                #[cfg(target_os = "macos")]
-                let advice = libc::MADV_FREE;
                 unsafe {
                     libc::madvise(
                         host_addr as *mut libc::c_void,
                         desc.len.try_into().unwrap(),
-                        advice,
+                        libc::MADV_DONTNEED,
                     )
                 };
+                // While the VM maps a page a vCPU has written, madvise frees nothing: the host process stays charged
+                // for every page the guest ever touched. The guest holds reported pages back until we return the
+                // descriptor, so take the range out of the VM, free it, and map it back; the guest's next write
+                // faults in a zero page that is charged again.
+                #[cfg(target_os = "macos")]
+                unsafe {
+                    use hvf::bindings::{
+                        hv_vm_map, hv_vm_unmap, HV_MEMORY_EXEC, HV_MEMORY_READ, HV_MEMORY_WRITE,
+                    };
+                    let len: usize = desc.len.try_into().unwrap();
+                    if hv_vm_unmap(desc.addr.0, len) == 0 {
+                        libc::madvise(host_addr as *mut libc::c_void, len, libc::MADV_FREE);
+                        if hv_vm_map(
+                            host_addr as *mut libc::c_void,
+                            desc.addr.0,
+                            len,
+                            (HV_MEMORY_READ | HV_MEMORY_WRITE | HV_MEMORY_EXEC).into(),
+                        ) != 0
+                        {
+                            error!("balloon: cannot map {:?}+{len} back into the VM", desc.addr);
+                        }
+                    }
+                }
             }
 
             have_used = true;
