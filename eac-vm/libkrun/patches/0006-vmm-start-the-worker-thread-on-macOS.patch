From c98be11a786ccfda7063fb2f74806c5611d3a939 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Fri, 16 Oct 2026 12:05:21 -0400
Subject: [PATCH 6/6] vmm: start the worker thread on macOS

The v2 builder starts the vmm worker only for SEV, TDX or an x86 split
irqchip, but on macOS the worker is what maps gpu blobs and virtiofs DAX
windows into the guest (WorkerMessage::GpuAddMapping). Without it the
first RESOURCE_MAP_BLOB panics the gpu worker on a closed channel.
---
 src/libkrun/src/api/vmm_builder.rs | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/libkrun/src/api/vmm_builder.rs b/src/libkrun/src/api/vmm_builder.rs
index 7a111cc8..28f4ed1f 100644
--- a/src/libkrun/src/api/vmm_builder.rs
+++ b/src/libkrun/src/api/vmm_builder.rs
@@ -456,9 +456,10 @@ fn build_vm(builder_cfg: VmmBuilder<'_>) -> Result<Vmm<'_>, VmmError> {
             {
                 builder_cfg.split_irqchip
             }
+            // On macOS the worker maps gpu blobs and virtiofs DAX windows into the guest.
             #[cfg(not(target_arch = "x86_64"))]
             {
-                false
+                cfg!(target_os = "macos")
             }
         }
     };
