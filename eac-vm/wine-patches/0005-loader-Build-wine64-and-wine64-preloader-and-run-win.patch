From d18492817da4ef5760dbbac9a7f46e053cb6f9a2 Mon Sep 17 00:00:00 2001
From: Paul Gofman <pgofman@codeweavers.com>
Date: Fri, 16 Oct 2026 07:30:09 -0400
Subject: [PATCH 5/6] loader: Build wine64 and wine64-preloader, and run
 wine64-preloader for AMD64 images.

EAC's Linux launcher reads /proc/self/exe of the Wine process and only proceeds with a 64-bit game when it is
wine64-preloader; with wine-preloader its injection child exits before exec (launcher result 210, #1).

Proton: ValveSoftware/wine e8f45bef0e48 (proton_11.0, "loader: HACK: Build wine64 and wine64-preloader."),
ported to upstream master: the enable_loader64 default sits after the "modules to disable by default" block, and
configure is regenerated (autoconf 2.73).
---
 configure                |  9 +++++++++
 configure.ac             |  8 ++++++++
 dlls/ntdll/unix/loader.c | 14 ++++++++++----
 loader64/Makefile.in     | 20 ++++++++++++++++++++
 tools/makedep.c          |  2 +-
 5 files changed, 48 insertions(+), 5 deletions(-)
 create mode 100644 loader64/Makefile.in

diff --git a/configure b/configure
index 8fc6ed2e..85c36890 100755
--- a/configure
+++ b/configure
@@ -1772,6 +1772,7 @@ enable_xml2
 enable_xslt
 enable_zlib
 enable_loader
+enable_loader64
 enable_nls
 enable_po
 enable_arp
@@ -21844,6 +21845,13 @@ then
     enable_compiler_rt=${enable_compiler_rt:-no}
 fi
 
+if test "$host_cpu" = "x86_64"
+then
+    enable_loader64=${enable_loader64:-yes}
+else
+    enable_loader64=${enable_loader64:-no}
+fi
+
 enable_winetest=${enable_winetest:-$enable_tests}
 
 
@@ -22974,6 +22982,7 @@ wine_fn_config_makefile libs/xml2 enable_xml2
 wine_fn_config_makefile libs/xslt enable_xslt
 wine_fn_config_makefile libs/zlib enable_zlib
 wine_fn_config_makefile loader enable_loader
+wine_fn_config_makefile loader64 enable_loader64
 wine_fn_config_makefile nls enable_nls
 wine_fn_config_makefile po enable_po
 wine_fn_config_makefile programs/arp enable_arp
diff --git a/configure.ac b/configure.ac
index 7748dc69..ad90a864 100644
--- a/configure.ac
+++ b/configure.ac
@@ -2371,6 +2371,13 @@ then
     enable_compiler_rt=${enable_compiler_rt:-no}
 fi
 
+if test "$host_cpu" = "x86_64"
+then
+    enable_loader64=${enable_loader64:-yes}
+else
+    enable_loader64=${enable_loader64:-no}
+fi
+
 dnl Disable winetest too if tests are disabled
 enable_winetest=${enable_winetest:-$enable_tests}
 
@@ -3503,6 +3510,7 @@ WINE_CONFIG_MAKEFILE(libs/xml2)
 WINE_CONFIG_MAKEFILE(libs/xslt)
 WINE_CONFIG_MAKEFILE(libs/zlib)
 WINE_CONFIG_MAKEFILE(loader)
+WINE_CONFIG_MAKEFILE(loader64)
 WINE_CONFIG_MAKEFILE(nls)
 WINE_CONFIG_MAKEFILE(po)
 WINE_CONFIG_MAKEFILE(programs/arp)
diff --git a/dlls/ntdll/unix/loader.c b/dlls/ntdll/unix/loader.c
index dcfb95bf..f65fc386 100644
--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -496,10 +496,16 @@ char *get_alternate_wineloader( WORD machine )
 }
 
 
-static void preloader_exec( char **argv )
+static void preloader_exec( char **argv, WORD machine )
 {
 #ifdef HAVE_WINE_PRELOADER
-    asprintf( &argv[0], "%s-preloader", argv[1] );
+#if !defined(__arm__) && !defined(__aarch64__)
+    if (machine == IMAGE_FILE_MACHINE_AMD64)
+        asprintf( &argv[0], "%s64-preloader", argv[1] );
+    else
+#endif
+        asprintf( &argv[0], "%s-preloader", argv[1] );
+
 #ifdef __APPLE__
     {
         posix_spawnattr_t attr;
@@ -544,10 +550,10 @@ static NTSTATUS loader_exec( char **argv, WORD machine )
 
     putenv( noexec );
 
-    if (((argv[1] = get_alternate_wineloader( machine )))) preloader_exec( argv );
+    if (((argv[1] = get_alternate_wineloader( machine )))) preloader_exec( argv, machine );
 
     argv[1] = strdup( wineloader );
-    preloader_exec( argv );
+    preloader_exec( argv, machine );
     return STATUS_INVALID_IMAGE_FORMAT;
 }
 
diff --git a/loader64/Makefile.in b/loader64/Makefile.in
new file mode 100644
index 00000000..cfbe51d4
--- /dev/null
+++ b/loader64/Makefile.in
@@ -0,0 +1,20 @@
+PARENTSRC = ../loader
+
+SOURCES = \
+	main.c \
+	preloader.c \
+	preloader_mac.c
+
+PROGRAMS = wine64 wine64-preloader
+INSTALL_LIB = wine64 wine64-preloader
+UNIX_CFLAGS = -fPIE
+
+preloader_EXTRADEFS = -fno-builtin
+
+wine64_OBJS = main.o
+wine64_DEPS = $(WINELOADER_DEPENDS)
+wine64_LDFLAGS = $(WINELOADER_LDFLAGS) $(LDEXECFLAGS) $(PTHREAD_LIBS)
+
+wine64_preloader_OBJS = preloader.o
+wine64_preloader_DEPS = $(WINELOADER_DEPENDS)
+wine64_preloader_LDFLAGS = $(WINEPRELOADER_LDFLAGS)
diff --git a/tools/makedep.c b/tools/makedep.c
index cc98e7b4..2b60a83e 100644
--- a/tools/makedep.c
+++ b/tools/makedep.c
@@ -4231,7 +4231,7 @@ static void output_programs( struct makefile *make )
         }
         strarray_addall( &make->all_targets[arch], symlinks );
 
-        install_dir = !strcmp( make->obj_dir, "loader" ) ? arch_install_dirs[arch] : "$(bindir)";
+        install_dir = !strcmp( make->obj_dir, "loader" ) || !strcmp( make->obj_dir, "loader64" ) ? arch_install_dirs[arch] : "$(bindir)";
         install_program( make, name, arch, program, install_dir );
         STRARRAY_FOR_EACH( link, &symlinks )
             install_program_symlink( make, link, obj_dir_path( make, program ),
