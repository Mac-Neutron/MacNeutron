From c7b7a3ea810999fd395055e600f41ee1f95e4637 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Thu, 22 Oct 2026 10:49:04 -0400
Subject: [PATCH 39/40] LinuxSyscalls: a thread's exit blocks every signal
 before its teardown

exit freed the signal alt stack (ReleaseDeferredTLSState) and the thread
object (DestroyThread) with signals still deliverable; a signal arriving
then ran FEX's host handler on freed memory. A thread exiting while being
sent SIGUSR1 (Wine's NtSuspendThread / NtGetContextThread do that) died by
SIGSEGV. Linux runs no handler once do_exit has started: block them all
first.
---
 .../Tools/LinuxEmulation/LinuxSyscalls/Syscalls/Thread.cpp   | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/Source/Tools/LinuxEmulation/LinuxSyscalls/Syscalls/Thread.cpp b/Source/Tools/LinuxEmulation/LinuxSyscalls/Syscalls/Thread.cpp
index 46b77f8..1481d89 100644
--- a/Source/Tools/LinuxEmulation/LinuxSyscalls/Syscalls/Thread.cpp
+++ b/Source/Tools/LinuxEmulation/LinuxSyscalls/Syscalls/Thread.cpp
@@ -451,6 +451,11 @@ void RegisterThread(FEX::HLE::SyscallHandler* Handler) {
                         }));
 
   REGISTER_SYSCALL_IMPL(exit, [](FEXCore::Core::CpuStateFrame* Frame, int status) -> uint64_t {
+    // No signal handler runs once a thread has called exit (Linux's do_exit). Block every signal before the teardown
+    // below frees the signal alt stack and the thread object: a signal landing in it ran FEX's handler on freed memory.
+    uint64_t AllSignals = ~0ULL;
+    ::syscall(SYS_rt_sigprocmask, SIG_BLOCK, &AllSignals, nullptr, sizeof(AllSignals));
+
     // TLS/DTV teardown is something FEX can't control. Disable glibc checking when we leave a pthread.
     // Since this thread is hard stopping, we can't track the TLS/DTV teardown in FEX's thread handling.
     FEXCore::Allocator::YesIKnowImNotSupposedToUseTheGlibcAllocator::HardDisable();
