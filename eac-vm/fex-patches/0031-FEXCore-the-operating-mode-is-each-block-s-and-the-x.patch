From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Tue, 20 Oct 2026 12:11:01 -0400
Subject: [PATCH] FEXCore: the operating mode is each block's, and the x87 pass
 sizes addresses by it

---
 FEXCore/Source/Interface/Core/Frontend.cpp                   | 5 ++++-
 FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp           | 2 +-
 FEXCore/Source/Interface/IR/IREmitter.h                      | 3 +++
 .../Source/Interface/IR/Passes/x87StackOptimizationPass.cpp  | 4 +++-
 4 files changed, 11 insertions(+), 3 deletions(-)

diff --git a/FEXCore/Source/Interface/Core/Frontend.cpp b/FEXCore/Source/Interface/Core/Frontend.cpp
index ca6b645..de91e3f 100644
--- a/FEXCore/Source/Interface/Core/Frontend.cpp
+++ b/FEXCore/Source/Interface/Core/Frontend.cpp
@@ -1763,8 +1763,11 @@ void Decoder::SetupDecodeInstructionsAtEntry(FEXCore::Core::InternalThreadState*
 
   // Decode operating mode from thread's CS segment.
   const auto CSSegment = Core::CPUState::GetSegmentFromIndex(Thread->CurrentFrame->State, Thread->CurrentFrame->State.cs_idx);
+  // The mode is each block's: Wine's new WoW64 runs 32-bit code (cs 0x23) in a 64-bit process.
+  // ponytail: compiled blocks are looked up by RIP alone, so a RIP run in both modes would reuse the first mode's code
+  // (Wine's 32-bit and 64-bit code never share an address); the code cache (EnableCodeCachingWIP, off) assumes one
+  // mode. Key the lookup and the cache on the mode when a program needs both.
   BlockInfo.Is64BitMode = CSSegment->L == 1;
-  LOGMAN_THROW_A_FMT(BlockInfo.Is64BitMode == CTX->Config.Is64BitMode, "Expected operating mode to not change at runtime!");
 
   EntryPoint = PC;
   BlockInfo.EntryPoints = {PC};
diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp b/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
index b3e1af2..7134f4f 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
@@ -4138,7 +4138,7 @@ void OpDispatchBuilder::BeginFunction(uint64_t RIP, const fextl::vector<FEXCore:
                                       uint32_t NumInstructions, bool _Is64BitMode, bool MonoBackpatcherBlock) {
   Entry = RIP;
   Is64BitMode = _Is64BitMode;
-  LOGMAN_THROW_A_FMT(Is64BitMode == CTX->Config.Is64BitMode, "Expected operating mode to not change at runtime!");
+  GuestGPRSize = GetGPROpSize();
   IsMonoBackpatcherBlock = MonoBackpatcherBlock;
   auto IRHeader = _IRHeader(InvalidNode, RIP, 0, NumInstructions, 0, 0);
   CreateJumpBlocks(Blocks);
diff --git a/FEXCore/Source/Interface/IR/IREmitter.h b/FEXCore/Source/Interface/IR/IREmitter.h
index aba0c1f..f9a7da6 100644
--- a/FEXCore/Source/Interface/IR/IREmitter.h
+++ b/FEXCore/Source/Interface/IR/IREmitter.h
@@ -475,6 +475,9 @@ public:
   IRPair<IROp_CodeBlock> CreateNewCodeBlockAfter(Ref insertAfter);
   void SetCurrentCodeBlock(Ref Node);
 
+  // The GPR size of the block being built (its code segment's mode), for passes that compute guest addresses.
+  OpSize GuestGPRSize {OpSize::i64Bit};
+
 protected:
   void RemoveArgUses(Ref Node);
 
diff --git a/FEXCore/Source/Interface/IR/Passes/x87StackOptimizationPass.cpp b/FEXCore/Source/Interface/IR/Passes/x87StackOptimizationPass.cpp
index f205097..e55a04c 100644
--- a/FEXCore/Source/Interface/IR/Passes/x87StackOptimizationPass.cpp
+++ b/FEXCore/Source/Interface/IR/Passes/x87StackOptimizationPass.cpp
@@ -161,7 +161,7 @@ public:
 
 private:
   const FEXCore::HostFeatures& Features;
-  const OpSize GPROpSize;
+  OpSize GPROpSize;
   bool ReducedPrecisionMode;
   FEX_CONFIG_OPT(DisableVixlIndirectCalls, DISABLE_VIXL_INDIRECT_RUNTIME_CALLS);
 
@@ -724,6 +724,8 @@ Ref X87StackOptimization::SynchronizeStackValues() {
 
 void X87StackOptimization::Run(IREmitter* Emit) {
   FEXCORE_PROFILE_SCOPED("PassManager::x87StackOpt");
+  // The block's own mode: a 32-bit block in a 64-bit process wraps its addresses at 4 GiB.
+  GPROpSize = Emit->GuestGPRSize;
 
   auto CurrentIR = Emit->ViewIR();
   auto* HeaderOp = CurrentIR.GetHeader();
-- 
