From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Tue, 20 Oct 2026 12:09:57 -0400
Subject: [PATCH] LinuxEmulation: a 64-bit process's GDT has the kernel's
 32-bit code (0x23) and data (0x2b) segments

---
 .../LinuxEmulation/LinuxSyscalls/ThreadManager.cpp     | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/Source/Tools/LinuxEmulation/LinuxSyscalls/ThreadManager.cpp b/Source/Tools/LinuxEmulation/LinuxSyscalls/ThreadManager.cpp
index 68c78de..48566f5 100644
--- a/Source/Tools/LinuxEmulation/LinuxSyscalls/ThreadManager.cpp
+++ b/Source/Tools/LinuxEmulation/LinuxSyscalls/ThreadManager.cpp
@@ -275,6 +275,16 @@ ThreadManager::CreateThread(const FEXCore::Core::CPUState* NewThreadState, uint6
     SSGDT->L = 0;
     SSGDT->D = 1;
     Frame->State.ss_cached = FEXCore::Core::CPUState::CalculateGDTBase(*SSGDT);
+
+    if (Is64BitMode()) {
+      // The kernel's __USER32_CS (0x23) beside __USER_CS, as in every x86-64 process: Wine's new WoW64 enters 32-bit
+      // code with IRETQ or a far jump to it, and loads __USER_DS (0x2b, set up above) into %ds/%es/%ss.
+      auto CS32GDT = FEXCore::Core::CPUState::GetSegmentFromIndex(Frame->State, FEXCore::Core::CPUState::DEFAULT_USER32_CS_SEL);
+      FEXCore::Core::CPUState::SetGDTBase(CS32GDT, 0);
+      FEXCore::Core::CPUState::SetGDTLimit(CS32GDT, 0xF'FFFFU);
+      CS32GDT->L = 0;
+      CS32GDT->D = 1;
+    }
   }
 
   if (InheritThread) {
