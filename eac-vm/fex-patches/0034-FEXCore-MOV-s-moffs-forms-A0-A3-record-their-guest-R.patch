From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Tue, 20 Oct 2026 16:30:14 -0400
Subject: [PATCH] FEXCore: MOV's moffs forms (A0-A3) record their guest RIP, so
 a fault in one reports its own instruction

Their memory operand is a literal, which CanHaveSideEffects didn't
count: no GuestOpcode marked them, and a fault in one (common in 32-bit
code: mov eax, [global]) reported the block's first instruction, so a
handler that resumes re-ran the block's earlier instructions.
---
 FEXCore/Source/Interface/Core/OpcodeDispatcher.h | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher.h b/FEXCore/Source/Interface/Core/OpcodeDispatcher.h
index c295d2b..d5bd4ed 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher.h
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher.h
@@ -248,9 +248,10 @@ public:
 
   static bool CanHaveSideEffects(const FEXCore::X86Tables::X86InstInfo* TableInfo, FEXCore::X86Tables::DecodedOp Op) {
     if (TableInfo) {
-      if (TableInfo->Flags & X86Tables::InstFlags::FLAGS_DEBUG_MEM_ACCESS) {
+      if (TableInfo->Flags & (X86Tables::InstFlags::FLAGS_DEBUG_MEM_ACCESS | X86Tables::InstFlags::FLAGS_MEM_OFFSET)) {
         // If it is marked as having memory access then always say it has a side-effect.
         // Not always true but better to be safe.
+        // MOV's moffs forms (A0-A3) access memory through a literal operand, which the checks below don't count.
         return true;
       }
 
