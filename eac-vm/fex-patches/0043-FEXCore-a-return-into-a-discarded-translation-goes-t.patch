@@ -85,6 +85,9 @@ struct GuestToHostMap {
   struct BlockEntry {
     uint64_t HostCode;
     fextl::vector<uint64_t> CodePages;
+    // The translation's start (its JITCodeHeader), whose return points are patched when the entry is erased; null when
