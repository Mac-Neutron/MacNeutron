From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Thu, 22 Oct 2026 21:30:58 -0400
Subject: [PATCH] Signals: a signal while FEX raises a guest fault or after a
 guest rt_sigreturn sees the live registers

Two ways an asynchronous signal (Wine's SIGUSR1 for NtSuspendThread, say)
was given stale guest registers, which its rt_sigreturn then made the
thread's:

- A block raising a guest SIGILL/SIGTRAP/SIGSEGV branches to a dispatcher
  stub that spills the static registers and then traps. A signal during
  that spill was taken for one in the dispatcher, whose frame is current,
  and got the registers of the last spill; the block had already asked for
  a fault to the top, so its return reloaded them. The stubs' spill ranges
  are now part of the signal delegator's config and count as JIT code.
- The guest's rt_sigreturn goes through the syscall dispatcher, which marks
  every register as spilled (InSyscallInfo) and clears that when the
  syscall returns, which rt_sigreturn never does. After a handler that left
  RIP alone the thread ran on with it set, so the next signal or SMC fault
  in JIT code skipped spilling the live registers. RestoreThreadState now
  puts back the interrupted code's value.

A thread executing ud2 in a loop under a SIGUSR1 flood got a SIGILL with
the previous return's registers within seconds; under Wine, Age of Empires
II DE's protector suspending its threads saw them die of "nested exception
on signal stack" or jump to their stack.
---
 .../Interface/Core/Dispatcher/Dispatcher.cpp      |  5 +++++
 .../Source/Interface/Core/Dispatcher/Dispatcher.h |  1 +
 FEXCore/include/FEXCore/Core/SignalDelegator.h    |  4 ++++
 .../LinuxSyscalls/SignalDelegator.cpp             | 15 ++++++++++++++-
 4 files changed, 24 insertions(+), 1 deletion(-)

diff --git a/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp b/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp
index 5637b8c..e64c8a8 100644
--- a/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp
+++ b/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp
@@ -403,6 +403,7 @@ void Dispatcher::EmitDispatcher() {
     GuestSignal_SIGILL = GetCursorAddress<uint64_t>();
 
     SpillStaticRegs(TMP1);
+    GuestSignalSpillRanges[0] = {GuestSignal_SIGILL, GetCursorAddress<uint64_t>()};
 
     hlt(0);
   }
@@ -413,6 +414,7 @@ void Dispatcher::EmitDispatcher() {
     GuestSignal_SIGTRAP = GetCursorAddress<uint64_t>();
 
     SpillStaticRegs(TMP1);
+    GuestSignalSpillRanges[1] = {GuestSignal_SIGTRAP, GetCursorAddress<uint64_t>()};
 
     brk(0);
   }
@@ -423,6 +425,7 @@ void Dispatcher::EmitDispatcher() {
     GuestSignal_SIGSEGV = GetCursorAddress<uint64_t>();
 
     SpillStaticRegs(TMP1);
+    GuestSignalSpillRanges[2] = {GuestSignal_SIGSEGV, GetCursorAddress<uint64_t>()};
 
     // hlt/udf = SIGILL
     // brk = SIGTRAP
@@ -2750,6 +2753,8 @@ SignalDelegatorConfig Dispatcher::MakeSignalDelegatorConfig() const {
 
     .SRAGPRMapping = GetSRAGPRMapping(),
     .SRAFPRMapping = GetSRAFPRMapping(),
+
+    .GuestSignalSpillRanges = GuestSignalSpillRanges,
   };
 }
 
diff --git a/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.h b/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.h
index 6f460fc..3a7284d 100644
--- a/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.h
+++ b/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.h
@@ -90,6 +90,7 @@ private:
   uint64_t GuestSignal_SIGTRAP {};
   uint64_t GuestSignal_SIGSEGV {};
   uint64_t GuestSignal_SynchronousFault {};
+  std::array<std::array<uint64_t, 2>, 3> GuestSignalSpillRanges {};
 
   uint64_t PauseReturnInstruction {};
   std::array<uint64_t, FallbackABI::FABI_UNKNOWN> ABIPointers {};
diff --git a/FEXCore/include/FEXCore/Core/SignalDelegator.h b/FEXCore/include/FEXCore/Core/SignalDelegator.h
index 4386f0c..cd6a4b0 100644
--- a/FEXCore/include/FEXCore/Core/SignalDelegator.h
+++ b/FEXCore/include/FEXCore/Core/SignalDelegator.h
@@ -53,6 +53,10 @@ struct SignalDelegatorConfig {
   // SRA index mapping.
   SRAIndexMapping SRAGPRMapping;
   SRAIndexMapping SRAFPRMapping;
+
+  // Where the guest signal stubs (SIGILL, SIGTRAP, SIGSEGV) spill the static registers before they trap: [begin, end)
+  // each. Until a stub's spill ends, the guest registers are in the host registers, as in JIT code.
+  std::array<std::array<uint64_t, 2>, 3> GuestSignalSpillRanges {};
 };
 
 class SignalDelegator {
diff --git a/Source/Tools/LinuxEmulation/LinuxSyscalls/SignalDelegator.cpp b/Source/Tools/LinuxEmulation/LinuxSyscalls/SignalDelegator.cpp
index e1f1d68..cb1ce18 100644
--- a/Source/Tools/LinuxEmulation/LinuxSyscalls/SignalDelegator.cpp
+++ b/Source/Tools/LinuxEmulation/LinuxSyscalls/SignalDelegator.cpp
@@ -25,6 +25,7 @@ $end_info$
 #include <FEXCore/Utils/ArchHelpers/Arm64.h>
 #include <FEXHeaderUtils/Syscalls.h>
 
+#include <algorithm>
 #include <atomic>
 #include <cerrno>
 #include <csignal>
@@ -267,6 +268,11 @@ void SignalDelegator::RestoreThreadState(FEXCore::Core::InternalThreadState* Thr
   if (Context->Flags & ArchHelpers::Context::ContextFlags::CONTEXT_FLAG_SYSCALLINFO_CLEARED) {
     // Back in the syscall handler the guest signal interrupted.
     Thread->CurrentFrame->InSyscallInfo = Context->ClearedSyscallInfo;
+  } else if (Type != RestoreType::TYPE_PAUSE) {
+    // A guest rt_sigreturn got here through the syscall dispatcher, which marked every register as spilled and clears
+    // that only when the syscall returns, which this one never does: the interrupted code's value comes back, or the
+    // next signal or SMC fault in JIT code would skip spilling the live registers and keep stale ones.
+    Thread->CurrentFrame->InSyscallInfo = Context->InSyscallInfo;
   }
 
   {
@@ -346,7 +352,14 @@ bool SignalDelegator::HandleDispatcherGuestSignal(FEXCore::Core::InternalThreadS
   ++Thread->CurrentFrame->SignalHandlerRefCounter;
 
   uint64_t OldPC = ArchHelpers::Context::GetPc(ucontext);
-  const bool WasInJIT = CTX->IsAddressInCodeBuffer(Thread, OldPC);
+  // A block raising a guest SIGILL/SIGTRAP/SIGSEGV branches to a dispatcher stub that spills the static registers and
+  // then traps. Until that spill ends the frame holds the registers of the last spill (an earlier signal's return, say)
+  // and the live ones are still in the host registers, as in JIT code: take them from there. The block has already
+  // asked for a fault to the top, so this signal's rt_sigreturn reloads the guest registers from its frame.
+  const bool InGuestSignalSpill = std::ranges::any_of(Config.GuestSignalSpillRanges, [OldPC](const auto& Range) {
+    return OldPC >= Range[0] && OldPC < Range[1];
+  });
+  const bool WasInJIT = CTX->IsAddressInCodeBuffer(Thread, OldPC) || InGuestSignalSpill;
 
   // Spill the SRA regardless of signal handler type
   // We are going to be returning to the top of the dispatcher which will fill again
