From 6ea9b6c441461082329e4224316fa66e5e77759f Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Thu, 22 Oct 2026 09:52:24 -0400
Subject: [PATCH] FEXCore: an invalid instruction on a hot page validates its
 first byte instead of spinning

On an SMC hot page (patches 0002, 0027) the JIT checks each instruction's
bytes before running it. An invalid instruction decodes with InstSize 0:
the check covered no bytes, and ValidateCode then compared TMP1, never
written, with the CRC, so every run looked modified and the block was
invalidated and retranslated forever. Age of Empires II DE's protector
makes a page RWX, rewrites it and plants an invalid opcode (a nanomite):
the game spun there. The check now covers at least the first byte, and a
zero-length ValidateCode reports the code unchanged.
---
 FEXCore/Source/Interface/Core/Core.cpp          | 9 ++++++---
 FEXCore/Source/Interface/Core/JIT/BranchOps.cpp | 6 ++++++
 2 files changed, 12 insertions(+), 3 deletions(-)

diff --git a/FEXCore/Source/Interface/Core/Core.cpp b/FEXCore/Source/Interface/Core/Core.cpp
index 38efa00..404cbc7 100644
--- a/FEXCore/Source/Interface/Core/Core.cpp
+++ b/FEXCore/Source/Interface/Core/Core.cpp
@@ -640,11 +640,14 @@ ContextImpl::GenerateIR(FEXCore::Core::InternalThreadState* Thread, uint64_t Gue
           auto ExistingCodePtr = reinterpret_cast<uint8_t*>(Block.Entry + BlockInstructionsLength);
           auto InstAddressReg = Thread->OpDispatcher->_EntrypointOffset(GPRSize, InstAddress - GuestRIP);
 
-          auto Value = FEXCore::Utils::crc32(ExistingCodePtr, DecodedInfo->InstSize);
+          // An invalid instruction decodes with no size: check its first byte at least, so that a protector rewriting the
+          // byte it planted (a nanomite) gets the new code, not the stale #UD.
+          const auto CheckSize = std::max<uint8_t>(DecodedInfo->InstSize, 1);
+          auto Value = FEXCore::Utils::crc32(ExistingCodePtr, CheckSize);
           auto CRC = WantsDiskCachePatching ?
-                       Thread->OpDispatcher->_PatchableGuestCRC(IR::OpSize::i64Bit, Value, (int64_t)ExistingCodePtr, DecodedInfo->InstSize) :
+                       Thread->OpDispatcher->_PatchableGuestCRC(IR::OpSize::i64Bit, Value, (int64_t)ExistingCodePtr, CheckSize) :
                        Thread->OpDispatcher->Constant(Value);
-          auto CodeChanged = Thread->OpDispatcher->_ValidateCode(CRC, InstAddressReg, DecodedInfo->InstSize);
+          auto CodeChanged = Thread->OpDispatcher->_ValidateCode(CRC, InstAddressReg, CheckSize);
 
           auto InvalidateCodeCond = Thread->OpDispatcher->CondJump(CodeChanged);
 
diff --git a/FEXCore/Source/Interface/Core/JIT/BranchOps.cpp b/FEXCore/Source/Interface/Core/JIT/BranchOps.cpp
index c418630..ac594e0 100644
--- a/FEXCore/Source/Interface/Core/JIT/BranchOps.cpp
+++ b/FEXCore/Source/Interface/Core/JIT/BranchOps.cpp
@@ -348,6 +348,12 @@ DEF_OP(ValidateCode) {
   const auto Dst = GetReg(Node);
   const auto CRC32Reg = GetReg(Op->crc);
 
+  if (!len) {
+    // Nothing to check: unchanged. (Comparing TMP1, never written below, made every run look modified.)
+    LoadConstant(ARMEmitter::Size::i32Bit, Dst, 0);
+    return;
+  }
+
   // Changes to TMP1
   auto WorkingReg = ARMEmitter::XReg::zr;
   auto BaseReg = TMP2;
