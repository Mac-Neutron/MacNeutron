From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Tue, 20 Oct 2026 16:30:14 -0400
Subject: [PATCH] FEXCore, LinuxEmulation: 64-bit push %fs/%gs pushes the
 selector; a 64-bit signal frame's fs and gs words are 0

As Linux and x86-64 CPUs do. FEX pushed the segment's base, and wrote
fs_idx/gs_idx into REG_CSGSFS, which Linux leaves 0 (and never restores
from): a WoW64 process's 64-bit code has a 32-bit TEB's selector in
%fs (0032).
---
 FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp           | 5 +++--
 .../LinuxSyscalls/SignalDelegator/GuestFramesManagement.cpp  | 4 ++--
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp b/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
index 73ce6c4..05c017f 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
@@ -385,11 +385,12 @@ void OpDispatchBuilder::PUSHSegmentOp(OpcodeArgs, uint32_t SegmentReg) {
     case FEXCore::X86Tables::DecodeFlags::FLAG_DS_PREFIX:
       Src = _LoadContextGPR(SrcSize, offsetof(FEXCore::Core::CPUState, ds_cached));
       break;
+    // 64-bit code pushes the selector too (zero-extended), not the base: a 32-bit TEB's selector Wine loaded.
     case FEXCore::X86Tables::DecodeFlags::FLAG_FS_PREFIX:
-      Src = _LoadContextGPR(SrcSize, offsetof(FEXCore::Core::CPUState, fs_cached));
+      Src = _LoadContextGPR(OpSize::i16Bit, offsetof(FEXCore::Core::CPUState, fs_idx));
       break;
     case FEXCore::X86Tables::DecodeFlags::FLAG_GS_PREFIX:
-      Src = _LoadContextGPR(SrcSize, offsetof(FEXCore::Core::CPUState, gs_cached));
+      Src = _LoadContextGPR(OpSize::i16Bit, offsetof(FEXCore::Core::CPUState, gs_idx));
       break;
     default: FEX_UNREACHABLE;
     }
diff --git a/Source/Tools/LinuxEmulation/LinuxSyscalls/SignalDelegator/GuestFramesManagement.cpp b/Source/Tools/LinuxEmulation/LinuxSyscalls/SignalDelegator/GuestFramesManagement.cpp
index 4c91eb2..7174ddc 100644
--- a/Source/Tools/LinuxEmulation/LinuxSyscalls/SignalDelegator/GuestFramesManagement.cpp
+++ b/Source/Tools/LinuxEmulation/LinuxSyscalls/SignalDelegator/GuestFramesManagement.cpp
@@ -549,9 +549,9 @@ uint64_t SignalDelegator::SetupFrame_x64(FEXCore::Core::InternalThreadState* Thr
   guest_uctx->uc_mcontext.gregs[FEXCore::x86_64::FEX_REG_EFL] = eflags;
   // This stores the CS/GS/FS selectors. It ALSO stores the SS selector in the top 16 bits...For some reason.
   // Despite the naming, the endianness is swapped from what you'd expect.
+  // Linux writes 0 for GS and FS in a 64-bit frame (and never restores them from it), whatever they hold.
   guest_uctx->uc_mcontext.gregs[FEXCore::x86_64::FEX_REG_CSGSFS] =
-    ((uint64_t)Frame->State.ss_idx << 48) | ((uint64_t)Frame->State.fs_idx << 32) | ((uint64_t)Frame->State.gs_idx << 16) |
-    ((uint64_t)Frame->State.cs_idx << 0);
+    ((uint64_t)Frame->State.ss_idx << 48) | ((uint64_t)Frame->State.cs_idx << 0);
 
   // aarch64 and x86_64 siginfo_t matches. We can just copy this over
   // SI_USER could also potentially have random data in it, needs to be bit perfect
-- 
