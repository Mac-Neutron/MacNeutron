From c0ac8465fe4bece6ca117f4f8b6e09d80048075e Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Tue, 20 Oct 2026 12:12:52 -0400
Subject: [PATCH] LinuxSyscalls: int 0x80 from a 64-bit process answers
 set_thread_area and get_thread_area with the i386 ABI

---
 .../Interface/Core/OpcodeDispatcher.cpp       |  8 +--
 .../LinuxEmulation/LinuxSyscalls/Syscalls.cpp | 14 ++++-
 .../LinuxSyscalls/x32/Thread.cpp              | 60 ++++++++++---------
 .../LinuxEmulation/LinuxSyscalls/x32/Thread.h |  1 +
 4 files changed, 48 insertions(+), 35 deletions(-)

diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp b/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
index f8a6cb7..0319fa9 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
@@ -4824,12 +4824,8 @@ void OpDispatchBuilder::INTOp(OpcodeArgs) {
     if (CTX->HostFeatures.HostType == FEXCore::HostFeatures::HostTypeEnum::Linux) {
       constexpr uint8_t SYSCALL_LITERAL = 0x80;
       if (Literal == SYSCALL_LITERAL) {
-        if (Is64BitMode) [[unlikely]] {
-          LogMan::Msg::EFmt("[Unsupported] Trying to execute 32-bit syscall from a 64-bit process.");
-          UnhandledOp(Op);
-          return;
-        }
-        // Syscall on linux
+        // Syscall on linux, from 64-bit code too (Wine's new WoW64 calls set_thread_area this way): the syscall
+        // handler tells it from `syscall` by the instruction at RIP.
         SyscallOp(Op, false);
         return;
       }
diff --git a/Source/Tools/LinuxEmulation/LinuxSyscalls/Syscalls.cpp b/Source/Tools/LinuxEmulation/LinuxSyscalls/Syscalls.cpp
index 207c33b..752ebb3 100644
--- a/Source/Tools/LinuxEmulation/LinuxSyscalls/Syscalls.cpp
+++ b/Source/Tools/LinuxEmulation/LinuxSyscalls/Syscalls.cpp
@@ -21,6 +21,7 @@ $end_info$
 #include "LinuxSyscalls/Syscalls/Thread.h"
 #include "LinuxSyscalls/Utils/Threads.h"
 #include "LinuxSyscalls/x32/Syscalls.h"
+#include "LinuxSyscalls/x32/Thread.h"
 #include "LinuxSyscalls/x64/Syscalls.h"
 #include "LinuxSyscalls/x32/Types.h"
 #include "LinuxSyscalls/x64/Types.h"
@@ -948,7 +949,18 @@ void SyscallHandler::HandleSyscall(FEXCore::Core::CpuStateFrame* Frame) {
   const auto Is64Bit = Is64BitMode();
 
   // TODO: At some point these will be runtime selectable based on `syscall` versus `int 0x80` entrypoint.
-  if (Is64Bit) {
+  // Done for one case: `int 0x80` (CD 80 at RIP) in a 64-bit process uses the i386 ABI, number in eax and first
+  // argument in ebx, and Linux answers it from its compat table.
+  // ponytail: only set_thread_area and get_thread_area, the two Wine's x86-64 WoW64 makes (alloc_fs_sel), and before
+  // any seccomp filter sees them; the x32 table and the filter when a program needs more.
+  const auto Inst = reinterpret_cast<const uint8_t*>(Frame->State.rip);
+  if (Is64Bit && Inst[0] == 0xCD && Inst[1] == 0x80) {
+    const auto Num = static_cast<uint32_t>(Frame->State.gregs[FEXCore::X86State::REG_RAX]);
+    const auto Arg = reinterpret_cast<void*>(static_cast<uint32_t>(Frame->State.gregs[FEXCore::X86State::REG_RBX]));
+    Frame->State.gregs[FEXCore::X86State::REG_RAX] = Num == 243 ? x32::SetThreadArea(Frame, Arg) :
+                                                     Num == 244 ? x32::GetThreadArea(Frame, Arg) :
+                                                                  -ENOSYS;
+  } else if (Is64Bit) {
     HandleSyscallImpl<true>(Frame, JITPC);
   } else {
     HandleSyscallImpl<false>(Frame, JITPC);
diff --git a/Source/Tools/LinuxEmulation/LinuxSyscalls/x32/Thread.cpp b/Source/Tools/LinuxEmulation/LinuxSyscalls/x32/Thread.cpp
index 096a623..93f8f07 100644
--- a/Source/Tools/LinuxEmulation/LinuxSyscalls/x32/Thread.cpp
+++ b/Source/Tools/LinuxEmulation/LinuxSyscalls/x32/Thread.cpp
@@ -97,6 +97,36 @@ uint64_t SetThreadArea(FEXCore::Core::CpuStateFrame* Frame, void* tls) {
   return 0;
 }
 
+uint64_t GetThreadArea(FEXCore::Core::CpuStateFrame* Frame, void* tls) {
+  struct x32::user_desc* u_info = reinterpret_cast<struct x32::user_desc*>(tls);
+  // Index to fetch comes from the user_desc
+  uint32_t Entry = u_info->entry_number;
+  if (Entry < TLS_NextEntry || Entry >= TLS_MaxEntry) {
+    return -EINVAL;
+  }
+
+  FaultSafeUserMemAccess::VerifyIsWritable(u_info, sizeof(*u_info));
+
+  const auto& GDT = &Frame->State.segment_arrays[FEXCore::Core::CPUState::SEGMENT_ARRAY_INDEX_GDT][Entry];
+
+  memset(u_info, 0, sizeof(*u_info));
+
+  // FEX only stores base instead of the full GDT
+  u_info->base_addr = Frame->State.CalculateGDTBase(*GDT);
+
+  // Fill the rest of the structure with expected data (even if wrong at the moment)
+  if (u_info->base_addr) {
+    u_info->limit = 0xF'FFFF;
+    u_info->seg_32bit = 1;
+    u_info->limit_in_pages = 1;
+    u_info->useable = 1;
+  } else {
+    u_info->read_exec_only = 1;
+    u_info->seg_not_present = 1;
+  }
+  return 0;
+}
+
 void AdjustRipForNewThread(FEXCore::Core::CpuStateFrame* Frame) {
   Frame->State.rip += 2;
 }
@@ -151,34 +181,8 @@ void RegisterThread(FEX::HLE::SyscallHandler* Handler) {
   REGISTER_SYSCALL_IMPL_X32(
     set_thread_area, [](FEXCore::Core::CpuStateFrame* Frame, struct user_desc* u_info) -> uint64_t { return SetThreadArea(Frame, u_info); });
 
-  REGISTER_SYSCALL_IMPL_X32(get_thread_area, [](FEXCore::Core::CpuStateFrame* Frame, struct user_desc* u_info) -> uint64_t {
-    // Index to fetch comes from the user_desc
-    uint32_t Entry = u_info->entry_number;
-    if (Entry < TLS_NextEntry || Entry >= TLS_MaxEntry) {
-      return -EINVAL;
-    }
-
-    FaultSafeUserMemAccess::VerifyIsWritable(u_info, sizeof(*u_info));
-
-    const auto& GDT = &Frame->State.segment_arrays[FEXCore::Core::CPUState::SEGMENT_ARRAY_INDEX_GDT][Entry];
-
-    memset(u_info, 0, sizeof(*u_info));
-
-    // FEX only stores base instead of the full GDT
-    u_info->base_addr = Frame->State.CalculateGDTBase(*GDT);
-
-    // Fill the rest of the structure with expected data (even if wrong at the moment)
-    if (u_info->base_addr) {
-      u_info->limit = 0xF'FFFF;
-      u_info->seg_32bit = 1;
-      u_info->limit_in_pages = 1;
-      u_info->useable = 1;
-    } else {
-      u_info->read_exec_only = 1;
-      u_info->seg_not_present = 1;
-    }
-    return 0;
-  });
+  REGISTER_SYSCALL_IMPL_X32(
+    get_thread_area, [](FEXCore::Core::CpuStateFrame* Frame, struct user_desc* u_info) -> uint64_t { return GetThreadArea(Frame, u_info); });
 
   REGISTER_SYSCALL_IMPL_X32(set_robust_list, [](FEXCore::Core::CpuStateFrame* Frame, struct robust_list_head* head, size_t len) -> uint64_t {
     if (len != 12) {
diff --git a/Source/Tools/LinuxEmulation/LinuxSyscalls/x32/Thread.h b/Source/Tools/LinuxEmulation/LinuxSyscalls/x32/Thread.h
index 51d4d38..3c54e2c 100644
--- a/Source/Tools/LinuxEmulation/LinuxSyscalls/x32/Thread.h
+++ b/Source/Tools/LinuxEmulation/LinuxSyscalls/x32/Thread.h
@@ -27,5 +27,6 @@ struct user_desc {
 };
 
 uint64_t SetThreadArea(FEXCore::Core::CpuStateFrame* Frame, void* tls);
+uint64_t GetThreadArea(FEXCore::Core::CpuStateFrame* Frame, void* tls);
 void AdjustRipForNewThread(FEXCore::Core::CpuStateFrame* Frame);
 } // namespace FEX::HLE::x32
