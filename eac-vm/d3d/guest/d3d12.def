LIBRARY d3d12.dll
EXPORTS
    D3D12CreateDevice = mnd3d.D3D12CreateDevice @101
    D3D12GetDebugInterface = mnd3d.D3D12GetDebugInterface @102
    D3D12CreateRootSignatureDeserializer = mnd3d.D3D12CreateRootSignatureDeserializer
    D3D12CreateVersionedRootSignatureDeserializer = mnd3d.D3D12CreateVersionedRootSignatureDeserializer
    D3D12SerializeRootSignature = mnd3d.D3D12SerializeRootSignature
    D3D12SerializeVersionedRootSignature = mnd3d.D3D12SerializeVersionedRootSignature
    D3D12GetInterface = mnd3d.D3D12GetInterface
