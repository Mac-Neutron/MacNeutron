[Unit]
Description=MacNeutron test runner: runs /mnt/share/run.sh, then powers off
After=local-fs.target systemd-binfmt.service
RequiresMountsFor=/mnt/share /home /usr/share/fex-emu/RootFS/fedora
ConditionPathExists=/mnt/share/run.sh

[Service]
Type=oneshot
ExecStart=/usr/libexec/mn-runner
StandardOutput=journal+console

[Install]
WantedBy=multi-user.target
