[Unit]
Description=MacNeutron guest network: gvproxy's static lease on eth0 (spec §5.7)
BindsTo=sys-subsystem-net-devices-eth0.device
After=sys-subsystem-net-devices-eth0.device
Before=mn-runner.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/ip link set eth0 up
ExecStart=/usr/sbin/ip addr add 192.168.127.2/24 dev eth0
ExecStart=/usr/sbin/ip route add default via 192.168.127.1

[Install]
WantedBy=sys-subsystem-net-devices-eth0.device
